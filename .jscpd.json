{
  "minTokens": 120,
  "minLines": 15,
  "mode": "weak",
  "format": [
    "php",
    "javascript",
    "typescript",
    "twig"
  ],
  "ignore": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js",
    "**/translations/**",
    "**/fixtures/**",
    "**/tests/**",
    "**/migrations/**"
  ],
  "reporters": [
    "console"
  ],
  "threshold": 100
}
