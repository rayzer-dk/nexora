{% extends '@storefront/base.html.twig' %}
{% set presentation = storefront_presentation() %}
{% block body %}
{% if demo_showcase %}
<section class="demo-hero-section">
    <div class="shell demo-hero-grid">
        <article class="demo-hero-card demo-hero-card--main">
            <div class="demo-hero-card__copy">
                <span class="demo-kicker">{{ ui_text('home_demo_kicker') }}</span>
                <h1>{{ ui_text('home_demo_title') }}</h1>
                <p>{{ ui_text('home_demo_text') }}</p>
                <div class="demo-hero-card__actions">
                    <a class="button button--primary" href="/catalog">{{ ui_text('go_catalog') }}</a>
                    <a class="button button--light" href="/about-us">{{ ui_text('about_platform') }}</a>
                </div>
                <div class="demo-hero-card__facts"><span>{{ ui_text('demo_products_10') }}</span><span>{{ ui_text('demo_categories_8') }}</span><span>{{ ui_text('coupon') }} {{ demo_showcase.coupon.code }}</span></div>
            </div>
            <div class="demo-hero-card__media"><img src="/media/demo/laptop-pro-14.webp" alt="{{ ui_text('demo_laptop_alt') }}" width="1100" height="720" fetchpriority="high" decoding="async"></div>
        </article>
        <div class="demo-hero-stack">
            <a class="demo-mini-banner demo-mini-banner--home" href="/home-appliances"><img src="/media/demo/hero-coffee-reference.webp" alt="{{ ui_text('home_appliances') }}" width="780" height="420"><span><small>{{ ui_text('for_home') }}</small><strong>{{ ui_text('coffee_comfort') }}</strong><b>{{ ui_text('view_arrow') }}</b></span></a>
            <a class="demo-mini-banner demo-mini-banner--beauty" href="/beauty-health"><img src="/media/demo/promo-beauty-reference.webp" alt="{{ ui_text('beauty_health') }}" width="780" height="420"><span><small>{{ ui_text('up_to_15_off') }}</small><strong>{{ ui_text('beauty_care') }}</strong><b>{{ ui_text('to_collection_arrow') }}</b></span></a>
        </div>
    </div>
</section>
{% elseif presentation.hero.title or presentation.hero.image %}
<section class="reference-hero-wrap">
    <div class="shell reference-hero">
        <div class="reference-hero__copy">
            {% if presentation.hero.eyebrow %}<p class="eyebrow">{{ presentation.hero.eyebrow }}</p>{% endif %}
            <h1>{{ presentation.hero.title ?: store_name }}</h1>
            {% if presentation.hero.subtitle %}<h2>{{ presentation.hero.subtitle }}</h2>{% endif %}
            {% if presentation.hero.text %}<p>{{ presentation.hero.text }}</p>{% endif %}
            {% if presentation.hero.button_label and presentation.hero.button_url %}<a class="reference-hero__button" href="{{ presentation.hero.button_url }}">{{ presentation.hero.button_label }} <span aria-hidden="true">→</span></a>{% endif %}
        </div>
        {% if presentation.hero.image %}<div class="reference-hero__visual"><img src="{{ presentation.hero.image }}" alt="" width="1200" height="452" fetchpriority="high" decoding="async"></div>{% endif %}
    </div>
</section>
{% else %}
<section class="home-hero shell"><div><p class="eyebrow">{{ site_mode == 'landing' ? ui_text('presentation') : ui_text('site') }}</p><h1>{{ store_name }}</h1>{% if site_features.catalog|default(false) %}<a class="button" href="/catalog">{{ ui_text('go_catalog') }}</a>{% endif %}</div></section>
{% endif %}

{% if presentation.home.show_categories and categories %}
<section class="shell demo-category-section" aria-label="{{ ui_text('product_categories') }}">
    <div class="reference-section-title reference-section-title--spaced"><div><small class="section-kicker">{{ ui_text('quick_choice') }}</small><h2>{{ ui_text('popular_categories') }}</h2></div><a href="/catalog">{{ ui_text('all_catalog_arrow') }}</a></div>
    <div class="reference-categories">
    {% for category in categories %}
    <a class="reference-category" href="{{ category.url }}">
        <span class="reference-category__image"><img src="{{ category.image|default('/assets/product-placeholder.svg') }}" alt="" width="480" height="360" loading="lazy" decoding="async"></span>
        <span class="reference-category__copy"><strong>{{ category.name }}</strong>{% if category.subtitle is defined %}<small>{{ category.subtitle }}</small>{% endif %}</span>
        <span class="reference-category__arrow" aria-hidden="true">→</span>
    </a>
    {% endfor %}
    </div>
</section>
{% endif %}

{% if presentation.home.show_benefits and benefits %}
<section class="shell reference-benefits" aria-label="{{ ui_text('benefits') }}">
{% for benefit in benefits %}<article><span class="reference-benefits__icon" data-icon="{{ benefit.icon }}" aria-hidden="true"></span><div><strong>{{ benefit.title }}</strong><small>{{ benefit.text }}</small></div></article>{% endfor %}
</section>
{% endif %}

{% if demo_showcase %}
<section class="shell demo-coupon-strip" aria-label="{{ ui_text('demo_promotion') }}"><div><span class="demo-coupon-strip__icon">%</span><div><small>{{ ui_text('check_promotions_engine') }}</small><strong>{{ ui_text('coupon') }} {{ demo_showcase.coupon.code }} — {{ demo_showcase.coupon.text }}</strong></div></div><a href="/catalog">{{ ui_text('choose_product_arrow') }}</a></section>
{% endif %}

{% if products and presentation.home.show_products %}
<section class="shell reference-products-section">
    <div class="reference-section-title reference-section-title--spaced"><div><small class="section-kicker">{{ ui_text('store_selection') }}</small><h2>{{ ui_text('popular_products') }}</h2></div><a href="/catalog">{{ ui_text('all_products_arrow') }}</a></div>
    <div class="product-grid demo-product-grid">{% for product in products %}{% include '@storefront/components/product_card.html.twig' with {product:product} only %}{% endfor %}</div>
</section>
{% endif %}

{% if demo_showcase and demo_showcase.promos %}
<section class="shell demo-promo-grid" aria-label="{{ ui_text('collections') }}">
{% for promo in demo_showcase.promos %}<a class="demo-promo-card demo-promo-card--{{ promo.tone }}" href="{{ promo.url }}"><img src="{{ promo.image }}" alt="" width="900" height="520" loading="lazy" decoding="async"><div><small>{{ promo.eyebrow }}</small><h2>{{ promo.title }}</h2><p>{{ promo.text }}</p><span>{{ ui_text('view_arrow') }}</span></div></a>{% endfor %}
</section>
{% elseif products and presentation.home.show_promos %}
<section class="shell reference-products-section"><div class="reference-products-layout">
{% if presentation.promo_left.image %}<a class="reference-side-promo reference-side-promo--left" href="{{ presentation.promo_left.url }}" style="--promo-image:url('{{ presentation.promo_left.image }}')"><div><h2>{{ presentation.promo_left.title }}</h2><p>{{ presentation.promo_left.text }}</p><span>{{ ui_text('view_arrow') }}</span></div></a>{% endif %}
{% if presentation.promo_right.image %}<a class="reference-side-promo reference-side-promo--right" href="{{ presentation.promo_right.url }}" style="--promo-image:url('{{ presentation.promo_right.image }}')"><div><h2>{{ presentation.promo_right.title }}</h2><p>{{ presentation.promo_right.text }}</p><span>{{ ui_text('to_catalog_arrow') }}</span></div></a>{% endif %}
</div></section>
{% endif %}

{% if demo_showcase and demo_showcase.brands %}
<section class="shell demo-brands"><div class="reference-section-title"><div><small class="section-kicker">{{ ui_text('brand_showcase') }}</small><h2>{{ ui_text('trusted_brands') }}</h2></div></div><div class="demo-brand-list">{% for brand in demo_showcase.brands %}<span>{{ brand }}</span>{% endfor %}</div></section>
{% endif %}

{% if articles and presentation.home.show_articles %}
<section class="home-section shell"><div class="section-heading"><div><p class="eyebrow">{{ ui_text('useful') }}</p><h2>{{ ui_text('blog_news') }}</h2></div><a href="/blog">{{ ui_text('all_articles_arrow') }}</a></div><div class="article-grid article-grid--media">{% for article in articles %}<article class="article-card article-card--media"><a class="article-card__image" href="{{ article.url }}"><img src="{{ article.image }}" alt="" width="960" height="540" loading="lazy" decoding="async"></a><div><time>{{ article.date }}</time><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p>{{ article.excerpt }}</p><a class="article-card__more" href="{{ article.url }}">{{ ui_text('read_arrow') }}</a></div></article>{% endfor %}</div></section>
{% endif %}

{% if demo_showcase %}
<section class="shell demo-contact-cta"><div><small>{{ ui_text('form_showcase') }}</small><h2>{{ ui_text('questions_about_product_store') }}</h2><p>{{ ui_text('contact_form_demo_text') }}</p></div><a class="button button--primary" href="/contact">{{ ui_text('contact_us') }}</a></section>
{% endif %}

{% if not categories and not products and not articles and site_mode in ['content','landing','forum'] %}
<section class="home-section shell"><div class="admin-safety-note"><strong>{{ store_name }}</strong><span>{{ ui_text('empty_home_admin_note') }}</span></div></section>
{% endif %}
{% endblock %}
