<section class="shell recent-viewed" data-recent-list hidden aria-label="{{ ui_text('recently_viewed')|e('html_attr') }}">
    <div class="recent-viewed__head">
        <h2 class="recent-viewed__title">{{ ui_icon('eye', 20) }}<span>{{ ui_text('recently_viewed') }}</span></h2>
        <div class="recent-viewed__controls" role="group" aria-label="{{ ui_text('recently_viewed') }}">
            <button type="button" data-recent-prev title="{{ ui_text('previous_products') }}" aria-label="{{ ui_text('previous_products') }}">{{ ui_icon('chevron-left', 18) }}</button>
            <button type="button" data-recent-next title="{{ ui_text('next_products') }}" aria-label="{{ ui_text('next_products') }}">{{ ui_icon('chevron-right', 18) }}</button>
        </div>
    </div>
    <ul class="recent-viewed__grid" data-recent-items tabindex="0"></ul>
</section>
