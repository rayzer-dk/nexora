{# Compact share control: one icon button opening a small menu of coloured network icons and a copy-link button. Expects share_url and share_title. #}
<details class="share-pop" data-share-pop data-share-links>
    <summary class="button button--secondary button--icon" title="{{ ui_text('blog_share')|e('html_attr') }}" aria-label="{{ ui_text('blog_share')|e('html_attr') }}">{{ ui_icon('share-2', 18) }}</summary>
    <div class="share-pop__menu" role="menu">
      <div class="share-pop__nets">
        <a class="share-pop__net share-pop__net--facebook" role="menuitem" rel="noopener noreferrer" target="_blank" title="Facebook" aria-label="Facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url|url_encode }}"><span class="share-pop__glyph" aria-hidden="true"></span></a>
        <a class="share-pop__net share-pop__net--telegram" role="menuitem" rel="noopener noreferrer" target="_blank" title="Telegram" aria-label="Telegram" href="https://t.me/share/url?url={{ share_url|url_encode }}&amp;text={{ share_title|url_encode }}"><span class="share-pop__glyph" aria-hidden="true"></span></a>
        <a class="share-pop__net share-pop__net--whatsapp" role="menuitem" rel="noopener noreferrer" target="_blank" title="WhatsApp" aria-label="WhatsApp" href="https://wa.me/?text={{ (share_title ~ ' ' ~ share_url)|url_encode }}"><span class="share-pop__glyph" aria-hidden="true"></span></a>
        <a class="share-pop__net share-pop__net--x" role="menuitem" rel="noopener noreferrer" target="_blank" title="X" aria-label="X" href="https://twitter.com/intent/tweet?url={{ share_url|url_encode }}&amp;text={{ share_title|url_encode }}"><span class="share-pop__glyph" aria-hidden="true"></span></a>
        <a class="share-pop__net share-pop__net--linkedin" role="menuitem" rel="noopener noreferrer" target="_blank" title="LinkedIn" aria-label="LinkedIn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url|url_encode }}"><span class="share-pop__glyph" aria-hidden="true"></span></a>
      </div>
      <button class="button button--secondary share-pop__copy" role="menuitem" type="button" data-copy-link="{{ share_url|e('html_attr') }}">{{ ui_icon('copy', 16) }}<span>{{ ui_text('share_copy_link') }}</span></button>
    </div>
</details>
