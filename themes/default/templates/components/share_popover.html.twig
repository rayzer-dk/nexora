{# Compact share control: one icon button opening a small menu of coloured network icons and a copy-link button. Expects share_url and share_title. #}
<details class="share-pop" data-share-pop data-share-links>
    <summary class="button button--secondary button--icon" title="{{ ui_text('blog_share')|e('html_attr') }}" aria-label="{{ ui_text('blog_share')|e('html_attr') }}">{{ ui_icon('share-2', 18) }}</summary>
    <div class="share-pop__menu" role="menu">
      <div class="share-pop__nets">
        <a class="share-pop__net share-pop__net--facebook" role="menuitem" rel="noopener noreferrer" target="_blank" title="Facebook" aria-label="Facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url|url_encode }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14 8.5V7c0-.7.2-1 1.1-1h1.4V3.2C16.2 3.1 15.4 3 14.500 3 12.300 3 10.800 4.300 10.800 6.800V8.500H8.500v3h2.300V21h3.200v-9.500h2.400l.4-3z"/></svg></a>
        <a class="share-pop__net share-pop__net--telegram" role="menuitem" rel="noopener noreferrer" target="_blank" title="Telegram" aria-label="Telegram" href="https://t.me/share/url?url={{ share_url|url_encode }}&amp;text={{ share_title|url_encode }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21.800 3.300 2.900 10.600c-1 .4-1 1 .1 1.300l4.800 1.500 1.900 5.900c.2.600.5.700 1 .4l2.700-2.200 4.900 3.600c.9.500 1.500.2 1.700-.8l3-14.300c.3-1.200-.4-1.700-1.200-1.400z"/></svg></a>
        <a class="share-pop__net share-pop__net--whatsapp" role="menuitem" rel="noopener noreferrer" target="_blank" title="WhatsApp" aria-label="WhatsApp" href="https://wa.me/?text={{ (share_title ~ ' ' ~ share_url)|url_encode }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 3a9 9 0 0 0-7.700 13.600L3 21l4.500-1.200A9 9 0 1 0 12 3zm4.600 12.300c-.2.600-1.200 1.100-1.700 1.200-.4.100-1 .1-1.600-.1-1.500-.5-3-1.500-4.200-3.200-.6-.8-1.100-1.700-1.100-2.600 0-.8.400-1.200.6-1.400.2-.2.400-.2.600-.2h.4c.1 0 .3 0 .4.300l.7 1.600c.1.200 0 .3 0 .4l-.4.500c-.1.100-.2.300-.1.500.4.700 1.200 1.600 2.100 2 .2.100.4.100.5-.1l.6-.7c.1-.2.300-.2.500-.1l1.600.8c.2.100.3.200.3.300 0 .2 0 .6-.2 1z"/></svg></a>
        <a class="share-pop__net share-pop__net--x" role="menuitem" rel="noopener noreferrer" target="_blank" title="X" aria-label="X" href="https://twitter.com/intent/tweet?url={{ share_url|url_encode }}&amp;text={{ share_title|url_encode }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.800 3h3l-6.600 7.500L22 21h-6.100l-4.800-6.300L5.600 21h-3l7-8L2 3h6.300l4.300 5.700zm-1.100 16.200h1.700L7.400 4.700H5.600z"/></svg></a>
        <a class="share-pop__net share-pop__net--linkedin" role="menuitem" rel="noopener noreferrer" target="_blank" title="LinkedIn" aria-label="LinkedIn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url|url_encode }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M5 8.500a1.900 1.900 0 1 0 0-3.800 1.900 1.900 0 0 0 0 3.800zM3.400 10h3.200v10.500H3.400zM9 10h3v1.400c.5-.9 1.600-1.700 3.200-1.700 3.300 0 3.800 2.100 3.800 4.800v6H16v-5.300c0-1.300 0-2.900-1.800-2.900s-2 1.400-2 2.800v5.400H9z"/></svg></a>
      </div>
      <button class="button button--secondary share-pop__copy" role="menuitem" type="button" data-copy-link="{{ share_url|e('html_attr') }}">{{ ui_icon('copy', 16) }}<span>{{ ui_text('share_copy_link') }}</span></button>
    </div>
</details>
