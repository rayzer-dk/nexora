<commerce-slider class="slider-shell">
    <div class="slider-shell__heading">
        {% if title %}<h2>{{ title }}</h2>{% endif %}
        <div class="slider-shell__actions">
            <button class="button button--secondary button--icon" type="button" data-slider-prev aria-label="{{ ui_text('previous') }}">{{ ui_icon('chevron-left', 20) }}</button>
            <button class="button button--secondary button--icon" type="button" data-slider-next aria-label="{{ ui_text('next') }}">{{ ui_icon('chevron-right', 20) }}</button>
        </div>
    </div>
    <div class="commerce-carousel" data-slider-track>
        {% block slides %}{% endblock %}
    </div>
</commerce-slider>
