{% set c = captcha_widget(form) %}
{% if c %}
<div class="captcha" data-captcha="{{ c.provider }}" data-captcha-form="{{ c.form }}"{% if c.site_key %} data-sitekey="{{ c.site_key }}"{% endif %}>
{% if c.provider == 'builtin' %}
    <input type="hidden" name="mc_captcha_token" value="{{ c.token }}" data-captcha-token>
    <div class="captcha__challenge" data-captcha-box>{% include '@storefront/components/captcha_challenge.html.twig' with {c: c} only %}<button class="captcha__refresh" type="button" data-captcha-refresh aria-label="{{ ui_text('captcha_refresh') }}" title="{{ ui_text('captcha_refresh') }}">{{ ui_icon('refresh-cw', 16) }}</button></div>
{% elseif c.provider == 'recaptcha_v3' %}
    <input type="hidden" name="g-recaptcha-response" value="" data-captcha-v3>
    <small class="captcha__note">{{ ui_text('captcha_protected_by_recaptcha') }}</small>
{% else %}
    <div class="captcha__widget" data-captcha-widget></div>
{% endif %}
</div>
{% endif %}
