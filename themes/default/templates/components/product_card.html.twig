{% set capabilities = site_capabilities() %}
<article class="catalog-card" data-product-card data-track-id="{{ product.sku|default('')|e('html_attr') }}" data-track-name="{{ product.name|e('html_attr') }}" data-track-price="{{ product.price_minor|default(0) }}" data-track-currency="{{ product.currency|default('')|e('html_attr') }}">
    <a class="catalog-card__media" href="{{ product.url }}" aria-label="{{ product.name }}">
        {% if product.badges|default([]) %}<span class="catalog-card__badges">{% for badge in product.badges %}<span class="product-badge product-badge--{{ badge.tone }}"{% if badge.color|default('') %} style="background:{{ badge.color }};color:{{ badge.fg }}"{% endif %} data-badge="{{ badge.code }}">{{ badge.label }}</span>{% endfor %}</span>{% endif %}
        <img src="{{ product.image }}" alt="{{ product.name }}" width="640" height="640" loading="lazy" decoding="async">
        {% if product.discount_percent|default(0) > 0 %}<span class="catalog-card__discount">-{{ product.discount_percent }}%</span>{% endif %}
    </a>
    <div class="catalog-card__tools">
        {% if capabilities.features.customer_accounts|default(false) %}
            {% if app.user %}<form method="post" action="{{ path('customer_wishlist_add',{product:product.id}) }}" class="catalog-card__wishlist"><input type="hidden" name="_token" value="{{ csrf_token('wishlist_add_' ~ product.id) }}"><button type="submit" class="catalog-card__tool" title="{{ ui_text('add_wishlist') }}" aria-label="{{ ui_text('add_wishlist') }}: {{ product.name }}">{{ ui_icon('heart', 16) }}</button></form>{% else %}<a class="catalog-card__tool" href="{{ path('customer_login') }}" title="{{ ui_text('login_to_save') }}" aria-label="{{ ui_text('login_to_save') }}">{{ ui_icon('heart', 16) }}</a>{% endif %}
        {% endif %}
        <form method="post" action="{{ path('product_compare_add',{product:product.id}) }}" class="catalog-card__compare"><input type="hidden" name="_token" value="{{ csrf_token('compare_' ~ product.id) }}"><button type="submit" class="catalog-card__tool" title="{{ ui_text('add_compare') }}" aria-label="{{ ui_text('add_compare') }}: {{ product.name }}">{{ ui_icon('arrow-left-right', 16) }}</button></form>
    </div>
    <div class="catalog-card__body">
        {% if product.brand %}<div class="catalog-card__brand">{{ product.brand }}</div>{% endif %}
        <h2><a href="{{ product.url }}">{{ product.name }}</a></h2>
        {% if capabilities.features.reviews|default(false) and product.rating is defined and product.rating.count > 0 %}<div class="catalog-card__rating"><span class="rating-stars" aria-hidden="true">{% for i in 1..5 %}{{ ui_icon(i <= product.rating.value|round ? 'star-filled' : 'star-empty', 14) }}{% endfor %}</span><small>{{ product.rating.value }} ({{ product.rating.count }})</small></div>{% endif %}
        <div class="catalog-card__meta"><span>SKU {{ product.sku }}</span><span class="{{ product.availability == 'https://schema.org/InStock' ? 'is-stock' : 'is-out' }}">{{ product.availability_label }}</span></div>
        <div class="catalog-card__price"><strong>{{ product.price }}</strong>{% if product.compare_at_price %}<del>{{ product.compare_at_price }}</del>{% endif %}</div>{% set vat_mode = product.tax.display_mode|default('price_only') %}{% if vat_mode != 'price_only' and product.tax.rate_label|default('0%') != '0%' %}<small class="catalog-card__vat">{% if vat_mode == 'net' %}{{ ui_text('price_without_vat') }}{% elseif vat_mode == 'net_with_gross' %}{{ ui_text('price_without_vat') }} · {{ product.tax.gross_price }}{% else %}{{ ui_text('including_vat') }} {{ product.tax.tax_amount }}{% endif %}</small>{% endif %}{% if product.sale_ends_at %}<div class="sale-timer" data-sale-timer="{{ product.sale_ends_at }}"><span class="sale-timer__label">{{ ui_icon('timer', 14) }} {{ ui_text('sale_ends_in') }}</span><span class="sale-timer__value" data-sale-timer-value></span></div>{% endif %}
        <div class="catalog-card__actions">
            {% if capabilities.features.cart|default(false) and product.purchase_allowed|default(false) and product.variant_id is defined and product.variant_id %}
            <form class="catalog-card__cart-form" action="/cart/add" method="post" data-card-add-to-cart>
                <input type="hidden" name="_token" value="{{ csrf_token('cart_mutation') }}">
                <input type="hidden" name="variant_id" value="{{ product.variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <button class="button button--primary catalog-card__buy" type="submit">{{ ui_icon('shopping-cart', 16) }}<span>{{ product.purchase_button_label|default(ui_text('add_cart')) }}</span></button>
            </form>
            {% else %}
            <a class="button button--secondary catalog-card__buy" href="{{ product.url }}"><span>{{ ui_text('details') }}</span>{{ ui_icon('arrow-right', 16) }}</a>
            {% endif %}
        </div>
    </div>
</article>
