<!doctype html><html lang="{{ locale|default('uk-UA') }}"><head><meta charset="utf-8"><title>{{ document.document_number }}</title><style>
@page{margin:18mm}body{font-family:"DejaVu Sans",Arial,sans-serif;color:#182230;font-size:12px;margin:0;background:#fff}.doc{max-width:900px;margin:0 auto}.toolbar{display:flex;gap:10px;justify-content:flex-end;margin:0 0 18px}.toolbar a,.toolbar button{padding:9px 12px;border:1px solid #ccd4df;border-radius:8px;background:#fff;color:#123;text-decoration:none}.head{display:flex;justify-content:space-between;border-bottom:3px solid #0057d9;padding-bottom:16px;margin-bottom:18px}.head h1{font-size:24px;margin:0 0 5px}.muted{color:#667085}.cols{display:table;width:100%;margin:18px 0}.col{display:table-cell;width:50%;vertical-align:top;padding-right:24px}.col h2{font-size:13px;margin:0 0 8px;text-transform:uppercase;color:#475467}.line{margin:3px 0}table{width:100%;border-collapse:collapse;margin-top:18px}th,td{border-bottom:1px solid #dfe5ec;padding:8px 6px;text-align:left;vertical-align:top}th{background:#f6f8fb;font-size:11px}.num{text-align:right;white-space:nowrap}.totals{width:45%;margin-left:auto;margin-top:18px}.totals div{display:flex;justify-content:space-between;padding:5px 0}.totals .grand{border-top:2px solid #182230;font-size:15px;font-weight:700;margin-top:4px;padding-top:9px}.footer{border-top:1px solid #dfe5ec;margin-top:30px;padding-top:12px;color:#667085;font-size:10px}@media print{.toolbar{display:none}.doc{max-width:none}}
</style></head><body><main class="doc">
{% if not pdf_mode %}<div class="toolbar"><button type="button" data-print>{{ ui_text('print') }}</button>{% if app.request.attributes.get('_route') starts with 'admin_' %}<a href="{{ path('admin_order_document_pdf',{document:document.public_id}) }}">PDF</a>{% else %}<a href="{{ path('customer_order_document_pdf',{document:document.public_id}) }}">PDF</a>{% endif %}</div>{% endif %}
{% set assets=document_assets(document) %}{% set s=document.snapshot %}{% set o=s.order %}{% set seller=s.seller %}{% set buyer=s.buyer %}{% set cur=o.currency %}
<header class="head"><div>{% if assets.logo %}<img src="{{ assets.logo }}" alt="" style="max-height:48px;max-width:220px;margin-bottom:10px;display:block">{% endif %}<h1>{% if document.document_type=='invoice' %}{{ ui_text('document_invoice') }}{% elseif document.document_type=='packing_slip' %}{{ ui_text('document_packing_slip') }}{% else %}{{ ui_text('document_credit_note') }}{% endif %}</h1><div class="muted">№ {{ document.document_number }}</div></div><div><strong>{{ ui_text('order_number')|replace({'%number%': o.number}) }}</strong><div class="muted">{{ ui_text('issued_at') }}: {{ document.issued_at|date('d.m.Y H:i') }}</div></div></header>
<section class="cols"><div class="col"><h2>{{ ui_text('seller') }}</h2><div class="line"><strong>{{ seller.legal_name|default(seller.name|default('')) }}</strong></div>{% if seller.registration_number %}<div class="line">{{ ui_text('registration_number') }}: {{ seller.registration_number }}</div>{% endif %}{% if seller.tax_number %}<div class="line">{{ ui_text('tax_number') }}: {{ seller.tax_number }}</div>{% endif %}{% if seller.vat_number %}<div class="line">{{ ui_text('document_vat') }} {{ seller.vat_number }}</div>{% endif %}{% if seller.registration_address %}<div class="line">{{ seller.registration_address }}</div>{% endif %}{% if seller.iban %}<div class="line">IBAN: {{ seller.iban }}</div>{% endif %}{% if seller.bank_name %}<div class="line">{{ ui_text('bank') }}: {{ seller.bank_name }}</div>{% endif %}{% if seller.email %}<div class="line">{{ seller.email }}</div>{% endif %}{% if seller.phone %}<div class="line">{{ seller.phone }}</div>{% endif %}</div>
<div class="col"><h2>{{ ui_text('buyer') }}</h2><div class="line"><strong>{{ buyer.name ?: ui_text('buyer') }}</strong></div>{% if buyer.email %}<div class="line">{{ buyer.email }}</div>{% endif %}{% if buyer.phone %}<div class="line">{{ buyer.phone }}</div>{% endif %}{% if s.fulfillment.destination is defined and s.fulfillment.destination %}{% set dest_parts = [] %}{% for key, value in s.fulfillment.destination %}{% if value is not iterable and value is not same as(null) and value != '' and not (key ends with '_id') and not (key ends with '_ref') and not (key ends with 'Ref') and key not in ['id','ref','code','provider','service','carrier'] %}{% set dest_parts = dest_parts|merge([value]) %}{% endif %}{% endfor %}{% if s.fulfillment.provider_code|default('') %}<div class="line"><strong>{{ s.fulfillment.provider_code|status_label('carrier') }}</strong></div>{% endif %}{% if dest_parts %}<div class="line">{{ dest_parts|join(', ') }}</div>{% endif %}{% endif %}</div></section>
{% if document.document_type == 'credit_note' %}<table><thead><tr><th>{{ ui_text('adjustment_description') }}</th><th class="num">{{ ui_text('amount') }}</th></tr></thead><tbody><tr><td>{{ ui_text('refund_for_order')|replace({'%number%': o.number}) }}</td><td class="num">-{{ (s.refund.amount_minor/100)|number_format(2,',',' ') }} {{ cur }}</td></tr></tbody></table>{% else %}<table><thead><tr><th>#</th><th></th><th>SKU</th><th>{{ ui_text('item_name') }}</th><th class="num">{{ ui_text('quantity_short') }}</th>{% if document.document_type!='packing_slip' %}<th class="num">{{ ui_text('price') }}</th><th class="num">{{ ui_text('amount') }}</th>{% endif %}</tr></thead><tbody>{% for item in s.items %}<tr><td>{{ loop.index }}</td><td style="width:40px">{% if assets.images[item.sku] is defined %}<img src="{{ assets.images[item.sku] }}" alt="" width="36" height="36" style="border-radius:4px">{% endif %}</td><td>{{ item.sku }}</td><td>{{ item.name }}</td><td class="num">{{ item.quantity|qty }}</td>{% if document.document_type!='packing_slip' %}<td class="num">{{ (item.unit_price_minor/100)|number_format(2,',',' ') }} {{ cur }}</td><td class="num">{{ (item.line_total_minor/100)|number_format(2,',',' ') }} {{ cur }}</td>{% endif %}</tr>{% endfor %}</tbody></table>{% endif %}
{% if document.document_type!='packing_slip' %}<section class="totals">{% if document.document_type=='credit_note' and s.refund %}<div class="grand"><span>{{ ui_text('adjustment_amount') }}</span><span>-{{ (s.refund.amount_minor/100)|number_format(2,',',' ') }} {{ cur }}</span></div>{% else %}<div><span>{{ ui_text('products_sum') }}</span><span>{{ (o.subtotal_minor/100)|number_format(2,',',' ') }} {{ cur }}</span></div>{% if o.discount_minor %}<div><span>{{ ui_text('discount') }}</span><span>-{{ (o.discount_minor/100)|number_format(2,',',' ') }} {{ cur }}</span></div>{% endif %}{% if o.shipping_minor %}<div><span>{{ ui_text('delivery') }}</span><span>{{ (o.shipping_minor/100)|number_format(2,',',' ') }} {{ cur }}</span></div>{% endif %}<div class="grand"><span>{{ ui_text('total') }}</span><span>{{ (o.total_minor/100)|number_format(2,',',' ') }} {{ cur }}</span></div>{% if o.tax_minor %}<div><span>{{ ui_text('including_vat') }}</span><span>{{ (o.tax_minor/100)|number_format(2,',',' ') }} {{ cur }}</span></div>{% endif %}{% endif %}</section>{% endif %}
<footer class="footer">{{ ui_text('document_snapshot_notice') }}</footer>
</main>{% if not pdf_mode %}<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">document.querySelector('[data-print]')?.addEventListener('click',()=>window.print());</script>{% endif %}</body></html>
