{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell compare-page">
    <div class="section-heading"><div><span>{{ ui_text('catalog_title') }}</span><h1>{{ ui_text('compare_products') }}</h1></div><div><span>{{ products|length }} / 4</span>{% if products %}<form method="post" action="{{ path('product_compare_clear') }}"><input type="hidden" name="_token" value="{{ csrf_token('compare_clear') }}"><button class="link-button" type="submit">{{ ui_text('clear') }}</button></form>{% endif %}</div></div>
    {% if products is empty %}
        <div class="detail-card"><p>{{ ui_text('compare_empty_text') }}</p><a class="button" href="{{ path('storefront_catalog') }}">{{ ui_text('go_catalog') }}</a></div>
    {% else %}
        <div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>{{ ui_text('attribute') }}</th>{% for product in products %}<th><a href="{{ product.url }}"><img src="{{ product.image }}" alt="{{ product.name }}" width="180" height="180"><span>{{ product.name }}</span></a><strong>{{ product.price }}</strong><form method="post" action="{{ path('product_compare_remove',{product:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('compare_remove_' ~ product.id) }}"><button type="submit" class="link-button">{{ ui_text('remove') }}</button></form></th>{% endfor %}</tr></thead><tbody><tr><th>SKU</th>{% for product in products %}<td>{{ product.sku }}</td>{% endfor %}</tr><tr><th>{{ ui_text('availability') }}</th>{% for product in products %}<td>{{ product.availability_label }}</td>{% endfor %}</tr>{% for name in attribute_names %}<tr><th>{{ name }}</th>{% for product in products %}<td>{% set shown=false %}{% for a in product.attributes %}{% if a.name == name %}{{ a.value }}{% set shown=true %}{% endif %}{% endfor %}{% if not shown %}—{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endblock %}
