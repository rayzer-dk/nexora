{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell compare-page">
    <div class="section-heading"><div><span class="eyebrow">{{ ui_text('catalog_title') }}</span><h1>{{ ui_text('compare_products') }}</h1></div><div><span>{{ products|length }} / 4</span>{% if products %}<form method="post" action="{{ path('product_compare_clear') }}"><input type="hidden" name="_token" value="{{ csrf_token('compare_clear') }}"><button class="button button--secondary button--sm" type="submit">{{ ui_icon('trash-2', 16) }}{{ ui_text('clear') }}</button></form>{% endif %}</div></div>
    {% if products is empty %}
        <div class="empty-state"><p>{{ ui_text('compare_empty_text') }}</p><a class="button button--primary" href="{{ path('storefront_catalog') }}">{{ ui_text('go_catalog') }}{{ ui_icon('arrow-right', 16) }}</a></div>
    {% else %}
        <div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>{{ ui_text('attribute') }}</th>{% for product in products %}<th><a href="{{ product.url }}">{{ media_picture(product.image, 'card', ['thumb', 'card'], '180px', {alt: (product.name), width: '180', height: '180'}) }}<span>{{ product.name }}</span></a><strong>{{ product.price }}</strong><form method="post" action="{{ path('product_compare_remove',{product:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('compare_remove_' ~ product.id) }}"><button type="submit" class="button button--link button--danger button--sm">{{ ui_icon('x', 16) }}{{ ui_text('remove') }}</button></form></th>{% endfor %}</tr></thead><tbody><tr><th>SKU</th>{% for product in products %}<td>{{ product.sku }}</td>{% endfor %}</tr><tr><th>{{ ui_text('availability') }}</th>{% for product in products %}<td>{{ product.availability_label }}</td>{% endfor %}</tr>{% for name in attribute_names %}<tr><th>{{ name }}</th>{% for product in products %}<td>{% set shown=false %}{% for a in product.attributes %}{% if a.name == name %}{{ a.value }}{% set shown=true %}{% endif %}{% endfor %}{% if not shown %}—{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endblock %}
