{% set presentation = storefront_presentation() %}
{% set primary_navigation = storefront_navigation() %}
{% set capabilities = site_capabilities() %}
{% set active_theme_css = active_theme_stylesheet() %}
{% set store_identity = storefront_identity() %}
{% set store_locales = storefront_locales() %}
{% set store_currencies = storefront_currencies() %}
{% set storefront_brand_name = presentation.brand.title ?: store_identity.name ?: store_name|default(ui_text('store')) %}
<!doctype html>
<html lang="{{ app.request.locale|default('uk-UA') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <title>{% block title %}{{ seo_head.title|default('') ?: page_title|default(store_name|default(ui_text('store'))) }}{% endblock %}</title>
    {% if seo_head is defined and seo_head.description|default('') %}<meta name="description" content="{{ seo_head.description }}">{% endif %}
    {% if seo_head is defined and seo_head.title|default('') %}<meta property="og:title" content="{{ seo_head.title }}">{% endif %}
    {% if seo_head is defined and seo_head.description|default('') %}<meta property="og:description" content="{{ seo_head.description }}">{% endif %}
    {% if seo_head is defined and seo_head.type|default('') %}<meta property="og:type" content="{{ seo_head.type }}">{% endif %}
    {% if seo_head is defined and seo_head.image|default('') %}<meta property="og:image" content="{{ seo_head.image }}">{% endif %}
    {% if presentation.brand.favicon %}<link rel="icon" href="{{ presentation.brand.favicon }}"><link rel="shortcut icon" href="{{ presentation.brand.favicon }}">{% endif %}
    {% if seo_head is defined and seo_head.canonical is defined %}<link rel="canonical" href="{{ seo_head.canonical }}">{% endif %}
    {% if seo_head is defined and seo_head.robots is defined %}<meta name="robots" content="{{ seo_head.robots }}">{% endif %}
    {% if seo_head is defined and seo_head.hreflang is defined %}{% for language, url in seo_head.hreflang %}<link rel="alternate" hreflang="{{ language }}" href="{{ url }}">{% endfor %}{% endif %}
    {% if seo_head is defined and seo_head.json_ld|default(null) %}<script type="application/ld+json">{{ seo_head.json_ld|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>{% endif %}
    {% if presentation.theme.font == 'inter' or presentation.theme.font == 'manrope' %}<link rel="stylesheet" href="/assets/fonts/fonts.css">{% endif %}
    <link rel="stylesheet" href="{{ vite_asset('assets/storefront/storefront.css', '/assets/storefront.css') }}">
    <style nonce="{{ app.request.attributes.get('_csp_nonce') }}">
      :root{
        --mc-color-primary:{{ presentation.theme.primary }};
        --mc-color-primary-hover:color-mix(in srgb, {{ presentation.theme.primary }} 82%, #000);
        --mc-color-accent:{{ presentation.theme.accent }};
        --mc-color-success:{{ presentation.theme.success }};
        --mc-color-surface:{{ presentation.theme.surface }};
        --mc-content-max:{{ presentation.theme.container }}px;
        --mc-radius-sm:{{ (presentation.theme.radius * 0.45)|round }}px;
        --mc-radius-md:{{ (presentation.theme.radius * 0.67)|round }}px;
        --mc-radius-lg:{{ presentation.theme.radius }}px;
        --mc-radius-xl:{{ (presentation.theme.radius * 1.33)|round }}px;
        {% if presentation.theme.font == 'inter' %}--mc-font-body:"Inter",ui-sans-serif,system-ui,sans-serif;{% elseif presentation.theme.font == 'manrope' %}--mc-font-body:"Manrope",ui-sans-serif,system-ui,sans-serif;{% endif %}
        {% if presentation.theme.shadow == 'none' %}--mc-shadow-sm:none;--mc-shadow-md:none;--mc-shadow-lg:none;--mc-shadow-card:none;{% elseif presentation.theme.shadow == 'soft' %}--mc-shadow-sm:0 3px 10px rgb(15 23 42 / .04);--mc-shadow-md:0 7px 20px rgb(15 23 42 / .06);--mc-shadow-lg:0 14px 36px rgb(15 23 42 / .09);--mc-shadow-card:0 7px 20px rgb(15 23 42 / .05);{% elseif presentation.theme.shadow == 'strong' %}--mc-shadow-sm:0 6px 18px rgb(15 23 42 / .10);--mc-shadow-md:0 14px 38px rgb(15 23 42 / .15);--mc-shadow-lg:0 28px 68px rgb(15 23 42 / .20);--mc-shadow-card:0 16px 42px rgb(15 23 42 / .14);{% endif %}
      }
      body[data-theme-density="compact"]{--mc-control-height-sm:28px;--mc-control-height-md:36px;--mc-control-height-lg:44px;--mc-space-4:12px;--mc-space-6:20px}
      body[data-theme-density="spacious"]{--mc-control-height-sm:36px;--mc-control-height-md:44px;--mc-control-height-lg:52px;--mc-space-4:20px;--mc-space-6:28px}
    </style>
    {% if active_theme_css %}<link rel="stylesheet" href="{{ active_theme_css }}">{% endif %}
    <link rel="stylesheet" href="{{ vite_asset('assets/storefront/consent.css', '/assets/consent.css') }}">
    <script nonce="{{ app.request.attributes.get('_csp_nonce') }}">window.dataLayer=window.dataLayer||[];window.gtag=window.gtag||function(){window.dataLayer.push(arguments);};window.gtag('consent','default',{security_storage:'granted',functionality_storage:'denied',personalization_storage:'denied',analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});</script>
    <script type="module" src="{{ vite_asset('assets/storefront/consent.js', '/assets/consent.js') }}"></script>
    {% block head %}{% endblock %}
{% for ext_asset in extension_assets() %}
  {% if ext_asset.type == 'css' %}<link rel="stylesheet" href="{{ ext_asset.url }}">{% endif %}
{% endfor %}
</head>
<body data-storefront-runtime data-theme-preset="{{ presentation.theme.preset }}" data-theme-density="{{ presentation.theme.density }}" data-theme-shadow="{{ presentation.theme.shadow }}" data-theme-font="{{ presentation.theme.font }}">
{% for message in app.flashes('error') %}<div class="global-notice store-notice is-error" data-store-toast-source>{{ message }}</div>{% endfor %}
{% for message in app.flashes('success') %}<div class="global-notice store-notice is-success" data-store-toast-source>{{ message }}</div>{% endfor %}
<a class="skip-link" href="#main">{{ ui_text('skip') }}</a>
{% if demo_showcase is defined and demo_showcase and (capabilities.features.catalog or not (demo_showcase.announcement.action_url|default('') starts with '/catalog')) %}<div class="demo-announcement"><div class="shell demo-announcement__inner"><div><strong>{{ demo_showcase.announcement.title }}</strong><span>{{ demo_showcase.announcement.text }}</span></div><a href="{{ demo_showcase.announcement.action_url }}">{{ demo_showcase.announcement.action_label }}{{ ui_icon('arrow-right', 16) }}</a></div></div>{% endif %}
<div class="reference-topbar"><div class="shell reference-topbar__inner"><div class="reference-topbar__service"><span>{{ presentation.utility.location }}</span><span>{{ presentation.utility.delivery }}</span><span>{{ presentation.utility.support }}</span></div><nav aria-label="{{ ui_text('service_nav') }}">{% if capabilities.features.content %}<a href="/about-us">{{ ui_text('about') }}</a><a href="/shipping">{{ ui_text('shipping_payment') }}</a><a href="/returns">{{ ui_text('returns') }}</a>{% endif %}{% if capabilities.features.blog %}<a href="/blog">{{ ui_text('blog') }}</a>{% endif %}{% if capabilities.features.forum|default(false) %}<a href="/forum">{{ ui_text('forum') }}</a>{% endif %}{% if capabilities.features.content %}<a href="/contact">{{ ui_text('contacts') }}</a>{% endif %}</nav></div></div>
<header class="reference-header">
    <div class="shell reference-header__main">
        <a class="reference-brand" href="/" aria-label="{{ ui_text('home') }}">{% if presentation.brand.logo %}<img class="reference-brand__logo" src="{{ presentation.brand.logo }}" alt="{{ storefront_brand_name }}">{% elseif presentation.brand.icon %}<img class="reference-brand__icon" src="{{ presentation.brand.icon }}" alt="">{% else %}<span class="reference-brand__bag" aria-hidden="true">{{ ui_icon('shopping-bag', 20) }}</span>{% endif %}<span><strong>{{ storefront_brand_name }}</strong><small>{{ presentation.brand.subtitle }}</small></span></a>
        {% if capabilities.features.search %}<form class="reference-search" action="/catalog" method="get" role="search" data-live-search><label class="sr-only" for="header-q">{{ ui_text('search') }}</label><input id="header-q" name="q" value="{{ app.request.query.get('q')|default('') }}" placeholder="{{ presentation.header.search_placeholder }}" autocomplete="off"><button type="submit" aria-label="{{ ui_text('find') }}" title="{{ ui_text('find') }}">{{ ui_icon('search', 20) }}</button><div class="live-search" data-live-search-results hidden></div></form>{% endif %}
        <div class="reference-header__actions">
            {% if store_locales|length > 1 %}<form class="reference-context-switch" method="get" action="{{ app.request.pathInfo }}"><label><span class="sr-only">{{ ui_text('language') }}</span><select name="lang" aria-label="{{ ui_text('language') }}">{% for option in store_locales %}<option value="{{ option.code }}" {{ option.code == store_identity.locale ? 'selected' : '' }}>{{ option.name }}</option>{% endfor %}</select></label><button class="button button--secondary button--sm" type="submit">{{ ui_text('apply') }}</button></form>{% endif %}
            {% if store_currencies|length > 1 %}<form class="reference-context-switch" method="get" action="{{ app.request.pathInfo }}"><label><span class="sr-only">{{ ui_text('currency') }}</span><select name="currency" aria-label="{{ ui_text('currency') }}">{% for option in store_currencies %}<option value="{{ option.code }}" {{ option.code == store_identity.currency ? 'selected' : '' }}>{{ option.code }}</option>{% endfor %}</select></label><button class="button button--secondary button--sm" type="submit">{{ ui_text('apply') }}</button></form>{% endif %}
            {% if capabilities.features.customer_accounts %}<a href="{{ app.user ? path('customer_account') : path('customer_login') }}" title="{{ ui_text('account') }}" class="reference-account-link"><span class="reference-account-icon" aria-hidden="true">{{ ui_icon('circle-user-round', 22) }}</span><small>{{ app.user ? ui_text('account') : ui_text('login') }}</small></a>{% endif %}
            {% if capabilities.features.cart %}<a href="/cart" title="{{ ui_text('cart') }}" class="reference-cart-link"><span class="reference-cart-icon" aria-hidden="true">{{ ui_icon('shopping-cart', 23) }}</span><span class="reference-cart-count" data-cart-count hidden>0</span><small>{{ ui_text('cart') }}</small></a>{% endif %}
        </div>
    </div>
    <div class="shell reference-header__nav-row">{% if capabilities.features.catalog %}<a class="reference-catalog-toggle" href="/catalog">{{ ui_icon('grid-2x2', 18) }} {{ ui_text('catalog') }}</a>{% endif %}{% if capabilities.features.catalog and presentation.header.show_category_nav and primary_navigation %}<nav class="reference-category-nav" aria-label="{{ ui_text('categories') }}">{% for item in primary_navigation %}<span class="reference-nav-item"><a href="{{ item.url }}"{% if item.open_new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.name }}{% if item.badge|default(null) %}<small>{{ item.badge }}</small>{% endif %}</a>{% if item.children|default([]) %}<span class="reference-nav-submenu">{% for child in item.children %}<a href="{{ child.url }}"{% if child.open_new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ child.name }}{% if child.badge|default(null) %}<small>{{ child.badge }}</small>{% endif %}</a>{% endfor %}</span>{% endif %}</span>{% endfor %}<a class="reference-category-nav__sale" href="/catalog">{{ ui_icon('badge-percent', 16) }}{{ ui_text('sale') }}</a></nav>{% endif %}</div>
</header>
<main id="main">{% block body %}{% endblock %}</main>
<div class="mc-consent" data-commerce-consent hidden role="dialog" aria-modal="false" aria-labelledby="mc-consent-title">
    <div class="mc-consent__copy"><h2 class="mc-consent__title" id="mc-consent-title">{{ ui_text('privacy_cookies') }}</h2><p class="mc-consent__text">{{ ui_text('consent_text') }}</p></div>
    <details class="mc-consent__details"><summary>{{ ui_text('consent_customize') }}{{ ui_icon('chevron-down', 16) }}</summary><div class="mc-consent__choices"><label class="mc-consent__choice"><input type="checkbox" checked disabled aria-label="{{ ui_text('essential') }}"> <span><strong>{{ ui_text('essential') }}</strong><small>{{ ui_text('essential_desc') }}</small></span></label><label class="mc-consent__choice"><input type="checkbox" name="consent_preferences" aria-label="{{ ui_text('preferences') }}"> <span><strong>{{ ui_text('preferences') }}</strong><small>{{ ui_text('preferences_desc') }}</small></span></label><label class="mc-consent__choice"><input type="checkbox" name="consent_analytics" aria-label="{{ ui_text('analytics') }}"> <span><strong>{{ ui_text('analytics') }}</strong><small>{{ ui_text('analytics_desc') }}</small></span></label><label class="mc-consent__choice"><input type="checkbox" name="consent_marketing" aria-label="{{ ui_text('marketing') }}"> <span><strong>{{ ui_text('marketing') }}</strong><small>{{ ui_text('marketing_desc') }}</small></span></label></div></details>
    <div class="mc-consent__actions"><button class="button button--secondary" type="button" data-consent-reject-optional>{{ ui_text('reject_optional') }}</button><button class="button button--secondary" type="button" data-consent-accept-all>{{ ui_text('accept_all') }}</button><button class="button button--secondary" type="button" data-consent-save>{{ ui_text('save_choice') }}</button></div>
</div>
<section class="newsletter-signup"><div class="shell newsletter-signup__inner"><div class="newsletter-signup__copy"><small>{{ ui_text('news_offers') }}</small><h2>{{ ui_text('newsletter_title') }}</h2><p>{{ ui_text('newsletter_text') }}</p></div><form class="newsletter-signup__form" method="post" action="{{ path('storefront_newsletter_subscribe') }}"><input type="hidden" name="_token" value="{{ csrf_token('newsletter_subscribe') }}"><label class="sr-only" for="newsletter-email">{{ ui_text('email') }}</label><input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com"><button class="button button--primary button--lg" type="submit">{{ ui_text('subscribe') }}</button></form></div></section><footer class="site-footer"><div class="shell site-footer__brand"><div class="site-footer__brand-copy"><div class="brand brand--footer">{% if presentation.brand.logo %}<img class="brand__logo" src="{{ presentation.brand.logo }}" alt="{{ storefront_brand_name }}">{% elseif presentation.brand.icon %}<img class="brand__icon" src="{{ presentation.brand.icon }}" alt="">{% else %}<span class="reference-brand__bag" aria-hidden="true">{{ ui_icon('shopping-bag', 20) }}</span>{% endif %}<span><strong>{{ storefront_brand_name }}</strong><small>{{ presentation.brand.subtitle ?: ui_text('modern_ecommerce') }}</small></span></div><p>{{ ui_text('platform_tagline') }}</p></div><div class="site-footer__grid"><section><h2>{{ ui_text('company') }}</h2>{% if capabilities.features.content %}<a href="/about-us">{{ ui_text('about') }}</a><a href="/contact">{{ ui_text('contacts') }}</a>{% endif %}{% if capabilities.features.blog %}<a href="/blog">{{ ui_text('blog') }}</a>{% endif %}{% if capabilities.features.forum|default(false) %}<a href="/forum">{{ ui_text('forum') }}</a>{% endif %}</section>{% if capabilities.features.content %}<section><h2>{{ ui_text('buyers') }}</h2><a href="/shipping">{{ ui_text('shipping') }}</a><a href="/payment">{{ ui_text('payment') }}</a><a href="/returns">{{ ui_text('returns_exchange') }}</a><a href="/warranty">{{ ui_text('warranty') }}</a><a href="/faq">{{ ui_text('faq') }}</a></section>{% endif %}<section><h2>{{ ui_text('legal') }}</h2>{% if capabilities.features.content %}<a href="/privacy-policy">{{ ui_text('privacy_policy') }}</a><a href="/cookie-policy">{{ ui_text('cookie_policy') }}</a><a href="/terms-and-conditions">{{ ui_text('terms') }}</a>{% endif %}<button class="footer-link-button" type="button" data-consent-open>{{ ui_text('cookie_settings') }}</button></section></div></div><div class="shell site-footer__bottom"><span>© {{ 'now'|date('Y') }} {{ storefront_brand_name }}</span><span>{{ store_identity.locale }} · {{ store_identity.currency }}</span></div></footer>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">window.MC_I18N={{ ui_catalog_json(['js_']) }};</script>
<script type="module" src="{{ vite_asset('assets/storefront/storefront-runtime.js', '/assets/storefront-runtime.js') }}"></script>
{% for ext_asset in extension_assets() %}
  {% if ext_asset.type == 'js' %}<script type="module" src="{{ ext_asset.url }}"{% if ext_asset.defer|default(true) %} defer{% endif %}></script>{% endif %}
{% endfor %}
</body>
</html>