{% set presentation = storefront_presentation() %}
{% set primary_navigation = storefront_navigation() %}
{% set capabilities = site_capabilities() %}
{% set active_theme_css = active_theme_stylesheet() %}
{% set store_identity = storefront_identity() %}
{% set storefront_brand_name = presentation.brand.title ?: store_identity.name ?: store_name|default(ui_text('store')) %}
<!doctype html>
<html lang="{{ app.request.locale|default('uk-UA') }}" data-color-scheme="{{ presentation.theme.color_scheme|default('light') }}" data-pwa="{{ presentation.brand.pwa|default('1') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="{{ presentation.theme.color_scheme|default('light') == 'light' ? 'light' : (presentation.theme.color_scheme == 'dark' ? 'dark' : 'light dark') }}">
    <title>{% block title %}{{ seo_head.title|default('') ?: page_title|default(store_name|default(ui_text('store'))) }}{% endblock %}</title>
    {% if seo_head is defined and seo_head.description|default('') %}<meta name="description" content="{{ seo_head.description }}">{% endif %}
    {% if seo_head is defined and seo_head.title|default('') %}<meta property="og:title" content="{{ seo_head.title }}">{% endif %}
    {% if seo_head is defined and seo_head.description|default('') %}<meta property="og:description" content="{{ seo_head.description }}">{% endif %}
    {% if seo_head is defined and seo_head.type|default('') %}<meta property="og:type" content="{{ seo_head.type }}">{% endif %}
    {% if seo_head is defined and seo_head.image|default('') %}<meta property="og:image" content="{{ seo_head.image }}">{% endif %}
    {% if seo_head is defined and seo_head.canonical|default('') %}<meta property="og:url" content="{{ seo_head.canonical }}">{% endif %}
    {% if seo_head is defined and (seo_head.title|default('') or seo_head.description|default('')) %}<meta property="og:site_name" content="{{ storefront_brand_name }}"><meta name="twitter:card" content="{{ seo_head.image|default('') ? 'summary_large_image' : 'summary' }}">{% endif %}
    {% if presentation.brand.pwa|default('1') == '1' %}<link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="{{ presentation.theme.primary }}">{% endif %}
    {% if presentation.brand.favicon %}<link rel="icon" href="{{ presentation.brand.favicon }}"><link rel="shortcut icon" href="{{ presentation.brand.favicon }}">{% else %}<link rel="icon" type="image/svg+xml" href="/assets/branding/nexora-mark.svg"><link rel="icon" type="image/png" sizes="32x32" href="/assets/branding/favicon-32.png"><link rel="apple-touch-icon" href="/assets/branding/favicon-180.png">{% endif %}
    {% if seo_head is defined and seo_head.canonical is defined %}<link rel="canonical" href="{{ seo_head.canonical }}">{% endif %}
    {% if seo_head is defined and seo_head.robots is defined %}<meta name="robots" content="{{ seo_head.robots }}">{% endif %}
    {% if seo_head is defined and seo_head.hreflang is defined %}{% for language, url in seo_head.hreflang %}<link rel="alternate" hreflang="{{ language }}" href="{{ url }}">{% endfor %}{% endif %}
    {% if seo_head is defined and seo_head.json_ld|default(null) %}<script type="application/ld+json">{{ seo_head.json_ld|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>{% endif %}
    {% if presentation.theme.font == 'inter' or presentation.theme.font == 'manrope' %}<link rel="stylesheet" href="/assets/fonts/fonts.css">{% endif %}
    {% if presentation.theme.toggle|default('1') == '1' %}<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">try{var t=localStorage.getItem('mc_theme');if(t==='light'||t==='dark'){document.documentElement.dataset.theme=t;}}catch(e){}</script>{% endif %}
    <link rel="stylesheet" href="{{ vite_asset('assets/storefront/storefront.css', '/assets/storefront.css') }}">
    <style nonce="{{ app.request.attributes.get('_csp_nonce') }}">
      :root{
        --mc-color-primary-base:{{ presentation.theme.primary }};
        --mc-color-accent-base:{{ presentation.theme.accent }};
        --mc-color-primary-contrast:{{ contrast_color(presentation.theme.primary) }};
        --mc-color-accent-contrast:{{ contrast_color(presentation.theme.accent) }};
        --mc-color-success:{{ presentation.theme.success }};
        --mc-color-surface:{{ presentation.theme.surface }};
        --mc-content-max:{{ presentation.theme.container }}px;
        --mc-radius-sm:{{ (presentation.theme.radius * 0.45)|round }}px;
        --mc-radius-md:{{ (presentation.theme.radius * 0.67)|round }}px;
        --mc-radius-lg:{{ presentation.theme.radius }}px;
        --mc-radius-xl:{{ (presentation.theme.radius * 1.33)|round }}px;
        {% if presentation.theme.font == 'inter' %}--mc-font-body:"Inter",ui-sans-serif,system-ui,sans-serif;{% elseif presentation.theme.font == 'manrope' %}--mc-font-body:"Manrope",ui-sans-serif,system-ui,sans-serif;{% endif %}
        {% if presentation.theme.shadow == 'none' %}--mc-shadow-sm:none;--mc-shadow-md:none;--mc-shadow-lg:none;--mc-shadow-card:none;{% elseif presentation.theme.shadow == 'soft' %}--mc-shadow-sm:0 3px 10px rgb(15 23 42 / .04);--mc-shadow-md:0 7px 20px rgb(15 23 42 / .06);--mc-shadow-lg:0 14px 36px rgb(15 23 42 / .09);--mc-shadow-card:0 7px 20px rgb(15 23 42 / .05);{% elseif presentation.theme.shadow == 'strong' %}--mc-shadow-sm:0 6px 18px rgb(15 23 42 / .10);--mc-shadow-md:0 14px 38px rgb(15 23 42 / .15);--mc-shadow-lg:0 28px 68px rgb(15 23 42 / .20);--mc-shadow-card:0 16px 42px rgb(15 23 42 / .14);{% endif %}
      }
      body[data-theme-density="compact"]{--mc-control-height-sm:28px;--mc-control-height-md:36px;--mc-control-height-lg:44px;--mc-space-4:12px;--mc-space-6:20px}
      body[data-theme-density="spacious"]{--mc-control-height-sm:36px;--mc-control-height-md:44px;--mc-control-height-lg:52px;--mc-space-4:20px;--mc-space-6:28px}
    </style>
    {% if active_theme_css %}<link rel="stylesheet" href="{{ active_theme_css }}">{% endif %}
    <link rel="stylesheet" href="{{ vite_asset('assets/storefront/consent.css', '/assets/consent.css') }}">
    <script nonce="{{ app.request.attributes.get('_csp_nonce') }}">window.dataLayer=window.dataLayer||[];window.gtag=window.gtag||function(){window.dataLayer.push(arguments);};window.gtag('consent','default',{security_storage:'granted',functionality_storage:'denied',personalization_storage:'denied',analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});</script>
    <script type="module" src="{{ vite_asset('assets/storefront/consent.js', '/assets/consent.js') }}"></script>
    {% set trk = tracking_tags() %}{% if trk %}
    {% if trk.ga4 %}<script type="text/plain" data-consent-category="analytics" async src="https://www.googletagmanager.com/gtag/js?id={{ trk.ga4 }}"></script><script type="text/plain" data-consent-category="analytics" nonce="{{ app.request.attributes.get('_csp_nonce') }}">window.gtag('js',new Date());window.gtag('config','{{ trk.ga4 }}');</script>{% endif %}
    {% if trk.gtm %}<script type="text/plain" data-consent-category="analytics" nonce="{{ app.request.attributes.get('_csp_nonce') }}">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ trk.gtm }}');</script>{% endif %}
    {% if trk.pixel %}<script type="text/plain" data-consent-category="marketing" nonce="{{ app.request.attributes.get('_csp_nonce') }}">!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','{{ trk.pixel }}');fbq('track','PageView');</script>{% endif %}
    {% endif %}
    {% block head %}{% endblock %}
{% for ext_asset in extension_assets() %}
  {% if ext_asset.type == 'css' %}<link rel="stylesheet" href="{{ ext_asset.url }}">{% endif %}
{% endfor %}
</head>
<body data-storefront-runtime data-theme-preset="{{ presentation.theme.preset }}" data-theme-density="{{ presentation.theme.density }}" data-theme-shadow="{{ presentation.theme.shadow }}" data-theme-font="{{ presentation.theme.font }}" data-card-style="{{ presentation.display.card_style }}" data-card-columns="{{ presentation.display.card_columns }}" data-card-ratio="{{ presentation.display.card_ratio }}" data-card-actions="{{ presentation.display.card_actions }}" data-category-style="{{ presentation.display.category_style }}" data-product-layout="{{ presentation.display.product_layout }}"{% if presentation.display.sticky_header %} data-sticky-header{% endif %}{% if presentation.display.sale_timer %} data-sale-timer{% endif %}>
{% for message in app.flashes('error') %}<div class="global-notice store-notice is-error" data-store-toast-source>{{ message }}</div>{% endfor %}
{% for message in app.flashes('success') %}<div class="global-notice store-notice is-success" data-store-toast-source>{{ message }}</div>{% endfor %}
<a class="skip-link" href="#main">{{ ui_text('skip') }}</a>
{% if demo_showcase is defined and demo_showcase and (capabilities.features.catalog or not (demo_showcase.announcement.action_url|default('') starts with '/catalog')) %}<div class="demo-announcement"><div class="shell demo-announcement__inner"><div><strong>{{ demo_showcase.announcement.title }}</strong><span>{{ demo_showcase.announcement.text }}</span></div><a href="{{ demo_showcase.announcement.action_url }}">{{ demo_showcase.announcement.action_label }}{{ ui_icon('arrow-right', 16) }}</a></div></div>{% endif %}
<div class="reference-topbar"><div class="shell reference-topbar__inner"><div class="reference-topbar__service"><span>{{ presentation.utility.location }}</span><span>{{ presentation.utility.delivery }}</span><span>{{ presentation.utility.support }}</span></div><nav aria-label="{{ ui_text('service_nav') }}">{% set utility_menu = storefront_menu('utility') %}{% if utility_menu %}{% for item in utility_menu %}<a href="{{ item.url }}"{% if item.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.name }}</a>{% endfor %}{% else %}{% if capabilities.features.content %}<a href="/about-us">{{ ui_text('about') }}</a><a href="/shipping">{{ ui_text('shipping_payment') }}</a><a href="/returns">{{ ui_text('returns') }}</a>{% endif %}{% if capabilities.features.blog %}<a href="/blog">{{ ui_text('blog') }}</a>{% endif %}{% if capabilities.features.forum|default(false) %}<a href="/forum">{{ ui_text('forum') }}</a>{% endif %}{% if capabilities.features.content %}<a href="/contact">{{ ui_text('contacts') }}</a>{% endif %}{% endif %}</nav>{% include '@storefront/components/header_switchers.html.twig' %}</div></div>
<header class="reference-header">
    <div class="shell reference-header__main">
        <a class="reference-brand" href="/" aria-label="{{ ui_text('home') }}">{% if presentation.brand.logo %}<img class="reference-brand__logo" src="{{ presentation.brand.logo }}" alt="{{ storefront_brand_name }}">{% elseif presentation.brand.icon %}<img class="reference-brand__icon" src="{{ presentation.brand.icon }}" alt="">{% else %}<span class="reference-brand__bag" aria-hidden="true">{{ ui_icon('shopping-bag', 20) }}</span>{% endif %}<span><strong>{{ storefront_brand_name }}</strong><small>{{ presentation.brand.subtitle }}</small></span></a>
        {% if capabilities.features.search %}<form class="reference-search" action="/catalog" method="get" role="search" data-live-search><label class="sr-only" for="header-q">{{ ui_text('search') }}</label><input id="header-q" name="q" value="{{ app.request.query.get('q')|default('') }}" placeholder="{{ presentation.header.search_placeholder }}" autocomplete="off"><button type="submit" aria-label="{{ ui_text('find') }}" title="{{ ui_text('find') }}">{{ ui_icon('search', 20) }}</button><div class="live-search" data-live-search-results hidden></div></form>{% endif %}
        <div class="reference-header__actions">
            {% if presentation.theme.toggle|default('1') == '1' %}<button class="reference-theme-toggle" type="button" data-theme-toggle aria-label="{{ ui_text('theme_toggle') }}" title="{{ ui_text('theme_toggle') }}"><span class="reference-theme-toggle__moon" aria-hidden="true">{{ ui_icon('moon', 20) }}</span><span class="reference-theme-toggle__sun" aria-hidden="true">{{ ui_icon('sun', 20) }}</span></button>{% endif %}
            {% if capabilities.features.customer_accounts %}<a href="{{ app.user ? path('customer_account') : path('customer_login') }}" title="{{ ui_text('account') }}" class="reference-account-link"><span class="reference-account-icon" aria-hidden="true">{{ ui_icon('circle-user-round', 22) }}</span><small>{{ app.user ? ui_text('account') : ui_text('login') }}</small></a>{% endif %}
            {% if capabilities.features.cart %}<a href="/cart" title="{{ ui_text('cart') }}" class="reference-cart-link" data-cart-open aria-haspopup="dialog"><span class="reference-cart-icon" aria-hidden="true">{{ ui_icon('shopping-cart', 23) }}</span><span class="reference-cart-count" data-cart-count{% if cart_count() < 1 %} hidden{% endif %}>{{ cart_count() }}</span><small>{{ ui_text('cart') }}</small></a>{% endif %}
        </div>
    </div>
    <div class="shell reference-header__nav-row">{% if capabilities.features.catalog %}{% include '@storefront/components/mega_menu.html.twig' %}{% endif %}{% if capabilities.features.catalog and presentation.header.show_category_nav and primary_navigation %}<nav class="reference-category-nav" aria-label="{{ ui_text('categories') }}">{% for item in primary_navigation %}<span class="reference-nav-item"><a href="{{ item.url }}"{% if item.open_new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.name }}{% if item.badge|default(null) %}<small>{{ item.badge }}</small>{% endif %}</a>{% if item.children|default([]) %}<span class="reference-nav-submenu">{% for child in item.children %}<a href="{{ child.url }}"{% if child.open_new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ child.name }}{% if child.badge|default(null) %}<small>{{ child.badge }}</small>{% endif %}</a>{% endfor %}</span>{% endif %}</span>{% endfor %}<a class="reference-category-nav__sale" href="/catalog">{{ ui_icon('badge-percent', 16) }}{{ ui_text('sale') }}</a></nav>{% endif %}</div>
</header>
<main id="main">{% block body %}{% endblock %}</main>
{% include '@storefront/components/cookie_banner.html.twig' %}
{% include '@storefront/components/site_footer.html.twig' %}
{% include '@storefront/components/contact_widget.html.twig' %}
{% if presentation.display.back_to_top %}<button class="back-to-top" type="button" data-back-to-top hidden aria-label="{{ ui_text('back_to_top') }}" title="{{ ui_text('back_to_top') }}">{{ ui_icon('arrow-up', 20) }}</button>{% endif %}
<button class="consent-fab" type="button" data-consent-open data-consent-fab hidden aria-label="{{ ui_text('cookie_settings') }}" title="{{ ui_text('cookie_settings') }}">{{ ui_icon('cookie', 20) }}</button>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">window.MC_I18N={{ ui_catalog_json(['js_']) }};</script>
<script type="module" src="{{ vite_asset('assets/storefront/storefront-runtime.js', '/assets/storefront-runtime.js') }}"></script>
{% for ext_asset in extension_assets() %}
  {% if ext_asset.type == 'js' %}<script type="module" src="{{ ext_asset.url }}"{% if ext_asset.defer|default(true) %} defer{% endif %}></script>{% endif %}
{% endfor %}
</body>
</html>