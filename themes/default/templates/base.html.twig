{% set presentation = storefront_presentation() %}
{% set primary_navigation = storefront_navigation() %}
{% set capabilities = site_capabilities() %}
{% set active_theme_css = active_theme_stylesheet() %}
{% set store_identity = storefront_identity() %}
{% set store_locales = storefront_locales() %}
{% set store_currencies = storefront_currencies() %}
<!doctype html>
<html lang="{{ app.request.locale|default('uk-UA') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <title>{% block title %}{{ page_title|default(store_name|default(ui_text('store'))) }}{% endblock %}</title>
    {% if presentation.brand.favicon %}<link rel="icon" href="{{ presentation.brand.favicon }}"><link rel="shortcut icon" href="{{ presentation.brand.favicon }}">{% else %}<link rel="icon" type="image/svg+xml" href="/assets/branding/nexora-mark.svg"><link rel="shortcut icon" href="/assets/branding/nexora-mark.svg">{% endif %}
    {% if seo_head is defined and seo_head.canonical is defined %}<link rel="canonical" href="{{ seo_head.canonical }}">{% endif %}
    {% if seo_head is defined and seo_head.robots is defined %}<meta name="robots" content="{{ seo_head.robots }}">{% endif %}
    {% if seo_head is defined and seo_head.hreflang is defined %}{% for language, url in seo_head.hreflang %}<link rel="alternate" hreflang="{{ language }}" href="{{ url }}">{% endfor %}{% endif %}
    {% if presentation.theme.font == 'inter' %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">{% elseif presentation.theme.font == 'manrope' %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">{% endif %}
    <link rel="stylesheet" href="{{ vite_asset('assets/storefront/storefront.css', '/assets/storefront.css') }}">
    {% if active_theme_css %}<link rel="stylesheet" href="{{ active_theme_css }}">{% endif %}
    <link rel="stylesheet" href="{{ vite_asset('assets/storefront/consent.css', '/assets/consent.css') }}">
    <script nonce="{{ app.request.attributes.get('_csp_nonce') }}">window.dataLayer=window.dataLayer||[];window.gtag=window.gtag||function(){window.dataLayer.push(arguments);};window.gtag('consent','default',{security_storage:'granted',functionality_storage:'denied',personalization_storage:'denied',analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});</script>
    <script type="module" src="{{ vite_asset('assets/storefront/consent.js', '/assets/consent.js') }}"></script>
    {% block head %}{% endblock %}
{% for ext_asset in extension_assets() %}
  {% if ext_asset.type == 'css' %}<link rel="stylesheet" href="{{ ext_asset.url }}">{% endif %}
{% endfor %}
</head>
<body data-storefront-runtime data-theme-preset="{{ presentation.theme.preset }}" data-theme-density="{{ presentation.theme.density }}" data-theme-shadow="{{ presentation.theme.shadow }}" data-theme-font="{{ presentation.theme.font }}">
{% for message in app.flashes('error') %}<div class="global-notice is-error">{{ message }}</div>{% endfor %}
{% for message in app.flashes('success') %}<div class="global-notice is-success">{{ message }}</div>{% endfor %}
<a class="skip-link" href="#main">{{ ui_text('skip') }}</a>
{% if demo_showcase is defined and demo_showcase %}<div class="demo-announcement"><div class="shell demo-announcement__inner"><div><strong>{{ demo_showcase.announcement.title }}</strong><span>{{ demo_showcase.announcement.text }}</span></div><a href="{{ demo_showcase.announcement.action_url }}">{{ demo_showcase.announcement.action_label }} {{ ui_icon('arrow-right', 16) }}</a></div></div>{% endif %}
<div class="reference-topbar"><div class="shell reference-topbar__inner"><div class="reference-topbar__service"><span>{{ presentation.utility.location }}</span><span>{{ presentation.utility.delivery }}</span><span>{{ presentation.utility.support }}</span></div><nav aria-label="{{ ui_text('service_nav') }}"><a href="/about-us">{{ ui_text('about') }}</a><a href="/shipping">{{ ui_text('shipping_payment') }}</a><a href="/returns">{{ ui_text('returns') }}</a>{% if capabilities.features.blog %}<a href="/blog">{{ ui_text('blog') }}</a>{% endif %}{% if capabilities.features.forum|default(false) %}<a href="/forum">{{ ui_text('forum') }}</a>{% endif %}<a href="/contact">{{ ui_text('contacts') }}</a></nav></div></div>
<header class="reference-header">
    <div class="shell reference-header__main">
        <a class="reference-brand" href="/" aria-label="{{ ui_text('home') }}">{% if presentation.brand.logo %}<img class="reference-brand__logo" src="{{ presentation.brand.logo }}" alt="{{ presentation.brand.title ?: store_name|default('Nexora Commerce') }}">{% elseif presentation.brand.icon %}<img class="reference-brand__icon" src="{{ presentation.brand.icon }}" alt="">{% else %}<span class="reference-brand__bag" aria-hidden="true"></span>{% endif %}<span><strong>{{ presentation.brand.title ?: store_name|default('Nexora Commerce') }}</strong><small>{{ presentation.brand.subtitle }}</small></span></a>
        {% if capabilities.features.search %}<form class="reference-search" action="/catalog" method="get" role="search" data-live-search><label class="sr-only" for="header-q">{{ ui_text('search') }}</label><input id="header-q" name="q" value="{{ app.request.query.get('q')|default('') }}" placeholder="{{ presentation.header.search_placeholder }}" autocomplete="off"><button type="submit" aria-label="{{ ui_text('find') }}" title="{{ ui_text('find') }}">{{ ui_icon('search', 20) }}</button><div class="live-search" data-live-search-results hidden></div></form>{% endif %}
        <div class="reference-header__actions">
            {% if store_locales|length > 1 %}<form class="reference-context-switch" method="get" action="{{ app.request.pathInfo }}"><label><span class="sr-only">{{ ui_text('language') }}</span><select name="lang" aria-label="{{ ui_text('language') }}">{% for option in store_locales %}<option value="{{ option.code }}" {{ option.code == store_identity.locale ? 'selected' : '' }}>{{ option.name }}</option>{% endfor %}</select></label><button type="submit">OK</button></form>{% endif %}
            {% if store_currencies|length > 1 %}<form class="reference-context-switch" method="get" action="{{ app.request.pathInfo }}"><label><span class="sr-only">{{ ui_text('currency') }}</span><select name="currency" aria-label="{{ ui_text('currency') }}">{% for option in store_currencies %}<option value="{{ option.code }}" {{ option.code == store_identity.currency ? 'selected' : '' }}>{{ option.code }}</option>{% endfor %}</select></label><button type="submit">OK</button></form>{% endif %}
            {% if capabilities.features.customer_accounts %}<a href="{{ app.user ? path('customer_account') : path('customer_login') }}" title="{{ ui_text('account') }}" class="reference-account-link"><span class="reference-account-icon" aria-hidden="true">{{ ui_icon('circle-user-round', 22) }}</span><small>{{ app.user ? ui_text('account') : ui_text('login') }}</small></a>{% endif %}
            {% if capabilities.features.cart %}<a href="/cart" title="{{ ui_text('cart') }}" class="reference-cart-link"><span class="reference-cart-icon" aria-hidden="true">{{ ui_icon('shopping-cart', 23) }}</span><span class="reference-cart-count" data-cart-count hidden>0</span><small>{{ ui_text('cart') }}</small></a>{% endif %}
        </div>
    </div>
    <div class="shell reference-header__nav-row">{% if capabilities.features.catalog %}<a class="reference-catalog-toggle" href="/catalog">{{ ui_icon('grid-2x2', 18) }} {{ ui_text('catalog') }}</a>{% endif %}{% if capabilities.features.catalog and presentation.header.show_category_nav and primary_navigation %}<nav class="reference-category-nav" aria-label="{{ ui_text('categories') }}">{% for item in primary_navigation %}<span class="reference-nav-item"><a href="{{ item.url }}"{% if item.open_new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.name }}{% if item.badge|default(null) %}<small>{{ item.badge }}</small>{% endif %}</a>{% if item.children|default([]) %}<span class="reference-nav-submenu">{% for child in item.children %}<a href="{{ child.url }}"{% if child.open_new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ child.name }}{% if child.badge|default(null) %}<small>{{ child.badge }}</small>{% endif %}</a>{% endfor %}</span>{% endif %}</span>{% endfor %}<a class="reference-category-nav__sale" href="/catalog">% {{ ui_text('sale') }}</a></nav>{% endif %}</div>
</header>
<main id="main">{% block body %}{% endblock %}</main>
<div class="mc-consent" data-commerce-consent hidden role="dialog" aria-modal="false" aria-labelledby="mc-consent-title"><h2 class="mc-consent__title" id="mc-consent-title">{{ ui_text('privacy_cookies') }}</h2><p class="mc-consent__text">{{ ui_text('consent_text') }}</p><div class="mc-consent__choices"><label class="mc-consent__choice"><input type="checkbox" checked disabled aria-label="{{ ui_text('essential') }}"> <span><strong>{{ ui_text('essential') }}</strong><br>{{ ui_text('essential_desc') }}</span></label><label class="mc-consent__choice"><input type="checkbox" name="consent_preferences" aria-label="{{ ui_text('preferences') }}"> <span><strong>{{ ui_text('preferences') }}</strong><br>{{ ui_text('preferences_desc') }}</span></label><label class="mc-consent__choice"><input type="checkbox" name="consent_analytics" aria-label="{{ ui_text('analytics') }}"> <span><strong>{{ ui_text('analytics') }}</strong><br>{{ ui_text('analytics_desc') }}</span></label><label class="mc-consent__choice"><input type="checkbox" name="consent_marketing" aria-label="{{ ui_text('marketing') }}"> <span><strong>{{ ui_text('marketing') }}</strong><br>{{ ui_text('marketing_desc') }}</span></label></div><div class="mc-consent__actions"><button type="button" data-consent-reject-optional>{{ ui_text('reject_optional') }}</button><button type="button" data-consent-accept-all>{{ ui_text('accept_all') }}</button><button type="button" data-consent-save>{{ ui_text('save_choice') }}</button></div></div>
<section class="newsletter-signup"><div class="shell newsletter-signup__inner"><div class="newsletter-signup__copy"><small>{{ ui_text('news_offers') }}</small><h2>{{ ui_text('newsletter_title') }}</h2><p>{{ ui_text('newsletter_text') }}</p></div><form method="post" action="{{ path('storefront_newsletter_subscribe') }}"><input type="hidden" name="_token" value="{{ csrf_token('newsletter_subscribe') }}"><label class="sr-only" for="newsletter-email">Email</label><input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com"><button type="submit">{{ ui_text('subscribe') }}</button></form></div></section><footer class="site-footer"><div class="shell site-footer__brand"><div class="site-footer__brand-copy"><div class="brand brand--footer">{% if presentation.brand.logo %}<img class="brand__logo" src="{{ presentation.brand.logo }}" alt="{{ presentation.brand.title ?: store_name|default('Nexora Commerce') }}">{% elseif presentation.brand.icon %}<img class="brand__icon" src="{{ presentation.brand.icon }}" alt="">{% else %}<span class="reference-brand__bag" aria-hidden="true"></span>{% endif %}<span><strong>{{ presentation.brand.title ?: store_name|default('Nexora Commerce') }}</strong><small>{{ presentation.brand.subtitle ?: ui_text('modern_ecommerce') }}</small></span></div><p>{{ ui_text('platform_tagline') }}</p></div><div class="site-footer__grid"><section><h2>{{ ui_text('company') }}</h2><a href="/about-us">{{ ui_text('about') }}</a><a href="/contact">{{ ui_text('contacts') }}</a>{% if capabilities.features.blog %}<a href="/blog">{{ ui_text('blog') }}</a>{% endif %}{% if capabilities.features.forum|default(false) %}<a href="/forum">{{ ui_text('forum') }}</a>{% endif %}</section><section><h2>{{ ui_text('buyers') }}</h2><a href="/shipping">{{ ui_text('shipping') }}</a><a href="/payment">{{ ui_text('payment') }}</a><a href="/returns">{{ ui_text('returns_exchange') }}</a><a href="/warranty">{{ ui_text('warranty') }}</a><a href="/faq">{{ ui_text('faq') }}</a></section><section><h2>{{ ui_text('legal') }}</h2><a href="/privacy-policy">{{ ui_text('privacy_policy') }}</a><a href="/cookie-policy">{{ ui_text('cookie_policy') }}</a><a href="/terms-and-conditions">{{ ui_text('terms') }}</a><button type="button" data-consent-open>{{ ui_text('cookie_settings') }}</button></section></div></div><div class="shell site-footer__bottom"><span>© {{ 'now'|date('Y') }} {{ presentation.brand.title ?: store_name|default('Nexora Commerce') }}</span><span>{{ store_identity.locale }} · {{ store_identity.currency }}</span></div></footer>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">window.MC_I18N={{ ui_catalog_json(['js_']) }};</script>
<script type="module" src="{{ vite_asset('assets/storefront/storefront-runtime.js', '/assets/storefront-runtime.js') }}"></script>
{% for ext_asset in extension_assets() %}
  {% if ext_asset.type == 'js' %}<script type="module" src="{{ ext_asset.url }}"{% if ext_asset.defer|default(true) %} defer{% endif %}></script>{% endif %}
{% endfor %}
</body>
</html>