<section class="product-info-block product-info-block--{{ b.type }}">{% if b.title %}<h2>{{ b.title }}</h2>{% endif %}{% if b.type == 'info' %}<div class="product-info-block__body">{{ b.html|raw }}</div>{% elseif b.type == 'list' %}<ul class="product-info-block__list">{% for item in b.items %}<li>{{ item }}</li>{% endfor %}</ul>{% else %}<div class="product-info-block__table"><table><thead><tr>{% for c in b.columns %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead><tbody>{% for row in b.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% endif %}</section>
