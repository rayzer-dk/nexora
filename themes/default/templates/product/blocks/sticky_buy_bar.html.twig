{% if product.purchase_allowed %}
<commerce-sticky-buy class="mobile-buy-bar" data-watch-selector="[data-buy-actions]"><div><strong>{{ product.price }}</strong><span>{{ product.availability_label }}</span></div><button type="button" data-sticky-buy-action>{{ product.purchase_button_label|default(ui_text('buy')) }}</button></commerce-sticky-buy>
{% endif %}
