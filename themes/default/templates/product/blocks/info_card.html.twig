{% import '@storefront/product/blocks/_dynamic_value.html.twig' as dyn %}
{% set dynamic = dyn.value(block, product) %}
<aside class="product-info-card">
    {% if block.settings.title|default('') %}<strong>{{ block.settings.title }}</strong>{% endif %}
    {% if dynamic %}<p>{{ dynamic }}</p>{% elseif block.settings.text|default('') %}<p>{{ block.settings.text|nl2br }}</p>{% endif %}
    {% if block.settings.button_url|default('') and block.settings.button_label|default('') %}<a class="button button--secondary button--sm" href="{{ block.settings.button_url }}">{{ block.settings.button_label }}</a>{% endif %}
</aside>
