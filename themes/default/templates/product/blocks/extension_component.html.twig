<section class="product-block extension-block" data-extension-component="{{ block.type|e('html_attr') }}">
  {% set title = block.settings.title|default('')|builder_text %}{% set text = block.settings.text|default('')|builder_text %}
  {% if title %}<h3>{{ title }}</h3>{% endif %}
  {% if text %}<div>{{ text|nl2br }}</div>{% endif %}
</section>
