<section class="detail-card">
    <h2>{{ ui_text('attributes') }}</h2>
    <dl class="spec-list">
        {% for attribute in product.attributes %}
            <div><dt>{{ attribute.name }}</dt><dd>{% if attribute.type|default('text') == 'boolean' %}{{ ui_text(attribute.value == '1' ? 'attribute.boolean.yes' : 'attribute.boolean.no') }}{% else %}{{ attribute.value }}{% endif %}</dd></div>
        {% endfor %}
    </dl>
</section>
