<section class="detail-card" id="questions">
    <div class="section-heading"><h2>{{ ui_text('qa_title') }}</h2><span>{{ product.questions|length }}</span></div>
    {% for item in product.questions %}<details class="qa-item"><summary>{{ item.question }}{{ ui_icon('chevron-down', 16) }}</summary><p>{{ item.answer }}</p><small>{{ item.author }}</small></details>{% else %}<p>{{ ui_text('no_questions') }}</p>{% endfor %}
    {% if app.user and is_granted('ROLE_CUSTOMER') %}<form method="post" action="{{ path('product_question_submit',{product:product.id}) }}" class="feedback-form"><input type="hidden" name="_token" value="{{ csrf_token('question_' ~ product.id) }}"><input type="hidden" name="_rendered_at" value="{{ 'now'|date('U') }}"><input class="hp-field" type="text" name="_website" value="" tabindex="-1" autocomplete="off" aria-hidden="true"><label>{{ ui_text('your_question') }}<textarea name="question" rows="3" maxlength="4000" required></textarea></label>{% include '@storefront/components/captcha.html.twig' with {form:'question'} only %}<button class="button button--primary" type="submit">{{ ui_text('send_question') }}</button></form>{% else %}<p><a href="{{ path('customer_login') }}">{{ ui_text('sign_in_prompt') }}</a>, {{ ui_text('to_ask_question') }}</p>{% endif %}
</section>
