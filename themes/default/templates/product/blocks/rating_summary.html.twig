{% if product.rating %}
<a class="rating-summary" href="#reviews" aria-label="{{ product.rating.value }} {{ ui_text('out_of_five') }}, {{ product.rating.count }} {{ ui_text('reviews_count') }}">
    <span class="rating-summary__score">{{ product.rating.value }}</span>
    <span class="rating-stars" aria-hidden="true">{% for i in 1..5 %}{{ ui_icon('star-filled', 16) }}{% endfor %}</span>
    <span class="rating-summary__count">{{ product.rating.count }} {{ ui_text('reviews_count') }}</span>
</a>
{% endif %}
