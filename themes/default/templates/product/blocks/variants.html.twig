{% if product.option_groups|default([]) %}
<div class="option-picker" data-option-picker data-variants="{{ product.variants|json_encode|e('html_attr') }}">
    {% for group in product.option_groups %}
    <fieldset class="option-group" data-option-group="{{ group.id }}">
        <legend>{{ group.name }}: <strong data-option-current></strong></legend>
        <div class="option-group__values">
            {% for value in group.values %}<button type="button" class="option-value{{ value.swatch ? ' option-value--swatch' : '' }}" data-option="{{ group.id }}" data-option-value="{{ value.id }}" data-label="{{ value.label|e('html_attr') }}" data-media="{{ value.media_id|default('') }}" aria-pressed="false" title="{{ value.label|e('html_attr') }}">{% if value.swatch %}<span class="option-value__dot" style="background:{{ value.swatch }}"></span>{% endif %}<span class="option-value__label">{{ value.label }}</span></button>{% endfor %}
        </div>
    </fieldset>
    {% endfor %}
</div>
{% elseif product.variants %}
{% set has_swatch = false %}
{% for variant in product.variants %}{% if variant.swatch|default('') %}{% set has_swatch = true %}{% endif %}{% endfor %}
<fieldset class="variant-picker{{ has_swatch ? ' variant-picker--swatches' : '' }}">
    <legend>{{ ui_text('variant') }}{% for variant in product.variants %}{% if variant.selected %}<strong class="variant-picker__current">{{ variant.label }}</strong>{% endif %}{% endfor %}</legend>
    <div class="variant-picker__options">
        {% for variant in product.variants %}
            {% if variant.swatch|default('') %}
                <a href="{{ product.url }}?variant={{ variant.id }}" class="variant-swatch{% if variant.selected %} is-selected{% endif %}{% if not variant.available %} is-unavailable{% endif %}" aria-current="{{ variant.selected ? 'true' : 'false' }}" aria-label="{{ variant.label }}" title="{{ variant.label }} · {{ variant.price }}{% if not variant.available %} · {{ ui_text('out_of_stock') }}{% endif %}"><span class="variant-swatch__dot" style="background:{{ variant.swatch }}"></span><span class="variant-swatch__name">{{ variant.label }}</span></a>
            {% else %}
                <a href="{{ product.url }}?variant={{ variant.id }}" class="variant-chip{% if variant.selected %} is-selected{% endif %}{% if not variant.available %} is-unavailable{% endif %}" aria-current="{{ variant.selected ? 'true' : 'false' }}" title="SKU {{ variant.sku }}{% if not variant.available %} · {{ ui_text('out_of_stock') }}{% endif %}"><span class="variant-chip__label">{{ variant.label }}</span><span class="variant-chip__price">{{ variant.price }}</span></a>
            {% endif %}
        {% endfor %}
    </div>
</fieldset>
{% endif %}
