{% import '@storefront/product/blocks/_dynamic_value.html.twig' as dyn %}
{% set dynamic = dyn.value(block, product) %}
<section class="product-custom-content">
    {% if block.settings.title|default('') %}<h2>{{ block.settings.title }}</h2>{% endif %}
    {% if dynamic %}<p>{{ dynamic }}</p>{% elseif block.settings.text|default('') %}<p>{{ block.settings.text|nl2br }}</p>{% endif %}
    {% if block.settings.button_url|default('') and block.settings.button_label|default('') %}<a class="button button--primary" href="{{ block.settings.button_url }}">{{ block.settings.button_label }}</a>{% endif %}
</section>
