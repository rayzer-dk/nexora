{% set source = block.settings.data_source|default('') %}
{% set dynamic = source == 'product.name' ? product.name : (source == 'product.brand' ? product.brand|default('') : (source == 'product.sku' ? product.sku|default('') : (source == 'product.gtin' ? product.gtin|default('') : (source == 'product.mpn' ? product.mpn|default('') : (source == 'product.price' ? product.price|default('') : (source == 'product.availability' ? product.availability_label|default('') : '')))))) %}
<section class="product-custom-content">
    {% if block.settings.title|default('') %}<h2>{{ block.settings.title }}</h2>{% endif %}
    {% if dynamic %}<p>{{ dynamic }}</p>{% elseif block.settings.text|default('') %}<p>{{ block.settings.text|nl2br }}</p>{% endif %}
    {% if block.settings.button_url|default('') and block.settings.button_label|default('') %}<a class="button" href="{{ block.settings.button_url }}">{{ block.settings.button_label }}</a>{% endif %}
</section>
