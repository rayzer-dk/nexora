<section class="detail-card" id="reviews">
    <div class="section-heading"><h2>{{ ui_text('reviews') }}</h2><span>{{ product.rating.count }} {{ ui_text('reviews_count') }}</span></div>
    {% for review in product.reviews %}
        <article class="review">
            <div class="review__head"><strong>{{ review.author }}</strong>{% if review.verified %}<span class="badge badge--success">{{ ui_text('verified_purchase') }}</span>{% endif %}<span class="review__stars" role="img" aria-label="{{ review.rating }} {{ ui_text('out_of_five') }}"><span class="rating-stars" aria-hidden="true">{% for i in 1..5 %}{{ ui_icon(i <= review.rating ? 'star-filled' : 'star-empty', 16) }}{% endfor %}</span></span></div>
            {% if review.title %}<h3>{{ review.title }}</h3>{% endif %}
            <p>{{ review.text }}</p>
            {% if review.images is not empty %}<div class="review-media" aria-label="{{ ui_text('review_photos') }}">{% for image in review.images %}<a href="{{ image }}" target="_blank" rel="noopener"><img src="{{ image }}" alt="{{ ui_text('review_photo_by', {author: review.author}) }}" loading="lazy"></a>{% endfor %}</div>{% endif %}
            {% if review.reply %}<div class="merchant-reply"><strong>{{ ui_text('store_reply') }}</strong><p>{{ review.reply }}</p></div>{% endif %}
            <div class="review__actions"><small>{{ ui_text('helpful_review') }}: {{ review.helpful }}</small>{% if app.user and is_granted('ROLE_CUSTOMER') %}<form method="post" action="{{ path('product_review_helpful',{id:review.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('review_helpful_' ~ review.id) }}"><button type="submit" class="button button--secondary button--sm">{{ ui_icon('thumbs-up', 16) }}{{ ui_text('helpful') }}</button></form>{% endif %}</div>
        </article>
    {% else %}<p>{{ ui_text('no_reviews') }}</p>{% endfor %}
    {% if app.user and is_granted('ROLE_CUSTOMER') %}
        <form method="post" action="{{ path('product_review_submit',{product:product.id}) }}" class="feedback-form" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ product.id) }}"><input type="hidden" name="_rendered_at" value="{{ 'now'|date('U') }}"><input class="hp-field" type="text" name="_website" value="" tabindex="-1" autocomplete="off" aria-hidden="true">
            <label>{{ ui_text('rating') }}<select name="rating" required><option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select></label>
            <label>{{ ui_text('title') }}<input type="text" name="title" maxlength="255"></label>
            <label>{{ ui_text('your_review') }}<textarea name="body" rows="4" maxlength="8000" required></textarea></label>
            <label>{{ ui_text('product_photo') }} <small>{{ ui_text('review_image_limits') }}</small><input type="file" name="images[]" accept="image/jpeg,image/png,image/webp,image/avif" multiple></label>
            <button class="button button--primary" type="submit">{{ ui_text('send_review') }}</button>
        </form>
    {% else %}<p><a href="{{ path('customer_login') }}">{{ ui_text('sign_in_prompt') }}</a>, {{ ui_text('to_leave_review') }}</p>{% endif %}
</section>
