{% if product.complementary %}
<section class="detail-card"><commerce-slider class="slider-shell"><div class="slider-shell__heading"><h2>{{ ui_text('bought_together') }}</h2><div class="slider-shell__actions"><button type="button" data-slider-prev aria-label="{{ ui_text('previous_products') }}">‹</button><button type="button" data-slider-next aria-label="{{ ui_text('next_products') }}">›</button></div></div><div class="commerce-carousel" data-slider-track>{% for item in product.complementary %}<a class="related-card" href="{{ item.url }}"><img src="{{ item.image }}" alt="{{ item.name }}" width="360" height="360" loading="lazy"><span><strong>{{ item.name }}</strong><small>{{ item.availability_label }}</small><b>{{ item.price }}</b></span></a>{% endfor %}</div></commerce-slider></section>
{% endif %}
{% if product.related %}
<section class="detail-card"><commerce-slider class="slider-shell"><div class="slider-shell__heading"><h2>{{ ui_text('similar_products') }}</h2><div class="slider-shell__actions"><button type="button" data-slider-prev aria-label="{{ ui_text('previous_products') }}">‹</button><button type="button" data-slider-next aria-label="{{ ui_text('next_products') }}">›</button></div></div><div class="commerce-carousel" data-slider-track>{% for item in product.related %}<a class="related-card" href="{{ item.url }}"><img src="{{ item.image }}" alt="{{ item.name }}" width="360" height="360" loading="lazy"><span><strong>{{ item.name }}</strong><small>{{ item.availability_label }}</small><b>{{ item.price }}</b></span></a>{% endfor %}</div></commerce-slider></section>
{% endif %}
{% if product.complementary or product.related %}<script type="module" src="{{ vite_asset('assets/storefront/slider.js', '/assets/slider.js') }}"></script>{% endif %}
