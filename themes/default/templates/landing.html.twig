{% extends '@storefront/base.html.twig' %}
{% set page_kind = 'home' %}
{% set presentation = storefront_presentation() %}
{% macro form_fields(form) %}
{% for f in form.fields %}{% if f.type %}
    {% set req = f.required or f.type in ['name'] %}
    {% if f.type == 'name' %}<label><span>{{ f.label }}{{ req ? ' *' : '' }}</span><input name="name" maxlength="190" autocomplete="name"{{ req ? ' required' : '' }}></label>
    {% elseif f.type == 'phone' %}<label><span>{{ f.label }}{{ req ? ' *' : '' }}</span><input name="phone" type="tel" maxlength="32" autocomplete="tel"{{ req ? ' required' : '' }}></label>
    {% elseif f.type == 'email' %}<label><span>{{ f.label }}{{ req ? ' *' : '' }}</span><input name="email" type="email" maxlength="190" autocomplete="email"{{ req ? ' required' : '' }}></label>
    {% elseif f.type == 'message' %}<label><span>{{ f.label }}{{ req ? ' *' : '' }}</span><textarea name="message" rows="3" maxlength="2000"{{ req ? ' required' : '' }}></textarea></label>
    {% elseif f.type == 'text' %}<label><span>{{ f.label }}{{ req ? ' *' : '' }}</span><input name="extra[{{ f.label }}]" maxlength="300"{{ req ? ' required' : '' }}></label>
    {% elseif f.type == 'select' %}<label><span>{{ f.label }}{{ req ? ' *' : '' }}</span><select name="extra[{{ f.label }}]"{{ req ? ' required' : '' }}><option value="">—</option>{% for o in f.options|split('|') %}{% if o|trim %}<option>{{ o|trim }}</option>{% endif %}{% endfor %}</select></label>
    {% elseif f.type == 'checkbox' %}<label class="lp-check"><input type="checkbox" name="extra[{{ f.label }}]" value="{{ ui_text('landing.ui.yes') }}"{{ req ? ' required' : '' }}><span>{{ f.label }}{{ req ? ' *' : '' }}</span></label>
    {% endif %}
{% endif %}{% endfor %}
{% endmacro %}
{% macro form_body(form, page_url, type) %}
    {% import _self as lp %}
    {% include '@storefront/components/spam_fields.html.twig' %}<input type="hidden" name="inquiry_type" value="{{ type }}"><input type="hidden" name="source_url" value="{{ page_url }}"><input type="hidden" name="form_title" value="{{ form.title }}">
    {{ lp.form_fields(form) }}
    {% include '@storefront/components/captcha.html.twig' with {form: type == 'callback' ? 'callback' : 'contact'} only %}
    <button class="lp-btn lp-btn--primary" type="submit">{{ ui_icon('send', 18) }}{{ form.button }}</button>
    <small>{{ ui_text('landing.ui.privacy_note') }}</small>
{% endmacro %}

{% import _self as lp %}
{% block site_header %}
<header class="lp-header" data-lp-header>
    <div class="lp-wrap lp-header__inner">
        <a class="lp-brand" href="#top" aria-label="{{ storefront_brand_name }}">{% if presentation.brand.logo %}<img src="{{ presentation.brand.logo }}" alt="{{ storefront_brand_name }}" height="32">{% else %}{% if presentation.brand.icon %}<img class="lp-brand__icon" src="{{ presentation.brand.icon }}" alt="" width="32" height="32">{% endif %}<strong>{{ storefront_brand_name }}</strong>{% endif %}</a>
        <nav class="lp-nav" aria-label="{{ ui_text('navigation') }}">
            <a href="#features">{{ ui_text('landing.nav.features') }}</a><a href="#how">{{ ui_text('landing.nav.how') }}</a><a href="#reviews">{{ ui_text('landing.nav.reviews') }}</a><a href="#faq">{{ ui_text('landing.nav.faq') }}</a><a href="#contact">{{ ui_text('landing.nav.contact') }}</a>
        </nav>
        <div class="lp-header__tools">
            {% include '@storefront/components/header_switchers.html.twig' %}
            {% if presentation.theme.toggle|default('1') == '1' %}<button class="reference-theme-toggle" type="button" data-theme-toggle aria-label="{{ ui_text('theme_toggle') }}" title="{{ ui_text('theme_toggle') }}"><span class="reference-theme-toggle__moon" aria-hidden="true">{{ ui_icon('sun-moon', 22) }}</span></button>{% endif %}
            <a class="lp-btn lp-btn--primary lp-btn--sm" href="{{ landing.hero.primary_url }}">{{ landing.hero.primary_label }}</a>
        </div>
    </div>
</header>
{% endblock %}
{% block body %}
<div id="top"></div>
<section class="lp-hero">
    <div class="lp-wrap lp-hero__grid">
        <div class="lp-hero__copy">
            {% if landing.hero.eyebrow %}<span class="lp-pill">{{ ui_icon('sparkles', 14) }}{{ landing.hero.eyebrow }}</span>{% endif %}
            <h1>{{ landing.hero.title }}</h1>
            <p class="lp-lead">{{ landing.hero.subtitle }}</p>
            <div class="lp-actions">
                <a class="lp-btn lp-btn--primary" href="{{ landing.hero.primary_url }}">{{ landing.hero.primary_label }}{{ ui_icon('arrow-right', 18) }}</a>
                {% if landing.hero.secondary_label %}<a class="lp-btn lp-btn--ghost" href="{{ landing.hero.secondary_url }}">{{ landing.hero.secondary_label }}</a>{% endif %}
            </div>
            {% if landing.hero.note %}<p class="lp-note">{{ ui_icon('check', 16) }}{{ landing.hero.note }}</p>{% endif %}
        </div>
        <div class="lp-hero__visual" aria-hidden="true">
            {% if landing.hero.image %}
                <img class="lp-hero__image" src="{{ landing.hero.image }}" alt="" width="640" height="520" loading="eager" decoding="async">
            {% else %}
                <div class="lp-mock">
                    <div class="lp-mock__bar"><i></i><i></i><i></i><span></span></div>
                    <div class="lp-mock__body">
                        <div class="lp-mock__hero"><b></b><b></b><em></em></div>
                        <div class="lp-mock__cards"><span></span><span></span><span></span></div>
                    </div>
                </div>
                <div class="lp-float lp-float--a">{{ ui_icon('trending-up', 18) }}<div><strong>{{ landing.stats[0].value }}</strong><small>{{ landing.stats[0].label }}</small></div></div>
                <div class="lp-float lp-float--b">{{ ui_icon('shield-check', 18) }}<div><strong>{{ landing.stats[1].value }}</strong><small>{{ landing.stats[1].label }}</small></div></div>
            {% endif %}
        </div>
    </div>
</section>

<section class="lp-stats" aria-label="{{ landing.headings.features }}">
    <div class="lp-wrap lp-stats__grid">{% for stat in landing.stats %}<div><strong>{{ stat.value }}</strong><span>{{ stat.label }}</span></div>{% endfor %}</div>
</section>

<section class="lp-section" id="features">
    <div class="lp-wrap">
        <header class="lp-section__head"><h2>{{ landing.headings.features }}</h2><p>{{ landing.headings.features_lead }}</p></header>
        <div class="lp-features">{% for f in landing.features %}<article class="lp-card"><span class="lp-card__icon" aria-hidden="true">{{ ui_icon(f.icon, 22) }}</span><h3>{{ f.title }}</h3><p>{{ f.text }}</p></article>{% endfor %}</div>
    </div>
</section>

<section class="lp-section lp-section--tint" id="how">
    <div class="lp-wrap">
        <header class="lp-section__head"><h2>{{ landing.headings.steps }}</h2></header>
        <ol class="lp-steps">{% for step in landing.steps %}<li><span class="lp-steps__n">{{ loop.index }}</span><h3>{{ step.title }}</h3><p>{{ step.text }}</p></li>{% endfor %}</ol>
    </div>
</section>

<section class="lp-section" id="reviews">
    <div class="lp-wrap">
        <header class="lp-section__head"><h2>{{ landing.headings.reviews }}</h2></header>
        <div class="lp-reviews">{% for r in landing.reviews %}<figure class="lp-review"><span class="lp-review__stars" aria-hidden="true">{% for i in 1..5 %}{{ ui_icon('star-filled', 16) }}{% endfor %}</span><blockquote>{{ r.quote }}</blockquote><figcaption><span class="lp-avatar" aria-hidden="true">{{ r.name|first|upper }}</span><span><strong>{{ r.name }}</strong><small>{{ r.role }}</small></span></figcaption></figure>{% endfor %}</div>
    </div>
</section>

<section class="lp-section lp-section--tint" id="faq">
    <div class="lp-wrap lp-wrap--narrow">
        <header class="lp-section__head"><h2>{{ landing.headings.faq }}</h2></header>
        <div class="lp-faq">{% for item in landing.faq %}<details{{ loop.first ? ' open' : '' }}><summary>{{ item.q }}{{ ui_icon('chevron-down', 18) }}</summary><p>{{ item.a }}</p></details>{% endfor %}</div>
    </div>
</section>

<section class="lp-section lp-contact" id="contact">
    <div class="lp-wrap">
        <div class="lp-cta">
            <div class="lp-cta__copy"><h2>{{ landing.cta.title }}</h2><p>{{ landing.cta.text }}</p></div>
            {% set main = landing.forms[0] %}
            {% if main.enabled %}
            <form class="lp-form" method="post" action="/contact/send" data-cw-form><input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
                <h3>{{ main.title }}</h3>
                <p>{{ main.text }}</p>
                {{ lp.form_body(main, app.request.uri, 'contact') }}
            </form>
            {% else %}
            <a class="lp-btn lp-btn--primary" href="{{ landing.hero.primary_url }}">{{ landing.cta.button }}</a>
            {% endif %}
        </div>
    </div>
</section>
{% for form in landing.forms|slice(1) %}{% if form.enabled %}
<dialog class="lp-dialog" id="form-{{ form.key }}" aria-labelledby="form-{{ form.key }}-title" data-lp-dialog>
    <form class="lp-form" method="post" action="/contact/send" data-cw-form><input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
        <button class="lp-dialog__close" type="button" data-lp-dialog-close aria-label="{{ ui_text('close') }}">{{ ui_icon('x', 20) }}</button>
        <h3 id="form-{{ form.key }}-title">{{ form.title }}</h3>
        <p>{{ form.text }}</p>
        {{ lp.form_body(form, app.request.uri, form.key == 'callback' ? 'callback' : 'contact') }}
    </form>
</dialog>
{% endif %}{% endfor %}
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">
(function(){var d=document;function open(id){var el=d.getElementById(id);if(el&&el.tagName==='DIALOG'&&el.showModal){el.showModal();return true;}return false;}
d.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[href^="#form-"]');if(a&&open(a.getAttribute('href').slice(1))){e.preventDefault();return;}
var c=e.target.closest&&e.target.closest('[data-lp-dialog-close]');if(c){c.closest('dialog').close();return;}
if(e.target.matches&&e.target.matches('dialog[data-lp-dialog]'))e.target.close();});
if(location.hash.indexOf('#form-')===0)open(location.hash.slice(1));})();
</script>
{% endblock %}
{% block site_footer %}
{% set hc = header_contacts() %}
<footer class="lp-footer">
    <div class="lp-wrap lp-footer__inner">
        <strong>{{ storefront_brand_name }}</strong>
        <span>{% if hc.phone_href %}<a href="{{ hc.phone_href }}">{{ hc.phone }}</a>{% endif %}{% if hc.email %}<a href="mailto:{{ hc.email }}">{{ hc.email }}</a>{% endif %}</span>
        <span>© {{ 'now'|date('Y') }} {{ storefront_brand_name }}. {{ ui_text('landing.ui.rights') }} <a href="/privacy-policy">{{ ui_text('landing.ui.privacy') }}</a></span>
    </div>
</footer>
{% endblock %}
