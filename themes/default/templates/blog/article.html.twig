{% extends '@storefront/base.html.twig' %}
{% block head %}<link rel="alternate" type="application/rss+xml" title="{{ ui_text('blog_rss')|e('html_attr') }}" href="/blog/feed.xml"><script type="application/ld+json" nonce="{{ app.request.attributes.get('_csp_nonce') }}">{{ structured_data_json|raw }}</script>{% endblock %}
{% block body %}
<article class="shell article-page" data-article data-lightbox-scope>
  {% include '@storefront/components/breadcrumbs.html.twig' with {items: breadcrumbs} only %}
  <div class="article-layout{% if article.toc %} has-toc{% endif %}">
    {% if article.toc %}
    <nav class="article-toc" aria-labelledby="article-toc-title">
      <h2 id="article-toc-title">{{ ui_icon('list-tree', 16) }}{{ ui_text('blog_toc') }}</h2>
      <ol>{% for item in article.toc %}<li class="{{ item.level == 3 ? 'article-toc__l3' : 'article-toc__l2' }}"><a href="#{{ item.id }}">{{ item.text }}</a></li>{% endfor %}</ol>
    </nav>
    {% endif %}
    <div class="article-main">
  <header class="article-header">
    <p class="article-header__kicker">{% if article.category %}<a class="blog-chip" href="/blog/category/{{ article.category.slug }}">{{ article.category.name }}</a>{% else %}<span class="eyebrow">{{ ui_text('blog') }}</span>{% endif %}</p>
    <h1>{{ article.title }}</h1>
    {% if article.excerpt %}<p class="article-header__lead">{{ article.excerpt }}</p>{% endif %}
    <p class="article-header__meta">
      {% if article.author %}<span>{{ ui_icon('user', 16) }}{{ ui_text('blog_by') }} {{ article.author }}</span>{% endif %}
      <span>{{ ui_icon('calendar', 16) }}<time datetime="{{ article.published_iso }}">{{ article.date }}</time></span>
      <span>{{ ui_icon('clock', 16) }}{{ ui_text('blog_min_read')|replace({'%min%': article.reading_minutes}) }}</span>
    </p>
  </header>
  {% set img_align = article.image_align|default('none') %}
  {% set img_size = article.image_size|default('m') %}
  {% if article.image and img_align == 'none' %}<figure class="article-hero article-hero--{{ img_size }}" data-lightbox-item><img src="{{ article.image }}" alt="{{ article.image_alt|e('html_attr') }}" width="1440" height="810" fetchpriority="high" decoding="async"></figure>{% endif %}
      <div class="article-body">
        {% if article.image and (img_align == 'left' or img_align == 'right') %}<figure class="article-figure article-figure--{{ img_align }} article-figure--{{ img_size }}" data-lightbox-item><img src="{{ article.image }}" alt="{{ article.image_alt|e('html_attr') }}" width="720" height="540" loading="eager" decoding="async"></figure>{% endif %}
        {{ article.body_html|raw|with_forms }}
      </div>
      {% if article.tags %}<ul class="article-tags" aria-label="{{ ui_text('blog_tags_label')|e('html_attr') }}">{% for tag in article.tags %}<li><a class="blog-chip" href="/blog/tag/{{ tag.slug }}">{{ ui_icon('tag', 14) }}{{ tag.name }}</a></li>{% endfor %}</ul>{% endif %}
      {% include '@storefront/components/share_links.html.twig' with {share_url: share_url, share_title: article.title} only %}
    </div>
    <aside class="article-rail" aria-label="{{ ui_text('blog_related')|e('html_attr') }}">
      {% set linked_products = article_products(article.id) %}
      {% if linked_products %}
      <section class="aside-card" aria-labelledby="article-products-title">
        <h2 id="article-products-title">{{ ui_icon('shopping-bag', 16) }}{{ ui_text('blog_products') }}</h2>
        <ul class="aside-links">{% for p in linked_products %}<li><a href="{{ p.path }}">{{ p.name }}{{ ui_icon('chevron-right', 14) }}</a></li>{% endfor %}</ul>
      </section>
      {% endif %}
      {% if related %}
      <section class="aside-card" aria-labelledby="article-related-title">
        <h2 id="article-related-title">{{ ui_icon('newspaper', 16) }}{{ ui_text('blog_related') }}</h2>
        <ul class="article-rail__list">{% for item in related|slice(0, 4) %}<li><a class="article-rail__item" href="{{ item.url }}">{% if item.image %}<img src="{{ item.image }}" alt="" width="96" height="64" loading="lazy" decoding="async">{% else %}<span class="article-rail__ph" aria-hidden="true">{{ ui_icon('file-text', 20) }}</span>{% endif %}<span><strong>{{ item.title }}</strong><small>{{ item.date }}</small></span></a></li>{% endfor %}</ul>
      </section>
      {% endif %}
    </aside>
  </div>

  {% if neighbors.prev or neighbors.next %}
  <nav class="article-neighbors" aria-label="{{ ui_text('pagination') }}">
    {% if neighbors.prev %}<a class="article-neighbors__link" rel="prev" href="{{ neighbors.prev.url }}"><small>{{ ui_icon('arrow-left', 14) }}{{ ui_text('blog_prev') }}</small><span>{{ neighbors.prev.title }}</span></a>{% else %}<span></span>{% endif %}
    {% if neighbors.next %}<a class="article-neighbors__link is-next" rel="next" href="{{ neighbors.next.url }}"><small>{{ ui_text('blog_next') }}{{ ui_icon('arrow-right', 14) }}</small><span>{{ neighbors.next.title }}</span></a>{% endif %}
  </nav>
  {% endif %}

</article>
{% endblock %}
