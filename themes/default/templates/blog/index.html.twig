{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell content-list"><header class="content-hero"><p class="eyebrow">{{ ui_text('useful_materials') }}</p><h1>{{ ui_text('blog') }}</h1><p>{{ ui_text('blog_intro') }}</p></header>
{% if articles %}<div class="article-grid article-grid--media">{% for article in articles %}<article class="article-card article-card--media"><a class="article-card__image" href="{{ article.url }}" tabindex="-1" aria-hidden="true"><img src="{{ article.image }}" alt="" width="960" height="540" loading="lazy" decoding="async"></a><div><time>{{ article.date }}</time><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt }}</p><a class="article-card__more" href="{{ article.url }}">{{ ui_text('read_more') }} →</a></div></article>{% endfor %}</div>{% else %}<div class="empty-state"><h2>{{ ui_text('no_articles') }}</h2><p>{{ ui_text('no_articles_text') }}</p></div>{% endif %}</section>
{% endblock %}
