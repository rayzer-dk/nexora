{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell content-list"><header class="content-hero"><p class="eyebrow">{{ ui_text('useful_materials') }}</p><h1>{{ ui_text('blog') }}</h1><p>{{ ui_text('blog_intro') }}</p></header>
{% if articles %}<div class="article-grid">{% for article in articles %}<article class="article-card"><a class="article-card__image{% if not article.image %} is-placeholder{% endif %}" href="{{ article.url }}" aria-label="{{ article.title|e('html_attr') }}">{% if article.image %}<img src="{{ article.image }}" alt="" width="960" height="540" loading="lazy" decoding="async">{% else %}{{ ui_icon('file-text', 32) }}{% endif %}</a><div class="article-card__body"><time>{{ article.date }}</time><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt }}</p><a class="article-card__more" href="{{ article.url }}">{{ ui_text('read_arrow') }}{{ ui_icon('arrow-right', 16) }}</a></div></article>{% endfor %}</div>{% else %}<div class="empty-state"><h2>{{ ui_text('no_articles') }}</h2><p>{{ ui_text('no_articles_text') }}</p></div>{% endif %}</section>
{% endblock %}
