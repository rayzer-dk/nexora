{% if articles and presentation.home.show_articles %}
<section class="home-section shell" data-home-builder-block="{{ layout_block.id }}"><div class="section-heading"><div><p class="eyebrow">{{ ui_text('useful') }}</p><h2>{{ layout_block.props.title|default('') ?: ui_text('blog_news') }}</h2></div><a href="/blog">{{ ui_text('all_articles_arrow') }}</a></div><div class="article-grid article-grid--media">{% for article in articles %}<article class="article-card article-card--media"><a class="article-card__image" href="{{ article.url }}" aria-label="{{ article.title|e('html_attr') }}"><img src="{{ article.image }}" alt="{{ article.title|e('html_attr') }}" width="960" height="540" loading="lazy" decoding="async"></a><div><time>{{ article.date }}</time><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p>{{ article.excerpt }}</p><a class="article-card__more" href="{{ article.url }}">{{ ui_text('read_arrow') }}</a></div></article>{% endfor %}</div></section>
{% endif %}
