{% if articles and presentation.home.show_articles %}
<section class="home-section shell" data-home-builder-block="{{ layout_block.id }}"><div class="section-heading"><div><p class="eyebrow">{{ ui_text('useful') }}</p><h2>{{ layout_block.props.title|default('') ?: ui_text('blog_news') }}</h2></div><a class="section-link" href="/blog">{{ ui_text('all_articles_arrow') }}{{ ui_icon('arrow-right', 16) }}</a></div><div class="article-grid">{% for article in articles %}<article class="article-card"><a class="article-card__image{% if not article.image %} is-placeholder{% endif %}" href="{{ article.url }}" aria-label="{{ article.title|e('html_attr') }}">{% if article.image %}<img src="{{ article.image }}" alt="" width="960" height="540" loading="lazy" decoding="async">{% else %}{{ ui_icon('file-text', 32) }}{% endif %}</a><div class="article-card__body"><time>{{ article.date }}</time><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p>{{ article.excerpt }}</p><a class="article-card__more" href="{{ article.url }}">{{ ui_text('read_arrow') }}{{ ui_icon('arrow-right', 16) }}</a></div></article>{% endfor %}</div></section>
{% endif %}
