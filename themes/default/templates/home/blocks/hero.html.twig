{% set props = layout_block.props|default({}) %}
{% if demo_showcase %}
<section data-home-builder-block="{{ layout_block.id }}">
    <div class="shell demo-hero-grid">
        <article class="demo-hero-card">
            <div class="demo-hero-card__copy">
                <span class="demo-kicker">{{ ui_text('home_demo_kicker') }}</span>
                <h1>{{ props.title|default('') ?: presentation.hero.title ?: ui_text('home_demo_title') }}</h1>
                <p>{{ props.text|default('') ?: presentation.hero.text ?: ui_text('home_demo_text') }}</p>
                <div class="demo-hero-card__actions">
                    {% set demo_button_url = props.button_url|default('') ?: presentation.hero.button_url ?: '/catalog' %}
                    {% set demo_button_label = props.button_label|default('') ?: presentation.hero.button_label ?: ui_text('go_catalog') %}
                    {% if site_features.catalog|default(false) and demo_button_label and demo_button_url %}<a class="button button--primary button--lg" href="{{ demo_button_url }}">{{ demo_button_label }}{{ ui_icon('arrow-right', 16) }}</a>{% endif %}
                    {% if site_features.content|default(false) %}<a class="button button--secondary button--lg" href="/about-us">{{ ui_text('about_platform') }}</a>{% endif %}
                </div>
                <div class="demo-hero-card__facts"><span>{{ ui_text('demo_products_count', {count: demo_showcase.counts.products}) }}</span><span>{{ ui_text('demo_categories_count', {count: demo_showcase.counts.categories}) }}</span><span>{{ ui_text('coupon') }} {{ demo_showcase.coupon.code }}</span></div>
            </div>
            {% set demo_hero_image = props.image|default('') ?: presentation.hero.image ?: '/media/demo/laptop-pro-14.webp' %}
            <div class="demo-hero-card__media"><img src="{{ demo_hero_image }}" alt="{{ ui_text('demo_laptop_alt') }}" width="1100" height="720" fetchpriority="high" decoding="async"></div>
        </article>
        {% if site_features.catalog|default(false) and demo_showcase and demo_showcase.promos|length >= 2 %}<div class="demo-hero-stack">
            {% for promo in demo_showcase.promos|slice(0, 2) %}<a class="demo-mini-banner demo-mini-banner--{{ promo.tone }}" href="{{ promo.url }}"><img src="{{ promo.image }}" alt="" width="420" height="420" loading="lazy" decoding="async"><span><strong>{{ promo.title }}</strong><b>{{ ui_text('view_arrow') }}{{ ui_icon('arrow-right', 16) }}</b></span></a>{% endfor %}
        </div>{% endif %}
    </div>
</section>
{% elseif props.title|default('') or props.text|default('') or props.image|default('') or presentation.hero.title or presentation.hero.image %}
<section class="reference-hero-wrap" data-home-builder-block="{{ layout_block.id }}">
    <div class="shell reference-hero">
        <div class="reference-hero__copy">
            {% if presentation.hero.eyebrow %}<p class="eyebrow">{{ presentation.hero.eyebrow }}</p>{% endif %}
            <h1>{{ props.title|default('') ?: presentation.hero.title ?: store_name }}</h1>
            {% if presentation.hero.subtitle %}<h2>{{ presentation.hero.subtitle }}</h2>{% endif %}
            {% if props.text|default('') or presentation.hero.text %}<p>{{ props.text|default('') ?: presentation.hero.text }}</p>{% endif %}
            {% set button_label = props.button_label|default('') ?: presentation.hero.button_label %}
            {% set button_url = props.button_url|default('') ?: presentation.hero.button_url %}
            {% if button_label and button_url %}<a class="button button--primary button--lg" href="{{ button_url }}">{{ button_label }}{{ ui_icon('arrow-right', 16) }}</a>{% endif %}
        </div>
        {% set hero_image = props.image|default('') ?: presentation.hero.image %}
        {% if hero_image %}<div class="reference-hero__visual"><img src="{{ hero_image }}" alt="" width="1200" height="452" fetchpriority="high" decoding="async"></div>{% endif %}
    </div>
</section>
{% else %}
<section class="home-hero shell" data-home-builder-block="{{ layout_block.id }}"><div><p class="eyebrow">{{ site_mode == 'landing' ? ui_text('presentation') : ui_text('site') }}</p><h1>{{ store_name }}</h1>{% if site_features.catalog|default(false) %}<a class="button button--primary button--lg" href="/catalog">{{ ui_text('go_catalog') }}{{ ui_icon('arrow-right', 16) }}</a>{% endif %}</div></section>
{% endif %}
