{% set block_products = product_sets[layout_block.id]|default(products) %}
{% if block_products and presentation.home.show_products %}
{% set display = layout_block.props.display|default('grid') == 'carousel' ? 'carousel' : 'grid' %}
<section class="shell reference-products-section" data-home-builder-block="{{ layout_block.id }}">
    <div class="reference-section-title reference-section-title--spaced"><div><small class="section-kicker">{{ ui_text('store_selection') }}</small><h2>{{ layout_block.props.title|default('') ?: ui_text('popular_products') }}</h2></div><a class="section-link" href="/catalog">{{ ui_text('all_products_arrow') }}{{ ui_icon('arrow-right', 16) }}</a></div>
    {% if display == 'carousel' %}
    <commerce-slider class="slider-shell slider-shell--products">
        <div class="slider-shell__heading slider-shell__heading--bare"><span></span><div class="slider-shell__actions"><button class="button button--secondary button--icon" type="button" data-slider-prev aria-label="{{ ui_text('previous') }}">{{ ui_icon('chevron-left', 20) }}</button><button class="button button--secondary button--icon" type="button" data-slider-next aria-label="{{ ui_text('next') }}">{{ ui_icon('chevron-right', 20) }}</button></div></div>
        <div class="commerce-carousel commerce-carousel--cards" data-slider-track>{% for product in block_products %}{% include '@storefront/components/product_card.html.twig' with {product:product} only %}{% endfor %}</div>
    </commerce-slider>
    {% else %}
    <div class="product-grid demo-product-grid">{% for product in block_products %}{% include '@storefront/components/product_card.html.twig' with {product:product} only %}{% endfor %}</div>
    {% endif %}
</section>
{% endif %}
