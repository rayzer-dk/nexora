{#- One section of the landing page, chosen by its key (s.key); the owner sets the order and visibility in Appearance -> Landing. Needs: s, landing. -#}
{% import '@storefront/landing/_macros.html.twig' as lp %}
{% if s.key == 'hero' %}
<section class="lp-hero">
    <div class="lp-wrap lp-hero__grid">
        <div class="lp-hero__copy">
            {% if landing.hero.eyebrow %}<span class="lp-pill">{{ ui_icon('sparkles', 14) }}{{ landing.hero.eyebrow }}</span>{% endif %}
            <h1>{{ landing.hero.title }}</h1>
            <p class="lp-lead">{{ landing.hero.subtitle }}</p>
            <div class="lp-actions">
                <a class="lp-btn lp-btn--primary" href="{{ landing.hero.primary_url }}">{{ landing.hero.primary_label }}{{ ui_icon('arrow-right', 18) }}</a>
                {% if landing.hero.secondary_label %}<a class="lp-btn lp-btn--ghost" href="{{ landing.hero.secondary_url }}">{{ landing.hero.secondary_label }}</a>{% endif %}
            </div>
            {% if landing.hero.note %}<p class="lp-note">{{ ui_icon('check', 16) }}{{ landing.hero.note }}</p>{% endif %}
        </div>
        <div class="lp-hero__visual" aria-hidden="true">
            {% if landing.hero.image %}
                <img class="lp-hero__image" src="{{ landing.hero.image }}" alt="" width="640" height="520" loading="eager" decoding="async">
            {% else %}
                <div class="lp-mock">
                    <div class="lp-mock__bar"><i></i><i></i><i></i><span></span></div>
                    <div class="lp-mock__body">
                        <div class="lp-mock__hero"><b></b><b></b><em></em></div>
                        <div class="lp-mock__chart"><svg data-chart viewBox="0 0 300 70" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="lpg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="currentColor" stop-opacity=".35"/><stop offset="1" stop-color="currentColor" stop-opacity="0"/></linearGradient></defs><path d="M0 58 L30 50 L60 54 L90 38 L120 42 L150 26 L180 32 L210 16 L240 22 L270 8 L300 12 L300 70 L0 70Z" fill="url(#lpg)"/><path d="M0 58 L30 50 L60 54 L90 38 L120 42 L150 26 L180 32 L210 16 L240 22 L270 8 L300 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/></svg></div><div class="lp-mock__cards"><span class="is-a"><i></i><i></i></span><span class="is-b"><i></i><i></i></span><span class="is-c"><i></i><i></i></span></div>
                    </div>
                </div>
                <div class="lp-float lp-float--a">{{ ui_icon('trending-up', 18) }}<div><strong>{{ landing.stats[0].value|default('') }}</strong><small>{{ landing.stats[0].label|default('') }}</small></div></div>
                <div class="lp-float lp-float--b">{{ ui_icon('shield-check', 18) }}<div><strong>{{ landing.stats[1].value|default('') }}</strong><small>{{ landing.stats[1].label|default('') }}</small></div></div>
            {% endif %}
        </div>
    </div>
</section>

{% elseif s.key == 'stats' %}
<section class="lp-stats" aria-label="{{ landing.headings.features }}">
    <div class="lp-wrap lp-stats__grid">{% for stat in landing.stats %}<div><strong>{{ stat.value }}</strong><span>{{ stat.label }}</span></div>{% endfor %}</div>
</section>

{% elseif s.key == 'features' %}
<section class="lp-section{{ s.tint ? ' lp-section--tint' : '' }}" id="features">
    <div class="lp-wrap">
        <header class="lp-section__head"><h2>{{ landing.headings.features }}</h2><p>{{ landing.headings.features_lead }}</p></header>
        <div class="lp-features">{% for f in landing.features %}<article class="lp-card"><span class="lp-card__icon" aria-hidden="true">{{ ui_icon(f.icon, 22) }}</span><h3>{{ f.title }}</h3><p>{{ f.text }}</p></article>{% endfor %}</div>
    </div>
</section>

{% elseif s.key == 'steps' %}
<section class="lp-section{{ s.tint ? ' lp-section--tint' : '' }}" id="how">
    <div class="lp-wrap">
        <header class="lp-section__head"><h2>{{ landing.headings.steps }}</h2></header>
        <ol class="lp-steps">{% for step in landing.steps %}<li><span class="lp-steps__n">{{ loop.index }}</span><h3>{{ step.title }}</h3><p>{{ step.text }}</p></li>{% endfor %}</ol>
    </div>
</section>

{% elseif s.key == 'reviews' %}
<section class="lp-section{{ s.tint ? ' lp-section--tint' : '' }}" id="reviews">
    <div class="lp-wrap">
        <header class="lp-section__head"><h2>{{ landing.headings.reviews }}</h2></header>
        <div class="lp-reviews">{% for r in landing.reviews %}<figure class="lp-review"><span class="lp-review__stars" aria-hidden="true">{% for i in 1..5 %}{{ ui_icon('star-filled', 16) }}{% endfor %}</span><blockquote>{{ r.quote }}</blockquote><figcaption><span class="lp-avatar" aria-hidden="true">{{ r.name|first|upper }}</span><span><strong>{{ r.name }}</strong><small>{{ r.role }}</small></span></figcaption></figure>{% endfor %}</div>
    </div>
</section>

{% elseif s.key == 'faq' %}
<section class="lp-section{{ s.tint ? ' lp-section--tint' : '' }}" id="faq">
    <div class="lp-wrap lp-wrap--narrow">
        <header class="lp-section__head"><h2>{{ landing.headings.faq }}</h2></header>
        <div class="lp-faq">{% for item in landing.faq %}<details{{ loop.first ? ' open' : '' }}><summary>{{ item.q }}{{ ui_icon('chevron-down', 18) }}</summary><p>{{ item.a }}</p></details>{% endfor %}</div>
    </div>
</section>

{% elseif s.key == 'cta' %}
<section class="lp-section lp-contact" id="contact">
    <div class="lp-wrap">
        <div class="lp-cta">
            <div class="lp-cta__copy"><h2>{{ landing.cta.title }}</h2><p>{{ landing.cta.text }}</p></div>
            {% set main = landing.forms[0] %}
            {% if main.enabled %}
            <form class="lp-form" method="post" action="/contact/send" data-cw-form><input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
                <h3>{{ main.title }}</h3>
                <p>{{ main.text }}</p>
                {{ lp.form_body(main, app.request.uri, 'contact') }}
            </form>
            {% else %}
            <a class="lp-btn lp-btn--primary" href="{{ landing.hero.primary_url }}">{{ landing.cta.button }}</a>
            {% endif %}
        </div>
    </div>
</section>
{% elseif s.key starts with 'custom' %}
{% set block = landing.custom[(s.key|slice(6)) - 1] %}
<section class="lp-section lp-custom{{ s.tint ? ' lp-section--tint' : '' }}" id="{{ s.key }}">
    <div class="lp-wrap lp-custom__grid{{ block.image ? ' has-image lp-custom--' ~ block.side : '' }}">
        {% if block.image %}<div class="lp-custom__media"><img src="{{ block.image }}" alt="{{ block.title }}" width="720" height="520" loading="lazy" decoding="async"></div>{% endif %}
        <div class="lp-custom__copy">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            {% if block.text %}<p>{{ block.text|nl2br }}</p>{% endif %}
            {% if block.button and block.url %}<a class="lp-btn lp-btn--primary" href="{{ block.url }}">{{ block.button }}{{ ui_icon('arrow-right', 18) }}</a>{% endif %}
        </div>
    </div>
</section>
{% elseif s.key starts with 'form_' %}
{% set fkey = s.key|replace({'form_': ''}) %}
{% for form in landing.forms %}{% if form.key == fkey and form.enabled %}
<section class="lp-section lp-inline-form{{ s.tint ? ' lp-section--tint' : '' }}" id="form-{{ form.key }}-section">
    <div class="lp-wrap lp-wrap--narrow">
        <form class="lp-form" method="post" action="/contact/send" data-cw-form><input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
            <h3>{{ form.title }}</h3>
            <p>{{ form.text }}</p>
            {{ lp.form_body(form, app.request.uri, form.key == 'callback' ? 'callback' : 'contact') }}
        </form>
    </div>
</section>
{% endif %}{% endfor %}
{% endif %}
