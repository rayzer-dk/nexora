<span class="fx-toolbar" role="toolbar" aria-label="{{ ui_text('forum_toolbar') }}" data-fx-toolbar>
    <button type="button" data-fx-wrap="**" title="{{ ui_text('forum_tb_bold') }}" aria-label="{{ ui_text('forum_tb_bold') }}">{{ ui_icon('bold', 16) }}</button>
    <button type="button" data-fx-wrap="*" title="{{ ui_text('forum_tb_italic') }}" aria-label="{{ ui_text('forum_tb_italic') }}">{{ ui_icon('italic', 16) }}</button>
    <button type="button" data-fx-wrap="~~" title="{{ ui_text('forum_tb_strike') }}" aria-label="{{ ui_text('forum_tb_strike') }}">{{ ui_icon('strikethrough', 16) }}</button>
    <button type="button" data-fx-wrap="`" title="{{ ui_text('forum_tb_code') }}" aria-label="{{ ui_text('forum_tb_code') }}">{{ ui_icon('code', 16) }}</button>
    <button type="button" data-fx-line="> " title="{{ ui_text('forum_tb_quote') }}" aria-label="{{ ui_text('forum_tb_quote') }}">{{ ui_icon('quote', 16) }}</button>
    <button type="button" data-fx-line="- " title="{{ ui_text('forum_tb_list') }}" aria-label="{{ ui_text('forum_tb_list') }}">{{ ui_icon('list', 16) }}</button>
    <button type="button" data-fx-link title="{{ ui_text('forum_tb_link') }}" aria-label="{{ ui_text('forum_tb_link') }}">{{ ui_icon('link', 16) }}</button>
