{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="forum-shell shell">
    <nav class="forum-breadcrumbs" aria-label="{{ ui_text('navigation') }}"><a href="/forum">{{ ui_text('forum') }}</a><span>›</span><span>{{ ui_text('forum_profile') }}</span></nav>
    <header class="forum-hero forum-hero--compact"><div><span class="forum-kicker">{{ ui_text('community') }}</span><h1>{{ ui_text('forum_profile') }}</h1><p>{{ ui_text('forum_profile_privacy') }}</p></div></header>
    {% for message in app.flashes('success') %}<div class="store-notice is-success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="store-notice is-error">{{ message }}</div>{% endfor %}
    <form method="post" class="account-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_profile') }}">
        <label>{{ ui_text('forum_nickname') }}<input type="text" name="nickname" value="{{ profile.nickname }}" required minlength="3" maxlength="64"></label>
        <label>{{ ui_text('forum_bio') }}<textarea name="bio" maxlength="500" rows="5">{{ profile.bio }}</textarea></label>
        <label><input type="checkbox" name="show_email" value="1" {{ profile.show_email ? 'checked' : '' }}> {{ ui_text('forum_show_email') }}</label>
        <label><input type="checkbox" name="show_phone" value="1" {{ profile.show_phone ? 'checked' : '' }}> {{ ui_text('forum_show_phone') }}</label>
        <label><input type="checkbox" name="allow_private_messages" value="1" {{ profile.allow_private_messages ? 'checked' : '' }}> {{ ui_text('forum_allow_private_messages') }}</label>
        <button class="forum-primary-button" type="submit">{{ ui_text('save_profile') }}</button>
    </form>
</section>
{% endblock %}
