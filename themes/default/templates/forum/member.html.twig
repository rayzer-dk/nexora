{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="forum-shell shell">
    <nav class="forum-breadcrumbs" aria-label="{{ ui_text('navigation') }}"><a href="/forum">{{ ui_text('forum') }}</a><span class="breadcrumbs__sep" aria-hidden="true">{{ ui_icon('chevron-right', 14) }}</span><span>{{ member.nickname }}</span></nav>
    <header class="forum-hero forum-hero--compact">
        <div>
            <span class="forum-avatar" aria-hidden="true">{{ member.nickname|first|upper }}</span>
            <h1>{{ member.nickname }}</h1>
            <p>{{ ui_text('forum_member_since')|replace({'%date%': member.created_at}) }}</p>
            {% if member.bio %}<p>{{ member.bio }}</p>{% endif %}
            {% if member.email %}<p>{{ ui_text('forum_public_email') }}: {{ member.email }}</p>{% endif %}
            {% if member.phone_e164 %}<p>{{ ui_text('forum_public_phone') }}: {{ member.phone_e164 }}</p>{% endif %}
        </div>
        <div class="forum-member-stats">
            <span><b>{{ member.stats.topics }}</b><small>{{ ui_text('topics_count_label') }}</small></span>
            <span><b>{{ member.stats.posts }}</b><small>{{ ui_text('messages_count_label') }}</small></span>
            <span><b>{{ member.stats.likes }}</b><small>{{ ui_text('forum_likes') }}</small></span>
        </div>
    </header>

    {% if can_message %}
        <details class="forum-compose-inline">
            <summary class="button button--primary">{{ ui_text('forum_private_message') }}</summary>
            <form method="post" action="{{ path('storefront_forum_message_start',{id:member.customer_id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_message_start_' ~ member.customer_id) }}">
                <textarea name="body" required minlength="2" maxlength="5000" rows="5" placeholder="{{ ui_text('forum_private_message_placeholder') }}"></textarea>
                <button class="button button--primary" type="submit">{{ ui_text('forum_send_private_message') }}</button>
            </form>
        </details>
    {% endif %}

    <div class="forum-topic-list">
        {% for item in activity %}
            <a class="forum-topic-row" href="{{ path('storefront_forum_topic',{id:item.topic_id,slug:item.slug}) }}#post-{{ item.post_id }}">
                <span class="forum-topic-row__status badge">{{ item.board_name }}</span>
                <span class="forum-topic-row__body"><strong>{{ item.title }}</strong><small>{{ item.published_at|default(item.created_at) }}</small></span>
                <span class="forum-topic-row__arrow" aria-hidden="true">{{ ui_icon('chevron-right', 20) }}</span>
            </a>
        {% else %}
            <div class="forum-empty"><h2>{{ ui_text('forum_no_activity') }}</h2></div>
        {% endfor %}
    </div>
</section>
{% endblock %}
