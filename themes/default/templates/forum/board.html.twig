{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="fx shell">
    <nav class="fx-crumbs" aria-label="{{ ui_text('navigation') }}"><a href="/forum">{{ ui_text('forum') }}</a>{% if board.parent_slug|default('') %}<span aria-hidden="true">{{ ui_icon('chevron-right', 14) }}</span><a href="{{ path('storefront_forum_board',{slug:board.parent_slug}) }}">{{ board.parent_name }}</a>{% endif %}<span aria-hidden="true">{{ ui_icon('chevron-right', 14) }}</span><span>{{ board.name }}</span></nav>
    <header class="fx-head">
        <div><span class="fx-eyebrow">{{ ui_text('forum_section') }}</span><h1>{{ board.name }}</h1>{% if board.description %}<p>{{ board.description }}</p>{% endif %}</div>
        <div class="fx-head__actions">
            <form method="get" action="{{ path('storefront_forum_search') }}" class="fx-search"><input type="search" name="q" minlength="2" placeholder="{{ ui_text('forum_search_placeholder') }}" aria-label="{{ ui_text('forum_search') }}"><button class="button button--primary" type="submit">{{ ui_icon('search', 16) }}<span>{{ ui_text('forum_search') }}</span></button></form>
            {% if app.user %}<button class="button button--primary" type="button" data-forum-compose-open>{{ ui_icon('plus', 16) }}<span>{{ ui_text('create_topic') }}</span></button>{% else %}<a class="button button--primary" href="{{ path('customer_login') }}">{{ ui_text('forum_sign_in_post') }}</a>{% endif %}
        </div>
    </header>

    {% for message in app.flashes('success') %}<div class="store-notice is-success" data-store-toast-source>{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="store-notice is-error" data-store-toast-source>{{ message }}</div>{% endfor %}

    {% if children %}
        <div class="fx-board__kids fx-board__kids--box"><span>{{ ui_text('forum_subforums') }}:</span>{% for kid in children %}<a href="{{ path('storefront_forum_board',{slug:kid.slug}) }}">{{ ui_icon('corner-down-right', 12) }}{{ kid.name }} <small>{{ kid.topic_count }}</small></a>{% endfor %}</div>
    {% endif %}

    <div class="fx-bar">
        <nav class="fx-sort" aria-label="{{ ui_text('forum_sort') }}">
            {% for key, label in {activity: ui_text('forum_sort_activity'), new: ui_text('forum_sort_new'), replies: ui_text('forum_sort_replies'), views: ui_text('forum_sort_views')} %}
                <a href="{{ path('storefront_forum_board',{slug:board.slug}) }}?sort={{ key }}"{% if sort == key %} class="is-active" aria-current="true"{% endif %}>{{ label }}</a>
            {% endfor %}
        </nav>
        {% if app.user and unread_count|default(0) > 0 %}<a class="fx-muted" href="{{ path('storefront_forum_following') }}">{{ ui_icon('star', 14) }} {{ ui_text('forum_favorites') }} · {{ unread_count }}</a>{% endif %}
    </div>

    <div class="fx-topics">
        {% for topic in topics %}
            {% include '@storefront/forum/_topic_row.html.twig' with {topic: topic} only %}
        {% else %}
            <div class="fx-empty"><h2>{{ ui_text('no_topics_yet') }}</h2><p>{{ ui_text('create_first_topic_text') }}</p></div>
        {% endfor %}
    </div>
</section>

{% if app.user %}
<div class="modal" data-forum-compose hidden aria-hidden="true">
    <div class="modal__backdrop" data-forum-compose-close></div>
    <section class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="forum-compose-title">
        <button class="modal__close button button--ghost button--icon" type="button" data-forum-compose-close aria-label="{{ ui_text('close') }}" title="{{ ui_text('close') }}">{{ ui_icon('x', 20) }}</button>
        <span class="eyebrow">{{ ui_text('new_topic') }}</span>
        <h2 id="forum-compose-title">{{ ui_text('create_topic_in')|replace({'%board%': board.name}) }}</h2>
        <p>{{ ui_text('forum_posting_as')|replace({'%name%': forum_nickname}) }} {{ ui_text('topic_moderation_text') }}</p>
        <form method="post" enctype="multipart/form-data" action="{{ path('storefront_forum_topic_create',{slug:board.slug}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ board.id) }}">
            <input type="hidden" name="rendered_at" value="{{ form_rendered_at }}">
            <label class="forum-honeypot" aria-hidden="true">{{ ui_text('company') }}<input name="company" tabindex="-1" autocomplete="off"></label>
            <label><span>{{ ui_text('topic_title') }}</span><input name="title" required maxlength="240"></label>
            <label class="fx-editor"><span>{{ ui_text('message') }}</span>{% include '@storefront/forum/_toolbar.html.twig' %}<textarea name="body" required minlength="3" maxlength="20000" rows="5"></textarea></label>
            <small class="fx-muted">{{ ui_text('forum_format_hint') }}</small>
            <div class="fx-extras"><label class="fx-file"><span>{{ ui_text('forum_attach_images') }}</span><input type="file" name="images[]" accept="image/jpeg,image/png,image/webp,image/gif" multiple></label>
            <details class="fx-pop fx-pollform"><summary class="fx-act">{{ ui_icon('chart-column', 14) }}{{ ui_text('forum_poll_add') }}</summary>
                <label><span>{{ ui_text('forum_poll_question') }}</span><input name="poll_question" maxlength="240"></label>
                <label><span>{{ ui_text('forum_poll_options') }}</span><textarea name="poll_options" rows="4"></textarea></label>
                <label class="fx-check"><input type="checkbox" name="poll_multiple" value="1"> {{ ui_text('forum_poll_multiple') }}</label>
            </details></div>
            {% include '@storefront/components/captcha.html.twig' with {form:'forum'} only %}<div class="modal__actions"><button class="button button--secondary" type="button" data-forum-compose-close>{{ ui_text('cancel') }}</button><button class="button button--primary" type="submit">{{ ui_text('send_for_moderation') }}</button></div>
        </form>
    </section>
</div>
{% endif %}
{% endblock %}
