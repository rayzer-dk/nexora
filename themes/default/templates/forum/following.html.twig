{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="forum-shell shell">
    <nav class="forum-breadcrumbs" aria-label="{{ ui_text('navigation') }}"><a href="/forum">{{ ui_text('forum') }}</a><span class="breadcrumbs__sep" aria-hidden="true">{{ ui_icon('chevron-right', 14) }}</span><span>{{ ui_text('forum_following') }}</span></nav>
    <header class="forum-hero forum-hero--compact"><div><span class="eyebrow">Community</span><h1>{{ ui_text('forum_following') }}</h1><p>{{ ui_text('forum_following_intro') }}</p></div></header>
    <div class="forum-topic-list">
        {% for topic in topics %}
            <a class="forum-topic-row" href="{{ path('storefront_forum_topic',{id:topic.id,slug:topic.slug}) }}">
                <span class="forum-topic-row__status badge">{{ topic.board_name }}</span>
                <span class="forum-topic-row__body"><strong>{{ topic.title }}</strong><small>{{ topic.last_post_at|default(topic.followed_at) }}</small></span>
                <span class="forum-topic-row__arrow" aria-hidden="true">{{ ui_icon('chevron-right', 20) }}</span>
            </a>
        {% else %}
            <div class="forum-empty"><h2>{{ ui_text('forum_no_followed_topics') }}</h2></div>
        {% endfor %}
    </div>
</section>
{% endblock %}
