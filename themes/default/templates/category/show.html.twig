{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="catalog-page shell">
    <nav class="breadcrumbs" aria-label="{{ ui_text('breadcrumbs') }}"><a href="/">{{ ui_text('home') }}</a><span>›</span><a href="/catalog">{{ ui_text('catalog') }}</a><span>›</span><span aria-current="page">{{ category.name }}</span></nav>
    <header class="catalog-heading"><div><p class="eyebrow">{{ ui_text('category') }}</p><h1>{{ category.name }}</h1>{% if category.description %}<div class="category-description"><p>{{ category.description }}</p></div>{% endif %}</div><p>{{ ui_text('products_count')|replace({'%count%': products.total}) }}</p></header>
    {% include '@storefront/components/catalog_filters.html.twig' %}
    {% include '@storefront/extension/slot.html.twig' with {slot:'category.before_grid'} only %}
    {% if products.items %}<div class="product-grid">{% for product in products.items %}{% include '@storefront/components/product_card.html.twig' with {product:product} only %}{% endfor %}</div>{% else %}<div class="empty-state"><h2>{{ ui_text('no_products_conditions') }}</h2><p>{{ ui_text('change_or_reset_filters') }}</p></div>{% endif %}
    {% include '@storefront/extension/slot.html.twig' with {slot:'category.after_grid'} only %}
    {% if products.pages > 1 %}<nav class="pager" aria-label="{{ ui_text('pagination') }}">{% if products.page > 1 %}<a href="?{% if catalog_query_base %}{{ catalog_query_base }}&amp;{% endif %}page={{ products.page-1 }}">{{ ui_text('back') }}</a>{% endif %}<span>{{ ui_text('page_of')|replace({'%page%': products.page, '%pages%': products.pages}) }}</span>{% if products.page < products.pages %}<a href="?{% if catalog_query_base %}{{ catalog_query_base }}&amp;{% endif %}page={{ products.page+1 }}">{{ ui_text('next') }}</a>{% endif %}</nav>{% endif %}
</section>
{% endblock %}
