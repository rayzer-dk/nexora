{% extends '@storefront/email/base.html.twig' %}
{% block content %}
<p style="margin:0 0 8px;color:#0b63f6;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em">{{ ui_text('order_received') }}</p>
<h1 style="margin:0 0 14px;font-size:28px;line-height:1.2;color:#101828">{{ ui_text('thank_you') }}{% if customer_name is defined and customer_name %}, {{ customer_name }}{% endif %}</h1>
{% if custom_body is defined and custom_body %}<p style="margin:0 0 22px;color:#475467;font-size:16px;line-height:1.65">{{ custom_body|nl2br }}</p>{% else %}<p style="margin:0 0 22px;color:#475467;font-size:16px;line-height:1.65">{{ ui_text('order_received_prefix') }} <strong>{{ order_number|default('') }}</strong>. {{ ui_text('order_received_suffix') }}</p>{% endif %}
{% if items is defined and items %}<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:18px 0 8px">{% for item in items %}<tr><td style="padding:10px 0;border-bottom:1px solid #e4e7ec"><strong>{{ item.name }}</strong><br><span style="color:#667085;font-size:13px">{{ item.sku }} · {{ item.quantity }} {{ item.unit_code }}</span></td><td style="padding:10px 0;border-bottom:1px solid #e4e7ec;text-align:right;white-space:nowrap">{{ (item.line_total_minor / 100)|number_format(2, ',', ' ') }} {{ currency }}</td></tr>{% endfor %}</table>{% endif %}
{% if discount_minor is defined and discount_minor > 0 %}<p style="margin:14px 0 0;color:#15803d"><strong>{{ ui_text('discount') }}: −{{ (discount_minor / 100)|number_format(2, ',', ' ') }} {{ currency }}</strong></p>{% endif %}
{% if fulfillment_label is defined and fulfillment_label %}<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f8fafc;border-radius:12px"><tr><td style="padding:16px 18px;color:#344054"><strong>{{ ui_text('delivery') }}</strong><br>{{ fulfillment_label }}</td></tr></table>{% endif %}
{% if total_minor is defined and currency is defined %}<p style="margin:22px 0 0;font-size:20px"><strong>{{ ui_text('total') }}: {{ (total_minor / 100)|number_format(2, ',', ' ') }} {{ currency }}</strong></p>{% elseif total is defined %}<p style="margin:22px 0 0;font-size:20px"><strong>{{ ui_text('total') }}: {{ total }}</strong></p>{% endif %}
{% endblock %}
