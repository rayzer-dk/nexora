<!doctype html>
<html lang="{{ locale|default('uk-UA') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{ notification_subject }}</title>
</head>
{% set mail = email_design() %}
<body style="margin:0;background:{{ mail.page_bg }};font-family:Arial,sans-serif;color:{{ mail.text }}">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:{{ mail.page_bg }};padding:28px 12px">
<tr><td align="center">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px;background:{{ mail.card_bg }};border-radius:18px;overflow:hidden;border:1px solid #e6ebf2">
<tr><td style="padding:24px 28px;background:{{ mail.header_bg }};color:{{ mail.header_text }}"><div style="font-size:20px;font-weight:700">{{ store_name|default('Nexora Commerce') }}</div></td></tr>
<tr><td style="padding:30px 28px">{% block content %}{% endblock %}</td></tr>
<tr><td style="padding:18px 28px;border-top:1px solid #edf0f5;color:#667085;font-size:12px;line-height:1.5">{{ footer_text|default(mail.footer ?: ui_text('service_email_footer')) }}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
