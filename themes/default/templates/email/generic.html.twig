{% extends '@storefront/email/base.html.twig' %}
{% block content %}
<h1 style="margin:0 0 14px;font-size:26px;line-height:1.25;color:#101828">{{ notification_subject }}</h1>
<p style="margin:0;color:#475467;font-size:16px;line-height:1.65">{{ notification_text }}</p>
{% if action_url is defined and action_url %}<p style="margin:26px 0 0"><a href="{{ action_url }}" style="display:inline-block;background:#0b63f6;color:#fff;text-decoration:none;font-weight:700;padding:12px 18px;border-radius:10px">{{ action_label|default(ui_text('open')) }}</a></p>{% endif %}
{% endblock %}
