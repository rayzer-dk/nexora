{% extends '@storefront/email/base.html.twig' %}
{% block content %}
<h1 style="margin:0 0 14px;font-size:26px;line-height:1.25;color:#101828">{{ notification_subject }}</h1>
{% if custom_html is defined and custom_html %}<div style="color:#475467;font-size:16px;line-height:1.65">{{ custom_html|raw }}</div>{% else %}<p style="margin:0;color:#475467;font-size:16px;line-height:1.65">{{ notification_text }}</p>{% endif %}
{% if items is defined and items %}<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:22px 0 8px">{% for item in items %}<tr>{% if item.image_url|default('') %}<td style="padding:10px 12px 10px 0;border-bottom:1px solid #e4e7ec;width:64px"><img src="{{ item.image_url }}" alt="" width="64" height="64" style="display:block;width:64px;height:64px;object-fit:cover;border-radius:8px;border:1px solid #e4e7ec"></td>{% endif %}<td style="padding:10px 0;border-bottom:1px solid #e4e7ec;color:#101828;font-size:15px;line-height:1.4"><strong>{{ item.name }}</strong><br><span style="color:#667085">{{ item.quantity * 1 }} × {{ (item.unit_price_minor / 100)|number_format(2, ',', ' ') }} {{ currency|default('') }}</span></td><td style="padding:10px 0 10px 12px;border-bottom:1px solid #e4e7ec;text-align:right;white-space:nowrap;color:#101828;font-weight:700">{{ (item.line_total_minor / 100)|number_format(2, ',', ' ') }} {{ currency|default('') }}</td></tr>{% endfor %}</table>{% if total_minor is defined and total_minor > 0 %}<p style="margin:12px 0 0;font-size:18px;text-align:right"><strong>{{ ui_text('total') }}: {{ (total_minor / 100)|number_format(2, ',', ' ') }} {{ currency|default('') }}</strong></p>{% endif %}{% endif %}
{% if coupon_code is defined and coupon_code %}<p style="margin:18px 0 0;padding:12px 14px;background:#f8fafc;border:1px dashed #98a2b3;border-radius:10px;color:#344054">{{ ui_text('promo_code') }}: <strong>{{ coupon_code }}</strong></p>{% endif %}
{% if action_url is defined and action_url %}<p style="margin:26px 0 0"><a href="{{ action_url }}" style="display:inline-block;background:{{ email_design().accent }};color:#fff;text-decoration:none;font-weight:700;padding:12px 18px;border-radius:10px">{{ action_label|default(ui_text('open')) }}</a></p>{% endif %}
{% endblock %}
