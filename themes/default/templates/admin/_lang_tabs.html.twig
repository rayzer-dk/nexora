{#
  Content-language tab bar shared by every multilingual edit form.
  tabs: list of {code, name, is_default, current, done, href?} - with href the tab is a link (server-side per-language form),
  without it the tab is a button that switches an in-page panel [data-lang-panel="lang-<code>"].
  options: {add_url, hint}.
#}
{% macro bar(tabs, options = {}) %}
<nav class="lang-tabs" aria-label="{{ ui_text('admin.lang_tabs.label') }}" data-lang-tabs data-lang-overwrite="{{ ui_text('admin.lang_tabs.copy_overwrite')|e('html_attr') }}">
  <ul class="lang-tabs__list">
    {% for tab in tabs %}
      <li class="lang-tabs__item{{ tab.current ? ' is-current' : '' }}{{ tab.done ? ' is-done' : ' is-missing' }}" data-lang-item="{{ tab.code }}">
        {% if tab.href is defined and tab.href %}
          <a class="lang-tabs__tab" href="{{ tab.href }}"{{ tab.current ? ' aria-current="page"' : '' }} lang="{{ tab.code }}">
        {% else %}
          <button type="button" class="lang-tabs__tab" data-lang-tab="lang-{{ tab.code }}" aria-pressed="{{ tab.current ? 'true' : 'false' }}" lang="{{ tab.code }}">
        {% endif %}
          {% if ui_flag(tab.code) %}<span class="lang-tabs__flag">{{ ui_flag(tab.code) }}</span>{% endif %}
          <span class="lang-tabs__name">{{ tab.name|split(' (')|first }}</span>
          {% if tab.is_default %}<span class="lang-tabs__default">{{ ui_text('admin.lang_tabs.default') }}</span>{% endif %}
          <span class="lang-tabs__mark" data-lang-mark title="{{ (tab.done ? ui_text('admin.lang_tabs.done') : ui_text('admin.lang_tabs.missing'))|e('html_attr') }}" aria-label="{{ (tab.done ? ui_text('admin.lang_tabs.done') : ui_text('admin.lang_tabs.missing'))|e('html_attr') }}">{{ tab.done ? '✓' : '•' }}</span>
        {% if tab.href is defined and tab.href %}</a>{% else %}</button>{% endif %}
      </li>
    {% endfor %}
  </ul>
  <a class="lang-tabs__add" href="{{ options.add_url|default(path('admin_system_localization') ~ '#locales') }}" title="{{ ui_text('admin.lang_tabs.add_hint')|e('html_attr') }}">{{ ui_icon('plus', 14) }}<span>{{ ui_text('admin.lang_tabs.add') }}</span></a>
</nav>
{% endmacro %}

{#
  One language bar for a whole edit form (product, category): the tabs switch every [data-lang-panel] of the form at once.
  Fields that exist per language carry data-lang-field="<field>" so that "copy" and "translate" find the pair in the
  source language. source: the locale code of the main (untranslated) fields.
#}
{% macro form_bar(tabs, source, hint) %}
{% set source_name = source %}{% for tab in tabs %}{% if tab.code == source %}{% set source_name = tab.name|split(' (')|first %}{% endif %}{% endfor %}
<div class="lang-form-bar">
  {{ _self.bar(tabs) }}
  <div class="lang-form-bar__actions" data-lang-actions data-lang-source="lang-{{ source }}" data-source-locale="{{ source }}" data-ai-token="{{ csrf_token('admin_ai') }}" data-msg-working="{{ ui_text('admin.ai.generating')|e('html_attr') }}" data-msg-done="{{ ui_text('admin.ai.draft_inserted')|e('html_attr') }}" data-msg-failed="{{ ui_text('admin.ai.draft_failed')|e('html_attr') }}" data-msg-nothing="{{ ui_text('admin.ai.nothing_to_translate')|e('html_attr') }}" data-msg-overwrite="{{ ui_text('admin.ai.overwrite_confirm')|e('html_attr') }}" hidden>
    <button type="button" class="admin-button" data-lang-copy>{{ ui_icon('copy', 16) }}<span>{{ ui_text('admin.lang_tabs.copy_from', {language: source_name}) }}</span></button>
    {% if ai_providers() %}{% if ai_providers()|length > 1 %}<select data-ai-provider aria-label="{{ ui_text('admin.ai.provider')|e('html_attr') }}">{% for pr in ai_providers() %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endfor %}</select>{% else %}<input type="hidden" data-ai-provider value="{{ ai_providers()|first.code }}">{% endif %}<button type="button" class="admin-button" data-lang-translate>{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.translations.translate') }}</span></button>{% endif %}
    <small class="lang-form-bar__status" data-lang-status role="status"></small>
  </div>
  {% if hint %}<p class="admin-help">{{ hint }}</p>{% endif %}
</div>
{% endmacro %}
