{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{% import '@storefront/admin/_pager.html.twig' as pager %}
{{ shell.start(ui_text('admin.media.library.mediateka'),'media','media') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.media.library.oformlennia_mediateka') }}</span></nav><h1>{{ ui_text('admin.media.library.mediateka') }}</h1><p>{{ ui_text('admin.media.library.yedyne_skhovyshche_zobrazhen_i_video_dlia_katalo') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
{% set cur = folder is null ? 'all' : (folder == 0 ? 'none' : folder) %}
<section class="media-actions admin-panel">
 <form method="post" enctype="multipart/form-data" action="{{ path('admin_media_upload') }}" data-media-drop class="media-upload-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('media_upload') }}">
  <input type="hidden" name="folder_id" value="{{ folder and folder > 0 ? folder : '' }}">
  <label class="media-dropzone"><strong>{{ ui_icon('image-plus', 20) }} {{ ui_text('admin.media.library.peretiahnit_media_siudy') }}</strong><span>{{ ui_text('admin.media.upload.from_pc') }} · {{ ui_text('admin.media.library.jpeg_png_webp_avif_do_20_mb_mp4_webm_do_100_mb') }}</span><input type="file" name="files[]" accept="image/jpeg,image/png,image/webp,image/avif,image/heic,image/heif,.heic,.heif,video/mp4,video/webm" multiple data-media-autosubmit><span class="media-dropzone__pick">{{ ui_icon('upload', 16) }} {{ ui_text('admin.media.library.zavantazhyty') }}</span><progress data-media-upload-progress max="100" value="0" hidden></progress><small data-media-upload-status></small></label>
 
 </form>
</section>
<div class="media-layout">
 <aside class="admin-panel media-folders" aria-label="{{ ui_text('admin.media.library.papka') }}">
  <h2>{{ ui_text('admin.media.folders.title') }}</h2>
  <nav>
   <a class="media-folder{{ cur == 'all' ? ' is-active' : '' }}" href="{{ path('admin_media_library') }}">{{ ui_icon('folder-open', 16) }}<span>{{ ui_text('admin.media.library.usi_papky') }}</span><em>{{ counts.all }}</em></a>
   <a class="media-folder{{ cur == 'none' ? ' is-active' : '' }}" href="{{ path('admin_media_library', {folder: 'none'}) }}">{{ ui_icon('image', 16) }}<span>{{ ui_text('admin.media.library.bez_papky') }}</span><em>{{ counts.unfiled }}</em></a>
   {% for f in folders %}<div class="media-folder-row"><a class="media-folder{{ cur == f.id ? ' is-active' : '' }}" href="{{ path('admin_media_library', {folder: f.id}) }}">{{ ui_icon('folder', 16) }}<span>{{ f.name }}</span><em>{{ counts.folders[f.id]|default(0) }}</em></a><form method="post" action="{{ path('admin_media_folder_delete', {folderId: f.id}) }}" data-confirm="{{ ui_text('admin.media.folder.confirm_delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('media_folder_delete_' ~ f.id) }}"><button class="admin-icon-button is-sm is-danger" type="submit" title="{{ ui_text('admin.media.folder.delete') }}" aria-label="{{ ui_text('admin.media.folder.delete') }}">{{ ui_icon('trash-2', 14) }}</button></form></div>{% endfor %}
  </nav>
  <form method="post" action="{{ path('admin_media_folder_create') }}" class="media-folder-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('media_folder_create') }}"><input type="text" name="name" required maxlength="190" placeholder="{{ ui_text('admin.media.library.nova_papka') }}" aria-label="{{ ui_text('admin.media.library.nova_papka') }}"><button class="admin-button" type="submit">{{ ui_icon('folder-plus', 16) }}<span class="visually-hidden">{{ ui_text('admin.media.library.stvoryty_papku') }}</span></button></form>
 </aside>
 <div class="media-main">
  <section class="admin-panel media-toolbar">
   <form method="get" class="media-search"><input type="hidden" name="folder" value="{{ cur == 'all' ? '' : cur }}"><input type="search" name="q" value="{{ query }}" placeholder="{{ ui_text('admin.media.library.poshuk_za_nazvoiu_alt_tehom_abo_shliakhom') }}"><button class="admin-button">{{ ui_text('admin.media.library.znaity') }}</button></form>
   <form method="post" id="media-bulk-form" class="media-bulk" data-media-bulk><input type="hidden" name="_csrf_token" value="{{ csrf_token('media_bulk') }}"><input type="hidden" name="folder_back" value="{{ cur == 'all' ? '' : cur }}">
    <label class="admin-check"><input type="checkbox" data-media-check-all> {{ ui_text('admin.media.bulk.select_all') }}</label>
    <span class="admin-help" data-media-selected>{{ ui_text('admin.media.bulk.none') }}</span>
    <select name="folder_id" aria-label="{{ ui_text('admin.media.bulk.move_to') }}"><option value="">{{ ui_text('admin.media.library.bez_papky') }}</option>{% for f in folders %}<option value="{{ f.id }}">{{ f.name }}</option>{% endfor %}</select>
    <button class="admin-button" type="submit" formaction="{{ path('admin_media_bulk_move') }}" disabled data-media-bulk-btn>{{ ui_icon('folder-open', 16) }} {{ ui_text('admin.media.bulk.move') }}</button>
    <button class="admin-button is-danger" type="submit" formaction="{{ path('admin_media_bulk_delete') }}" disabled data-media-bulk-btn data-confirm="{{ ui_text('admin.media.bulk.confirm_delete') }}">{{ ui_icon('trash-2', 16) }} {{ ui_text('admin.media.bulk.delete') }}</button>
   </form>
  </section>
  <section class="media-grid">
{% for item in result.items %}<article class="media-card"><label class="media-card__check" title="{{ ui_text('admin.media.bulk.select') }}"><input type="checkbox" name="ids[]" value="{{ item.id }}" data-media-check form="media-bulk-form" aria-label="{{ ui_text('admin.media.bulk.select') }}"></label><button class="media-thumb" type="button" data-media-edit="{{ item.id }}">{% if item.mime_type starts with 'video/' %}<video src="{{ item.url }}" muted preload="metadata" playsinline></video><span class="media-video-badge">VIDEO</span>{% else %}<img src="{{ item.url }}" alt="{{ item.alt_text }}" loading="lazy">{% endif %}</button><div class="media-card__body"><strong title="{{ item.title ?: item.storage_key }}">{{ item.title ?: item.storage_key|split('/')|last }}</strong><small>{% if item.mime_type starts with 'video/' %}{{ item.mime_type|replace({'video/':''})|upper }}{% else %}{{ item.width }}×{{ item.height }}{% endif %} · {{ (item.bytes/1024)|round }} KB</small><button class="admin-button" type="button" data-media-edit="{{ item.id }}">{{ ui_text('admin.media.library.metadani') }}</button></div>
<div class="media-editor" data-media-editor="{{ item.id }}" hidden><form method="post" action="{{ path('admin_media_metadata',{assetId:item.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('media_metadata_' ~ item.id) }}"><label>{{ ui_text('admin.media.library.nazva') }}<input type="text" name="title" value="{{ item.title }}" maxlength="500"></label><label>{{ ui_text('ui.admin.media.library.alt') }}<input type="text" name="alt_text" value="{{ item.alt_text }}" maxlength="500"></label><label>{{ ui_text('admin.media.library.papka') }}<select name="folder_id"><option value="">{{ ui_text('admin.media.library.bez_papky') }}</option>{% for f in folders %}<option value="{{ f.id }}" {% if item.folder_id==f.id %}selected{% endif %}>{{ f.name }}</option>{% endfor %}</select></label><label>{{ ui_text('admin.media.library.tehy') }}<input type="text" name="tags" value="{{ item.tags|join(', ') }}"></label><div class="media-focal"><label>{{ ui_text('ui.admin.media.library.focal_x') }}<input type="number" min="0" max="100" step="1" name="focal_x" value="{{ item.focal_x }}"></label><label>{{ ui_text('ui.admin.media.library.focal_y') }}<input type="number" min="0" max="100" step="1" name="focal_y" value="{{ item.focal_y }}"></label></div><button class="admin-button is-primary">{{ ui_text('admin.media.library.zberehty') }}</button></form><form method="post" action="{{ path('admin_media_delete',{assetId:item.id}) }}" data-confirm="{{ ui_text('admin.media.library.return_confirm_vydalyty_fail_vykorystovuvanyi_fa') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('media_delete_' ~ item.id) }}"><button class="admin-button is-danger" type="submit">{{ ui_text('admin.media.library.bezpechno_vydalyty') }}</button></form></div></article>{% else %}<div class="admin-panel"><p>{{ ui_text('admin.media.library.failiv_za_zadanymy_umovamy_ne_znaideno') }}</p></div>{% endfor %}
  </section>
  {{ pager.render(result.page, result.total, result.limit) }}
 </div>
</div>
<details class="admin-panel media-processing-settings"><summary>{{ ui_text('admin.media.library.image_processing') }}</summary><div class="admin-panel__header"><div><small>{{ ui_text('admin.media.library.processing') }}</small><h2>{{ ui_text('admin.media.library.image_processing') }}</h2></div><span class="admin-help">{{ ui_text('admin.media.library.processing_help') }}</span></div><form method="post" action="{{ path('admin_media_settings') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('media_settings') }}"><label>{{ ui_text('admin.media.library.output_format') }}<select name="format"><option value="original" {% if processing.format=='original' %}selected{% endif %}>{{ ui_text('admin.media.library.format_original') }}</option><option value="jpeg" {% if processing.format=='jpeg' %}selected{% endif %}>JPEG</option><option value="png" {% if processing.format=='png' %}selected{% endif %}>PNG</option><option value="webp" {% if processing.format=='webp' %}selected{% endif %}>WebP</option><option value="avif" {% if processing.format=='avif' %}selected{% endif %}>AVIF</option></select></label><label>{{ ui_text('admin.media.library.quality') }}<input type="number" name="quality" min="35" max="95" value="{{ processing.quality }}"><small>{{ ui_text('admin.media.library.quality_help') }}</small></label><div class="is-wide"><strong>{{ ui_text('admin.media.library.generated_sizes') }}</strong><div class="admin-check-grid">{% for width in [320,640,960,1280,1920] %}<label><input type="checkbox" name="widths[]" value="{{ width }}" {% if width in processing.widths %}checked{% endif %}> {{ width }} px</label>{% endfor %}</div></div><label class="admin-check is-wide"><input type="checkbox" name="include_original" value="1" {% if processing.include_original %}checked{% endif %}> {{ ui_text('admin.media.library.keep_original_size') }}</label><div class="is-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.media.library.save_processing') }}</button></div></form></details>
{{ shell.end() }}
