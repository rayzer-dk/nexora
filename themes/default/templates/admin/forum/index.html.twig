{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.forum.index.forum'),'forum') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">Nexora Commerce · v{{ platform_version }}</span></nav><h1>{{ ui_text('admin.forum.index.forum_i_moderatsiia') }}</h1><p>{{ ui_text('admin.forum.index.forum_izolovanyi_vid_iadra_mahazynu_novi_publich') }}</p></div><a class="admin-button is-primary" href="/forum" target="_blank" rel="noopener">{{ ui_text('admin.forum.index.vidkryty_forum') }}</a></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}

<div data-tabs="forum-index">
<section class="admin-panel" data-tab="t1">
    <div class="admin-panel__header"><div><small>{{ ui_text('admin.forum.index.struktura') }}</small><h2>{{ ui_text('admin.forum.index.rozdily_forumu') }}</h2></div><span class="admin-help">{{ ui_text('admin.forum.index.mozhna_dodavaty_bez_perezavantazhennia_systemy') }}</span></div>
    <form method="post" action="{{ path('admin_forum_board_create') }}" class="admin-inline-form" data-dirty-guard>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_board_create') }}">
        <label><span>{{ ui_text('admin.forum.index.nazva') }}</span><input name="name" required maxlength="190" placeholder="{{ ui_text('admin.forum.index.zahalni_obhovorennia') }}"></label>
        <label><span>URL</span><input name="slug" maxlength="160" placeholder="{{ ui_text('ui.admin.forum.index.general')|e('html_attr') }}"></label>
        <label class="is-wide"><span>{{ ui_text('admin.forum.index.opys') }}</span><input name="description" maxlength="1000" placeholder="{{ ui_text('admin.forum.index.korotko_pro_tematyku_rozdilu') }}"></label>
        <label><span>{{ ui_text('admin.forum.board.parent') }}</span><select name="parent_id"><option value="0">{{ ui_text('admin.forum.board.top_level') }}</option>{% for opt in queue.boards|default([])|filter(o => not o.parent_id) %}<option value="{{ opt.id }}">{{ opt.name }}</option>{% endfor %}</select></label>
        <label><span>{{ ui_text('admin.forum.index.poriadok') }}</span><input name="sort_order" type="number" value="0"></label>
        <button type="submit">{{ ui_text('admin.forum.index.dodaty_rozdil') }}</button>
    </form>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.rozdil') }}</th><th>URL</th><th>{{ ui_text('admin.forum.board.topics') }}</th><th>{{ ui_text('admin.forum.index.status') }}</th><th>{{ ui_text('admin.forum.index.poriadok') }}</th><th class="is-actions"></th></tr></thead><tbody>{% for board in queue.boards %}<tr><td><strong>{{ board.name }}</strong><small class="admin-cell-sub">{{ board.description }}</small></td><td>/forum/{{ board.slug }}</td><td>{{ board.topic_count }}</td><td>{{ status_badge(board.status) }}</td><td>{{ board.sort_order }}</td><td class="is-actions"><details class="admin-collapse"><summary>{{ ui_icon('pencil', 14) }}</summary>
<form method="post" action="{{ path('admin_forum_board_update', {id: board.id}) }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_board_' ~ board.id) }}">
<label>{{ ui_text('admin.forum.index.nazva') }}<input name="name" required maxlength="190" value="{{ board.name }}"></label>
<label>{{ ui_text('admin.forum.index.poriadok') }}<input name="sort_order" type="number" value="{{ board.sort_order }}"></label>
<label>{{ ui_text('admin.forum.board.parent') }}<select name="parent_id"><option value="0">{{ ui_text('admin.forum.board.top_level') }}</option>{% for opt in queue.boards|default([])|filter(o => not o.parent_id and o.id != board.id) %}<option value="{{ opt.id }}"{{ board.parent_id == opt.id ? ' selected' : '' }}>{{ opt.name }}</option>{% endfor %}</select></label>
<label class="admin-form-wide">{{ ui_text('admin.forum.index.opys') }}<input name="description" maxlength="1000" value="{{ board.description }}"></label>
<label>{{ ui_text('admin.forum.index.status') }}<select name="status"><option value="active"{{ board.status == 'active' ? ' selected' : '' }}>{{ ui_text('admin.forum.board.active') }}</option><option value="hidden"{{ board.status == 'hidden' ? ' selected' : '' }}>{{ ui_text('admin.forum.board.hidden') }}</option></select></label>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.blog.save') }}</button></div></form>
<form method="post" action="{{ path('admin_forum_board_delete', {id: board.id}) }}" data-confirm="{{ ui_text('admin.forum.board.delete_confirm') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_board_' ~ board.id) }}"><button class="admin-button is-danger" type="submit"{{ board.topic_count > 0 ? ' disabled title="' ~ ui_text('admin.forum.board.not_empty')|e('html_attr') ~ '"' : '' }}>{{ ui_icon('trash-2', 14) }} {{ ui_text('admin.forum.board.delete') }}</button></form></details></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.forum.index.rozdiliv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>
</section>

<section class="admin-panel" data-tab="t2">
    <div class="admin-panel__header"><div><small>{{ ui_text('admin.forum.index.moderatsiia') }}</small><h2>{{ ui_text('admin.forum.index.novi_temy') }}</h2></div><span class="admin-badge">{{ queue.topics|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.tema') }}</th><th>{{ ui_text('admin.forum.index.rozdil') }}</th><th>{{ ui_text('admin.forum.index.avtor') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead><tbody>
    {% for topic in queue.topics %}<tr><td><strong>{{ topic.title }}</strong></td><td>{{ topic.board_name }}</td><td>{{ topic.author_name }}</td><td>{{ topic.created_at|local_datetime }}</td><td class="is-actions"><form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:'approve'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.opublikuvaty') }}" aria-label="{{ ui_text('admin.forum.index.opublikuvaty') }}">{{ ui_icon('check', 18) }}</button></form><form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:'reject'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button is-danger" type="submit" data-confirm="{{ ui_text('admin.forum.index.vidkhylyty_tsiu_temu') }}" title="{{ ui_text('admin.forum.index.vidkhylyty') }}" aria-label="{{ ui_text('admin.forum.index.vidkhylyty') }}">{{ ui_icon('x', 18) }}</button></form></td></tr>{% else %}<tr><td colspan="5">{{ ui_text('admin.forum.index.cherha_tem_porozhnia') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-panel" data-tab="t3">
    <div class="admin-panel__header"><div><small>{{ ui_text('admin.forum.index.moderatsiia') }}</small><h2>{{ ui_text('admin.forum.index.novi_vidpovidi') }}</h2></div><span class="admin-badge">{{ queue.posts|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.tema_tekst') }}</th><th>{{ ui_text('admin.forum.index.avtor') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead><tbody>
    {% for post in queue.posts %}<tr><td><strong>{{ post.topic_title }}</strong><small class="admin-cell-sub">{{ post.body_text|slice(0,220) }}{% if post.body_text|length > 220 %}…{% endif %}</small></td><td>{{ post.author_name }}</td><td>{{ post.created_at|local_datetime }}</td><td class="is-actions"><form method="post" action="{{ path('admin_forum_post_moderate',{id:post.id,action:'approve'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_post_' ~ post.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.opublikuvaty') }}" aria-label="{{ ui_text('admin.forum.index.opublikuvaty') }}">{{ ui_icon('check', 18) }}</button></form><form method="post" action="{{ path('admin_forum_post_moderate',{id:post.id,action:'reject'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_post_' ~ post.id) }}"><button class="admin-icon-button is-danger" type="submit" data-confirm="{{ ui_text('admin.forum.index.vidkhylyty_tse_povidomlennia') }}" title="{{ ui_text('admin.forum.index.vidkhylyty') }}" aria-label="{{ ui_text('admin.forum.index.vidkhylyty') }}">{{ ui_icon('x', 18) }}</button></form></td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.forum.index.cherha_vidpovidei_porozhnia') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-panel" data-tab="t4">
    <div class="admin-panel__header"><div><small>{{ ui_text('admin.forum.index.moderatsiia') }}</small><h2>{{ ui_text('admin.forum.published_topics') }}</h2></div><span class="admin-badge">{{ queue.published_topics|length }}</span></div>
    <details class="admin-collapse"><summary>{{ ui_icon('plus', 14) }} {{ ui_text('admin.forum.new_topic') }}</summary>
        <form method="post" action="{{ path('admin_forum_topic_create') }}" class="admin-form-grid">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_staff_topic') }}">
            <label><span>{{ ui_text('admin.forum.col.board') }}</span><select name="board_id" required>{% for board in queue.boards %}<option value="{{ board.id }}">{{ board.name }}</option>{% endfor %}</select></label>
            <label><span>{{ ui_text('admin.forum.author_name') }}</span><input name="author" maxlength="120" value="{{ ui_text('admin.forum.team_name') }}"></label>
            <label class="is-wide"><span>{{ ui_text('admin.forum.col.topic') }}</span><input name="title" maxlength="240" required></label>
            <label class="is-wide"><span>{{ ui_text('admin.forum.message') }}</span><textarea name="body" rows="5" required minlength="3"></textarea></label>
            <label class="admin-check"><input type="checkbox" name="pinned" value="1"> {{ ui_text('admin.forum.pin') }}</label>
            <button class="admin-button is-primary" type="submit">{{ ui_text('admin.forum.publish') }}</button>
        </form>
    </details>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.col.topic') }}</th><th>{{ ui_text('admin.forum.col.board') }}</th><th>{{ ui_text('admin.forum.col.views') }}</th><th>{{ ui_text('admin.forum.col.state') }}</th><th class="is-actions">{{ ui_text('admin.forum.col.actions') }}</th></tr></thead><tbody>
    {% for topic in queue.published_topics %}
        <tr>
            <td><a href="{{ path('admin_forum_topic_view',{id:topic.id}) }}"><strong>{{ topic.title }}</strong></a><small class="admin-cell-sub">{{ topic.author_name }} · {{ topic.last_post_at|local_datetime }}</small></td>
            <td>{{ topic.board_name }}</td><td>{{ topic.views_count }}</td>
            <td><span class="admin-badge">{{ ui_text(topic.is_pinned ? 'admin.forum.state.pinned' : 'admin.forum.state.normal') }} · {{ ui_text(topic.is_locked ? 'admin.forum.state.locked' : 'admin.forum.state.open') }}</span></td>
            <td class="is-actions">
                <form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:topic.is_pinned ? 'unpin' : 'pin'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text(topic.is_pinned ? 'admin.forum.unpin' : 'admin.forum.pin') }}" aria-label="{{ ui_text(topic.is_pinned ? 'admin.forum.unpin' : 'admin.forum.pin') }}">{{ ui_icon('pin', 18) }}</button></form>
                <form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:topic.is_locked ? 'unlock' : 'lock'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text(topic.is_locked ? 'admin.forum.open_topic' : 'admin.forum.close_topic') }}" aria-label="{{ ui_text(topic.is_locked ? 'admin.forum.open_topic' : 'admin.forum.close_topic') }}">{{ ui_icon(topic.is_locked ? 'unlock' : 'lock', 18) }}</button></form>
            </td>
        </tr>
    {% else %}<tr><td colspan="5">{{ ui_text('admin.forum.no_published') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-panel" data-tab="t5">
    <div class="admin-panel__header"><div><small>{{ ui_text('admin.forum.community_safety') }}</small><h2>{{ ui_text('admin.forum.reports') }}</h2></div><span class="admin-badge">{{ queue.reports|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.col.topic_message') }}</th><th>{{ ui_text('admin.forum.col.reason') }}</th><th>{{ ui_text('admin.forum.col.reporter') }}</th><th>{{ ui_text('admin.forum.col.date') }}</th><th class="is-actions">{{ ui_text('admin.forum.col.actions') }}</th></tr></thead><tbody>
    {% for report in queue.reports %}
        <tr>
            <td><strong>{{ report.topic_title }}</strong><small class="admin-cell-sub">{{ report.body_text|slice(0,220) }}{% if report.body_text|length > 220 %}…{% endif %}</small></td>
            <td><strong>{{ report.reason }}</strong>{% if report.details %}<small class="admin-cell-sub">{{ report.details }}</small>{% endif %}</td>
            <td>{{ report.reporter_name }}</td><td>{{ report.created_at|local_datetime }}</td>
            <td class="is-actions"><form method="post" action="{{ path('admin_forum_report_resolve',{id:report.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_report_' ~ report.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.mark_resolved') }}" aria-label="{{ ui_text('admin.forum.mark_resolved') }}">{{ ui_icon('check', 18) }}</button></form></td>
        </tr>
    {% else %}<tr><td colspan="5">{{ ui_text('admin.forum.no_reports') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-panel" data-tab="t6">
    <div class="admin-panel__header"><div><small>{{ ui_text('admin.forum.index.community_safety') }}</small><h2>{{ ui_text('admin.forum.index.private_message_reports') }}</h2></div><span class="admin-badge">{{ queue.dm_reports|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.private_message') }}</th><th>{{ ui_text('admin.forum.index.sender') }}</th><th>{{ ui_text('admin.forum.index.reporter') }}</th><th>{{ ui_text('admin.forum.index.reason') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead><tbody>
    {% for report in queue.dm_reports %}
        <tr>
            <td><span title="{{ report.body_text|e('html_attr') }}">{{ report.body_text|slice(0,220) }}{% if report.body_text|length > 220 %}…{% endif %}</span></td>
            <td>{{ report.sender_nickname|default('—') }}</td>
            <td>{{ report.reporter_nickname|default('—') }}</td>
            <td><strong>{{ report.reason }}</strong>{% if report.details %}<small class="admin-cell-sub" title="{{ report.details|e('html_attr') }}">{{ report.details|slice(0,220) }}{% if report.details|length > 220 %}…{% endif %}</small>{% endif %}</td>
            <td>{{ report.created_at|local_datetime }}</td>
            <td class="is-actions"><form method="post" action="{{ path('admin_forum_dm_report_resolve',{id:report.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_dm_report_' ~ report.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.mark_resolved') }}" aria-label="{{ ui_text('admin.forum.index.mark_resolved') }}">{{ ui_icon('check', 18) }}</button></form></td>
        </tr>
    {% else %}<tr><td colspan="6">{{ ui_text('admin.forum.index.no_private_message_reports') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-panel" data-tab="t7">
    <div class="admin-panel__header">
        <div><small>{{ ui_text('admin.forum.index.community_safety') }}</small><h2>{{ ui_text('admin.forum.index.user_bans') }}</h2></div>
        <span class="admin-badge">{{ queue.bans|length }}</span>
    </div>
    <form method="post" action="{{ path('admin_forum_ban_create') }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.confirm.ban') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_ban_create') }}">
        <label><span>{{ ui_text('admin.forum.index.customer_id') }}</span><input type="number" min="1" name="customer_id" required></label>
        <label><span>{{ ui_text('admin.forum.index.ban_days') }}</span><input type="number" min="1" max="3650" name="duration_days" placeholder="{{ ui_text('admin.forum.index.permanent') }}"></label>
        <label class="is-wide"><span>{{ ui_text('admin.forum.index.ban_reason') }}</span><input type="text" name="reason" maxlength="1000" required></label>
        <button type="submit">{{ ui_text('admin.forum.index.apply_ban') }}</button>
    </form>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead><tr><th>{{ ui_text('admin.forum.index.user') }}</th><th>{{ ui_text('admin.forum.index.ban_reason') }}</th><th>{{ ui_text('admin.forum.index.expires') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead>
            <tbody>
            {% for ban in queue.bans %}
                <tr>
                    <td><strong>{{ ban.nickname }}</strong><small class="admin-cell-sub">ID {{ ban.customer_id }}</small></td>
                    <td><span title="{{ ban.reason|e('html_attr') }}">{{ ban.reason|slice(0,220) }}{% if ban.reason|length > 220 %}…{% endif %}</span></td>
                    <td>{{ ban.expires_at ? ban.expires_at|local_datetime : ui_text('admin.forum.index.permanent') }}</td>
                    <td>{{ ban.created_at|local_datetime }}</td>
                    <td class="is-actions"><form method="post" action="{{ path('admin_forum_ban_revoke',{id:ban.id}) }}" data-confirm="{{ ui_text('admin.confirm.revoke') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_ban_' ~ ban.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.revoke_ban') }}" aria-label="{{ ui_text('admin.forum.index.revoke_ban') }}">{{ ui_icon('check', 18) }}</button></form></td>
                </tr>
            {% else %}
                <tr><td colspan="5">{{ ui_text('admin.forum.index.no_active_bans') }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>

<section class="admin-panel" data-tab="t8">
    <div class="admin-panel__header"><div><small>{{ ui_text('admin.forum.index.moderatsiia') }}</small><h2>{{ ui_text('admin.forum.settings') }}</h2></div></div>
    <form method="post" action="{{ path('admin_forum_settings') }}" class="admin-form-grid">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_settings') }}">
        {% set modes = {moderate: ui_text('admin.forum.mode.moderate'), trusted: ui_text('admin.forum.mode.trusted'), authorized: ui_text('admin.forum.mode.authorized')} %}
        <label><span>{{ ui_text('admin.forum.settings.topics') }}</span><select name="topics_mode">{% for key, label in modes %}<option value="{{ key }}"{{ forum_settings.topics_mode == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
        <label><span>{{ ui_text('admin.forum.settings.replies') }}</span><select name="replies_mode">{% for key, label in modes %}<option value="{{ key }}"{{ forum_settings.replies_mode == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
        <label><span>{{ ui_text('admin.forum.settings.trusted_after') }}</span><input type="number" name="trusted_after" min="1" max="100" value="{{ forum_settings.trusted_after }}"></label>
        <label><span>{{ ui_text('admin.forum.settings.max_links') }}</span><input type="number" name="max_links" min="0" max="20" value="{{ forum_settings.max_links }}"></label>
        <p class="admin-help is-wide">{{ ui_text('admin.forum.settings.help') }}</p>
        <button class="admin-button is-primary" type="submit">{{ ui_text('admin.forum.settings.save') }}</button>
    </form>
</section>

</div>
{{ shell.end() }}
