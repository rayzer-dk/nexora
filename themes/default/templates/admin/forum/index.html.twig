{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.forum.index.forum'),'forum') }}
<header class="admin-runtime__header"><div><small>Nexora Commerce · v{{ platform_version }}</small><h1>{{ ui_text('admin.forum.index.forum_i_moderatsiia') }}</h1><p>{{ ui_text('admin.forum.index.forum_izolovanyi_vid_iadra_mahazynu_novi_publich') }}</p></div><a class="admin-preview-link" href="/forum" target="_blank" rel="noopener">{{ ui_text('admin.forum.index.vidkryty_forum') }}</a></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="store-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}

<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>{{ ui_text('admin.forum.index.struktura') }}</small><h2>{{ ui_text('admin.forum.index.rozdily_forumu') }}</h2></div><span class="admin-help">{{ ui_text('admin.forum.index.mozhna_dodavaty_bez_perezavantazhennia_systemy') }}</span></div>
    <form method="post" action="{{ path('admin_forum_board_create') }}" class="admin-inline-form" data-dirty-guard>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_board_create') }}">
        <label><span>{{ ui_text('admin.forum.index.nazva') }}</span><input name="name" required maxlength="190" placeholder="{{ ui_text('admin.forum.index.zahalni_obhovorennia') }}"></label>
        <label><span>URL</span><input name="slug" maxlength="160" placeholder="{{ ui_text('ui.admin.forum.index.general')|e('html_attr') }}"></label>
        <label class="admin-inline-form__wide"><span>{{ ui_text('admin.forum.index.opys') }}</span><input name="description" maxlength="1000" placeholder="{{ ui_text('admin.forum.index.korotko_pro_tematyku_rozdilu') }}"></label>
        <label><span>{{ ui_text('admin.forum.index.poriadok') }}</span><input name="sort_order" type="number" value="0"></label>
        <button type="submit">{{ ui_text('admin.forum.index.dodaty_rozdil') }}</button>
    </form>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.rozdil') }}</th><th>URL</th><th>{{ ui_text('admin.forum.index.status') }}</th><th>{{ ui_text('admin.forum.index.poriadok') }}</th></tr></thead><tbody>{% for board in queue.boards %}<tr><td><strong>{{ board.name }}</strong><small class="admin-cell-subtitle">{{ board.description }}</small></td><td>/forum/{{ board.slug }}</td><td><span class="admin-status-pill {{ board.status == 'active' ? 'is-active' : '' }}">{{ board.status }}</span></td><td>{{ board.sort_order }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.forum.index.rozdiliv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>
</section>

<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>{{ ui_text('admin.forum.index.moderatsiia') }}</small><h2>{{ ui_text('admin.forum.index.novi_temy') }}</h2></div><span class="admin-status-pill">{{ queue.topics|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.tema') }}</th><th>{{ ui_text('admin.forum.index.rozdil') }}</th><th>{{ ui_text('admin.forum.index.avtor') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead><tbody>
    {% for topic in queue.topics %}<tr><td><strong>{{ topic.title }}</strong></td><td>{{ topic.board_name }}</td><td>{{ topic.author_name }}</td><td>{{ topic.created_at }}</td><td class="is-actions"><form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:'approve'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.opublikuvaty') }}">✓</button></form><form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:'reject'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button is-danger" type="submit" data-confirm="{{ ui_text('admin.forum.index.vidkhylyty_tsiu_temu') }}" title="{{ ui_text('admin.forum.index.vidkhylyty') }}">×</button></form></td></tr>{% else %}<tr><td colspan="5">{{ ui_text('admin.forum.index.cherha_tem_porozhnia') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>{{ ui_text('admin.forum.index.moderatsiia') }}</small><h2>{{ ui_text('admin.forum.index.novi_vidpovidi') }}</h2></div><span class="admin-status-pill">{{ queue.posts|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.tema_tekst') }}</th><th>{{ ui_text('admin.forum.index.avtor') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead><tbody>
    {% for post in queue.posts %}<tr><td><strong>{{ post.topic_title }}</strong><small class="admin-cell-subtitle">{{ post.body_text|slice(0,220) }}{% if post.body_text|length > 220 %}…{% endif %}</small></td><td>{{ post.author_name }}</td><td>{{ post.created_at }}</td><td class="is-actions"><form method="post" action="{{ path('admin_forum_post_moderate',{id:post.id,action:'approve'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_post_' ~ post.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.opublikuvaty') }}">✓</button></form><form method="post" action="{{ path('admin_forum_post_moderate',{id:post.id,action:'reject'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_post_' ~ post.id) }}"><button class="admin-icon-button is-danger" type="submit" data-confirm="{{ ui_text('admin.forum.index.vidkhylyty_tse_povidomlennia') }}" title="{{ ui_text('admin.forum.index.vidkhylyty') }}">×</button></form></td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.forum.index.cherha_vidpovidei_porozhnia') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>{{ ui_text('admin.forum.index.moderatsiia') }}</small><h2>Опубліковані теми</h2></div><span class="admin-status-pill">{{ queue.published_topics|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Тема</th><th>Розділ</th><th>Перегляди</th><th>Стан</th><th class="is-actions">Дії</th></tr></thead><tbody>
    {% for topic in queue.published_topics %}
        <tr>
            <td><strong>{{ topic.title }}</strong><small class="admin-cell-subtitle">{{ topic.author_name }} · {{ topic.last_post_at }}</small></td>
            <td>{{ topic.board_name }}</td><td>{{ topic.views_count }}</td>
            <td><span class="admin-status-pill">{{ topic.is_pinned ? 'pinned' : 'normal' }} · {{ topic.is_locked ? 'locked' : 'open' }}</span></td>
            <td class="is-actions">
                <form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:topic.is_pinned ? 'unpin' : 'pin'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button" type="submit" title="{{ topic.is_pinned ? 'Відкріпити' : 'Закріпити' }}">★</button></form>
                <form method="post" action="{{ path('admin_forum_topic_moderate',{id:topic.id,action:topic.is_locked ? 'unlock' : 'lock'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_topic_' ~ topic.id) }}"><button class="admin-icon-button" type="submit" title="{{ topic.is_locked ? 'Відкрити тему' : 'Закрити тему' }}">◉</button></form>
            </td>
        </tr>
    {% else %}<tr><td colspan="5">Опублікованих тем ще немає.</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>Community safety</small><h2>Скарги користувачів</h2></div><span class="admin-status-pill">{{ queue.reports|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Тема / повідомлення</th><th>Причина</th><th>Автор скарги</th><th>Дата</th><th class="is-actions">Дії</th></tr></thead><tbody>
    {% for report in queue.reports %}
        <tr>
            <td><strong>{{ report.topic_title }}</strong><small class="admin-cell-subtitle">{{ report.body_text|slice(0,220) }}{% if report.body_text|length > 220 %}…{% endif %}</small></td>
            <td><strong>{{ report.reason }}</strong>{% if report.details %}<small class="admin-cell-subtitle">{{ report.details }}</small>{% endif %}</td>
            <td>{{ report.reporter_name }}</td><td>{{ report.created_at }}</td>
            <td class="is-actions"><form method="post" action="{{ path('admin_forum_report_resolve',{id:report.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_report_' ~ report.id) }}"><button class="admin-icon-button is-success" type="submit" title="Позначити вирішеною">✓</button></form></td>
        </tr>
    {% else %}<tr><td colspan="5">Відкритих скарг немає.</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>Community safety</small><h2>{{ ui_text('admin.forum.index.private_message_reports') }}</h2></div><span class="admin-status-pill">{{ queue.dm_reports|length }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.forum.index.private_message') }}</th><th>{{ ui_text('admin.forum.index.sender') }}</th><th>{{ ui_text('admin.forum.index.reporter') }}</th><th>{{ ui_text('admin.forum.index.reason') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead><tbody>
    {% for report in queue.dm_reports %}
        <tr>
            <td><span title="{{ report.body_text|e('html_attr') }}">{{ report.body_text|slice(0,220) }}{% if report.body_text|length > 220 %}…{% endif %}</span></td>
            <td>{{ report.sender_nickname|default('—') }}</td>
            <td>{{ report.reporter_nickname|default('—') }}</td>
            <td><strong>{{ report.reason }}</strong>{% if report.details %}<small class="admin-cell-subtitle" title="{{ report.details|e('html_attr') }}">{{ report.details|slice(0,220) }}{% if report.details|length > 220 %}…{% endif %}</small>{% endif %}</td>
            <td>{{ report.created_at }}</td>
            <td class="is-actions"><form method="post" action="{{ path('admin_forum_dm_report_resolve',{id:report.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_dm_report_' ~ report.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.mark_resolved') }}">✓</button></form></td>
        </tr>
    {% else %}<tr><td colspan="6">{{ ui_text('admin.forum.index.no_private_message_reports') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-editor-card">
    <div class="admin-card-heading">
        <div><small>{{ ui_text('admin.forum.index.community_safety') }}</small><h2>{{ ui_text('admin.forum.index.user_bans') }}</h2></div>
        <span class="admin-status-pill">{{ queue.bans|length }}</span>
    </div>
    <form method="post" action="{{ path('admin_forum_ban_create') }}" class="admin-inline-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_ban_create') }}">
        <label><span>{{ ui_text('admin.forum.index.customer_id') }}</span><input type="number" min="1" name="customer_id" required></label>
        <label><span>{{ ui_text('admin.forum.index.ban_days') }}</span><input type="number" min="1" max="3650" name="duration_days" placeholder="{{ ui_text('admin.forum.index.permanent') }}"></label>
        <label class="admin-inline-form__wide"><span>{{ ui_text('admin.forum.index.ban_reason') }}</span><input type="text" name="reason" maxlength="1000" required></label>
        <button type="submit">{{ ui_text('admin.forum.index.apply_ban') }}</button>
    </form>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead><tr><th>{{ ui_text('admin.forum.index.user') }}</th><th>{{ ui_text('admin.forum.index.ban_reason') }}</th><th>{{ ui_text('admin.forum.index.expires') }}</th><th>{{ ui_text('admin.forum.index.data') }}</th><th class="is-actions">{{ ui_text('admin.forum.index.dii') }}</th></tr></thead>
            <tbody>
            {% for ban in queue.bans %}
                <tr>
                    <td><strong>{{ ban.nickname }}</strong><small class="admin-cell-subtitle">ID {{ ban.customer_id }}</small></td>
                    <td><span title="{{ ban.reason|e('html_attr') }}">{{ ban.reason|slice(0,220) }}{% if ban.reason|length > 220 %}…{% endif %}</span></td>
                    <td>{{ ban.expires_at|default(ui_text('admin.forum.index.permanent')) }}</td>
                    <td>{{ ban.created_at }}</td>
                    <td class="is-actions"><form method="post" action="{{ path('admin_forum_ban_revoke',{id:ban.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forum_ban_' ~ ban.id) }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.forum.index.revoke_ban') }}">✓</button></form></td>
                </tr>
            {% else %}
                <tr><td colspan="5">{{ ui_text('admin.forum.index.no_active_bans') }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{{ shell.end() }}
