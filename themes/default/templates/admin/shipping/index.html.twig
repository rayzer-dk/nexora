{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.shipping.index.vidpravlennia'),'orders') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.shipping.index.lohistyka') }}</small><h1>{{ ui_text('admin.shipping.index.vidpravlennia') }}</h1><p class="admin-list-summary">{{ ui_text('admin.shipping.index.ttn_tracking_povernennia_ta_statusy_dostavky') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-runtime__panel admin-runtime__panel--wide"><form method="get"><label><span>{{ ui_text('admin.shipping.index.status') }}</span><select name="status"><option value="">{{ ui_text('admin.shipping.index.usi') }}</option>{% for s in ['registered','label_ready','in_transit','delivered','exception','returning','returned','cancelled'] %}<option value="{{ s }}"{{ status==s?' selected':'' }}>{{ s }}</option>{% endfor %}</select></label><button type="submit">{{ ui_text('admin.shipping.index.filtruvaty') }}</button></form><form method="post" action="{{ path('admin_shipment_bulk_status') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_shipment_bulk_status') }}"><div class="admin-inline-actions"><select name="status" required><option value="">{{ ui_text('admin.shipping.index.masova_diia') }}</option>{% for st in ['label_ready','in_transit','delivered','exception','returning','returned','cancelled'] %}<option value="{{ st }}">{{ st }}</option>{% endfor %}</select><button type="submit">{{ ui_text('admin.shipping.index.zastosuvaty') }}</button></div><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th><input type="checkbox" data-check-all title="{{ ui_text('admin.shipping.index.vybraty_vsi') }}"></th><th>{{ ui_text('admin.shipping.index.zamovlennia') }}</th><th>{{ ui_text('admin.shipping.index.napriamok') }}</th><th>{{ ui_text('admin.shipping.index.pereviznyk') }}</th><th>{{ ui_text('ui.admin.shipping.index.tracking') }}</th><th>{{ ui_text('admin.shipping.index.status') }}</th><th>{{ ui_text('admin.shipping.index.data') }}</th><th>{{ ui_text('admin.shipping.index.dii') }}</th></tr></thead><tbody>{% for s in shipments %}<tr><td><input type="checkbox" name="shipments[]" value="{{ s.public_id_text }}" data-row-check title="{{ ui_text('admin.shipping.index.vybraty_vidpravlennia') }}"></td><td><a href="{{ path('admin_order_view',{publicId:s.order_public_id}) }}">{{ s.order_number }}</a></td><td>{{ s.direction }}</td><td>{{ s.provider_code }}</td><td><a href="{{ path('admin_shipment_view',{shipment:s.public_id_text}) }}"><strong>{{ s.tracking_number }}</strong></a></td><td>{{ s.status }}</td><td>{{ s.created_at }}</td><td><a href="{{ path('admin_shipment_label',{shipment:s.public_id_text}) }}" target="_blank">{{ ui_text('ui.admin.shipping.index.pdf_label') }}</a></td></tr>{% else %}<tr><td colspan="8">{{ ui_text('admin.shipping.index.vidpravlen_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></form></section>
{{ shell.end() }}
