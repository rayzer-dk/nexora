{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.shipping.index.vidpravlennia'),'shipments') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.shipping.index.lohistyka') }}</span></nav><h1>{{ ui_text('admin.shipping.index.vidpravlennia') }}</h1><p class="admin-list-summary">{{ ui_text('admin.shipping.index.ttn_tracking_povernennia_ta_statusy_dostavky') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel admin-panel--compact"><form method="get" class="admin-filters admin-filters--inline admin-filters--compact">
<label><span>{{ ui_text('admin.shipping.index.status') }}</span><select name="status"><option value="">{{ ui_text('admin.shipping.index.usi') }}</option>{% for s in ['registered','label_ready','in_transit','delivered','exception','returning','returned','cancelled'] %}<option value="{{ s }}"{{ status==s?' selected':'' }}>{{ s|status_label('shipment') }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.shipping.filter.from') }}</span><input type="date" name="from" value="{{ filters.from }}"></label>
<label><span>{{ ui_text('admin.shipping.filter.to') }}</span><input type="date" name="to" value="{{ filters.to }}"></label>
<label class="admin-search">{{ ui_icon('search', 16) }}<input type="search" name="q" value="{{ filters.q }}" placeholder="{{ ui_text('admin.shipping.filter.search')|e('html_attr') }}" aria-label="{{ ui_text('admin.shipping.filter.search')|e('html_attr') }}"></label>
<label><span>{{ ui_text('admin.shipping.filter.sort') }}</span><select name="sort">{% for key in ['created','updated','status','order','carrier'] %}<option value="{{ key }}"{{ filters.sort == key ? ' selected' : '' }}>{{ ui_text('admin.shipping.filter.sort_' ~ key) }}</option>{% endfor %}</select></label>
<label><span>&nbsp;</span><select name="dir" aria-label="{{ ui_text('admin.shipping.filter.dir')|e('html_attr') }}"><option value="desc"{{ filters.dir != 'asc' ? ' selected' : '' }}>{{ ui_text('admin.shipping.filter.desc') }}</option><option value="asc"{{ filters.dir == 'asc' ? ' selected' : '' }}>{{ ui_text('admin.shipping.filter.asc') }}</option></select></label>
<button type="submit" class="admin-button is-primary">{{ ui_text('admin.shipping.index.filtruvaty') }}</button>
<a class="admin-button" href="{{ path('admin_shipments_export', {status: status, from: filters.from, to: filters.to, q: filters.q, sort: filters.sort, dir: filters.dir}) }}">{{ ui_icon('download', 16) }}<span>CSV</span></a></form><form method="post" action="{{ path('admin_shipment_bulk_status') }}" class="admin-bulk-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_shipment_bulk_status') }}"><div class="admin-inline-actions"><select name="status" required><option value="">{{ ui_text('admin.shipping.index.masova_diia') }}</option>{% for st in ['label_ready','in_transit','delivered','exception','returning','returned','cancelled'] %}<option value="{{ st }}">{{ st|status_label('shipment') }}</option>{% endfor %}</select><button type="submit">{{ ui_text('admin.shipping.index.zastosuvaty') }}</button></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th><input type="checkbox" data-check-all title="{{ ui_text('admin.shipping.index.vybraty_vsi') }}"></th><th>{{ ui_text('admin.shipping.index.zamovlennia') }}</th><th>{{ ui_text('admin.shipping.index.napriamok') }}</th><th>{{ ui_text('admin.shipping.index.pereviznyk') }}</th><th>{{ ui_text('ui.admin.shipping.index.tracking') }}</th><th>{{ ui_text('admin.shipping.index.status') }}</th><th>{{ ui_text('admin.shipping.index.data') }}</th><th>{{ ui_text('admin.shipping.index.dii') }}</th></tr></thead><tbody>{% for s in shipments %}<tr><td><input type="checkbox" name="shipments[]" value="{{ s.public_id_text }}" data-row-check title="{{ ui_text('admin.shipping.index.vybraty_vidpravlennia') }}"></td><td><a href="{{ path('admin_order_view',{publicId:s.order_public_id}) }}">{{ s.order_number }}</a></td><td>{{ s.direction|status_label('direction') }}</td><td>{{ s.provider_code|status_label('carrier') }}</td><td><a href="{{ path('admin_shipment_view',{shipment:s.public_id_text}) }}"><strong>{{ s.tracking_number }}</strong></a></td><td>{{ status_badge(s.status, 'shipment') }}</td><td>{{ s.created_at|slice(0,16) }}</td><td><a href="{{ path('admin_shipment_label',{shipment:s.public_id_text}) }}" target="_blank">{{ ui_text('ui.admin.shipping.index.pdf_label') }}</a></td></tr>{% else %}<tr><td colspan="8">{{ ui_text('admin.shipping.index.vidpravlen_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></form></section>
{{ shell.end() }}
