{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.carriers.title'),'shipments') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_shipments') }}">{{ ui_text('admin_shipments') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.carriers.title') }}</span></nav><h1>{{ ui_text('admin.carriers.title') }}</h1><p>{{ ui_text('admin.carriers.intro') }}</p></div><div class="admin-page-actions"><a class="admin-button" href="{{ path('admin_shipment_methods') }}">{{ ui_icon('settings', 16) }}<span>{{ ui_text('admin.carriers.methods') }}</span></a></div></header>
<section class="admin-stats">{% for c in carriers %}<article class="is-tone-{{ c.connected ? 'success' : 'warning' }}"><span>{{ ui_icon(c.connected ? 'circle-check' : 'clock', 16) }} {{ c.label }}</span><strong>{{ ui_text(c.connected ? 'admin.carriers.connected' : 'admin.carriers.not_connected') }}</strong></article>{% endfor %}</section>
<section class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.carriers.carrier') }}</th><th>{{ ui_text('admin.carriers.abilities') }}</th><th>{{ ui_text('admin.carriers.settings') }}</th></tr></thead><tbody>
{% for c in carriers %}<tr><td><strong>{{ c.label }}</strong><small class="admin-cell-sub">{{ c.code }}</small></td>
<td>{% for flag, label in {rates: 'admin.carriers.cap_rates', create: 'admin.carriers.cap_create', tracking: 'admin.carriers.cap_tracking', returns: 'admin.carriers.cap_returns'} %}{% if attribute(c, flag) %}<span class="admin-badge is-active">{{ ui_text(label) }}</span> {% endif %}{% endfor %}{% if c.create and not c.create_ready %}<small class="admin-edited">{{ ui_icon('circle-alert', 12) }} {{ ui_text('admin.carriers.ttn_needs') }}</small>{% endif %}</td>
<td>{% if c.keys %}<ul class="admin-key-list">{% for k in c.keys %}<li class="{{ k.set ? 'is-set' : 'is-missing' }}"><code>{{ k.name }}</code> {{ k.set ? '✓' : '✗' }}{% if k.scope == 'ttn' %} <small>{{ ui_text('admin.carriers.for_ttn') }}</small>{% endif %}</li>{% endfor %}</ul>{% else %}<small>{{ ui_text('admin.carriers.no_settings') }}</small>{% endif %}</td></tr>{% endfor %}
</tbody></table></div><p class="admin-help">{{ ui_text('admin.carriers.where') }}</p></section>
{{ shell.end() }}
