{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.shipping_countries.title'),'shipping_countries') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.shipping_countries.title') }}</span></nav><h1>{{ ui_text('admin.shipping_countries.title') }}</h1><p>{{ ui_text('admin.shipping_countries.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% if not restricted %}<div class="admin-notice is-warning" data-shipping-open>{{ ui_text('admin.shipping_countries.unrestricted') }}</div>{% endif %}
<section class="admin-panel" data-shipping-countries><div class="admin-panel__header"><h2>{{ ui_text('admin.shipping_countries.countries') }}</h2><span>{{ enabled_countries|length }}</span></div>
<form method="post" action="{{ path('admin_shipment_countries_save') }}" data-confirm="{{ ui_text('admin.shipping_countries.confirm_save') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('shipping_countries') }}">
<div class="admin-checkbox-grid">{% for c in countries %}<label class="admin-check"><input type="checkbox" name="countries[]" value="{{ c.code }}"{{ c.enabled ? ' checked' : '' }}> {{ c.name }} <small>{{ c.code }}</small></label>{% endfor %}</div>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.badges.save') }}</button></div></form></section>
<section class="admin-panel" data-shipping-regions><div class="admin-panel__header"><h2>{{ ui_text('admin.shipping_countries.regions') }}{% if selected_name %}: {{ selected_name }}{% endif %}</h2></div>
{% if enabled_countries %}<nav class="admin-view-chips" aria-label="{{ ui_text('admin.shipping_countries.regions') }}">{% for c in enabled_countries %}<a href="{{ path('admin_shipment_countries',{country:c.code}) }}"{{ c.code == selected ? ' aria-current="true"' : '' }}>{{ c.name }}</a>{% endfor %}</nav>{% endif %}
{% if selected %}
<form method="post" action="{{ path('admin_shipment_regions_save') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('shipping_countries') }}"><input type="hidden" name="country" value="{{ selected }}"><input type="hidden" name="action" value="save">
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.badges.enabled') }}</th><th>{{ ui_text('admin.shipping_countries.region') }}</th><th></th></tr></thead><tbody>
{% for r in regions %}<tr><td><input type="checkbox" name="enabled[]" value="{{ r.id }}"{{ r.enabled ? ' checked' : '' }} aria-label="{{ r.name }}"></td><td>{{ r.name }}</td><td><button class="admin-icon-button is-danger" type="submit" formaction="{{ path('admin_shipment_region_delete',{id:r.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}" title="{{ ui_text('admin.badges.delete') }}" aria-label="{{ ui_text('admin.badges.delete') }}">{{ ui_icon('trash-2', 18) }}</button></td></tr>{% else %}<tr><td colspan="3">{{ ui_text('admin.shipping_countries.no_regions') }}</td></tr>{% endfor %}
</tbody></table></div><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.badges.save') }}</button></div></form>
<form method="post" action="{{ path('admin_shipment_regions_save') }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('shipping_countries') }}"><input type="hidden" name="country" value="{{ selected }}"><input type="hidden" name="action" value="add"><input type="text" name="name" maxlength="190" required placeholder="{{ ui_text('admin.shipping_countries.region') }}" aria-label="{{ ui_text('admin.shipping_countries.region') }}"><button class="admin-button" type="submit">{{ ui_icon('plus', 18) }} {{ ui_text('admin.badges.create') }}</button>{% if can_import %}<button class="admin-button" type="submit" name="action" value="import" formnovalidate>{{ ui_icon('download', 18) }} {{ ui_text('admin.shipping_countries.import') }}</button>{% endif %}</form>
{% else %}<p>{{ ui_text('admin.shipping_countries.pick') }}</p>{% endif %}</section>
{{ shell.end() }}
