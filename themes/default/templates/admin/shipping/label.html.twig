<!doctype html><html><head><meta charset="utf-8"><style>body{font-family:DejaVu Sans,sans-serif;font-size:11px;color:#111}h1{font-size:16px;margin:0 0 8px}h2{font-size:18px;font-weight:700;border:2px solid #111;padding:8px;margin:8px 0}p{margin:4px 0}small{display:block;color:#555;font-size:9px}</style></head><body><h1>{{ shipment.direction == 'return' ? 'RETURN' : 'SHIPMENT' }}</h1><h2>{{ shipment.tracking_number }}</h2><p><b>{{ shipment.provider_code }}</b> · {{ shipment.service_type }}</p><p>Order: {{ shipment.order_number }}</p><p>{{ shipment.customer_name }}</p><p>{{ shipment.customer_phone }}</p>{% if shipment.snapshot.destination is defined %}{% for key,value in shipment.snapshot.destination %}{% if value %}<p>{{ key }}: {{ value }}</p>{% endif %}{% endfor %}{% endif %}<small>{{ ui_text('ui.admin.shipping.label.internal_printable_dispatch_label_carrier_label_rema') }}</small></body></html>
