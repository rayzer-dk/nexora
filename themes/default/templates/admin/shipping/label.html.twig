<!doctype html><html><head><meta charset="utf-8"><style>body{font-family:DejaVu Sans,sans-serif;font-size:11px;color:#111}h1{font-size:16px;margin:0 0 8px}.code{font-size:18px;font-weight:700;border:2px solid #111;padding:8px;margin:8px 0}.row{margin:4px 0}.muted{color:#555;font-size:9px}</style></head><body><h1>{{ shipment.direction == 'return' ? 'RETURN' : 'SHIPMENT' }}</h1><div class="code">{{ shipment.tracking_number }}</div><div class="row"><b>{{ shipment.provider_code }}</b> · {{ shipment.service_type }}</div><div class="row">Order: {{ shipment.order_number }}</div><div class="row">{{ shipment.customer_name }}</div><div class="row">{{ shipment.customer_phone }}</div>{% if shipment.snapshot.destination is defined %}{% for key,value in shipment.snapshot.destination %}{% if value %}<div class="row">{{ key }}: {{ value }}</div>{% endif %}{% endfor %}{% endif %}<div class="muted">{{ ui_text('ui.admin.shipping.label.internal_printable_dispatch_label_carrier_label_rema') }}</div></body></html>
