{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.shipping.view.vidpravlennia') ~ shipment.tracking_number,'shipments') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.shipping.view.lohistyka') }}</small><h1>{{ shipment.tracking_number }}</h1><p class="admin-list-summary">{{ shipment.provider_code }} · {{ shipment.direction }} · {{ shipment.status }}</p></div><a class="admin-primary-link" href="{{ path('admin_shipments') }}">{{ ui_text('admin.shipping.view.do_vidpravlen') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<div class="admin-order-layout"><div><section class="admin-runtime__panel admin-runtime__panel--wide"><div><small>{{ ui_text('admin.shipping.view.vidpravlennia_2') }}</small><h2>{{ shipment.order_number }}</h2></div><dl class="admin-order-destination"><div><dt>{{ ui_text('ui.admin.shipping.view.tracking') }}</dt><dd>{{ shipment.tracking_number }}</dd></div><div><dt>{{ ui_text('ui.admin.shipping.view.provider') }}</dt><dd>{{ shipment.provider_code }}</dd></div><div><dt>{{ ui_text('ui.admin.shipping.view.service') }}</dt><dd>{{ shipment.service_type }}</dd></div><div><dt>{{ ui_text('ui.admin.shipping.view.direction') }}</dt><dd>{{ shipment.direction }}</dd></div><div><dt>{{ ui_text('ui.admin.shipping.view.status') }}</dt><dd>{{ shipment.status }}</dd></div>{% if shipment.external_id %}<div><dt>{{ ui_text('ui.admin.shipping.view.external_id') }}</dt><dd>{{ shipment.external_id }}</dd></div>{% endif %}</dl><div class="admin-inline-actions"><a href="{{ path('admin_shipment_label',{shipment:shipment.public_id_text}) }}" target="_blank">{{ ui_text('ui.admin.shipping.view.internal_pdf_label') }}</a>{% if shipment.carrier_label_url %}<a href="{{ shipment.carrier_label_url }}" target="_blank" rel="noopener noreferrer">{{ ui_text('ui.admin.shipping.view.carrier_label') }}</a>{% endif %}</div></section>
<section class="admin-runtime__panel admin-runtime__panel--wide"><div><small>{{ ui_text('admin.shipping.view.istoriia') }}</small><h2>{{ ui_text('admin.shipping.view.podii_vidpravlennia') }}</h2></div><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>{{ ui_text('admin.shipping.view.podiia') }}</th><th>{{ ui_text('admin.shipping.view.dani') }}</th><th>{{ ui_text('admin.shipping.view.khto') }}</th><th>{{ ui_text('admin.shipping.view.data') }}</th></tr></thead><tbody>{% for e in shipment.events %}<tr><td>{{ e.event_type }}</td><td><code>{{ e.payload_json }}</code></td><td>{{ e.actor|default('system') }}</td><td>{{ e.created_at }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.shipping.view.podii_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section></div>
<aside class="admin-order-sidebar"><section class="admin-runtime__panel"><div><small>{{ ui_text('admin.shipping.view.operatsii') }}</small><h2>{{ ui_text('admin.shipping.view.status') }}</h2></div>{% if admin_can('orders.manage') and shipment.status not in ['delivered','returned','cancelled'] %}<form method="post" action="{{ path('admin_shipment_status',{shipment:shipment.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_shipment_status_' ~ shipment.public_id_text) }}"><select name="status">{% for st in ['label_ready','in_transit','delivered','exception','returning','returned','cancelled'] %}{% if not (st == 'cancelled' and shipment.external_id) %}<option value="{{ st }}">{{ st }}</option>{% endif %}{% endfor %}</select><button type="submit">{{ ui_text('admin.shipping.view.onovyty_status') }}</button></form>{% endif %}{% if shipment.provider_code == 'nova_post' and shipment.external_id %}<hr><form method="post" action="{{ path('admin_nova_post_tracking',{shipment:shipment.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_nova_post_tracking_' ~ shipment.public_id_text) }}"><button type="submit">{{ ui_text('admin.shipping.view.pereviryty_tracking_api') }}</button></form>{% if nova_post_label_configured|default(false) %}<a href="{{ path('admin_nova_post_label',{shipment:shipment.public_id_text}) }}" target="_blank">{{ ui_text('ui.admin.shipping.view.carrier_pdf_label') }}</a>{% endif %}{% if admin_can('orders.manage') and shipment.status not in ['delivered','returned','cancelled'] %}<form method="post" action="{{ path('admin_nova_post_cancel',{shipment:shipment.public_id_text}) }}" onsubmit="{{ ui_text('admin.shipping.view.return_confirm_skasuvaty_vidpravlennia_u_novii_p') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_nova_post_cancel_' ~ shipment.public_id_text) }}"><button type="submit">{{ ui_text('admin.shipping.view.skasuvaty_u_pereviznyka') }}</button></form>{% endif %}{% endif %}</section></aside></div>
{{ shell.end() }}
