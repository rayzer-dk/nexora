{# Assistant helper: task, label, inputs (name => css selector), outputs (name => css selector); compact: only the button, for table rows #}
{% set box_providers = ai_providers()|filter(p => not p.translation_only|default(false)) %}{% if box_providers %}<div class="admin-ai-helper{{ compact|default(false) ? ' is-compact' : '' }}" data-ai-box data-ai-token="{{ csrf_token('admin_ai') }}">{% if not compact|default(false) %}<div><strong>{{ ui_text('admin.ai.helper_title') }}</strong><small>{{ ui_text('admin.ai.helper_hint') }}</small></div>{% endif %}<select data-ai-provider{{ compact|default(false) ? ' hidden' : '' }} aria-label="{{ ui_text('admin.ai.provider')|e('html_attr') }}">{% for pr in box_providers %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endfor %}</select><button type="button" data-ai-task="{{ task }}" data-ai-in="{{ inputs|json_encode|e('html_attr') }}" data-ai-out="{{ outputs|json_encode|e('html_attr') }}">{{ ui_icon('sparkles', 16) }}<span>{{ label }}</span></button><span data-ai-status role="status"></span></div>{% endif %}
