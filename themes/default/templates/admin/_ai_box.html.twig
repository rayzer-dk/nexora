{# Assistant helper: task, label, inputs (name => css selector), outputs (name => css selector) #}
{% if ai_providers() %}<div class="admin-ai-helper" data-ai-box data-ai-token="{{ csrf_token('admin_ai') }}"><div><strong>{{ ui_text('admin.ai.helper_title') }}</strong><small>{{ ui_text('admin.ai.helper_hint') }}</small></div><select data-ai-provider aria-label="{{ ui_text('admin.ai.provider')|e('html_attr') }}">{% for pr in ai_providers() %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endfor %}</select><button type="button" data-ai-task="{{ task }}" data-ai-in="{{ inputs|json_encode|e('html_attr') }}" data-ai-out="{{ outputs|json_encode|e('html_attr') }}">{{ ui_icon('sparkles', 16) }}<span>{{ label }}</span></button><span data-ai-status role="status"></span></div>{% endif %}
