{% extends '@storefront/admin/auth_base.html.twig' %}
{% block card %}
        <h1 id="login-title">{{ ui_text('admin.reset.forgot_title') }}</h1>
        {% if sent %}
            <div class="admin-notice is-success" role="status">{{ ui_icon('check', 20) }}<span>{{ ui_text('admin.reset.sent') }}</span></div>
        {% else %}
            <p>{{ ui_text('admin.reset.forgot_lead') }}</p>
            {% if error %}<div class="admin-notice is-error" role="alert">{{ ui_icon('circle-alert', 20) }}<span>{{ error }}</span></div>{% endif %}
            <form method="post" action="{{ path('admin_login_forgot') }}">
                <label><span>Email</span><input type="email" name="email" autocomplete="username" required autofocus></label>
                <input type="hidden" name="_token" value="{{ csrf_token('admin_login_forgot') }}">
                <button type="submit" class="admin-button is-primary is-lg">{{ ui_text('admin.reset.send') }}</button>
            </form>
        {% endif %}
        <p class="admin-login-links"><a href="{{ path('admin_login') }}">{{ ui_text('admin.reset.back') }}</a></p>
{% endblock %}
