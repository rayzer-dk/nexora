{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{% import '@storefront/admin/commerce/_promotion_form.html.twig' as pf %}{{ shell.start(promo.name, 'promotions') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_commerce_promotions') }}">{{ ui_text('admin.promo.title') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ promo.name }}</span></nav><h1>{{ promo.name }} {{ status_badge(promo.status) }} {% include '@storefront/admin/_tip.html.twig' with {key:'promotions'} only %}</h1><p>{{ ui_text('admin.promo.edit_intro') }}</p></div><a class="admin-button" href="{{ path('admin_commerce_promotions') }}">{{ ui_icon('arrow-left', 16) }} {{ ui_text('admin.customers.back') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-stats"><article><span>{{ ui_text('admin.commerce.promotions.vykorystano') }}</span><strong>{{ stats.used }}{% if promo.usage_limit %} / {{ promo.usage_limit }}{% endif %}</strong><small>{{ ui_text('admin.promo.used_hint') }}</small></article><article><span>{{ ui_text('admin.promo.given') }}</span><strong>{{ (stats.discount_minor / 100)|number_format(2, ',', ' ') }}</strong><small>{{ ui_text('admin.promo.given_hint') }}</small></article><article><span>{{ ui_text('admin.promo.revenue') }}</span><strong>{{ (stats.revenue_minor / 100)|number_format(2, ',', ' ') }}</strong><small>{{ ui_text('admin.promo.revenue_hint') }}</small></article><article><span>{{ ui_text('admin.promo.customers') }}</span><strong>{{ stats.customers }}</strong><small>{{ stats.last ? ui_text('admin.customers.last') ~ ': ' ~ stats.last|slice(0, 10) : '—' }}</small></article></section>
<section class="admin-panel">{{ pf.form(promo, '', 'promotion_edit_' ~ promo.id, ui_text('admin.badges.save'), markets, category_options, group_options) }}</section>
{% if redemptions %}<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.promo.history') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.commerce.customers.data') }}</th><th>{{ ui_text('admin.orders.index.zamovlennia') }}</th><th>{{ ui_text('admin.commerce.promotions.promokod') }}</th><th>{{ ui_text('admin.promo.given') }}</th></tr></thead><tbody>{% for r in redemptions %}<tr><td class="is-nowrap">{{ r.created_at|slice(0, 16) }}</td><td>{% if r.order_public_id %}<a href="{{ path('admin_order_view', {publicId: r.order_public_id}) }}" data-row-open>{{ r.order_number }}</a>{% else %}—{% endif %}</td><td>{{ r.coupon_code|default('—') }}</td><td class="is-nowrap">{{ (r.discount_minor / 100)|number_format(2, ',', ' ') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{{ shell.end() }}
