{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.feeds.torhovi_fidy'),'feeds') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.commerce.feeds.kanaly_prodazhiv') }}</span></nav><h1>{{ ui_text('ui.admin.commerce.feeds.feed_center') }}</h1><p>{{ ui_text('admin.commerce.feeds.odna_kanonichna_model_tovaru_dlia_google_meta_pi') }}</p></div><a class="admin-button is-primary" href="/sitemap.xml" target="_blank" rel="noopener">{{ ui_text('admin.commerce.feeds.vidkryty_sitemap_xml') }}</a></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-stats"><article><span>{{ ui_text('admin.commerce.feeds.mahazyn') }}</span><strong>{{ store.name|default('—') }}</strong><small>{{ store.code|default('—') }}</small></article><article><span>{{ ui_text('admin.commerce.feeds.mova') }}</span><strong>{{ locale }}</strong><small>{{ ui_text('admin.commerce.feeds.potochnyi_feed_context') }}</small></article><article><span>{{ ui_text('admin.commerce.feeds.valiuta') }}</span><strong>{{ store.default_currency|default('UAH') }}</strong><small>{{ ui_text('admin.commerce.feeds.kanonichnyi_pricing') }}</small></article></section>
{% if store_locales|length >= 1 %}<section class="admin-panel feeds-locales"><div class="admin-panel__header"><div><small>{{ ui_text('admin.feeds.language') }}</small><h2>{{ ui_text('admin.feeds.language_title') }}</h2><p>{{ ui_text('admin.feeds.language_help') }}</p></div></div>{% if store_locales|length > 1 %}<div class="admin-segmented" role="group" aria-label="{{ ui_text('admin.feeds.language') }}">{% for code in store_locales %}<a class="admin-segmented__item{{ code == locale ? ' is-active' : '' }}" href="?locale={{ code|url_encode }}"{{ code == locale ? ' aria-current="true"' : '' }}>{{ code }}</a>{% endfor %}</div>{% endif %}<div class="admin-inline-actions feeds-sitemaps"><span class="admin-help">{{ ui_text('admin.feeds.sitemaps') }}</span>{% for code in store_locales %}<a class="admin-button is-sm" href="/sitemaps/{{ store.code|default('default')|url_encode }}/{{ code|url_encode }}/1.xml" target="_blank" rel="noopener">{{ ui_icon('rss', 14) }} sitemap · {{ code }}</a>{% endfor %}</div></section>{% endif %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.commerce.feeds.feeds') }}</small><h2>{{ ui_text('admin.commerce.feeds.hotovi_kanaly') }}</h2><p>{{ ui_text('admin.commerce.feeds.url_mozhna_skopiiuvaty_v_kabinet_maidanchyka_nev') }}</p></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.commerce.feeds.kanal') }}</th><th>{{ ui_text('admin.commerce.feeds.peredano') }}</th><th>{{ ui_text('admin.commerce.feeds.propushcheno') }}</th><th>{{ ui_text('admin.commerce.feeds.onovleno') }}</th><th>URL</th><th class="is-actions">{{ ui_text('admin.commerce.feeds.diia') }}</th></tr></thead><tbody>{% for row in rows %}<tr><td><strong>{{ row.label }}</strong><small class="admin-cell-sub">{{ row.code }}</small>{% if row.warnings %}<small class="admin-cell-sub" title="{{ row.warnings|join(' | ') }}">{{ row.warnings|first }}</small>{% endif %}</td><td>{{ row.count is null ? '—' : row.count }}</td><td><span class="admin-badge {{ row.skipped ? 'is-warning' : 'is-active' }}">{{ row.skipped is null ? '—' : row.skipped }}</span></td><td>{{ row.generated_at|default(ui_text('admin.commerce.feeds.shche_ne_heneruvavsia')) }}{% if row.bytes %}<small class="admin-cell-sub">{{ (row.bytes / 1024)|number_format(1, '.', ' ') }} KB</small>{% endif %}</td><td><div class="admin-inline-actions"><input type="text" value="{{ row.url }}" readonly title="{{ ui_text('admin.commerce.feeds.url_fida') }}"><button class="admin-icon-button" type="button" data-copy-value="{{ row.url }}" title="{{ ui_text('admin.commerce.feeds.skopiiuvaty_url_fida') }}" aria-label="{{ ui_text('admin.commerce.feeds.skopiiuvaty_url_fida') }}">{{ ui_icon('copy',16) }}</button></div></td><td class="is-actions"><form method="post" action="{{ path('admin_commerce_feed_generate',{platform:row.code}) }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('feed_generate_' ~ row.code) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text('admin.commerce.feeds.zheneruvaty_feed') }}" aria-label="{{ ui_text('admin.commerce.feeds.zheneruvaty_feed') }}">{{ ui_icon('refresh-cw', 16) }}</button></form>{% if row.generated_at %}<a class="admin-icon-button" href="{{ path('admin_commerce_feed_preview',{platform:row.code}) }}" target="_blank" rel="noopener" title="{{ ui_text('admin.commerce.feeds.perehlianuty_feed') }}" aria-label="{{ ui_text('admin.commerce.feeds.perehlianuty_feed') }}">{{ ui_icon('external-link', 16) }}</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.commerce.feeds.marketplace_taxonomy') }}</small><h2>{{ ui_text('admin.commerce.feeds.mapping_katehorii') }}</h2><p>{{ ui_text('admin.commerce.feeds.rozetka_potrebuie_katehoriiu_marketpleisa_dlia_p') }}</p></div></div><form method="post" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('feed_category_mapping') }}"><label><span>{{ ui_text('admin.commerce.feeds.maidanchyk') }}</span><select name="platform"><option value="rozetka">ROZETKA</option><option value="prom">Prom.ua</option></select></label><label><span>{{ ui_text('admin.commerce.feeds.katehoriia_mahazynu') }}</span><select name="category_id" required><option value="">{{ ui_text('admin.commerce.feeds.oberit') }}</option>{% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label><label><span>{{ ui_text('admin.commerce.feeds.id_katehorii_maidanchyka') }}</span><input type="text" name="external_category_id" required></label><label><span>{{ ui_text('admin.commerce.feeds.nazva_katehorii_maidanchyka') }}</span><input type="text" name="external_category_name"></label><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.commerce.feeds.zberehty_mapping') }}</button></div></form>{% if mappings %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.commerce.feeds.maidanchyk') }}</th><th>{{ ui_text('admin.commerce.feeds.katehoriia_mahazynu') }}</th><th>{{ ui_text('ui.admin.commerce.feeds.external_id') }}</th><th>{{ ui_text('ui.admin.commerce.feeds.external_name') }}</th></tr></thead><tbody>{% for m in mappings %}<tr><td>{{ m.platform }}</td><td>{{ m.category_name }}</td><td><code>{{ m.external_category_id }}</code></td><td>{{ m.external_category_name|default('—') }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>
<section class="admin-safety-note"><strong>{{ ui_text('admin.commerce.feeds.yedyne_dzherelo_danykh') }}</strong><span>{{ ui_text('admin.commerce.feeds.feed_center_ne_zberihaie_okremi_tsiny_abo_zalysh') }}</span></section>
{{ shell.end() }}
