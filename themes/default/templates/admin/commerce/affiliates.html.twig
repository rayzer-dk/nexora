{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.affiliate.title'),'affiliates') }}
<header class="admin-page-header"><div><h1>{{ ui_text('admin.affiliate.title') }}</h1><p>{{ ui_text('admin.affiliate.intro') }}</p></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
{% if admin_can('marketing.manage') %}<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.affiliate.new') }}</h2></div>
<form method="post" action="{{ path('admin_commerce_affiliate_create') }}" class="admin-form-grid" data-affiliate-form><input type="hidden" name="_token" value="{{ csrf_token('admin_affiliate') }}">
<label><span>{{ ui_text('admin.affiliate.name') }}</span><input type="text" name="name" maxlength="190" required></label>
<label><span>E-mail</span><input type="email" name="email" maxlength="320"><small>{{ ui_text('admin.affiliate.email_hint') }}</small></label>
<label><span>{{ ui_text('admin.affiliate.percent') }}</span><input type="text" inputmode="decimal" name="percent" value="5" required></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_icon('plus', 16) }} {{ ui_text('admin.affiliate.add') }}</button></div></form></section>{% endif %}
<section class="admin-panel">
{% if rows %}<div class="admin-table-wrap"><table class="admin-table" data-affiliates><thead><tr><th>{{ ui_text('admin.affiliate.name') }}</th><th>{{ ui_text('admin.affiliate.link') }}</th><th class="num">%</th><th class="num">{{ ui_text('admin.affiliate.clicks') }}</th><th class="num">{{ ui_text('admin.affiliate.orders') }}</th><th class="num">{{ ui_text('admin.affiliate.sales') }}</th><th class="num">{{ ui_text('admin.affiliate.pending') }}</th><th class="num">{{ ui_text('admin.affiliate.approved') }}</th><th class="num">{{ ui_text('admin.affiliate.paid_total') }}</th><th></th></tr></thead><tbody>
{% for a in rows %}<tr data-affiliate="{{ a.code }}"><td>{{ a.name }}{% if a.status != 'active' %} <span class="admin-badge is-warning">{{ ui_text('admin.affiliate.paused') }}</span>{% endif %}<br><small>{{ a.email }}</small></td><td><code>{{ base }}/?ref={{ a.code }}</code></td><td class="num">{{ a.percent }}</td><td class="num">{{ a.clicks }}</td><td class="num">{{ a.orders }}</td><td class="num">{{ (a.sales_minor/100)|number_format(2, '.', ' ') }}</td><td class="num">{{ (a.pending_minor/100)|number_format(2, '.', ' ') }}</td><td class="num"><strong>{{ (a.approved_minor/100)|number_format(2, '.', ' ') }}</strong></td><td class="num">{{ (a.paid_minor/100)|number_format(2, '.', ' ') }}</td>
<td>{% if admin_can('marketing.manage') %}<form method="post" action="{{ path('admin_commerce_affiliate_action', {id: a.id, operation: 'pay'}) }}" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token('admin_affiliate') }}"><button class="admin-button is-sm" type="submit"{{ a.approved_minor > 0 ? '' : ' disabled' }} data-confirm="{{ ui_text('admin.affiliate.pay_confirm')|e('html_attr') }}">{{ ui_text('admin.affiliate.pay') }}</button></form> <form method="post" action="{{ path('admin_commerce_affiliate_action', {id: a.id, operation: a.status == 'active' ? 'pause' : 'resume'}) }}" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token('admin_affiliate') }}"><button class="admin-button is-sm" type="submit">{{ a.status == 'active' ? ui_text('admin.affiliate.pause') : ui_text('admin.affiliate.resume') }}</button></form>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
<p class="admin-help">{{ ui_text('admin.affiliate.note') }} ({{ currency }})</p>
{% else %}<p class="admin-empty">{{ ui_text('admin.affiliate.empty') }}</p>{% endif %}</section>
{{ shell.end() }}
