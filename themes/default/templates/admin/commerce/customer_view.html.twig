{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(customer.display_name|default(customer.email), 'customers') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_commerce_customers') }}">{{ ui_text('admin.customers.title') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ customer.display_name|default('—') }}</span></nav>
<h1>{{ customer.display_name|default('—') }} {{ status_badge(customer.status) }}</h1>
<p>{% if admin_can('personal_data.view') %}{{ customer.email }}{% if customer.phone_e164 %} · <a href="tel:{{ customer.phone_e164 }}">{{ customer.phone_e164 }}</a>{% endif %}{% else %}{{ ui_text('admin.commerce.customers.prykhovano') }}{% endif %}</p></div>
<a class="admin-button" href="{{ path('admin_commerce_customers') }}">{{ ui_icon('arrow-left', 16) }} {{ ui_text('admin.customers.back') }}</a></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-stats">
<article><span>{{ ui_text('admin.customers.orders') }}</span><strong>{{ stats.orders }}</strong><small>{% if stats.last_order %}{{ ui_text('admin.customers.last') }}: {{ stats.last_order|slice(0, 10) }}{% else %}—{% endif %}</small></article>
<article><span>{{ ui_text('admin.customers.spent') }}</span><strong>{{ (stats.spent_minor / 100)|number_format(2, ',', ' ') }} {{ stats.currency }}</strong><small>{{ ui_text('admin.customers.avg') }}: {{ (stats.avg_minor / 100)|number_format(2, ',', ' ') }}</small></article>
<article><span>{{ ui_text('admin.customers.bonus') }}</span><strong>{{ loyalty ? loyalty.points_balance : 0 }}</strong><small>{{ loyalty ? ui_text('admin.customers.bonus_total', {earned: loyalty.lifetime_earned, spent: loyalty.lifetime_spent}) : '—' }}</small></article>
<article><span>{{ ui_text('admin.customers.activity') }}</span><strong>{{ counts.wishlist }} · {{ counts.reviews }} · {{ counts.inquiries }}</strong><small>{{ ui_text('admin.customers.activity_hint') }}</small></article>
</section>
<div class="admin-detail"><div>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customers.orders_list') }}</h2><span>{{ orders|length }}</span></div>
{% if orders %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.orders.index.zamovlennia') }}</th><th>{{ ui_text('admin.commerce.customers.data') }}</th><th>{{ ui_text('admin.orders.index.oplata') }}</th><th>{{ ui_text('admin.orders.index.dostavka') }}</th><th>{{ ui_text('admin.orders.index.suma') }}</th></tr></thead><tbody>
{% for o in orders %}<tr><td><a href="{{ path('admin_order_view', {publicId: o.public_id}) }}" data-row-open><strong>{{ o.order_number }}</strong></a>{{ status_badge(o.status, 'order') }}</td><td class="is-nowrap">{{ o.created_at|slice(0, 16) }}</td><td>{{ status_badge(o.payment_status, 'payment') }}</td><td>{{ status_badge(o.fulfillment_status, 'fulfillment') }}</td><td class="is-nowrap"><strong>{{ (o.total_minor / 100)|number_format(2, ',', ' ') }} {{ o.currency }}</strong></td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="admin-help">{{ ui_text('admin.customers.no_orders') }}</p>{% endif %}</section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customers.notes') }}</h2><span>{{ notes|length }}</span></div>
{% if admin_can('customers.manage') %}<form method="post" action="{{ path('admin_commerce_customer_note', {id: customer.id}) }}" class="admin-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_note_' ~ customer.id) }}"><label><span>{{ ui_text('admin.customers.note_new') }}</span><textarea name="body" rows="3" maxlength="4000" required placeholder="{{ ui_text('admin.customers.note_ph') }}"></textarea></label><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('plus', 16) }} {{ ui_text('admin.customers.note_add') }}</button></div></form>{% endif %}
{% for n in notes %}<article class="admin-note"><div class="admin-note__meta"><strong>{{ n.author|default('—') }}</strong><small>{{ n.created_at|slice(0, 16) }}</small>{% if admin_can('customers.manage') %}<form method="post" action="{{ path('admin_commerce_customer_note_remove', {id: customer.id, noteId: n.id}) }}" data-confirm="{{ ui_text('admin.customers.note_remove_confirm') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_note_' ~ customer.id) }}"><button type="submit" class="admin-icon-button is-sm" title="{{ ui_text('admin.fields.delete') }}">{{ ui_icon('trash-2', 14) }}</button></form>{% endif %}</div><p>{{ n.body|nl2br }}</p></article>{% else %}<p class="admin-help">{{ ui_text('admin.customers.no_notes') }}</p>{% endfor %}</section>
</div>
<aside class="admin-detail__aside">
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customers.profile') }}</h2></div>
<dl class="admin-definition-list">
<div><dt>{{ ui_text('admin.customers.registered') }}</dt><dd>{{ customer.created_at|slice(0, 16) }}</dd></div>
<div><dt>{{ ui_text('admin.customers.last_seen') }}</dt><dd>{{ customer.last_seen_at ? customer.last_seen_at|slice(0, 16) : '—' }}</dd></div>
<div><dt>{{ ui_text('admin.customers.language') }}</dt><dd>{{ customer.locale|default('—') }}</dd></div>
<div><dt>Email</dt><dd>{{ customer.email_verified_at ? status_badge('verified') : status_badge('unverified') }}</dd></div>
<div><dt>{{ ui_text('admin.customers.phone') }}</dt><dd>{{ customer.phone_verified_at ? status_badge('verified') : '—' }}</dd></div>
<div><dt>{{ ui_text('admin.customers.subscription') }}</dt><dd>{% if subscription %}{{ status_badge(subscription.status) }}{% if subscription.consent_source %}<small>{{ subscription.consent_source }}</small>{% endif %}{% else %}{{ ui_text('admin.customers.not_subscribed') }}{% endif %}</dd></div>
</dl></section>
{% if admin_can('customers.manage') %}<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.commerce.customers.hrupa') }}</h2></div>
<form method="post" action="{{ path('admin_commerce_customers') }}" class="admin-group-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_group_' ~ customer.id) }}"><input type="hidden" name="id" value="{{ customer.id }}"><input type="text" name="customer_group_code" list="customer-groups" value="{{ customer.customer_group_code|default('default') }}" pattern="[a-z0-9_-]{1,64}" maxlength="64" required><datalist id="customer-groups">{% for g in groups %}<option value="{{ g }}">{% endfor %}</datalist><button type="submit">{{ ui_text('admin.commerce.customers.zberehty') }}</button></form></section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customers.access') }}</h2></div>
<form method="post" action="{{ path('admin_commerce_customer_status', {id: customer.id}) }}"{% if customer.status == 'active' %} data-confirm="{{ ui_text('admin.customers.block_confirm') }}"{% endif %}><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_status_' ~ customer.id) }}"><input type="hidden" name="status" value="{{ customer.status == 'active' ? 'blocked' : 'active' }}"><button type="submit" class="admin-button{{ customer.status == 'active' ? ' is-danger' : '' }}">{{ ui_icon(customer.status == 'active' ? 'lock' : 'check', 16) }} {{ customer.status == 'active' ? ui_text('admin.customers.block') : ui_text('admin.customers.unblock') }}</button></form></section>{% endif %}
</aside></div>
{{ shell.end() }}
