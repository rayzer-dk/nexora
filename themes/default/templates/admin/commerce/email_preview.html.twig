{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.email_preview.preview_lystiv'),'notifications') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.commerce.email_preview.komunikatsii') }}</small><h1>{{ ui_text('ui.admin.commerce.email_preview.preview_email') }}</h1><p>{{ ui_text('admin.commerce.email_preview.pereviriaite_shablon_pered_realnoiu_vidpravkoiu_') }}</p></div><a class="admin-preview-link" href="{{ path('admin_commerce_notifications') }}">{{ ui_text('admin.commerce.email_preview.nazad') }}</a></header>
<section class="admin-runtime__panel"><form method="get" class="admin-list-toolbar"><select name="template"><option value="order_created" {% if template=='order_created' %}selected{% endif %}>{{ ui_text('admin.commerce.email_preview.nove_zamovlennia') }}</option><option value="order_status" {% if template=='order_status' %}selected{% endif %}>{{ ui_text('admin.commerce.email_preview.status_zamovlennia') }}</option><option value="generic" {% if template=='generic' %}selected{% endif %}>{{ ui_text('admin.commerce.email_preview.servisne_povidomlennia') }}</option><option value="campaign" {% if template=='campaign' %}selected{% endif %}>{{ ui_text('admin.commerce.email_preview.rozsylka') }}</option></select><button type="submit">{{ ui_text('admin.commerce.email_preview.pokazaty') }}</button></form></section>
<div class="email-preview-grid"><section><h2>{{ ui_text('ui.admin.commerce.email_preview.desktop') }}</h2><iframe src="{{ path('admin_email_preview_render',{template:template}) }}" title="{{ ui_text('ui.admin.commerce.email_preview.desktop_email_preview')|e('html_attr') }}"></iframe></section><section class="is-mobile"><h2>{{ ui_text('ui.admin.commerce.email_preview.mobile') }}</h2><iframe src="{{ path('admin_email_preview_render',{template:template}) }}" title="{{ ui_text('ui.admin.commerce.email_preview.mobile_email_preview')|e('html_attr') }}"></iframe></section></div>
{{ shell.end() }}
