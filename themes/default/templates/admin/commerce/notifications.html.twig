{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{% import '@storefront/admin/_help.html.twig' as help %}{{ shell.start(ui_text('admin.commerce.notifications.tsentr_spovishchen'),'notifications') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.commerce.notifications.komunikatsii') }}</span></nav><h1>{{ ui_text('admin.commerce.notifications.tsentr_spovishchen') }}</h1><p>{{ ui_text('admin.commerce.notifications.email_telegram_i_sms_vykorystovuiut_odnu_postiin') }}</p></div><a class="admin-button is-primary" href="{{ path('admin_email_preview') }}">{{ ui_text('ui.admin.commerce.notifications.preview_email') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-stats"><article><span>{{ ui_text('admin.commerce.notifications.ochikuiut') }}</span><strong>{{ counts.pending|default(0) }}</strong></article><article><span>{{ ui_text('admin.commerce.notifications.nadislano') }}</span><strong>{{ counts.sent|default(0) }}</strong></article><article><span>{{ ui_text('admin.commerce.notifications.pomylky') }}</span><strong>{{ counts.failed|default(0) }}</strong></article></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.notifications.diahnostyka') }}</small><h2>{{ ui_text('admin.commerce.notifications.test_kanalu') }}</h2></div><form method="post" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('notification_test') }}"><label><span>{{ ui_text('admin.commerce.notifications.kanal') }}</span><select name="channel"><option value="email">Email</option><option value="telegram">{{ ui_text('ui.admin.commerce.notifications.telegram') }}</option><option value="sms">SMS</option></select></label><label><span>{{ ui_text('admin.commerce.notifications.otrymuvach') }}</span><input type="text" name="recipient" required placeholder="{{ ui_text('admin.commerce.notifications.email_chat_id_abo_380') }}">{{ help.hint(ui_text('admin.help.notifications.recipient'), 'https://core.telegram.org/bots/api#getupdates', ui_text('admin.help.notifications.recipient_link'), 'shop@example.com / -1001234567890 / 380501234567') }}</label><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.commerce.notifications.dodaty_test_u_cherhu') }}</button></div></form></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.notifications.queue') }}</small><h2>{{ ui_text('admin.notifications.maintenance') }}</h2></div><div class="admin-inline-actions">
<form method="post" action="{{ path('admin_commerce_notifications_maintenance') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('notification_maintenance') }}"><input type="hidden" name="action" value="retry_failed"><button class="admin-button" type="submit"{{ counts.failed|default(0) == 0 ? ' disabled' : '' }}>{{ ui_icon('rotate-ccw', 16) }} {{ ui_text('admin.notifications.retry_failed') }} ({{ counts.failed|default(0) }})</button></form>
<form method="post" action="{{ path('admin_commerce_notifications_maintenance') }}" data-confirm="{{ ui_text('admin.notifications.purge_confirm') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('notification_maintenance') }}"><input type="hidden" name="action" value="purge_sent"><label class="admin-inline-label">{{ ui_text('admin.notifications.older_than') }} <input type="number" name="days" value="30" min="7" max="3650"> {{ ui_text('admin.analytics.index.dniv') }}</label><button class="admin-button is-danger" type="submit">{{ ui_icon('trash-2', 16) }} {{ ui_text('admin.notifications.purge_sent') }}</button></form></div></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.notifications.ostanni_100') }}</small><h2>{{ ui_text('admin.commerce.notifications.istoriia_dostavky') }}</h2></div><form class="admin-filters" method="get"><label class="admin-filters__search"><span>{{ ui_text('admin.subscribers.search') }}</span><input type="search" name="q" value="{{ q }}"></label>
<label><span>{{ ui_text('admin.commerce.notifications.status') }}</span><select name="status"><option value="">{{ ui_text('admin.subscribers.any') }}</option>{% for st in ['pending','processing','sent','failed'] %}<option value="{{ st }}"{{ status == st ? ' selected' : '' }}>{{ st|status_label }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.commerce.notifications.kanal') }}</span><select name="channel"><option value="">{{ ui_text('admin.subscribers.any') }}</option>{% for ch in channels %}<option value="{{ ch }}"{{ channel == ch ? ' selected' : '' }}>{{ ch }}</option>{% endfor %}</select></label>
<div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.orders.index.zastosuvaty') }}</button></div></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>{{ ui_text('admin.commerce.notifications.kanal') }}</th><th>{{ ui_text('admin.commerce.notifications.typ') }}</th><th>{{ ui_text('admin.commerce.notifications.otrymuvach') }}</th><th>{{ ui_text('admin.commerce.notifications.status') }}</th><th>{{ ui_text('admin.commerce.notifications.sproby') }}</th><th>{{ ui_text('admin.commerce.notifications.pomylka') }}</th></tr></thead><tbody>{% for r in rows %}<tr><td>#{{ r.id }}</td><td><span class="admin-badge">{{ r.channel }}</span></td><td>{{ r.notification_type }}</td><td title="{{ r.recipient }}">{{ r.recipient }}</td><td><span class="admin-badge {{ r.status == 'sent' ? 'is-success' : (r.status == 'failed' ? 'is-danger' : '') }}">{{ r.status }}</span></td><td>{{ r.attempts }}</td><td title="{{ r.last_error }}">{{ r.last_error|default('—') }}</td></tr>{% else %}<tr><td colspan="7">{{ ui_text('admin.commerce.notifications.cherha_poky_porozhnia') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
