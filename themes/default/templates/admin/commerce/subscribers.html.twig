{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.subscribers.title'),'subscribers') }}
{% import '@storefront/admin/_pager.html.twig' as pager %}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.subscribers.title') }}</span></nav><h1>{{ ui_text('admin.subscribers.title') }}</h1><p>{{ ui_text('admin.subscribers.intro') }}</p></div><div class="admin-page-actions"><a class="admin-button" href="{{ path('admin_commerce_campaigns') }}">{{ ui_icon('megaphone', 16) }} {{ ui_text('admin.subscribers.to_campaigns') }}</a>{% if admin_can('customers.export') %}<a class="admin-button" href="{{ path('admin_commerce_subscribers_export') }}">{{ ui_icon('download', 16) }} {{ ui_text('admin.campaigns.export_subscribers') }}</a>{% endif %}</div></header>
<section class="admin-panel">
<div class="admin-inline-actions"><span class="admin-badge is-active">{{ ui_text('admin.subscribers.active') }}: {{ totals.active|default(0) }}</span><span class="admin-badge">{{ ui_text('admin.subscribers.pending') }}: {{ totals.pending|default(0) }}</span><span class="admin-badge">{{ ui_text('admin.subscribers.unsubscribed') }}: {{ totals.unsubscribed|default(0) }}</span></div>
<form class="admin-filters" method="get"><label class="admin-filters__search"><span>{{ ui_text('admin.subscribers.search') }}</span><input type="search" name="search" value="{{ search }}" placeholder="name@example.com"></label>
<label><span>{{ ui_text('admin.subscribers.status') }}</span><select name="status"><option value="">{{ ui_text('admin.subscribers.any') }}</option>{% for code in ['active','pending','unsubscribed'] %}<option value="{{ code }}"{{ status == code ? ' selected' : '' }}>{{ ui_text('admin.subscribers.' ~ code) }}</option>{% endfor %}</select></label>
<div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.orders.index.zastosuvaty') }}</button></div></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>E-mail</th><th>{{ ui_text('admin.subscribers.status') }}</th><th>{{ ui_text('admin.subscribers.language') }}</th><th>{{ ui_text('admin.subscribers.source') }}</th><th>{{ ui_text('admin.subscribers.since') }}</th><th></th></tr></thead><tbody>
{% for r in rows %}<tr><td><strong>{{ r.email }}</strong></td><td><span class="admin-badge{{ r.status == 'active' ? ' is-active' : '' }}">{{ ui_text('admin.subscribers.' ~ r.status) }}</span></td><td>{{ r.locale }}</td><td>{{ r.consent_source }}</td><td>{{ (r.confirmed_at ?: r.created_at)|slice(0,10) }}</td><td>{% if admin_can('marketing.manage') %}<button type="button" class="admin-button is-danger" data-ajax-delete="{{ path('admin_commerce_subscriber_delete', {id: r.id}) }}" data-token="{{ csrf_token('campaign_send') }}" data-confirm-text="{{ ui_text('admin.subscribers.delete_confirm')|e('html_attr') }}" aria-label="{{ ui_text('admin.subscribers.delete')|e('html_attr') }}">{{ ui_icon('trash-2', 16) }}</button>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.subscribers.empty') }}</td></tr>{% endfor %}
</tbody></table></div>
{% if pages > 1 %}<nav class="admin-pager" aria-label="{{ ui_text('admin.subscribers.title') }}">{% if page > 1 %}<a class="admin-button" href="?search={{ search|url_encode }}&status={{ status }}&page={{ page - 1 }}">←</a>{% endif %}<span>{{ page }} / {{ pages }}</span>{% if page < pages %}<a class="admin-button" href="?search={{ search|url_encode }}&status={{ status }}&page={{ page + 1 }}">→</a>{% endif %}</nav>{% endif %}
</section>
{{ shell.end() }}
