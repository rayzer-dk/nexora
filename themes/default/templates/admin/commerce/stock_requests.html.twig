{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{% macro th(label, key, sort, dir, filters) %}{% set next = (sort == key and dir == 'asc') ? 'desc' : 'asc' %}<th><a class="admin-sort{{ sort == key ? ' is-active' : '' }}" href="{{ path('admin_commerce_stock_requests', filters|merge({sort: key, dir: next})) }}">{{ label }}{% if sort == key %} {{ ui_icon(dir == 'asc' ? 'chevron-up' : 'chevron-down', 14) }}{% endif %}</a></th>{% endmacro %}
{% import _self as m %}
{{ shell.start(ui_text('admin.stockrequests.title'),'stock_requests') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.stockrequests.title') }}</span></nav><h1>{{ ui_text('admin.stockrequests.title') }}</h1><p>{{ ui_text('admin.stockrequests.help') }}</p></div>
<div class="admin-page-actions"><a class="admin-button" href="{{ path('admin_commerce_stock_requests_export', filters) }}">{{ ui_icon('download', 18) }}<span>{{ ui_text('admin.stockrequests.export') }}</span></a></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-stats"><article><span>{{ ui_text('admin.stockrequests.waiting') }}</span><strong>{{ stats.waiting|default(0) }}</strong><small>{{ ui_text('admin.stockrequests.waiting_hint') }}</small></article><article><span>{{ ui_text('admin.stockrequests.unconfirmed') }}</span><strong>{{ stats.unconfirmed|default(0) }}</strong><small>{{ ui_text('admin.stockrequests.unconfirmed_hint') }}</small></article><article><span>{{ ui_text('admin.stockrequests.notified') }}</span><strong>{{ stats.notified|default(0) }}</strong><small>{{ ui_text('admin.stockrequests.notified_hint') }}</small></article></section>
{% if top %}<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.stockrequests.top_kicker') }}</small><h2>{{ ui_text('admin.stockrequests.top') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><tbody>{% for t in top %}<tr><td><strong>{{ t.product_name }}</strong> <small>{{ t.sku }}</small></td><td>{{ ui_text('admin.stockrequests.waiting') }}: {{ t.waiting }}</td><td>{{ ui_text('admin.stockrequests.unconfirmed') }}: {{ t.unconfirmed }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
<section class="admin-toolbar"><form class="admin-filters" method="get" action="{{ path('admin_commerce_stock_requests') }}">
<label class="admin-filters__search"><span>{{ ui_text('admin.stockrequests.search') }}</span><input type="search" name="q" value="{{ filters.q }}" placeholder="{{ ui_text('admin.stockrequests.search_placeholder')|e('html_attr') }}"></label>
<label><span>{{ ui_text('admin.stockrequests.status') }}</span><select name="status"><option value="">{{ ui_text('admin.stockrequests.all') }}</option><option value="active"{{ filters.status == 'active' ? ' selected' : '' }}>{{ ui_text('admin.stockrequests.status_active') }}</option><option value="pending"{{ filters.status == 'pending' ? ' selected' : '' }}>{{ ui_text('admin.stockrequests.status_pending') }}</option><option value="notified"{{ filters.status == 'notified' ? ' selected' : '' }}>{{ ui_text('admin.stockrequests.status_notified') }}</option></select></label>
<label><span>{{ ui_text('admin.stockrequests.from') }}</span><input type="date" name="from" value="{{ filters.from }}"></label>
<label><span>{{ ui_text('admin.stockrequests.to') }}</span><input type="date" name="to" value="{{ filters.to }}"></label>
<input type="hidden" name="sort" value="{{ sort }}"><input type="hidden" name="dir" value="{{ dir }}">
<button type="submit">{{ ui_text('admin.stockrequests.apply') }}</button></form></section>
<div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr>{{ m.th(ui_text('admin.stockrequests.col_created'), 'created', sort, dir, filters) }}{{ m.th(ui_text('admin.stockrequests.col_product'), 'product', sort, dir, filters) }}{{ m.th('E-mail', 'email', sort, dir, filters) }}{{ m.th(ui_text('admin.stockrequests.status'), 'status', sort, dir, filters) }}{{ m.th(ui_text('admin.stockrequests.col_stock'), 'stock', sort, dir, filters) }}<th class="is-actions"></th></tr></thead><tbody>
{% for r in rows %}<tr><td class="admin-nowrap">{{ r.created_at|local_datetime }}{% if r.admin_seen_at is null and r.status == 'active' %} <span class="admin-badge is-info">{{ ui_text('admin.stockrequests.new') }}</span>{% endif %}</td>
<td><a href="{{ path('admin_catalog_product_edit', {publicId: r.product_uuid}) }}"><strong>{{ r.product_name }}</strong></a><small class="admin-cell-sub">{{ r.sku }}</small></td>
<td>{{ r.email }}<small class="admin-cell-sub">{{ r.locale }}</small></td>
<td><span class="admin-badge is-{{ r.status == 'active' ? 'success' : (r.status == 'notified' ? 'muted' : 'warning') }}">{{ r.status == 'active' ? ui_text('admin.stockrequests.status_active') : (r.status == 'notified' ? ui_text('admin.stockrequests.status_notified') : ui_text('admin.stockrequests.status_pending')) }}</span>{% if r.notified_at %}<small class="admin-cell-sub">{{ r.notified_at|local_datetime }}</small>{% endif %}</td>
<td>{% if r.available > 0 %}<span class="admin-badge is-success">{{ r.available|number_format(0, '.', ' ') }}</span>{% else %}<span class="admin-muted">0</span>{% endif %}</td>
<td class="is-actions"><span class="admin-row-actions">{% if r.available > 0 and r.status == 'active' %}<form method="post" action="{{ path('admin_commerce_stock_requests_notify', {product: r.product_uuid}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_stock_requests') }}"><button class="admin-icon-button is-sm" type="submit" title="{{ ui_text('admin.stockrequests.notify_now')|e('html_attr') }}" aria-label="{{ ui_text('admin.stockrequests.notify_now')|e('html_attr') }}">{{ ui_icon('send', 16) }}</button></form>{% endif %}
<form method="post" action="{{ path('admin_commerce_stock_requests_delete', {id: r.request_uuid}) }}" data-confirm="{{ ui_text('admin.stockrequests.delete_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_stock_requests') }}"><button class="admin-icon-button is-sm is-danger" type="submit" title="{{ ui_text('admin.stockrequests.delete')|e('html_attr') }}" aria-label="{{ ui_text('admin.stockrequests.delete')|e('html_attr') }}">{{ ui_icon('trash-2', 16) }}</button></form></span></td></tr>
{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.stockrequests.empty') }}</td></tr>{% endfor %}</tbody></table></div>
{% if pages > 1 %}<nav class="admin-pagination" aria-label="{{ ui_text('admin.nav.breadcrumb') }}">{% if page > 1 %}<a class="admin-button" href="{{ path('admin_commerce_stock_requests', filters|merge({sort: sort, dir: dir, page: page - 1})) }}" aria-label="{{ ui_text('admin.stockrequests.prev') }}">{{ ui_icon('chevron-left', 16) }}</a>{% endif %}<span>{{ page }} / {{ pages }} · {{ total }}</span>{% if page < pages %}<a class="admin-button" href="{{ path('admin_commerce_stock_requests', filters|merge({sort: sort, dir: dir, page: page + 1})) }}" aria-label="{{ ui_text('admin.stockrequests.next') }}">{{ ui_icon('chevron-right', 16) }}</a>{% endif %}</nav>{% endif %}</div>
{{ shell.end() }}
