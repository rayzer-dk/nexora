{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.import_export.import_ta_eksport'),'import_export') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.commerce.import_export.kataloh') }}</small><h1>{{ ui_text('admin.commerce.import_export.import_ta_eksport') }}</h1><p>{{ ui_text('admin.commerce.import_export.csv_cherez_toi_samyi_validation_event_pipeline_s') }}</p></div>{% if admin_can('catalog.export') %}<a class="admin-primary-link" href="{{ path('admin_commerce_export_products') }}">{{ ui_text('admin.commerce.import_export.eksport_tovariv_csv') }}</a><a class="admin-preview-link" href="{{ path('admin_commerce_export_products_multilingual') }}">{{ ui_text('admin.commerce.import_export.export_multilingual') }}</a>{% endif %}{% if admin_can('feeds.view') %}<a class="admin-preview-link" href="{{ path('admin_commerce_feeds') }}">{{ ui_text('ui.admin.commerce.import_export.feed_center_xml_json') }}</a>{% endif %}<a class="admin-preview-link" href="{{ path('admin_commerce_import_wizard') }}">{{ ui_text('admin.import.universal.link') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% if admin_can('catalog.manage') %}<section class="admin-runtime__panel"><div><small>CSV</small><h2>{{ ui_text('admin.commerce.import_export.perevirka_abo_import') }}</h2><p>{{ ui_text('admin.commerce.import_export.oboviazkovi_kolonky_sku_name_price_pidtrymuiutsi') }} {{ ui_text('admin.commerce.import_export.multilingual_hint') }}</p></div><form method="post" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_import') }}"><label><span>{{ ui_text('admin.commerce.import_export.csv_fail') }}</span><input type="file" name="catalog_csv" accept=".csv,text/csv" required></label><label><span>{{ ui_text('admin.commerce.import_export.rezhym') }}</span><select name="mode"><option value="preview">{{ ui_text('admin.commerce.import_export.tilky_pereviryty') }}</option><option value="apply">{{ ui_text('admin.commerce.import_export.zastosuvaty_import') }}</option></select><small>{{ ui_text('admin.commerce.import_export.pered_velykym_importom_spochatku_vykorystovuite_') }}</small></label><div class="admin-form-actions"><button type="submit">{{ ui_text('admin.commerce.import_export.zapustyty') }}</button></div></form></section>{% endif %}
{% if report %}<section class="admin-runtime__panel"><div><small>{{ ui_text('admin.commerce.import_export.rezultat') }}</small><h2>{{ ui_text('admin.commerce.import_export.zvit_operatsii') }}</h2></div><div class="admin-runtime__metrics"><article><span>{{ ui_text('admin.commerce.import_export.riadkiv') }}</span><strong>{{ report.rows }}</strong></article>{% if report.valid is defined %}<article><span>{{ ui_text('admin.commerce.import_export.korektnykh') }}</span><strong>{{ report.valid }}</strong></article><article><span>{{ ui_text('admin.commerce.import_export.pomylkovykh') }}</span><strong>{{ report.invalid }}</strong></article>{% else %}<article><span>{{ ui_text('admin.commerce.import_export.stvoreno') }}</span><strong>{{ report.created }}</strong></article><article><span>{{ ui_text('admin.commerce.import_export.onovleno') }}</span><strong>{{ report.updated }}</strong></article><article><span>{{ ui_text('admin.commerce.import_export.pomylok') }}</span><strong>{{ report.failed }}</strong></article>{% endif %}</div>{% if report.errors %}<div class="admin-notice is-error"><strong>{{ ui_text('admin.commerce.import_export.pershi_pomylky') }}</strong><ul>{% for e in report.errors %}<li>{{ e }}</li>{% endfor %}</ul></div>{% endif %}</section>{% endif %}
{{ shell.end() }}
