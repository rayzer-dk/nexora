{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.inquiries.zvernennia_pokuptsiv'),'inquiries') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('ui.admin.commerce.inquiries.customer_care') }}</span></nav><h1>{{ ui_text('admin.commerce.inquiries.zvernennia_pokuptsiv') }}</h1><p>{{ ui_text('admin.commerce.inquiries.kontaktni_formy_pytannia_po_tovarakh_zapyty_tsin') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-stats">{% for st in ['new','in_progress','resolved','closed'] %}<a class="admin-stat-link{{ filters.status == st ? ' is-active' : '' }}" href="{{ path('admin_commerce_inquiries', {status: filters.status == st ? '' : st}) }}"><article><span>{{ status_badge(st == 'new' ? 'new' : st) }}</span><strong>{{ counts[st]|default(0) }}</strong></article></a>{% endfor %}</section>
<form method="get" class="admin-filters admin-filters--inline admin-panel"><label>{{ ui_text('admin.customers.search') }}<input type="search" name="q" value="{{ filters.q }}" placeholder="{{ ui_text('admin.customers.search_ph') }}"></label><label>{{ ui_text('admin.commerce.inquiries.typ') }}<select name="type"><option value="">{{ ui_text('admin.filter.all') }}</option>{% for ty in types %}<option value="{{ ty }}"{{ filters.type == ty ? ' selected' : '' }}>{{ ty|status_label('inquiry') }}</option>{% endfor %}</select></label><label>{{ ui_text('admin.commerce.customers.status') }}<select name="status"><option value="">{{ ui_text('admin.filter.all') }}</option>{% for st in ['new','in_progress','resolved','closed'] %}<option value="{{ st }}"{{ filters.status == st ? ' selected' : '' }}>{{ st|status_label }}</option>{% endfor %}</select></label><div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.orders.index.zastosuvaty') }}</button></div></form>
<section class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.commerce.inquiries.data') }}</th><th>{{ ui_text('admin.commerce.inquiries.typ') }}</th><th>{{ ui_text('admin.commerce.inquiries.kontakt') }}</th><th>{{ ui_text('admin.commerce.inquiries.tovar') }}</th><th>{{ ui_text('admin.commerce.inquiries.povidomlennia') }}</th><th>{{ ui_text('admin.commerce.inquiries.status_notatka') }}</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.created_at }}</td><td><span class="admin-badge">{{ row.inquiry_type|status_label('inquiry') }}</span></td><td><strong>{{ row.name }}</strong><small>{{ row.phone|default('') }}{% if row.email %} · {{ row.email }}{% endif %}</small></td><td>{{ row.product_name|default('—') }}</td><td><div class="admin-cell-wrap" title="{{ row.message }}">{{ row.message }}</div></td><td><form method="post" class="inquiry-update-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('inquiry_update_' ~ row.id) }}"><input type="hidden" name="id" value="{{ row.id }}"><select name="status"><option value="new" {{ row.status=='new'?'selected':'' }}>{{ ui_text('admin.commerce.inquiries.nove') }}</option><option value="in_progress" {{ row.status=='in_progress'?'selected':'' }}>{{ ui_text('admin.commerce.inquiries.v_roboti') }}</option><option value="resolved" {{ row.status=='resolved'?'selected':'' }}>{{ ui_text('admin.commerce.inquiries.vyrisheno') }}</option><option value="closed" {{ row.status=='closed'?'selected':'' }}>{{ ui_text('admin.commerce.inquiries.zakryto') }}</option></select><textarea name="admin_note" rows="2" maxlength="4000" placeholder="{{ ui_text('admin.commerce.inquiries.notatka_menedzhera') }}">{{ row.admin_note }}</textarea><button type="submit">{{ ui_text('admin.commerce.inquiries.zberehty') }}</button></form></td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.commerce.inquiries.zvernen_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>{{ shell.end() }}
