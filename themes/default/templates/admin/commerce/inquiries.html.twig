{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.inquiries.zvernennia_pokuptsiv'),'inquiries') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('ui.admin.commerce.inquiries.customer_care') }}</span></nav><h1>{{ ui_text('admin.commerce.inquiries.zvernennia_pokuptsiv') }}</h1><p>{{ ui_text('admin.commerce.inquiries.kontaktni_formy_pytannia_po_tovarakh_zapyty_tsin') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
{% set total_count = 0 %}{% for st in ['new','in_progress','resolved','closed'] %}{% set total_count = total_count + counts[st]|default(0) %}{% endfor %}
<section class="admin-stats">
<a class="admin-stat-link{{ filters.status == '' ? ' is-active' : '' }}" href="{{ path('admin_commerce_inquiries', {status: ''}) }}"><article class="is-tone-primary"><span>{{ ui_icon('inbox', 16) }} {{ ui_text('admin.filter.all') }}</span><strong>{{ total_count }}</strong></article></a>
{% set tones = {new:'warning', in_progress:'info', resolved:'success', closed:'neutral'} %}{% set icons = {new:'bell', in_progress:'clock', resolved:'circle-check', closed:'circle-x'} %}
{% for st in ['new','in_progress','resolved','closed'] %}<a class="admin-stat-link{{ filters.status == st ? ' is-active' : '' }}" href="{{ path('admin_commerce_inquiries', {status: filters.status == st ? '' : st}) }}"><article class="is-tone-{{ tones[st] }}"><span>{{ ui_icon(icons[st], 16) }} {{ st|status_label('inquiry_status') }}</span><strong>{{ counts[st]|default(0) }}</strong></article></a>{% endfor %}
</section>
<form method="get" class="admin-filters admin-filters--inline admin-panel"><label>{{ ui_text('admin.customers.search') }}<input type="search" name="q" value="{{ filters.q }}" placeholder="{{ ui_text('admin.customers.search_ph') }}"></label><label>{{ ui_text('admin.commerce.inquiries.typ') }}<select name="type"><option value="">{{ ui_text('admin.filter.all') }}</option>{% for ty in types %}<option value="{{ ty }}"{{ filters.type == ty ? ' selected' : '' }}>{{ ty|status_label('inquiry') }}</option>{% endfor %}</select></label><label>{{ ui_text('admin.commerce.customers.status') }}<select name="status"><option value="">{{ ui_text('admin.filter.all') }}</option>{% for st in ['new','in_progress','resolved','closed'] %}<option value="{{ st }}"{{ filters.status == st ? ' selected' : '' }}>{{ st|status_label }}</option>{% endfor %}</select></label><div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.orders.index.zastosuvaty') }}</button></div></form>
<section class="admin-panel admin-inquiries">{% for row in rows %}
<article class="admin-inquiry is-{{ row.status }}">
    <div class="admin-inquiry__product">{% if row.product_image|default('') %}<a href="{{ row.product_path ? '/' ~ row.product_path : '#' }}" target="_blank" rel="noopener"><img src="/media/{{ row.product_image }}" alt="" width="56" height="56" loading="lazy"></a>{% else %}<span class="admin-inquiry__noimg" aria-hidden="true">{{ ui_icon('message-square', 22) }}</span>{% endif %}</div>
    <div class="admin-inquiry__main">
        <div class="admin-inquiry__head"><span class="admin-badge">{{ row.inquiry_type|status_label('inquiry') }}</span> <span class="admin-badge is-{{ row.status }}">{{ row.status|status_label('inquiry_status') }}</span> <small>{{ row.created_at|slice(0,16) }}</small></div>
        <p class="admin-inquiry__who"><strong>{{ row.name }}</strong>{% if row.phone %} · <a href="tel:{{ row.phone }}">{{ row.phone }}</a>{% endif %}{% if row.email %} · <a href="mailto:{{ row.email }}">{{ row.email }}</a>{% endif %}</p>
        {% if row.product_name %}<p class="admin-inquiry__item">{% if row.product_path %}<a href="/{{ row.product_path }}" target="_blank" rel="noopener">{{ row.product_name }}</a>{% else %}{{ row.product_name }}{% endif %}</p>{% endif %}
        {% if row.message %}<p class="admin-inquiry__text">{{ row.message|nl2br }}</p>{% endif %}
        {% if row.admin_note %}<p class="admin-inquiry__note">{{ ui_icon('pencil', 12) }} {{ row.admin_note|nl2br }}</p>{% endif %}
    </div>
    <div class="admin-inquiry__side">
        <details class="admin-inquiry__reply"><summary class="admin-button is-primary">{{ ui_icon('send', 16) }}<span>{{ ui_text('admin.inquiry.reply') }}</span></summary>
            <form method="post" action="{{ path('admin_commerce_inquiries_reply', {id: row.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('inquiry_reply_' ~ row.id) }}">
                <textarea name="reply" rows="4" maxlength="4000" required placeholder="{{ ui_text('admin.inquiry.reply_placeholder')|e('html_attr') }}"></textarea>
                <div class="admin-inquiry__channels">{% if row.email %}<label class="admin-check"><input type="radio" name="channel" value="email" checked><span>{{ ui_icon('mail', 14) }} E-mail</span></label>{% endif %}{% if row.phone and sms_enabled %}<label class="admin-check"><input type="radio" name="channel" value="sms"{{ row.email ? '' : ' checked' }}><span>{{ ui_icon('smartphone', 14) }} SMS</span></label>{% endif %}</div>
                <button class="admin-button is-primary" type="submit">{{ ui_text('admin.inquiry.send') }}</button>
            </form>
        </details>
        <form method="post" class="inquiry-update-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('inquiry_update_' ~ row.id) }}"><input type="hidden" name="id" value="{{ row.id }}"><select name="status" aria-label="{{ ui_text('admin.commerce.customers.status') }}">{% for st in ['new','in_progress','resolved','closed'] %}<option value="{{ st }}"{{ row.status == st ? ' selected' : '' }}>{{ st|status_label('inquiry_status') }}</option>{% endfor %}</select><input type="hidden" name="admin_note" value="{{ row.admin_note|e('html_attr') }}"><button type="submit" class="admin-button">{{ ui_text('admin.commerce.inquiries.zberehty') }}</button></form>
    </div>
</article>
{% else %}<p class="admin-empty">{{ ui_text('admin.commerce.inquiries.zvernen_shche_nemaie') }}</p>{% endfor %}</section>
{{ shell.end() }}