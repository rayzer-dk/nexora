{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.marketing_automation.marketynhova_avtomatyzatsiia'),'marketing_automation') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.commerce.marketing_automation.marketynh') }}</span></nav><h1>{{ ui_text('admin.commerce.marketing_automation.avtomatyzatsiia_ta_atrybutsiia') }}</h1><p>{{ ui_text('admin.commerce.marketing_automation.lifecycle_lysty_pratsiuiut_lyshe_dlia_pidtverdzh') }}</p></div><span class="admin-badge">{{ ui_text('ui.admin.commerce.marketing_automation.consent_safe') }}</span></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<div data-tabs="marketing" data-tabs-flex>
<section class="admin-panel" data-tab="carts" data-tab-icon="shopping-cart" data-tab-count="{{ abandoned_stats.total }}" data-tab-label="{{ ui_text('admin.carts.tab') }}">
<div class="admin-panel__header"><div><small>{{ ui_text('admin.carts.eyebrow') }}</small><h2>{{ ui_text('admin.carts.title') }}</h2><p>{{ ui_text('admin.carts.intro') }}</p></div></div>
<section class="admin-stats">
<article><span>{{ ui_text('admin.carts.stat_total') }}</span><strong>{{ abandoned_stats.total }}</strong><small>{{ ui_text('admin.carts.stat_total_hint') }}</small></article>
<article><span>{{ ui_text('admin.carts.stat_contact') }}</span><strong>{{ abandoned_stats.with_contact }}</strong><small>{{ ui_text('admin.carts.stat_contact_hint') }}</small></article>
<article><span>{{ ui_text('admin.carts.stat_emailed') }}</span><strong>{{ abandoned_stats.emailed }}</strong><small>{{ ui_text('admin.carts.stat_emailed_hint') }}</small></article>
<article><span>{{ ui_text('admin.carts.stat_recovered') }}</span><strong>{{ abandoned_stats.recovered }}</strong><small>{{ (abandoned_stats.value_minor/100)|number_format(0,',',' ') }} {{ ui_text('admin.carts.stat_value') }}</small></article>
</section>
{% if abandoned %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.carts.col_customer') }}</th><th>{{ ui_text('admin.carts.col_contact') }}</th><th>{{ ui_text('admin.carts.col_items') }}</th><th>{{ ui_text('admin.carts.col_total') }}</th><th>{{ ui_text('admin.carts.col_when') }}</th><th>{{ ui_text('admin.carts.col_email') }}</th></tr></thead><tbody>
{% for c in abandoned %}<tr><td><strong>{{ admin_can('personal_data.view') ? (c.display_name|default(ui_text('admin.carts.guest'))) : ui_text('admin.carts.hidden') }}</strong></td><td>{% if admin_can('personal_data.view') %}{% if c.phone_e164 %}<a href="tel:{{ c.phone_e164 }}">{{ c.phone_e164 }}</a><br>{% endif %}{% if c.email %}<small>{{ c.email }}</small>{% elseif not c.phone_e164 %}<span class="admin-muted">{{ ui_text('admin.carts.no_contact') }}</span>{% endif %}{% else %}—{% endif %}</td>
<td><ul class="admin-cart-items">{% for i in c.items|slice(0, 4) %}<li>{{ i.name }} <small>× {{ i.quantity * 1 }}</small></li>{% endfor %}{% if c.items|length > 4 %}<li><small>+{{ c.items|length - 4 }}</small></li>{% endif %}</ul></td>
<td><strong>{{ (c.total_minor/100)|number_format(2,',',' ') }} {{ c.currency }}</strong></td><td>{{ c.updated_at|slice(0, 16) }}</td>
<td><span class="admin-badge is-{{ c.mail_state == 'recovered' ? 'success' : (c.mail_state == 'sent' ? 'info' : (c.mail_state == 'no_contact' ? 'muted' : 'warning')) }}">{{ ui_text('admin.carts.mail.' ~ c.mail_state) }}</span>{% if c.mail_at %}<br><small>{{ c.mail_at|slice(0, 16) }}</small>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="admin-help">{{ ui_text('admin.carts.empty') }}</p>{% endif %}
</section>
<div class="admin-split" data-tab="emails" data-tab-icon="mail" data-tab-label="{{ ui_text('admin.carts.tab_emails') }}">
{% for code,label in types %}{% set a=automations[code] ?? null %}
<section class="admin-panel"><div><small>{{ code }}</small><h2>{{ label }}</h2><p>{% if code == 'abandoned_cart' %}{{ ui_text('admin.commerce.marketing_automation.nahaduie_pro_aktyvnyi_koshyk_pislia_periodu_bezd') }}{% elseif code == 'post_purchase' %}{{ ui_text('admin.commerce.marketing_automation.nadsylaie_follow_up_pislia_zamovlennia_dohliad_a') }}{% else %}{{ ui_text('admin.commerce.marketing_automation.povertaie_kliientiv_iaki_davno_ne_robyly_novykh_') }}{% endif %}</p></div>
<form method="post" class="admin-form"><input type="hidden" name="automation_type" value="{{ code }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('marketing_automation_' ~ code) }}">
<label><span>{{ ui_text('admin.commerce.marketing_automation.uvimkneno') }}</span><input type="checkbox" name="enabled" value="1"{{ a and a.enabled ? ' checked' : '' }}></label>
<label><span>{{ ui_text('admin.commerce.marketing_automation.zatrymka_hodyn') }}</span><input type="number" name="delay_hours" min="1" max="8760" value="{{ a.delay_hours ?? (code == 'abandoned_cart' ? 24 : (code == 'post_purchase' ? 72 : 4320)) }}" required></label>
<label><span>{{ ui_text('admin.commerce.marketing_automation.tema') }}</span><input type="text" name="subject" maxlength="255" value="{{ a.subject ?? (code == 'abandoned_cart' ? ui_text('admin.commerce.marketing_automation.vy_zalyshyly_tovary_u_koshyku') : (code == 'post_purchase' ? ui_text('admin.commerce.marketing_automation.diakuiemo_za_pokupku') : ui_text('admin.commerce.marketing_automation.my_skuchyly_za_vamy'))) }}" required></label>
<label class="admin-check"><input type="checkbox" name="is_html" value="1"{{ a.is_html|default(0) ? ' checked' : '' }}><span><strong>{{ ui_text('admin.tpl.html_mode') }}</strong><small>{{ ui_text('admin.tpl.html_mode_hint') }}</small></span></label>
<label><span>{{ ui_text('admin.commerce.marketing_automation.tekst') }}</span><textarea name="body" rows="10" maxlength="20000" required>{{ a.body_text ?? (code == 'abandoned_cart' ? ui_text('admin.commerce.marketing_automation.vashi_tovary_vse_shche_chekaiut_vidnovit_koshyk_') : (code == 'post_purchase' ? ui_text('admin.commerce.marketing_automation.diakuiemo_za_zamovlennia_yakshcho_potribna_dopom') : ui_text('admin.commerce.marketing_automation.davno_ne_bachylysia_perehliante_novynky_ta_aktua'))) }}</textarea><small>{{ ui_text('admin.commerce.marketing_automation.dostupni_zminni') }} {{ '{{customer_name}}' }}, {{ '{{coupon_code}}' }}, {{ '{{cart_url}}' }}, {{ '{{account_url}}' }}.</small></label>
<label><span>{{ ui_text('admin.commerce.marketing_automation.promokod_neobov_iazkovo') }}</span><input type="text" name="coupon_code" maxlength="64" value="{{ a.coupon_code ?? '' }}"></label><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.commerce.marketing_automation.zberehty') }}</button></div></form></section>{% endfor %}
</div>
<section class="admin-panel" data-tab="results" data-tab-icon="chart-column" data-tab-label="{{ ui_text('admin.carts.tab_results') }}"><div><small>{{ ui_text('admin.commerce.marketing_automation.rezultaty') }}</small><h2>{{ ui_text('admin.commerce.marketing_automation.dostavky_avtomatyzatsii') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.commerce.marketing_automation.stsenarii') }}</th><th>{{ ui_text('admin.commerce.marketing_automation.postavleno_v_cherhu') }}</th><th>{{ ui_text('admin.commerce.marketing_automation.vidnovleno_koshykiv') }}</th></tr></thead><tbody>{% for r in stats %}<tr><td>{{ types[r.automation_type] ?? r.automation_type }}</td><td>{{ r.deliveries }}</td><td>{{ r.recovered ?? 0 }}</td></tr>{% else %}<tr><td colspan="3" class="admin-empty">{{ ui_text('admin.commerce.marketing_automation.shche_nemaie_dostavok') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel" data-tab="attribution" data-tab-icon="target" data-tab-label="{{ ui_text('admin.carts.tab_attribution') }}"><div><small>{{ ui_text('admin.commerce.marketing_automation.90_dniv') }}</small><h2>{{ ui_text('admin.commerce.marketing_automation.last_touch_atrybutsiia_zamovlen') }}</h2><p>{{ ui_text('admin.commerce.marketing_automation.utm_zberihaiutsia_iak_snapshot_zamovlennia_direc') }}</p></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('ui.admin.commerce.marketing_automation.source') }}</th><th>{{ ui_text('ui.admin.commerce.marketing_automation.medium') }}</th><th>{{ ui_text('admin.commerce.marketing_automation.zamovlen') }}</th><th>{{ ui_text('admin.commerce.marketing_automation.vyruchka') }}</th></tr></thead><tbody>{% for r in attribution %}<tr><td>{{ r.source }}</td><td>{{ r.medium }}</td><td>{{ r.orders }}</td><td>{{ (r.revenue_minor / 100)|number_format(2,'.',' ') }} {{ r.currency }}</td></tr>{% else %}<tr><td colspan="4" class="admin-empty">{{ ui_text('admin.commerce.marketing_automation.danykh_atrybutsii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
</div>
{{ shell.end() }}
