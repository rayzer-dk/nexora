{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.promotions.aktsii_ta_promokody'),'promotions') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.commerce.promotions.prodazhi') }}</small><h1>{{ ui_text('admin.commerce.promotions.aktsii_ta_promokody') }}</h1><p>{{ ui_text('admin.commerce.promotions.serverni_pravyla_znyzhok_pidsumok_checkout_nikol') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% if admin_can('marketing.manage') %}<section class="admin-runtime__panel"><div><small>{{ ui_text('admin.commerce.promotions.nova_aktsiia') }}</small><h2>{{ ui_text('admin.commerce.promotions.avtomatychna_znyzhka_abo_promokod') }}</h2></div><form method="post" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('promotion_save') }}"><label><span>{{ ui_text('admin.commerce.promotions.nazva') }}</span><input type="text" name="name" required maxlength="190"></label><label><span>{{ ui_text('admin.commerce.promotions.mekhanika') }}</span><select name="trigger_type"><option value="automatic">{{ ui_text('admin.commerce.promotions.avtomatychna') }}</option><option value="coupon">{{ ui_text('admin.commerce.promotions.promokod') }}</option></select></label><label><span>{{ ui_text('admin.commerce.promotions.promokod') }}</span><input type="text" name="code" maxlength="64" placeholder="SAVE10"></label><label><span>{{ ui_text('admin.commerce.promotions.typ_znyzhky') }}</span><select name="discount_type"><option value="percent">{{ ui_text('admin.commerce.promotions.vidsotok') }}</option><option value="fixed">{{ ui_text('admin.commerce.promotions.fiksovana_suma') }}</option></select></label><label><span>{{ ui_text('admin.commerce.promotions.rozmir') }}</span><input type="number" name="discount_value" step="0.01" min="0.01" required></label><label><span>{{ ui_text('admin.commerce.promotions.minimalna_suma_koshyka') }}</span><input type="number" name="min_subtotal" step="0.01" min="0" value="0"></label><label><span>{{ ui_text('admin.commerce.promotions.zahalnyi_limit') }}</span><input type="number" name="usage_limit" min="0" value="0"><small>{{ ui_text('admin.commerce.promotions.0_bez_limitu') }}</small></label><label><span>{{ ui_text('admin.commerce.promotions.limit_na_kliienta') }}</span><input type="number" name="per_customer_limit" min="0" value="0"></label><label><span>{{ ui_text('admin.commerce.promotions.priorytet') }}</span><input type="number" name="priority" value="100"></label><label><span>{{ ui_text('admin.commerce.promotions.pochatok') }}</span><input type="datetime-local" name="starts_at"></label><label><span>{{ ui_text('admin.commerce.promotions.zavershennia') }}</span><input type="datetime-local" name="ends_at"></label><label><span>{{ ui_text('admin.commerce.promotions.id_tovariv') }}</span><input type="text" name="product_ids" placeholder="12, 15, 18"><small>{{ ui_text('admin.commerce.promotions.porozhno_usi_tovary') }}</small></label><label><span>{{ ui_text('admin.commerce.promotions.id_katehorii') }}</span><input type="text" name="category_ids" placeholder="3, 7"><small>{{ ui_text('admin.commerce.promotions.porozhno_usi_katehorii') }}</small></label><label><span>{{ ui_text('admin.commerce.promotions.hrupy_pokuptsiv') }}</span><input type="text" name="customer_groups" placeholder="{{ ui_text('ui.admin.commerce.promotions.default_vip_wholesale_guest')|e('html_attr') }}"><small>{{ ui_text('admin.commerce.promotions.porozhno_usi_hrupy_guest_nezareiestrovani') }}</small></label><label class="admin-check"><input type="checkbox" name="stop_processing" value="1"><span>{{ ui_text('admin.commerce.promotions.ne_zastosovuvaty_nyzhchi_za_priorytetom_aktsii_p') }}</span></label><div class="admin-form-actions"><button type="submit">{{ ui_text('admin.commerce.promotions.stvoryty_aktsiiu') }}</button></div></form></section>{% endif %}
<section class="admin-runtime__panel"><div><small>{{ ui_text('admin.commerce.promotions.pravyla') }}</small><h2>{{ ui_text('admin.commerce.promotions.aktyvni_ta_vymkneni') }}</h2></div><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>{{ ui_text('admin.commerce.promotions.nazva') }}</th><th>{{ ui_text('admin.commerce.promotions.kod') }}</th><th>{{ ui_text('admin.commerce.promotions.znyzhka') }}</th><th>{{ ui_text('admin.commerce.promotions.vykorystano') }}</th><th>{{ ui_text('admin.commerce.promotions.status') }}</th><th>{{ ui_text('admin.commerce.promotions.diia') }}</th></tr></thead><tbody>{% for p in promotions %}<tr><td><strong>{{ p.name }}</strong><small>{{ ui_text('admin.commerce.promotions.priorytet') }} {{ p.priority }}</small></td><td>{{ p.code|default(ui_text('admin.commerce.promotions.avtomatychno')) }}</td><td>{% if p.discount_type == 'percent' %}{{ (p.discount_value / 100)|number_format(2, ',', ' ') }}%{% else %}{{ (p.discount_value / 100)|number_format(2, ',', ' ') }}{% endif %}</td><td>{{ p.usage_count }}{% if p.usage_limit %} / {{ p.usage_limit }}{% endif %}</td><td><span class="admin-status {{ p.status == 'active' ? 'is-success' : '' }}">{{ p.status }}</span></td><td>{% if admin_can('marketing.manage') %}<form method="post" action="{{ path('admin_commerce_promotion_toggle',{id:p.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('promotion_toggle_' ~ p.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text('admin.commerce.promotions.uvimknuty_abo_vymknuty_pravylo') }}">{{ p.status == 'active' ? '⏸' : '▶' }}</button></form>{% else %}<span class="admin-status-pill">{{ ui_text('admin.commerce.promotions.tilky_perehliad') }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.commerce.promotions.aktsii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
