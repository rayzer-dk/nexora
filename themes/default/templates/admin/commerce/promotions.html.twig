{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.promotions.aktsii_ta_promokody'),'promotions') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.commerce.promotions.prodazhi') }}</span></nav><h1>{{ ui_text('admin.commerce.promotions.aktsii_ta_promokody') }} {% include '@storefront/admin/_tip.html.twig' with {key:'promotions'} only %}</h1><p>{{ ui_text('admin.commerce.promotions.serverni_pravyla_znyzhok_pidsumok_checkout_nikol') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% if admin_can('marketing.manage') %}<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.promotions.nova_aktsiia') }}</small><h2>{{ ui_text('admin.commerce.promotions.avtomatychna_znyzhka_abo_promokod') }}</h2></div>{% import '@storefront/admin/commerce/_promotion_form.html.twig' as pf %}{{ pf.form(null, '', 'promotion_save', ui_text('admin.commerce.promotions.stvoryty_aktsiiu'), markets, category_options, group_options) }}</section>{% endif %}
<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.promotions.pravyla') }}</small><h2>{{ ui_text('admin.commerce.promotions.aktyvni_ta_vymkneni') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.commerce.promotions.nazva') }}</th><th>{{ ui_text('admin.commerce.promotions.kod') }}</th><th>{{ ui_text('admin.commerce.promotions.znyzhka') }}</th><th>{{ ui_text('admin.commerce.promotions.vykorystano') }}</th><th>{{ ui_text('admin.promo.given') }}</th><th>{{ ui_text('admin.promo.period') }}</th><th>{{ ui_text('admin.commerce.promotions.status') }}</th><th>{{ ui_text('admin.commerce.promotions.diia') }}</th></tr></thead><tbody>{% for p in promotions %}<tr><td><a href="{{ path('admin_commerce_promotion_edit', {id: p.id}) }}" data-row-open><strong>{{ p.name }}</strong></a><small>{{ ui_text('admin.commerce.promotions.priorytet') }} {{ p.priority }}</small></td><td>{{ p.code|default(ui_text('admin.commerce.promotions.avtomatychno')) }}</td><td>{% if p.discount_type == 'percent' %}{{ (p.discount_value / 100)|number_format(2, ',', ' ') }}%{% else %}{{ (p.discount_value / 100)|number_format(2, ',', ' ') }}{% endif %}</td><td>{{ p.usage_count }}{% if p.usage_limit %} / {{ p.usage_limit }}{% endif %}</td><td class="is-nowrap">{{ (stats[p.id].discount_minor|default(0) / 100)|number_format(2, ',', ' ') }}</td><td class="is-nowrap">{{ p.starts_at ? p.starts_at|slice(0, 10) : '…' }} — {{ p.ends_at ? p.ends_at|slice(0, 10) : '…' }}</td><td>{{ status_badge(p.status) }}</td><td>{% if admin_can('marketing.manage') %}<form method="post" action="{{ path('admin_commerce_promotion_toggle',{id:p.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('promotion_toggle_' ~ p.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text('admin.commerce.promotions.uvimknuty_abo_vymknuty_pravylo') }}" aria-label="{{ ui_text('admin.commerce.promotions.uvimknuty_abo_vymknuty_pravylo') }}">{{ ui_icon(p.status == 'active' ? 'pause' : 'play', 18) }}</button></form><a class="admin-icon-button" href="{{ path('admin_commerce_promotion_edit', {id: p.id}) }}" title="{{ ui_text('admin.promo.edit') }}" aria-label="{{ ui_text('admin.promo.edit') }}">{{ ui_icon('pencil', 18) }}</a><form method="post" action="{{ path('admin_commerce_promotion_duplicate', {id: p.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('promotion_toggle_' ~ p.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text('admin.promo.duplicate') }}" aria-label="{{ ui_text('admin.promo.duplicate') }}">{{ ui_icon('copy', 18) }}</button></form><form method="post" action="{{ path('admin_commerce_promotion_delete', {id: p.id}) }}" data-confirm="{{ ui_text('admin.promo.delete_confirm') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('promotion_toggle_' ~ p.id) }}"><button class="admin-icon-button is-danger" type="submit" title="{{ ui_text('admin.fields.delete') }}" aria-label="{{ ui_text('admin.fields.delete') }}">{{ ui_icon('trash-2', 18) }}</button></form>{% else %}<span class="admin-badge">{{ ui_text('admin.commerce.promotions.tilky_perehliad') }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="8" class="admin-empty">{{ ui_text('admin.commerce.promotions.aktsii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
