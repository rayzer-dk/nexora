{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.customers.pokuptsi'),'customers') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('ui.admin.commerce.customers.customers') }}</small><h1>{{ ui_text('admin.commerce.customers.pokuptsi_ta_hrupy') }}</h1><p>{{ ui_text('admin.commerce.customers.hrupa_vykorystovuietsia_pravylamy_aktsii_default') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="store-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-runtime__panel"><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>{{ ui_text('admin.commerce.customers.pokupets') }}</th><th>Email</th><th>{{ ui_text('admin.commerce.customers.status') }}</th><th>{{ ui_text('admin.commerce.customers.hrupa') }}</th><th>{{ ui_text('admin.commerce.customers.data') }}</th></tr></thead><tbody>{% for c in rows %}<tr><td><strong>{{ c.display_name|default('—') }}</strong></td><td>{% if admin_can('personal_data.view') %}{{ c.email }}{% else %}<span class="admin-status-pill">{{ ui_text('admin.commerce.customers.prykhovano') }}</span>{% endif %}</td><td><span class="admin-status-pill">{{ c.status }}</span></td><td>{% if admin_can('customers.manage') %}<form method="post" class="admin-inline-actions"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_group_' ~ c.id) }}"><input type="hidden" name="id" value="{{ c.id }}"><input type="text" name="customer_group_code" value="{{ c.customer_group_code|default('default') }}" pattern="[a-z0-9_-]{1,64}" maxlength="64" required><button type="submit">{{ ui_text('admin.commerce.customers.zberehty') }}</button></form>{% else %}<span class="admin-status-pill">{{ c.customer_group_code|default('default') }}</span>{% endif %}</td><td>{{ c.created_at|local_datetime }}</td></tr>{% else %}<tr><td colspan="5" class="admin-empty">{{ ui_text('admin.commerce.customers.pokuptsiv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>{{ shell.end() }}
