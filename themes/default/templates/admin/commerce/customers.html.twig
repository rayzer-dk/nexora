{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.customers.pokuptsi'),'customers') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('ui.admin.commerce.customers.customers') }}</span></nav><h1>{{ ui_text('admin.commerce.customers.pokuptsi_ta_hrupy') }}</h1><p>{{ ui_text('admin.commerce.customers.hrupa_vykorystovuietsia_pravylamy_aktsii_default') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<form method="get" class="admin-filters admin-filters--inline admin-panel"><label>{{ ui_text('admin.customers.search') }}<input type="search" name="q" value="{{ filters.q }}" placeholder="{{ ui_text('admin.customers.search_ph') }}"></label><label>{{ ui_text('admin.commerce.customers.hrupa') }}<select name="group"><option value="">{{ ui_text('admin.filter.all') }}</option>{% for g in groups %}<option value="{{ g }}"{{ filters.group == g ? ' selected' : '' }}>{{ g }}</option>{% endfor %}</select></label><label>{{ ui_text('admin.commerce.customers.status') }}<select name="status"><option value="">{{ ui_text('admin.filter.all') }}</option><option value="active"{{ filters.status == 'active' ? ' selected' : '' }}>{{ 'active'|status_label }}</option><option value="blocked"{{ filters.status == 'blocked' ? ' selected' : '' }}>{{ 'blocked'|status_label }}</option></select></label><label>{{ ui_text('admin.customers.sort') }}<select name="sort">{% for k in ['new','spent','orders','last'] %}<option value="{{ k }}"{{ filters.sort == k ? ' selected' : '' }}>{{ ui_text('admin.customers.sort.' ~ k) }}</option>{% endfor %}</select></label><div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.orders.index.zastosuvaty') }}</button></div></form>
<section class="admin-stats"><article><span>{{ ui_text('admin.customers.total') }}</span><strong>{{ totals.total|default(0) }}</strong></article><article><span>{{ ui_text('admin.customers.new30') }}</span><strong>{{ totals.new30|default(0) }}</strong></article><article><span>{{ ui_text('admin.customers.blocked') }}</span><strong>{{ totals.blocked|default(0) }}</strong></article></section>
<section class="admin-panel"><div class="admin-inline-actions"><a class="admin-button" href="{{ path('admin_commerce_customers_export') }}">{{ ui_icon('download', 16) }} {{ ui_text('admin.customers.export') }}</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.commerce.customers.pokupets') }}</th><th>Email</th><th>{{ ui_text('admin.customers.phone') }}</th><th>{{ ui_text('admin.customers.orders') }}</th><th>{{ ui_text('admin.customers.spent') }}</th><th>{{ ui_text('admin.commerce.customers.status') }}</th><th>{{ ui_text('admin.commerce.customers.hrupa') }}</th><th>{{ ui_text('admin.commerce.customers.data') }}</th></tr></thead><tbody>{% for c in rows %}<tr><td><a href="{{ path('admin_commerce_customer_view', {id: c.id}) }}" data-row-open><strong>{{ c.display_name|default('—') }}</strong></a></td><td>{% if admin_can('personal_data.view') %}{{ c.email }}{% else %}<span class="admin-badge">{{ ui_text('admin.commerce.customers.prykhovano') }}</span>{% endif %}</td><td>{% if admin_can('personal_data.view') and c.phone_e164 %}<a href="tel:{{ c.phone_e164 }}">{{ c.phone_e164 }}</a>{% else %}—{% endif %}</td><td data-sort="{{ c.orders_count }}">{{ c.orders_count }}{% if c.last_order_at %}<small>{{ ui_text('admin.customers.last') }}: {{ c.last_order_at|slice(0, 10) }}</small>{% endif %}</td><td class="is-nowrap">{% if c.orders_count > 0 %}<strong>{{ (c.spent_minor / 100)|number_format(2, ',', ' ') }} {{ c.currency }}</strong>{% else %}—{% endif %}</td><td><span class="admin-badge is-{{ c.status }}">{{ c.status|status_label }}</span></td><td>{% if admin_can('customers.manage') %}<form method="post" class="admin-group-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_group_' ~ c.id) }}"><input type="hidden" name="id" value="{{ c.id }}"><input type="text" name="customer_group_code" value="{{ c.customer_group_code|default('default') }}" pattern="[a-z0-9_-]{1,64}" maxlength="64" required><button type="submit">{{ ui_text('admin.commerce.customers.zberehty') }}</button></form>{% else %}<span class="admin-badge">{{ c.customer_group_code|default('default') }}</span>{% endif %}</td><td>{{ c.created_at }}</td></tr>{% else %}<tr><td colspan="8" class="admin-empty">{{ ui_text('admin.commerce.customers.pokuptsiv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>{{ shell.end() }}
