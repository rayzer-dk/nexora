{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.campaigns.kampanii'),'campaigns') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.commerce.campaigns.marketynh') }}</span></nav><h1>{{ ui_text('admin.commerce.campaigns.email_kampanii') }}</h1><p>{{ ui_text('admin.commerce.campaigns.rozsylka_lyshe_pidtverdzhenym_double_opt_in_pidp') }}</p></div><span class="admin-badge">{{ subscribers }} {{ ui_text('admin.commerce.campaigns.aktyvnykh') }}</span></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel admin-howto"><h2>{{ ui_text('admin.campaigns.howto.title') }}</h2><ol><li>{{ ui_text('admin.campaigns.howto.step1') }}</li><li>{{ ui_text('admin.campaigns.howto.step2') }}</li><li>{{ ui_text('admin.campaigns.howto.step3') }}</li><li>{{ ui_text('admin.campaigns.howto.step4') }}</li></ol></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.campaigns.nova_kampaniia') }}</small><h2>{{ ui_text('admin.commerce.campaigns.postavyty_lysty_v_cherhu') }}</h2><p>{{ ui_text('admin.commerce.campaigns.vidpravka_vykonuietsia_notification_worker_i_ne_') }}</p></div><form method="post" class="admin-form" data-admin-ajax="buttons"><input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign_send') }}"><div class="campaign-tools" data-campaign-tools data-url-templates="{{ path('admin_commerce_campaign_template_save') }}" data-url-preview="{{ path('admin_commerce_campaign_preview') }}">
<label><span>{{ ui_text('admin.campaigns.templates') }}</span><select data-template-select><option value="">{{ ui_text('admin.campaigns.templates_none') }}</option>{% for tpl in templates %}<option value="{{ tpl.id }}" data-show="{{ path('admin_commerce_campaign_template_show', {id: tpl.id}) }}" data-delete="{{ path('admin_commerce_campaign_template_delete', {id: tpl.id}) }}">{{ tpl.name }}</option>{% endfor %}</select></label>
<button type="button" class="admin-button" data-template-load>{{ ui_icon('download', 16) }} {{ ui_text('admin.campaigns.template_load') }}</button>
<button type="button" class="admin-button is-danger" data-template-delete data-confirm-text="{{ ui_text('admin.campaigns.template_delete_confirm')|e('html_attr') }}">{{ ui_icon('trash-2', 16) }} {{ ui_text('admin.campaigns.template_delete') }}</button>
<label><span>{{ ui_text('admin.campaigns.template_name') }}</span><input type="text" data-template-name maxlength="120"></label>
<button type="button" class="admin-button" data-template-save>{{ ui_icon('save', 16) }} {{ ui_text('admin.campaigns.template_save') }}</button>
<button type="button" class="admin-button" data-campaign-preview>{{ ui_icon('eye', 16) }} {{ ui_text('admin.campaigns.preview') }}</button>
<small data-campaign-status role="status"></small>
</div>
<iframe class="admin-email-frame" data-campaign-frame title="{{ ui_text('admin.campaigns.preview')|e('html_attr') }}" hidden></iframe>
<label><span>{{ ui_text('admin.commerce.campaigns.sehment') }}</span><select name="segment">{% for code,label in segments %}<option value="{{ code }}">{{ label }}</option>{% endfor %}</select></label><label><span>{{ ui_text('admin.commerce.campaigns.tema') }}</span><input type="text" name="subject" maxlength="255" required></label><label><span>{{ ui_text('admin.campaigns.format') }}</span><select name="format"><option value="text">{{ ui_text('admin.campaigns.format_text') }}</option><option value="html">{{ ui_text('admin.campaigns.format_html') }}</option><option value="html_raw">{{ ui_text('admin.campaigns.format_raw') }}</option></select><small>{{ ui_text('admin.campaigns.format_hint') }}</small></label><label><span>{{ ui_text('admin.commerce.campaigns.tekst') }}</span><textarea name="body" rows="12" maxlength="20000" required></textarea></label><label><span>{{ ui_text('admin.campaigns.test_to') }}</span><input type="email" name="test_to" placeholder="you@example.com"></label><div class="admin-form-actions"><button class="admin-button" type="submit" data-admin-ajax-submit formaction="{{ path('admin_commerce_campaign_test') }}" formnovalidate>{{ ui_icon('send', 16) }} {{ ui_text('admin.campaigns.test_button') }}</button><a class="admin-button" href="{{ path('admin_commerce_subscribers_export') }}">{{ ui_icon('download', 16) }} {{ ui_text('admin.campaigns.export_subscribers') }}</a><button class="admin-button is-primary" type="submit" data-confirm="{{ ui_text('admin.commerce.campaigns.postavyty_kampaniiu_v_cherhu_dlia_vsikh_aktyvnyk') }}">{{ ui_text('admin.commerce.campaigns.postavyty_v_cherhu') }}</button></div></form></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.campaigns.istoriia') }}</small><h2>{{ ui_text('admin.commerce.campaigns.ostanni_kampanii') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>{{ ui_text('admin.commerce.campaigns.tema') }}</th><th>{{ ui_text('admin.commerce.campaigns.sehment') }}</th><th>{{ ui_text('admin.commerce.campaigns.status') }}</th><th>{{ ui_text('admin.commerce.campaigns.otrymuvachiv') }}</th><th>{{ ui_text('admin.commerce.campaigns.stvoreno') }}</th><th>{{ ui_text('admin.campaigns.actions') }}</th></tr></thead><tbody>{% for r in rows %}<tr><td>#{{ r.id }}</td><td><strong>{{ r.subject }}</strong></td><td>{{ segments[r.segment_code] ?? r.segment_code }}</td><td><span class="admin-badge is-{{ r.status }}">{{ r.status }}</span></td><td>{{ r.recipient_count }}</td><td>{{ r.created_at }}</td><td class="admin-row-actions"><button type="button" class="admin-button" data-campaign-reuse data-show="{{ path('admin_commerce_campaign_show', {id: r.id}) }}">{{ ui_icon('copy', 16) }} {{ ui_text('admin.campaigns.reuse') }}</button>{% if r.status not in ['queued','enqueuing'] %}<button type="button" class="admin-button is-danger" data-campaign-delete data-delete="{{ path('admin_commerce_campaign_delete', {id: r.id}) }}" data-confirm-text="{{ ui_text('admin.campaigns.delete_confirm')|e('html_attr') }}">{{ ui_icon('trash-2', 16) }}</button>{% endif %}</td></tr>{% else %}<tr><td colspan="7" class="admin-empty">{{ ui_text('admin.commerce.campaigns.kampanii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
