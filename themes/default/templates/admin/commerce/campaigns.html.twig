{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.commerce.campaigns.kampanii'),'campaigns') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.commerce.campaigns.marketynh') }}</span></nav><h1>{{ ui_text('admin.commerce.campaigns.email_kampanii') }}</h1><p>{{ ui_text('admin.commerce.campaigns.rozsylka_lyshe_pidtverdzhenym_double_opt_in_pidp') }}</p></div><span class="admin-badge">{{ subscribers }} {{ ui_text('admin.commerce.campaigns.aktyvnykh') }}</span></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel admin-howto"><h2>{{ ui_text('admin.campaigns.howto.title') }}</h2><ol><li>{{ ui_text('admin.campaigns.howto.step1') }}</li><li>{{ ui_text('admin.campaigns.howto.step2') }}</li><li>{{ ui_text('admin.campaigns.howto.step3') }}</li><li>{{ ui_text('admin.campaigns.howto.step4') }}</li></ol></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.campaigns.nova_kampaniia') }}</small><h2>{{ ui_text('admin.commerce.campaigns.postavyty_lysty_v_cherhu') }}</h2><p>{{ ui_text('admin.commerce.campaigns.vidpravka_vykonuietsia_notification_worker_i_ne_') }}</p></div><form method="post" class="admin-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign_send') }}"><label><span>{{ ui_text('admin.commerce.campaigns.sehment') }}</span><select name="segment">{% for code,label in segments %}<option value="{{ code }}">{{ label }}</option>{% endfor %}</select></label><label><span>{{ ui_text('admin.commerce.campaigns.tema') }}</span><input type="text" name="subject" maxlength="255" required></label><label><span>{{ ui_text('admin.commerce.campaigns.tekst') }}</span><textarea name="body" rows="8" maxlength="20000" required></textarea></label><div class="admin-form-actions"><button class="admin-button is-primary" type="submit" data-confirm="{{ ui_text('admin.commerce.campaigns.postavyty_kampaniiu_v_cherhu_dlia_vsikh_aktyvnyk') }}">{{ ui_text('admin.commerce.campaigns.postavyty_v_cherhu') }}</button></div></form></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.commerce.campaigns.istoriia') }}</small><h2>{{ ui_text('admin.commerce.campaigns.ostanni_kampanii') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>{{ ui_text('admin.commerce.campaigns.tema') }}</th><th>{{ ui_text('admin.commerce.campaigns.sehment') }}</th><th>{{ ui_text('admin.commerce.campaigns.status') }}</th><th>{{ ui_text('admin.commerce.campaigns.otrymuvachiv') }}</th><th>{{ ui_text('admin.commerce.campaigns.stvoreno') }}</th></tr></thead><tbody>{% for r in rows %}<tr><td>#{{ r.id }}</td><td><strong>{{ r.subject }}</strong></td><td>{{ segments[r.segment_code] ?? r.segment_code }}</td><td><span class="admin-badge is-{{ r.status }}">{{ r.status }}</span></td><td>{{ r.recipient_count }}</td><td>{{ r.created_at }}</td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.commerce.campaigns.kampanii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
