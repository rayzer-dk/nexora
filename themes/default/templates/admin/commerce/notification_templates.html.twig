{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.tpl.title'),'notification_templates') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="{{ path('admin_commerce_notifications') }}">{{ ui_text('admin_notifications') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.tpl.title') }}</span></nav><h1>{{ ui_text('admin.tpl.title') }}</h1><p>{{ ui_text('admin.tpl.intro') }}</p></div><div class="admin-page-actions"><a class="admin-button" href="{{ path('admin_email_preview') }}">{{ ui_icon('external-link', 18) }} {{ ui_text('admin.tpl.preview') }}</a></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<nav class="admin-view-chips" aria-label="{{ ui_text('admin.tpl.language') }}">{% for l in locales %}<a href="{{ path('admin_commerce_notification_templates', {locale: l.code}) }}"{{ l.code == locale ? ' aria-current="page"' : '' }}>{{ l.native_name }}</a>{% endfor %}</nav>
{% set titles = {'order.created': ui_text('admin.tpl.type.order_created'), 'order.status_updated': ui_text('admin.tpl.type.order_status_updated'), 'return.status': ui_text('admin.tpl.type.return_status'), 'inquiry_received': ui_text('admin.tpl.type.inquiry_received'), 'newsletter.confirm': ui_text('admin.tpl.type.newsletter_confirm')} %}
<div data-tabs="tpl">
{% for item in items %}
{% set subject_value = item.stored ? item.stored.subject : item.default.subject %}{% set body_value = item.stored ? item.stored.body : item.default.body %}
<section class="admin-panel" data-notification-template="{{ item.code }}" data-tab="{{ item.code|replace({'.': '-'}) }}" data-tab-label="{{ titles[item.code] }}" data-tab-icon="mail">
<div class="admin-panel__header"><h2>{{ titles[item.code] }}</h2><span class="admin-badge is-{{ item.stored and item.stored.enabled ? 'active' : 'disabled' }}">{{ item.stored and item.stored.enabled ? ui_text('admin.tpl.custom') : ui_text('admin.tpl.default') }}</span></div>
<div data-tabs="tpl-{{ item.code|replace({'.': '-'}) }}" class="tpl-inner">
<div data-tab="edit" data-tab-label="{{ ui_text('admin.tpl.tab_edit') }}" data-tab-icon="pencil">
<form method="post" action="{{ path('admin_commerce_notification_templates_save') }}" class="admin-form-grid" data-tpl-form data-preview-url="{{ path('admin_commerce_notification_templates_preview') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_notification_templates') }}"><input type="hidden" name="code" value="{{ item.code }}"><input type="hidden" name="locale" value="{{ locale }}">
{% if not item.stored %}<p class="admin-help admin-form-wide">{{ ui_text('admin.tpl.default_hint') }}</p>{% endif %}
<label class="admin-form-wide">{{ ui_text('admin.tpl.subject') }}<input type="text" name="subject" maxlength="255" required value="{{ subject_value }}"></label>
<label class="admin-form-wide admin-check"><input type="checkbox" name="is_html" value="1"{{ item.stored and item.stored.is_html ? ' checked' : '' }}><span><strong>{{ ui_text('admin.tpl.html_mode') }}</strong><small>{{ ui_text('admin.tpl.html_mode_hint') }}</small></span></label>
<label class="admin-form-wide">{{ ui_text('admin.tpl.body') }}<textarea name="body" rows="12" maxlength="30000" required>{{ body_value }}</textarea></label>
<div class="admin-form-wide tpl-placeholders"><small>{{ ui_text('admin.tpl.placeholders') }} ({{ ui_text('admin.tpl.placeholders_click') }}):</small> {% for p in item.placeholders %}<button type="button" class="admin-chip" data-insert-placeholder="%{{ p }}%"><code>%{{ p }}%</code></button> {% endfor %}</div>
<label class="admin-check"><input type="checkbox" name="enabled" value="1"{{ item.stored is null or item.stored.enabled ? ' checked' : '' }}> {{ ui_text('admin.tpl.enabled') }}</label>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.blog.save') }}</button></div></form>
{% if item.stored %}<form method="post" action="{{ path('admin_commerce_notification_templates_save') }}" data-confirm="{{ ui_text('admin.tpl.confirm_reset') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_notification_templates') }}"><input type="hidden" name="code" value="{{ item.code }}"><input type="hidden" name="locale" value="{{ locale }}"><input type="hidden" name="action" value="reset"><button class="admin-button is-danger" type="submit">{{ ui_icon('rotate-ccw', 18) }} {{ ui_text('admin.tpl.reset') }}</button></form>{% endif %}
</div>
<div data-tab="preview" data-tab-label="{{ ui_text('admin.tpl.tab_preview') }}" data-tab-icon="eye" hidden><p class="admin-help">{{ ui_text('admin.tpl.preview_hint') }}</p><iframe class="tpl-preview" title="{{ ui_text('admin.tpl.tab_preview') }}" sandbox data-tpl-preview></iframe></div>
<div data-tab="html" data-tab-label="HTML" data-tab-icon="code-xml" hidden><p class="admin-help">{{ ui_text('admin.tpl.html_hint') }}</p><pre class="tpl-html" data-tpl-html tabindex="0"></pre></div>
</div>
</section>
{% endfor %}
</div>
{{ shell.end() }}
