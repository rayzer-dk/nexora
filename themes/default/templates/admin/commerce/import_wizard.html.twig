{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.import.universal.title'),'import_export') }}
<header class="admin-runtime__header"><div><small>CSV / XLSX / OpenCart export</small><h1>{{ ui_text('admin.import.universal.heading') }}</h1><p>{{ ui_text('admin.import.universal.intro') }}</p></div><a class="admin-preview-link" href="{{ path('admin_commerce_import_export') }}">{{ ui_text('admin.import.universal.standard_csv') }}</a></header>
{{ shell.flashes(app.flashes) }}
<section class="admin-runtime__panel"><div><small>{{ ui_text('admin.import.universal.step1') }}</small><h2>{{ ui_text('admin.import.universal.upload_heading') }}</h2><p>{{ ui_text('admin.import.universal.upload_help') }}</p></div><form method="post" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('universal_import') }}"><input type="hidden" name="action" value="inspect"><label><span>{{ ui_text('admin.import.universal.file') }}</span><input type="file" name="import_file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></label><label><span>{{ ui_text('admin.import.universal.saved_profile') }}</span><select name="profile_id"><option value="0">{{ ui_text('admin.import.universal.autodetect') }}</option>{% for profile in profiles %}<option value="{{ profile.id }}">{{ profile.name }}</option>{% endfor %}</select><small>{{ ui_text('admin.import.universal.profile_help') }}</small></label><div class="admin-form-actions"><button type="submit">{{ ui_text('admin.import.universal.read_columns') }}</button></div></form></section>
{% if inspection %}<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('admin.import.universal.step2') }}</small><h2>{{ ui_text('admin.import.universal.mapping_heading') }}</h2><p>{{ ui_text('admin.import.universal.mapping_help') }}</p></div><span class="admin-status-pill">{{ inspection.format|upper }}</span></div><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('universal_import') }}"><input type="hidden" name="action" value="run"><input type="hidden" name="token" value="{{ inspection.token }}"><input type="hidden" name="source_format" value="{{ inspection.format }}"><div class="admin-form-grid">{% for target,label_key in target_fields %}<label><span>{{ ui_text(label_key) }}</span><select name="mapping[{{ target }}]"><option value="">{{ ui_text('admin.import.universal.skip') }}</option>{% for header in inspection.headers %}{% if header %}<option value="{{ header }}" {{ inspection.suggestions[target]|default('') == header ? 'selected' : '' }}>{{ header }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label><span>{{ ui_text('admin.import.universal.save_profile_as') }}</span><input type="text" name="profile_name" maxlength="190" placeholder="{{ ui_text('admin.import.universal.profile_placeholder') }}"><small>{{ ui_text('admin.import.universal.save_profile_help') }}</small></label><label><span>{{ ui_text('admin.import.universal.mode') }}</span><select name="mode"><option value="preview">{{ ui_text('admin.import.universal.preview_only') }}</option><option value="apply">{{ ui_text('admin.import.universal.apply') }}</option></select><small>{{ ui_text('admin.import.universal.preview_recommended') }}</small></label></div><div class="admin-form-actions"><button type="submit">{{ ui_text('admin.import.universal.run') }}</button></div></form></section>
{% if inspection.multilingual|default([]) %}<section class="admin-editor-card"><div class="admin-card-heading"><div><small>i18n</small><h2>{{ ui_text('admin.import.universal.multilingual_detected') }}</h2><p>{{ ui_text('admin.import.universal.multilingual_help') }}</p></div></div><div class="admin-inline-actions">{% for locale, fields in inspection.multilingual %}<span class="admin-status-pill is-active">{{ locale }} · {{ fields|keys|join(', ') }}</span>{% endfor %}</div></section>{% endif %}<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('admin.import.universal.preview') }}</small><h2>{{ ui_text('admin.import.universal.first_rows') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr>{% for h in inspection.headers %}{% if h %}<th>{{ h }}</th>{% endif %}{% endfor %}</tr></thead><tbody>{% for row in inspection.sample %}<tr>{% for h in inspection.headers %}{% if h %}<td>{{ row[h]|default('') }}</td>{% endif %}{% endfor %}</tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% if report %}<section class="admin-runtime__panel"><div><small>{{ ui_text('admin.import.universal.result') }}</small><h2>{{ ui_text('admin.import.universal.report') }}</h2></div><div class="admin-runtime__metrics"><article><span>{{ ui_text('admin.import.universal.rows') }}</span><strong>{{ report.rows }}</strong></article>{% if report.valid is defined %}<article><span>{{ ui_text('admin.import.universal.valid') }}</span><strong>{{ report.valid }}</strong></article><article><span>{{ ui_text('admin.import.universal.invalid') }}</span><strong>{{ report.invalid }}</strong></article>{% else %}<article><span>{{ ui_text('admin.import.universal.created') }}</span><strong>{{ report.created }}</strong></article><article><span>{{ ui_text('admin.import.universal.updated') }}</span><strong>{{ report.updated }}</strong></article><article><span>{{ ui_text('admin.import.universal.errors') }}</span><strong>{{ report.failed }}</strong></article>{% endif %}</div>{% if report.errors %}<div class="admin-notice is-error"><ul>{% for e in report.errors %}<li>{{ e }}</li>{% endfor %}</ul></div>{% endif %}</section>{% endif %}
{{ shell.end() }}
