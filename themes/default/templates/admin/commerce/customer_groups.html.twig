{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.customer_groups.title'),'customer_groups') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.customer_groups.title') }}</span></nav><h1>{{ ui_text('admin.customer_groups.title') }}</h1><p>{{ ui_text('admin.customer_groups.hint') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.customer_groups.code') }}</th><th>{{ ui_text('admin.customer_groups.name') }}</th><th>{{ ui_text('admin.customer_groups.discount') }}</th><th>{{ ui_text('admin.customer_groups.skip_sale') }}</th><th>{{ ui_text('admin.customer_groups.customers') }}</th><th></th></tr></thead><tbody>
{% for g in groups %}<tr><td><code>{{ g.code }}</code><form method="post" id="cg-{{ g.code }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_groups') }}"><input type="hidden" name="code" value="{{ g.code }}"><input type="hidden" name="sort_order" value="{{ g.sort_order }}"></form></td><td><input form="cg-{{ g.code }}" type="text" name="name" value="{{ g.name }}" maxlength="190" required></td><td><input form="cg-{{ g.code }}" type="number" name="discount_percent" value="{{ g.discount_bps / 100 }}" min="0" max="90" step="0.01"> %</td><td><label class="admin-check"><input form="cg-{{ g.code }}" type="checkbox" name="skip_sale_items" value="1"{{ g.skip_sale_items ? ' checked' : '' }}></label></td><td>{{ counts[g.code]|default(0) }}</td>
<td class="is-nowrap"><button class="admin-button is-primary" form="cg-{{ g.code }}" type="submit">{{ ui_text('admin.commerce.customers.zberehty') }}</button>{% if g.code != 'default' %}<form method="post" class="admin-inline-form" data-confirm="{{ ui_text('admin.customer_groups.confirm_delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_groups') }}"><input type="hidden" name="action" value="delete"><input type="hidden" name="code" value="{{ g.code }}"><button class="admin-button is-danger" type="submit">{{ ui_icon('trash-2', 16) }}</button></form>{% endif %}</td></tr>{% endfor %}
</tbody></table></div></section>
<section class="admin-panel"><h2>{{ ui_text('admin.customer_groups.add') }}</h2><form method="post" class="admin-filters admin-filters--inline"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_groups') }}"><label>{{ ui_text('admin.customer_groups.code') }}<input type="text" name="code" pattern="[a-z0-9][a-z0-9_-]{0,63}" maxlength="64" required></label><label>{{ ui_text('admin.customer_groups.name') }}<input type="text" name="name" maxlength="190" required></label><label>{{ ui_text('admin.customer_groups.discount') }} %<input type="number" name="discount_percent" value="0" min="0" max="90" step="0.01"></label><label class="admin-check"><input type="checkbox" name="skip_sale_items" value="1"> {{ ui_text('admin.customer_groups.skip_sale') }}</label><div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('plus', 16) }} {{ ui_text('admin.customer_groups.add') }}</button></div></form></section>{{ shell.end() }}
