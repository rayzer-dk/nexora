<span class="admin-password-field">
    <input type="password" name="{{ name }}" autocomplete="{{ autocomplete }}" {% if minlength is defined %}minlength="{{ minlength }}"{% endif %} required>
    <button type="button" class="admin-password-toggle" data-password-toggle aria-pressed="false" aria-label="{{ ui_text('admin.login.show_password') }}" title="{{ ui_text('admin.login.show_password') }}"><span class="is-off">{{ ui_icon('eye', 18) }}</span><span class="is-on">{{ ui_icon('eye-off', 18) }}</span></button>
</span>
