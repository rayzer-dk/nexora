{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.rewards.index.podarunkovi_kartky_ta_loialnist'),'rewards') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('ui.admin.rewards.index.commerce') }}</small><h1>{{ ui_text('admin.rewards.index.podarunkovi_kartky_ta_loialnist') }}</h1><p>{{ ui_text('admin.rewards.index.balans_kartok_pravyla_bonusiv_i_zhurnal_vykoryst') }}</p></div></header>
{% for m in app.flashes('success') %}<div class="alert alert-success">{{ m }}</div>{% endfor %}{% for m in app.flashes('error') %}<div class="alert alert-danger">{{ m }}</div>{% endfor %}
{% if issued %}<div class="admin-card"><h2>{{ ui_text('admin.rewards.index.novyi_kod') }}</h2><p><strong>{{ issued.code }}</strong></p><p>{{ ui_text('admin.rewards.index.suma') }} {{ (issued.amount_minor/100)|number_format(2,',',' ') }} {{ issued.currency }}</p><p class="muted">{{ ui_text('admin.rewards.index.povnyi_kod_nadali_ne_zberihaietsia_i_povtorno_ne') }}</p></div>{% endif %}
<div class="admin-grid admin-grid--2"><section class="admin-card"><h2>{{ ui_text('admin.rewards.index.vypustyty_kartku') }}</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="issue"><label>{{ ui_text('admin.rewards.index.suma_2') }}<input type="number" min="1" step="0.01" name="amount" required></label><label>{{ ui_text('admin.rewards.index.valiuta') }}<input type="text" name="currency" maxlength="3" value="{{ store_currency }}" required></label><label>{{ ui_text('admin.rewards.index.diie_do') }}<input type="datetime-local" name="expires_at"></label><button class="button button--primary" type="submit">{{ ui_text('admin.rewards.index.stvoryty_kartku') }}</button></form></section>
<section class="admin-card"><h2>{{ ui_text('admin.rewards.index.loialnist') }}</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="loyalty"><label><input type="checkbox" name="enabled" value="1" {% if config.enabled %}checked{% endif %}> {{ ui_text('admin.rewards.index.uvimkneno') }}</label><label>{{ ui_text('admin.rewards.index.baliv_za_1_00') }}<input type="number" min="0" name="earn_points_per_major" value="{{ config.earn_points_per_major }}"></label><label>{{ ui_text('admin.rewards.index.vartist_1_bala_u_minornykh_odynytsiakh') }}<input type="number" min="1" name="redeem_minor_per_point" value="{{ config.redeem_minor_per_point }}"></label><label>{{ ui_text('admin.rewards.index.minimum_baliv_dlia_spysannia') }}<input type="number" min="1" name="min_redeem_points" value="{{ config.min_redeem_points }}"></label><button class="button button--primary" type="submit">{{ ui_text('admin.rewards.index.zberehty') }}</button></form></section></div>
<section class="admin-card"><h2>{{ ui_text('admin.rewards.index.kartky') }}</h2><div class="table-responsive"><table class="table"><thead><tr><th>{{ ui_text('admin.rewards.index.kod') }}</th><th>{{ ui_text('admin.rewards.index.pochatkova_suma') }}</th><th>{{ ui_text('admin.rewards.index.zalyshok') }}</th><th>{{ ui_text('admin.rewards.index.status') }}</th><th>{{ ui_text('admin.rewards.index.diie_do') }}</th></tr></thead><tbody>{% for c in cards %}<tr><td>•••• {{ c.code_last4 }}</td><td>{{ (c.initial_minor/100)|number_format(2,',',' ') }} {{ c.currency }}</td><td>{{ (c.balance_minor/100)|number_format(2,',',' ') }} {{ c.currency }}</td><td>{{ c.status }}</td><td>{{ c.expires_at|local_datetime }}</td></tr>{% else %}<tr><td colspan="5">{{ ui_text('admin.rewards.index.kartok_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>{{ shell.end() }}
