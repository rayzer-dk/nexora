{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.rewards.index.podarunkovi_kartky_ta_loialnist'),'rewards') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('ui.admin.rewards.index.commerce') }}</span></nav><h1>{{ ui_text('admin.rewards.index.podarunkovi_kartky_ta_loialnist') }}</h1><p>{{ ui_text('admin.rewards.index.balans_kartok_pravyla_bonusiv_i_zhurnal_vykoryst') }}</p></div></header>
{% for m in app.flashes('success') %}<div class="admin-notice is-success">{{ m }}</div>{% endfor %}{% for m in app.flashes('error') %}<div class="admin-notice is-error">{{ m }}</div>{% endfor %}
{% if issued %}<div class="admin-panel"><h2>{{ ui_text('admin.rewards.index.novyi_kod') }}</h2><p><strong>{{ issued.code }}</strong></p><p>{{ ui_text('admin.rewards.index.suma') }} {{ (issued.amount_minor/100)|number_format(2,',',' ') }} {{ issued.currency }}</p><p class="muted">{{ ui_text('admin.rewards.index.povnyi_kod_nadali_ne_zberihaietsia_i_povtorno_ne') }}</p></div>{% endif %}
<div data-tabs="rewards"><section class="admin-panel" data-tab="issue" data-tab-icon="plus"><h2>{{ ui_text('admin.rewards.index.vypustyty_kartku') }}</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="issue"><label>{{ ui_text('admin.rewards.index.suma_2') }}<input type="number" min="1" step="0.01" name="amount" required></label><label>{{ ui_text('admin.rewards.index.valiuta') }}<input type="text" name="currency" maxlength="3" value="{{ store_currency }}" required></label><label>{{ ui_text('admin.rewards.index.diie_do') }}<input type="datetime-local" name="expires_at"></label><button class="admin-button is-primary" type="submit">{{ ui_text('admin.rewards.index.stvoryty_kartku') }}</button></form></section>
<section class="admin-panel" data-tab="loyalty" data-tab-icon="star"><h2>{{ ui_text('admin.rewards.index.loialnist') }}</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="loyalty"><label><input type="checkbox" name="enabled" value="1" {% if config.enabled %}checked{% endif %}> {{ ui_text('admin.rewards.index.uvimkneno') }}</label><label>{{ ui_text('admin.rewards.index.baliv_za_1_00') }}<input type="number" min="0" name="earn_points_per_major" value="{{ config.earn_points_per_major }}"></label><label>{{ ui_text('admin.rewards.index.vartist_1_bala_u_minornykh_odynytsiakh') }}<input type="number" min="1" name="redeem_minor_per_point" value="{{ config.redeem_minor_per_point }}"></label><label>{{ ui_text('admin.rewards.index.minimum_baliv_dlia_spysannia') }}<input type="number" min="1" name="min_redeem_points" value="{{ config.min_redeem_points }}"></label><button class="admin-button is-primary" type="submit">{{ ui_text('admin.rewards.index.zberehty') }}</button></form>{% if admin_can('rewards.manage') %}<h3>{{ ui_text('admin.rewards.manual_points') }}</h3><form method="post" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="loyalty_adjust"><label>E-mail<input type="email" name="email" required></label><label>{{ ui_text('admin.rewards.points') }}<input type="number" name="points" required placeholder="+100 / -50"></label><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.rewards.apply') }}</button></div></form>{% endif %}
<p class="admin-help">{{ ui_text('admin.rewards.points_outstanding') }}: <strong>{{ loyalty_overview.total_points }}</strong></p>
<div class="admin-grid-2"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.customer') }}</th><th>{{ ui_text('admin.rewards.balance') }}</th><th>{{ ui_text('admin.rewards.earned') }}</th><th>{{ ui_text('admin.rewards.spent') }}</th></tr></thead><tbody>{% for a in loyalty_overview.accounts %}<tr><td><strong>{{ admin_can('personal_data.view') ? a.display_name : '—' }}</strong>{% if admin_can('personal_data.view') %}<small class="admin-cell-sub">{{ a.email }}</small>{% endif %}</td><td>{{ a.points_balance }}</td><td>{{ a.lifetime_earned }}</td><td>{{ a.lifetime_spent }}</td></tr>{% else %}<tr><td colspan="4" class="admin-empty">—</td></tr>{% endfor %}</tbody></table></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.customer') }}</th><th>{{ ui_text('admin.rewards.event') }}</th><th>{{ ui_text('admin.rewards.points') }}</th><th>{{ ui_text('admin.rewards.balance') }}</th></tr></thead><tbody>{% for t in loyalty_overview.transactions %}<tr><td>{{ admin_can('personal_data.view') ? t.display_name : '—' }}<small class="admin-cell-sub">{{ t.created_at|slice(0,16) }}</small></td><td>{{ t.tx_type }}</td><td>{{ t.points > 0 ? '+' : '' }}{{ t.points }}</td><td>{{ t.balance_after }}</td></tr>{% else %}<tr><td colspan="4" class="admin-empty">—</td></tr>{% endfor %}</tbody></table></div></div>
</section>
<section class="admin-panel" data-tab="cards" data-tab-icon="credit-card"><h2>{{ ui_text('admin.rewards.index.kartky') }}</h2>
<section class="admin-stats"><article><span>{{ ui_text('admin.rewards.active_cards') }}</span><strong>{{ card_stats.active }}</strong></article><article><span>{{ ui_text('admin.rewards.liability') }}</span><strong>{{ (card_stats.liability_minor/100)|number_format(2,',',' ') }} {{ store_currency }}</strong><small>{{ ui_text('admin.rewards.liability_hint') }}</small></article></section>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.rewards.index.kod') }}</th><th>{{ ui_text('admin.rewards.index.pochatkova_suma') }}</th><th>{{ ui_text('admin.rewards.index.zalyshok') }}</th><th>{{ ui_text('admin.rewards.spent') }}</th><th>{{ ui_text('admin.rewards.index.status') }}</th><th>{{ ui_text('admin.rewards.index.diie_do') }}</th><th class="is-actions"></th></tr></thead><tbody>{% for c in cards %}<tr><td>**** {{ c.code_last4 }}</td><td>{{ (c.initial_minor/100)|number_format(2,',',' ') }} {{ c.currency }}</td><td>{{ (c.balance_minor/100)|number_format(2,',',' ') }} {{ c.currency }}</td><td>{{ (c.spent_minor/100)|number_format(2,',',' ') }}</td><td>{{ status_badge(c.status) }}</td><td>{{ c.expires_at ? c.expires_at|slice(0,16) : '—' }}</td><td class="is-actions">{% if admin_can('rewards.manage') %}<details class="admin-collapse"><summary>{{ ui_icon('settings', 14) }}</summary>
<form method="post" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="card_adjust"><input type="hidden" name="card_id" value="{{ c.id }}"><label>{{ ui_text('admin.rewards.adjust') }} ({{ c.currency }})<input type="number" step="0.01" name="delta" required placeholder="+50 / -20"></label><div class="admin-form-actions"><button class="admin-button" type="submit">{{ ui_text('admin.rewards.apply') }}</button></div></form>
<form method="post" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="card_expiry"><input type="hidden" name="card_id" value="{{ c.id }}"><label>{{ ui_text('admin.rewards.index.diie_do') }}<input type="datetime-local" name="expires_at"></label><div class="admin-form-actions"><button class="admin-button" type="submit">{{ ui_text('admin.rewards.apply') }}</button></div></form>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_rewards') }}"><input type="hidden" name="action" value="card_status"><input type="hidden" name="card_id" value="{{ c.id }}">{% if c.status == 'blocked' %}<input type="hidden" name="status" value="active"><button class="admin-button" type="submit">{{ ui_text('admin.rewards.unblock') }}</button>{% else %}<input type="hidden" name="status" value="blocked"><button class="admin-button is-danger" type="submit">{{ ui_text('admin.rewards.block') }}</button>{% endif %}</form></details>{% endif %}
{% if card_history[c.id]|default([]) %}<details class="admin-collapse"><summary>{{ ui_icon('clock', 14) }}</summary><ul class="admin-sms-history">{% for h in card_history[c.id] %}<li><small>{{ h.created_at|slice(0,16) }}</small> · {{ h.tx_type }} <strong>{{ (h.amount_minor/100)|number_format(2,',',' ') }}</strong> → {{ (h.balance_after_minor/100)|number_format(2,',',' ') }}{% if h.order_number %} · {{ h.order_number }}{% endif %}</li>{% endfor %}</ul></details>{% endif %}</td></tr>{% else %}<tr><td colspan="7">{{ ui_text('admin.rewards.index.kartok_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section></div>{{ shell.end() }}
