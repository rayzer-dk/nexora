{% extends '@storefront/admin/auth_base.html.twig' %}
{% block card %}
        <h1 id="login-title">{{ ui_text('admin.reset.reset_title') }}</h1>
        {% if not usable %}
            <div class="admin-notice is-error" role="alert">{{ ui_icon('circle-alert', 20) }}<span>{{ ui_text('admin.reset.invalid') }}</span></div>
            <p class="admin-login-links"><a href="{{ path('admin_login_forgot') }}">{{ ui_text('admin.reset.request_again') }}</a></p>
        {% else %}
            <p>{{ ui_text('admin.reset.reset_lead') }}</p>
            {% if error %}<div class="admin-notice is-error" role="alert">{{ ui_icon('circle-alert', 20) }}<span>{{ error }}</span></div>{% endif %}
            <form method="post" action="{{ path('admin_login_recover', {token: app.request.attributes.get('token')}) }}">
                <label><span>{{ ui_text('admin.reset.new_password') }}</span>{% include '@storefront/admin/_password_field.html.twig' with {name: 'password', autocomplete: 'new-password', minlength: 12} only %}</label>
                <label><span>{{ ui_text('admin.reset.confirm_password') }}</span>{% include '@storefront/admin/_password_field.html.twig' with {name: 'password_confirm', autocomplete: 'new-password', minlength: 12} only %}</label>
                <input type="hidden" name="_token" value="{{ csrf_token('admin_login_recover') }}">
                <button type="submit" class="admin-button is-primary is-lg">{{ ui_text('admin.reset.save') }}</button>
            </form>
        {% endif %}
{% endblock %}
