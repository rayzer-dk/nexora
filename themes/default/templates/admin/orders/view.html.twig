{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.orders.view.zamovlennia') ~ order.order_number,'orders') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.orders.view.zamovlennia_2') }}</span></nav><h1>{{ order.order_number }}</h1><p class="admin-list-summary">{{ ui_text('admin.orders.view.stvoreno') }} {{ order.created_at }}</p></div><a class="admin-button is-primary" href="{{ path('admin_orders') }}">{{ ui_text('admin.orders.view.do_spysku') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}

<section class="admin-stats">
  <article><span>{{ ui_text('admin.orders.view.status') }}</span><strong>{{ order.status|status_label }}</strong><small>{{ order.fulfillment_status|status_label }}</small></article>
  <article><span>{{ ui_text('admin.orders.view.oplata') }}</span><strong>{{ order.payment_status|status_label }}</strong><small>{{ payment_label|default(payment.provider_code|default('—')) }}</small></article>
  <article><span>{{ ui_text('admin.orders.view.suma') }}</span><strong>{{ order.total_display }}</strong><small>{% if order.refundable_minor > 0 %}{{ ui_text('admin.orders.view.dostupno_do_povernennia') }} {{ order.refundable_display }}{% else %}{{ ui_text('admin.orders.view.povernennia_nedostupne') }}{% endif %}</small></article>
  <article><span>{{ ui_text('admin.orders.view.kliient') }}</span><strong>{% if admin_can('personal_data.view') %}{{ order.customer_name }}{% else %}{{ ui_text('admin.orders.view.prykhovano') }}{% endif %}</strong><small>{% if admin_can('personal_data.view') %}{{ order.customer_phone }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}{% else %}{{ ui_text('admin.orders.view.personalni_dani_nedostupni_dlia_tsiiei_roli') }}{% endif %}</small></article>
</section>

<div class="admin-detail">
<div>
<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.sklad_zamovlennia') }}</small><h2>{{ ui_text('admin.orders.view.tovary') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.orders.view.tovar') }}</th><th>SKU</th><th>{{ ui_text('admin.orders.view.kilkist') }}</th><th>{{ ui_text('admin.orders.view.tsina') }}</th><th>{{ ui_text('admin.orders.view.suma') }}</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.name }}</td><td>{{ item.sku }}</td><td>{{ item.quantity }} {{ item.unit_code }}</td><td>{{ (item.unit_price_minor/100)|number_format(2,',',' ') }} {{ order.currency }}</td><td>{{ (item.line_total_minor/100)|number_format(2,',',' ') }} {{ order.currency }}</td></tr>{% endfor %}</tbody></table></div></section>

{% if fulfillment %}<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.dostavka') }}</small><h2>{{ delivery_label|default(fulfillment.provider_code) }} · {{ fulfillment.status }}</h2></div>
<form class="admin-order-action-form" method="post" action="{{ path('admin_order_fulfillment',{publicId:order.public_id_text}) }}" data-dirty-guard>
<input type="hidden" name="_token" value="{{ csrf_token('admin_order_' ~ order.public_id_text) }}">
<div class="admin-form-grid"><label><span>{{ ui_text('admin.orders.view.status_dostavky') }}</span><select name="status">{% for value in fulfillment_statuses %}<option value="{{ value }}"{{ fulfillment.status == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label><label><span>{{ ui_text('admin.orders.view.nomer_vidpravlennia') }}</span><input name="tracking_number" maxlength="190" value="{{ fulfillment.tracking_number|default('') }}" placeholder="{{ ui_text('admin.orders.view.ttn_tracking') }}"></label></div>
<div class="admin-inline-actions"><button type="submit">{{ ui_text('admin.orders.view.onovyty_dostavku') }}</button></div>
</form>
{% if fulfillment.destination and admin_can('personal_data.view') %}<dl class="admin-definition-list">{% for key,value in fulfillment.destination %}{% if value %}<div><dt>{{ ui_text('admin.orders.dest.' ~ key) }}</dt><dd>{{ value }}</dd></div>{% endif %}{% endfor %}</dl>{% endif %}
</section>{% endif %}

<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.orders.view.lohistyka') }}</small><h2>{{ ui_text('admin.orders.view.vidpravlennia_ttn') }}</h2><p>{{ ui_text('admin.orders.view.reiestruite_faktychni_vidpravlennia_okremo_vid_z') }}</p></div><a href="{{ path('admin_shipments') }}">{{ ui_text('admin.orders.view.usi_vidpravlennia') }}</a></div>
{% if admin_can('orders.manage') and fulfillment and fulfillment.provider_code|default('') == 'nova_post' and nova_post_api_configured|default(false) %}<form class="admin-order-action-form" method="post" action="{{ path('admin_nova_post_create',{order:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_nova_post_create_' ~ order.public_id_text) }}"><div><strong>{{ ui_text('admin.orders.view.stvoryty_ttn_novoi_poshty_cherez_api_2_0') }}</strong><p>{{ ui_text('admin.orders.view.pratsiuie_dlia_viddilennia_poshtomatu_z_perevire') }}</p></div><div class="admin-form-grid"><label><span>{{ ui_text('admin.orders.view.vaha_kh') }}</span><input type="number" name="weight_kg" min="0.1" max="1000" step="0.1" value="1" required></label><label><span>{{ ui_text('admin.orders.view.opys_vidpravlennia') }}</span><input type="text" name="description" maxlength="100" value="{{ ui_text('admin.orders.view.zamovlennia_2') }} {{ order.order_number }}"></label></div><button type="submit">{{ ui_text('admin.orders.view.stvoryty_ttn_cherez_api') }}</button></form>{% endif %}
{% if admin_can('orders.manage') and fulfillment and fulfillment.provider_code|default('') != 'self_pickup' %}<form class="admin-order-action-form" method="post" action="{{ path('admin_shipment_register',{order:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_shipment_' ~ order.public_id_text) }}"><div class="admin-form-grid"><label><span>{{ ui_text('admin.orders.view.napriamok') }}</span><select name="direction"><option value="outbound">{{ ui_text('admin.orders.view.vidpravka_kliientu') }}</option><option value="return">{{ ui_text('admin.orders.view.povernennia_vid_kliienta') }}</option></select></label><label><span>{{ ui_text('admin.orders.view.pereviznyk') }}</span><input name="provider_code" maxlength="64" value="{{ fulfillment.provider_code|default('') }}" required></label><label><span>{{ ui_text('admin.orders.view.servis') }}</span><input name="service_type" maxlength="64" value="{{ fulfillment.service_type|default('pickup_point') }}" required></label><label><span>{{ ui_text('admin.orders.view.ttn_tracking') }}</span><input name="tracking_number" maxlength="190" required></label><label><span>{{ ui_text('ui.admin.orders.view.external_id') }}</span><input name="external_id" maxlength="190"></label><label><span>{{ ui_text('ui.admin.orders.view.carrier_label_https_url') }}</span><input type="url" name="carrier_label_url" maxlength="2048"></label></div><label><span>{{ ui_text('admin.orders.view.rma_public_id_dlia_return_iakshcho_ie') }}</span><input name="return_public_id" maxlength="36"></label><label><span>{{ ui_text('admin.orders.view.notatka') }}</span><textarea name="note" rows="2" maxlength="4000"></textarea></label><button type="submit">{{ ui_text('admin.orders.view.zareiestruvaty_vidpravlennia') }}</button></form>{% endif %}
{% if shipments %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.orders.view.napriamok') }}</th><th>{{ ui_text('admin.orders.view.pereviznyk') }}</th><th>{{ ui_text('ui.admin.orders.view.tracking') }}</th><th>{{ ui_text('admin.orders.view.status') }}</th><th>{{ ui_text('ui.admin.orders.view.label') }}</th><th>{{ ui_text('admin.orders.view.onovyty') }}</th></tr></thead><tbody>{% for s in shipments %}<tr><td>{{ s.direction }}</td><td>{{ s.provider_code }}</td><td><strong>{{ s.tracking_number }}</strong>{% if s.external_id %}<small>{{ s.external_id }}</small>{% endif %}</td><td>{{ s.status }}</td><td><a href="{{ path('admin_shipment_label',{shipment:s.public_id_text}) }}" target="_blank">{{ ui_text('ui.admin.orders.view.internal_pdf') }}</a>{% if s.carrier_label_url %} · <a href="{{ s.carrier_label_url }}" target="_blank" rel="noopener noreferrer">{{ ui_text('ui.admin.orders.view.carrier_label') }}</a>{% endif %}</td><td>{% if admin_can('orders.manage') and s.status not in ['delivered','returned','cancelled'] %}<form method="post" action="{{ path('admin_shipment_status',{shipment:s.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_shipment_status_' ~ s.public_id_text) }}"><input type="hidden" name="order" value="{{ order.public_id_text }}"><select name="status">{% for st in ['label_ready','in_transit','delivered','exception','returning','returned','cancelled'] %}<option value="{{ st }}">{{ st }}</option>{% endfor %}</select><button type="submit">{{ ui_text('admin.orders.view.onovyty') }}</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>

<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.orders.view.dokumenty') }}</small><h2>{{ ui_text('admin.orders.view.dokumenty_zamovlennia') }}</h2><p>{{ ui_text('admin.orders.view.rakhunok_pakuvalnyi_lyst_i_credit_note_zberihaiu') }}</p></div></div>
<div class="admin-order-actions">{% if admin_can('orders.manage') %}<form method="post" action="{{ path('admin_order_document_issue',{order:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_document_' ~ order.public_id_text) }}"><input type="hidden" name="type" value="invoice"><button type="submit">{{ ui_text('admin.orders.view.vypustyty_rakhunok') }}</button></form><form method="post" action="{{ path('admin_order_document_issue',{order:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_document_' ~ order.public_id_text) }}"><input type="hidden" name="type" value="packing_slip"><button type="submit">{{ ui_text('admin.orders.view.pakuvalnyi_lyst') }}</button></form>{% endif %}</div>
{% if documents %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.orders.view.typ') }}</th><th>{{ ui_text('admin.orders.view.nomer') }}</th><th>{{ ui_text('admin.orders.view.vypushcheno') }}</th><th>{{ ui_text('admin.orders.view.khto') }}</th><th>{{ ui_text('admin.orders.view.dii') }}</th></tr></thead><tbody>{% for doc in documents %}<tr><td>{{ doc.document_type }}</td><td><strong>{{ doc.document_number }}</strong></td><td>{{ doc.issued_at }}</td><td>{{ doc.created_by|default('system') }}</td><td><a href="{{ path('admin_order_document_view',{document:doc.public_id}) }}" target="_blank">{{ ui_text('admin.orders.view.perehliad') }}</a> · <a href="{{ path('admin_order_document_pdf',{document:doc.public_id}) }}">PDF</a></td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% if admin_can('orders.refund') and refunds %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.orders.view.povernennia') }}</th><th>{{ ui_text('admin.orders.view.status') }}</th><th>{{ ui_text('admin.orders.view.dokument') }}</th></tr></thead><tbody>{% for refund in refunds %}<tr><td>{{ refund.amount_display }}</td><td>{{ refund.status }}</td><td>{% if refund.status == 'succeeded' %}<form method="post" action="{{ path('admin_order_document_issue',{order:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_document_' ~ order.public_id_text) }}"><input type="hidden" name="type" value="credit_note"><input type="hidden" name="refund_id" value="{{ refund.id }}"><button type="submit">{{ ui_text('admin.orders.view.vypustyty_credit_note') }}</button></form>{% else %}{{ ui_text('admin.orders.view.pislia_uspishnoho_povernennia') }}{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>
<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.istoriia') }}</small><h2>{{ ui_text('admin.orders.view.podii') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>#</th><th>{{ ui_text('admin.orders.view.podiia') }}</th><th>{{ ui_text('admin.orders.view.detali') }}</th><th>{{ ui_text('admin.orders.view.khto') }}</th><th>{{ ui_text('admin.orders.view.data') }}</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.sequence_no }}</td><td><strong>{{ event.event_type }}</strong></td><td>{% if event.payload_data.note is defined %}<span title="{{ event.payload_data.note }}">{{ event.payload_data.note|slice(0,160) }}{% if event.payload_data.note|length > 160 %}…{% endif %}</span>{% elseif event.payload %}<code title="{{ event.payload }}">{{ event.payload|slice(0,180) }}{% if event.payload|length > 180 %}…{% endif %}</code>{% else %}—{% endif %}</td><td>{{ event.actor_type }}<small>{{ event.actor_subject }}</small></td><td>{{ event.created_at }}</td></tr>{% endfor %}</tbody></table></div></section>

{% if refunds %}<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.platezhi') }}</small><h2>{{ ui_text('admin.orders.view.povernennia') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.orders.view.suma') }}</th><th>{{ ui_text('admin.orders.view.status') }}</th><th>{{ ui_text('admin.orders.view.stvoreno') }}</th></tr></thead><tbody>{% for refund in refunds %}<tr><td>{{ refund.amount_display }}</td><td><span class="admin-badge {{ refund.status == 'succeeded' ? 'is-active' : (refund.status == 'failed' ? 'is-quarantined' : 'is-staged') }}">{{ refund.status }}</span></td><td>{{ refund.created_at }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}

{% if notifications %}<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.komunikatsii') }}</small><h2>{{ ui_text('admin.orders.view.povidomlennia') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.orders.view.typ') }}</th><th>{{ ui_text('admin.orders.view.kanal') }}</th><th>{{ ui_text('admin.orders.view.status') }}</th><th>{{ ui_text('admin.orders.view.sproby') }}</th><th>{{ ui_text('admin.orders.view.data') }}</th></tr></thead><tbody>{% for row in notifications %}<tr><td>{{ row.notification_type }}</td><td>{{ row.channel }}</td><td><span class="admin-badge {{ row.status == 'sent' ? 'is-active' : (row.status == 'failed' ? 'is-quarantined' : 'is-staged') }}" title="{{ row.last_error|default('') }}">{{ row.status }}</span></td><td>{{ row.attempts }}</td><td>{{ row.sent_at|default(row.created_at) }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
</div>

<aside class="admin-detail__aside">
<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.operatsii') }}</small><h2>{{ ui_text('admin.orders.view.keruvannia') }}</h2></div><div class="admin-order-actions">
{% if admin_can('orders.manage') and payment.provider_code in ['bank_transfer','cash_on_delivery'] and order.payment_status not in ['paid','refunded'] %}<form method="post" action="{{ path('admin_order_mark_paid',{publicId:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_' ~ order.public_id_text) }}"><button type="submit">{{ ui_text('admin.orders.view.pidtverdyty_oplatu') }}</button></form>{% endif %}
{% if admin_can('orders.manage') and order.status != 'completed' and order.payment_status == 'paid' and order.fulfillment_status in ['delivered','not_required'] %}<form method="post" action="{{ path('admin_order_complete',{publicId:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_' ~ order.public_id_text) }}"><button type="submit">{{ ui_text('admin.orders.view.zavershyty_zamovlennia') }}</button></form>{% endif %}
{% if admin_can('orders.manage') and order.customer_email %}<form method="post" action="{{ path('admin_order_notify',{publicId:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_' ~ order.public_id_text) }}"><button type="submit">{{ ui_text('admin.orders.view.nadislaty_status_kliientu') }}</button></form>{% endif %}
{% if admin_can('orders.manage') and order.status not in ['cancelled','refunded','completed'] and order.payment_status != 'paid' %}<form method="post" action="{{ path('admin_order_cancel',{publicId:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_' ~ order.public_id_text) }}"><button class="is-danger" type="submit" data-confirm="{{ ui_text('admin.orders.view.skasuvaty_zamovlennia_ta_zvilnyty_aktyvnyi_sklad') }}">{{ ui_text('admin.orders.view.skasuvaty_zamovlennia') }}</button></form>{% endif %}
</div></section>

{% if admin_can('orders.refund') and payment.provider_code == 'monobank' and order.refundable_minor > 0 %}<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.oplata') }}</small><h2>{{ ui_text('admin.orders.view.povernennia_koshtiv') }}</h2><p>{{ ui_text('admin.orders.view.maksymum') }} <strong>{{ order.refundable_display }}</strong>{{ ui_text('admin.orders.view.zalyshte_pole_porozhnim_dlia_povnoho_dostupnoho_') }}</p></div><form class="admin-order-action-form" method="post" action="{{ path('admin_order_refund',{publicId:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_' ~ order.public_id_text) }}"><label><span>{{ ui_text('admin.orders.view.suma_2') }} {{ order.currency }}</span><input name="amount" inputmode="decimal" placeholder="{{ ui_text('admin.orders.view.napryklad_250_00') }}"></label><button class="is-danger" type="submit" data-confirm="{{ ui_text('admin.orders.view.peredaty_zapyt_na_povernennia_platizhnomu_provai') }}">{{ ui_text('admin.orders.view.povernuty_koshty') }}</button></form></section>{% endif %}

{% if admin_can('orders.manage') %}<section class="admin-panel"><div><small>{{ ui_text('admin.orders.view.komanda') }}</small><h2>{{ ui_text('admin.orders.view.vnutrishnia_notatka') }}</h2><p>{{ ui_text('admin.orders.view.notatka_zalyshaietsia_tilky_v_istorii_administru') }}</p></div><form class="admin-order-action-form" method="post" action="{{ path('admin_order_note',{publicId:order.public_id_text}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_order_' ~ order.public_id_text) }}"><textarea name="note" rows="4" maxlength="4000" placeholder="{{ ui_text('admin.orders.view.napryklad_kliient_pidtverdyv_zminu_chasu_dostavk') }}"></textarea><button type="submit">{{ ui_text('admin.orders.view.dodaty_notatku') }}</button></form></section>{% endif %}
{% include '@storefront/admin/extension/slot.html.twig' with {slot:'admin.order.sidebar'} only %}
</aside>
</div>
{{ shell.end() }}
