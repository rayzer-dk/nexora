{% import '@storefront/admin/_pager.html.twig' as pager %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.orders.index.zamovlennia'),'orders') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.orders.index.prodazhi') }}</span></nav><h1>{{ ui_text('admin.orders.index.zamovlennia') }}</h1><p class="admin-list-summary">{{ count }} {{ ui_text('admin.orders.index.zamovlen_zberezheni_predstavlennia_vlasni_kolonk') }}</p></div><a class="admin-button is-primary" href="{{ path('admin_orders_manual') }}">{{ ui_icon('plus', 16) }}{{ ui_text('admin.manual_order.title') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-toolbar">
<form class="admin-filters" method="get">
  <label class="admin-filters__search"><span>{{ ui_text('admin.orders.index.poshuk') }}</span><input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.orders.index.nomer_kliient_telefon_abo_email') }}"></label>
  <label><span>{{ ui_text('admin.orders.index.zamovlennia') }}</span><select name="status"><option value="">{{ ui_text('admin.orders.index.usi_statusy') }}</option>{% for value in order_statuses %}<option value="{{ value }}"{{ status == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <label><span>{{ ui_text('admin.orders.index.oplata') }}</span><select name="payment_status"><option value="">{{ ui_text('admin.orders.index.usi') }}</option>{% for value in payment_statuses %}<option value="{{ value }}"{{ payment_status == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <label><span>{{ ui_text('admin.orders.index.dostavka') }}</span><select name="fulfillment_status"><option value="">{{ ui_text('admin.orders.index.usi') }}</option>{% for value in fulfillment_statuses %}<option value="{{ value }}"{{ fulfillment_status == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <label><span>{{ ui_text('admin.orders.index.na_storintsi') }}</span><select name="limit">{% for value in [25,50,100] %}<option value="{{ value }}"{{ limit == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <details class="admin-column-picker"><summary>{{ ui_text('admin.orders.index.kolonky') }}</summary><div>{% set labels={order:ui_text('admin.orders.index.zamovlennia'),customer:ui_text('admin.orders.index.kliient'),payment:ui_text('admin.orders.index.oplata'),fulfillment:ui_text('admin.orders.index.dostavka'),total:ui_text('admin.orders.index.suma'),date:ui_text('admin.orders.index.data')} %}{% for c in allowed_columns %}<label><input type="checkbox" name="columns[]" value="{{ c }}"{{ c in active_columns ? ' checked' : '' }}> {{ labels[c] }}</label>{% endfor %}</div></details>
  <div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.orders.index.zastosuvaty') }}</button>{% if search or status or payment_status or fulfillment_status or limit != 25 %}<a class="admin-button" href="{{ path('admin_orders') }}">{{ ui_text('admin.orders.index.skynuty') }}</a>{% endif %}</div>
</form>
<details class="admin-save-view"><summary class="admin-button">{{ ui_icon('check', 16) }} {{ ui_text('admin.orders.index.zberehty_vyhliad') }}</summary><form method="post" action="{{ path('admin_order_saved_view_save') }}" class="admin-save-view__form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_order_saved_view_save') }}"><input type="hidden" name="search" value="{{ search }}"><input type="hidden" name="status" value="{{ status }}"><input type="hidden" name="payment_status" value="{{ payment_status }}"><input type="hidden" name="fulfillment_status" value="{{ fulfillment_status }}"><input type="hidden" name="limit" value="{{ limit }}">{% for c in active_columns %}<input type="hidden" name="columns[]" value="{{ c }}">{% endfor %}<input type="text" name="name" maxlength="190" required placeholder="{{ ui_text('admin.orders.index.nazva_predstavlennia') }}"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.orders.index.zberehty_vyhliad') }}</button></form></details>
</section>
{% if saved_views %}<div class="admin-view-chips">{% for v in saved_views %}<span><a href="{{ path('admin_orders',{view:v.id,search:v.filters.search|default(''),status:v.filters.status|default(''),payment_status:v.filters.payment_status|default(''),fulfillment_status:v.filters.fulfillment_status|default(''),limit:v.filters.limit|default(25)}) }}">{{ v.name }}</a><form method="post" action="{{ path('admin_order_saved_view_delete',{id:v.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_order_saved_view_delete_' ~ v.id) }}"><button title="{{ ui_text('admin.orders.index.vydalyty_predstavlennia') }}" aria-label="{{ ui_text('admin.orders.index.vydalyty_predstavlennia') }}">{{ ui_icon('x',16) }}</button></form></span>{% endfor %}</div>{% endif %}
{% if admin_can('orders.manage') and orders %}<form method="post" action="{{ path('admin_order_bulk') }}" class="admin-form" data-order-bulk data-confirm="{{ ui_text('admin.orders.bulk.confirm')|e('html_attr') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_order_bulk') }}">
<div class="admin-bulk-actions"><select name="action" required aria-label="{{ ui_text('admin.orders.bulk.action') }}"><option value="">{{ ui_text('admin.orders.bulk.action') }}</option><option value="complete">{{ ui_text('admin.orders.bulk.complete') }}</option>{% for value in fulfillment_statuses %}<option value="fulfillment:{{ value }}">{{ ui_text('admin.orders.bulk.fulfillment') }}: {{ value }}</option>{% endfor %}</select><button type="submit" class="admin-button">{{ ui_icon('list-checks', 16) }}<span>{{ ui_text('admin.orders.bulk.apply') }}</span></button><small>{{ ui_text('admin.orders.bulk.hint') }}</small></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr>{% if admin_can('orders.manage') %}<th><input type="checkbox" data-check-all title="{{ ui_text('admin.orders.bulk.select_all') }}" aria-label="{{ ui_text('admin.orders.bulk.select_all') }}"></th>{% endif %}{% if 'order' in active_columns %}<th data-sort-key="order">{{ ui_text('admin.orders.index.zamovlennia') }}</th>{% endif %}{% if 'customer' in active_columns %}<th data-sort-key="customer">{{ ui_text('admin.orders.index.kliient') }}</th>{% endif %}{% if 'payment' in active_columns %}<th data-sort-key="payment">{{ ui_text('admin.orders.index.oplata') }}</th>{% endif %}{% if 'fulfillment' in active_columns %}<th data-sort-key="fulfillment">{{ ui_text('admin.orders.index.dostavka') }}</th>{% endif %}{% if 'total' in active_columns %}<th data-sort-key="total">{{ ui_text('admin.orders.index.suma') }}</th>{% endif %}{% if 'date' in active_columns %}<th data-sort-key="date">{{ ui_text('admin.orders.index.data') }}</th>{% endif %}<th aria-label="{{ ui_text('admin.orders.index.dii') }}"></th></tr></thead><tbody>
{% for order in orders %}
<tr>{% if admin_can('orders.manage') %}<td><input type="checkbox" name="order_ids[]" value="{{ order.public_id }}" data-row-check aria-label="{{ order.order_number }}"></td>{% endif %}{% if 'order' in active_columns %}<td><strong>{{ order.order_number }}</strong><small><span class="admin-badge {{ order.status in ['completed','confirmed'] ? 'is-active' : (order.status in ['cancelled','refunded','payment_failed'] ? 'is-quarantined' : 'is-staged') }}">{{ order.status }}</span></small></td>{% endif %}{% if 'customer' in active_columns %}<td>{% if admin_can('personal_data.view') %}{{ order.customer_name }}<small title="{{ order.customer_phone }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}">{{ order.customer_phone }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}</small>{% else %}<strong>{{ ui_text('admin.orders.index.prykhovano') }}</strong><small>{{ ui_text('admin.orders.index.bez_prava_personal_data_view') }}</small>{% endif %}</td>{% endif %}{% if 'payment' in active_columns %}<td><span class="admin-badge {{ order.payment_status == 'paid' ? 'is-active' : (order.payment_status in ['failed','expired','cancelled'] ? 'is-quarantined' : 'is-staged') }}">{{ order.payment_status }}</span><small>{{ order.provider_code|default('—') }}</small></td>{% endif %}{% if 'fulfillment' in active_columns %}<td><span class="admin-badge {{ order.fulfillment_status in ['delivered','not_required'] ? 'is-active' : (order.fulfillment_status == 'cancelled' ? 'is-quarantined' : 'is-staged') }}">{{ order.fulfillment_status }}</span></td>{% endif %}{% if 'total' in active_columns %}<td><strong>{{ order.total_display }}</strong></td>{% endif %}{% if 'date' in active_columns %}<td>{{ order.created_at }}</td>{% endif %}<td class="is-actions"><button type="button" class="admin-icon-button" data-quick-preview="{{ path('admin_order_preview',{publicId:order.public_id}) }}" title="{{ ui_text('admin.orders.index.shvydkyi_preview') }}" aria-label="{{ ui_text('admin.orders.index.shvydkyi_preview') }}">{{ ui_icon('eye', 18) }}</button><a class="admin-icon-button" href="{{ path('admin_order_view',{publicId:order.public_id}) }}" title="{{ ui_text('admin.orders.index.vidkryty_zamovlennia') }}" aria-label="{{ ui_text('admin.orders.index.vidkryty_zamovlennia') }}">{{ ui_icon('arrow-right',16) }}</a></td></tr>
{% else %}<tr><td colspan="{{ active_columns|length + 2 }}" class="admin-empty">{{ ui_text('admin.orders.index.za_zadanymy_umovamy_zamovlen_nemaie') }}</td></tr>{% endfor %}
</tbody></table></div>
</form>{% else %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr>{% if admin_can('orders.manage') %}<th><input type="checkbox" data-check-all title="{{ ui_text('admin.orders.bulk.select_all') }}" aria-label="{{ ui_text('admin.orders.bulk.select_all') }}"></th>{% endif %}{% if 'order' in active_columns %}<th data-sort-key="order">{{ ui_text('admin.orders.index.zamovlennia') }}</th>{% endif %}{% if 'customer' in active_columns %}<th data-sort-key="customer">{{ ui_text('admin.orders.index.kliient') }}</th>{% endif %}{% if 'payment' in active_columns %}<th data-sort-key="payment">{{ ui_text('admin.orders.index.oplata') }}</th>{% endif %}{% if 'fulfillment' in active_columns %}<th data-sort-key="fulfillment">{{ ui_text('admin.orders.index.dostavka') }}</th>{% endif %}{% if 'total' in active_columns %}<th data-sort-key="total">{{ ui_text('admin.orders.index.suma') }}</th>{% endif %}{% if 'date' in active_columns %}<th data-sort-key="date">{{ ui_text('admin.orders.index.data') }}</th>{% endif %}<th aria-label="{{ ui_text('admin.orders.index.dii') }}"></th></tr></thead><tbody>
{% for order in orders %}
<tr>{% if admin_can('orders.manage') %}<td><input type="checkbox" name="order_ids[]" value="{{ order.public_id }}" data-row-check aria-label="{{ order.order_number }}"></td>{% endif %}{% if 'order' in active_columns %}<td><strong>{{ order.order_number }}</strong><small><span class="admin-badge {{ order.status in ['completed','confirmed'] ? 'is-active' : (order.status in ['cancelled','refunded','payment_failed'] ? 'is-quarantined' : 'is-staged') }}">{{ order.status }}</span></small></td>{% endif %}{% if 'customer' in active_columns %}<td>{% if admin_can('personal_data.view') %}{{ order.customer_name }}<small title="{{ order.customer_phone }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}">{{ order.customer_phone }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}</small>{% else %}<strong>{{ ui_text('admin.orders.index.prykhovano') }}</strong><small>{{ ui_text('admin.orders.index.bez_prava_personal_data_view') }}</small>{% endif %}</td>{% endif %}{% if 'payment' in active_columns %}<td><span class="admin-badge {{ order.payment_status == 'paid' ? 'is-active' : (order.payment_status in ['failed','expired','cancelled'] ? 'is-quarantined' : 'is-staged') }}">{{ order.payment_status }}</span><small>{{ order.provider_code|default('—') }}</small></td>{% endif %}{% if 'fulfillment' in active_columns %}<td><span class="admin-badge {{ order.fulfillment_status in ['delivered','not_required'] ? 'is-active' : (order.fulfillment_status == 'cancelled' ? 'is-quarantined' : 'is-staged') }}">{{ order.fulfillment_status }}</span></td>{% endif %}{% if 'total' in active_columns %}<td><strong>{{ order.total_display }}</strong></td>{% endif %}{% if 'date' in active_columns %}<td>{{ order.created_at }}</td>{% endif %}<td class="is-actions"><button type="button" class="admin-icon-button" data-quick-preview="{{ path('admin_order_preview',{publicId:order.public_id}) }}" title="{{ ui_text('admin.orders.index.shvydkyi_preview') }}" aria-label="{{ ui_text('admin.orders.index.shvydkyi_preview') }}">{{ ui_icon('eye', 18) }}</button><a class="admin-icon-button" href="{{ path('admin_order_view',{publicId:order.public_id}) }}" title="{{ ui_text('admin.orders.index.vidkryty_zamovlennia') }}" aria-label="{{ ui_text('admin.orders.index.vidkryty_zamovlennia') }}">{{ ui_icon('arrow-right',16) }}</a></td></tr>
{% else %}<tr><td colspan="{{ active_columns|length + 2 }}" class="admin-empty">{{ ui_text('admin.orders.index.za_zadanymy_umovamy_zamovlen_nemaie') }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
{% set q = '&limit=' ~ limit ~ (search ? '&search=' ~ search|url_encode : '') ~ (status ? '&status=' ~ status|url_encode : '') ~ (payment_status ? '&payment_status=' ~ payment_status|url_encode : '') ~ (fulfillment_status ? '&fulfillment_status=' ~ fulfillment_status|url_encode : '') ~ (selected_view ? '&view=' ~ selected_view : '') %}{% for c in active_columns %}{% set q = q ~ '&columns%5B%5D=' ~ c|url_encode %}{% endfor %}
{{ pager.render(page, count, limit) }}
{{ shell.end() }}
