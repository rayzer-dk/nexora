{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.orders.index.zamovlennia'),'orders') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.orders.index.prodazhi') }}</small><h1>{{ ui_text('admin.orders.index.zamovlennia') }}</h1><p class="admin-list-summary">{{ count }} {{ ui_text('admin.orders.index.zamovlen_zberezheni_predstavlennia_vlasni_kolonk') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-list-toolbar admin-list-toolbar--views">
<form class="admin-order-filters" method="get">
  <label class="admin-order-filters__search"><span>{{ ui_text('admin.orders.index.poshuk') }}</span><input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.orders.index.nomer_kliient_telefon_abo_email') }}"></label>
  <label><span>{{ ui_text('admin.orders.index.zamovlennia') }}</span><select name="status"><option value="">{{ ui_text('admin.orders.index.usi_statusy') }}</option>{% for value in order_statuses %}<option value="{{ value }}"{{ status == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <label><span>{{ ui_text('admin.orders.index.oplata') }}</span><select name="payment_status"><option value="">{{ ui_text('admin.orders.index.usi') }}</option>{% for value in payment_statuses %}<option value="{{ value }}"{{ payment_status == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <label><span>{{ ui_text('admin.orders.index.dostavka') }}</span><select name="fulfillment_status"><option value="">{{ ui_text('admin.orders.index.usi') }}</option>{% for value in fulfillment_statuses %}<option value="{{ value }}"{{ fulfillment_status == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <label><span>{{ ui_text('admin.orders.index.na_storintsi') }}</span><select name="limit">{% for value in [25,50,100] %}<option value="{{ value }}"{{ limit == value ? ' selected' : '' }}>{{ value }}</option>{% endfor %}</select></label>
  <details class="admin-column-picker"><summary>{{ ui_text('admin.orders.index.kolonky') }}</summary><div>{% set labels={order:ui_text('admin.orders.index.zamovlennia'),customer:ui_text('admin.orders.index.kliient'),payment:ui_text('admin.orders.index.oplata'),fulfillment:ui_text('admin.orders.index.dostavka'),total:ui_text('admin.orders.index.suma'),date:ui_text('admin.orders.index.data')} %}{% for c in allowed_columns %}<label><input type="checkbox" name="columns[]" value="{{ c }}"{{ c in active_columns ? ' checked' : '' }}> {{ labels[c] }}</label>{% endfor %}</div></details>
  <button type="submit">{{ ui_text('admin.orders.index.zastosuvaty') }}</button>
  {% if search or status or payment_status or fulfillment_status or limit != 25 %}<a href="{{ path('admin_orders') }}">{{ ui_text('admin.orders.index.skynuty') }}</a>{% endif %}
</form>
<form method="post" action="{{ path('admin_order_saved_view_save') }}" class="admin-save-view"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_order_saved_view_save') }}"><input type="hidden" name="search" value="{{ search }}"><input type="hidden" name="status" value="{{ status }}"><input type="hidden" name="payment_status" value="{{ payment_status }}"><input type="hidden" name="fulfillment_status" value="{{ fulfillment_status }}"><input type="hidden" name="limit" value="{{ limit }}">{% for c in active_columns %}<input type="hidden" name="columns[]" value="{{ c }}">{% endfor %}<input type="text" name="name" maxlength="190" required placeholder="{{ ui_text('admin.orders.index.nazva_predstavlennia') }}"><button type="submit">{{ ui_text('admin.orders.index.zberehty_vyhliad') }}</button></form>
</section>
{% if saved_views %}<div class="admin-view-chips">{% for v in saved_views %}<span><a href="{{ path('admin_orders',{view:v.id,search:v.filters.search|default(''),status:v.filters.status|default(''),payment_status:v.filters.payment_status|default(''),fulfillment_status:v.filters.fulfillment_status|default(''),limit:v.filters.limit|default(25)}) }}">{{ v.name }}</a><form method="post" action="{{ path('admin_order_saved_view_delete',{id:v.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_order_saved_view_delete_' ~ v.id) }}"><button title="{{ ui_text('admin.orders.index.vydalyty_predstavlennia') }}" aria-label="{{ ui_text('admin.orders.index.vydalyty_predstavlennia') }}">×</button></form></span>{% endfor %}</div>{% endif %}
<div class="admin-table-wrap"><table class="admin-data-table"><thead><tr>{% if 'order' in active_columns %}<th>{{ ui_text('admin.orders.index.zamovlennia') }}</th>{% endif %}{% if 'customer' in active_columns %}<th>{{ ui_text('admin.orders.index.kliient') }}</th>{% endif %}{% if 'payment' in active_columns %}<th>{{ ui_text('admin.orders.index.oplata') }}</th>{% endif %}{% if 'fulfillment' in active_columns %}<th>{{ ui_text('admin.orders.index.dostavka') }}</th>{% endif %}{% if 'total' in active_columns %}<th>{{ ui_text('admin.orders.index.suma') }}</th>{% endif %}{% if 'date' in active_columns %}<th>{{ ui_text('admin.orders.index.data') }}</th>{% endif %}<th aria-label="{{ ui_text('admin.orders.index.dii') }}"></th></tr></thead><tbody>
{% for order in orders %}
<tr>{% if 'order' in active_columns %}<td><strong>{{ order.order_number }}</strong><small><span class="admin-status-pill {{ order.status in ['completed','confirmed'] ? 'is-active' : (order.status in ['cancelled','refunded','payment_failed'] ? 'is-quarantined' : 'is-staged') }}">{{ order.status }}</span></small></td>{% endif %}{% if 'customer' in active_columns %}<td>{% if admin_can('personal_data.view') %}{{ order.customer_name }}<small title="{{ order.customer_phone }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}">{{ order.customer_phone }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}</small>{% else %}<strong>{{ ui_text('admin.orders.index.prykhovano') }}</strong><small>{{ ui_text('admin.orders.index.bez_prava_personal_data_view') }}</small>{% endif %}</td>{% endif %}{% if 'payment' in active_columns %}<td><span class="admin-status-pill {{ order.payment_status == 'paid' ? 'is-active' : (order.payment_status in ['failed','expired','cancelled'] ? 'is-quarantined' : 'is-staged') }}">{{ order.payment_status }}</span><small>{{ order.provider_code|default('—') }}</small></td>{% endif %}{% if 'fulfillment' in active_columns %}<td><span class="admin-status-pill {{ order.fulfillment_status in ['delivered','not_required'] ? 'is-active' : (order.fulfillment_status == 'cancelled' ? 'is-quarantined' : 'is-staged') }}">{{ order.fulfillment_status }}</span></td>{% endif %}{% if 'total' in active_columns %}<td><strong>{{ order.total_display }}</strong></td>{% endif %}{% if 'date' in active_columns %}<td>{{ order.created_at }}</td>{% endif %}<td class="is-actions"><button type="button" class="admin-icon-button" data-quick-preview="{{ path('admin_order_preview',{publicId:order.public_id}) }}" title="{{ ui_text('admin.orders.index.shvydkyi_preview') }}" aria-label="{{ ui_text('admin.orders.index.shvydkyi_preview') }}">◉</button><a class="admin-icon-button" href="{{ path('admin_order_view',{publicId:order.public_id}) }}" title="{{ ui_text('admin.orders.index.vidkryty_zamovlennia') }}" aria-label="{{ ui_text('admin.orders.index.vidkryty_zamovlennia') }}">→</a></td></tr>
{% else %}<tr><td colspan="{{ active_columns|length + 1 }}" class="admin-empty">{{ ui_text('admin.orders.index.za_zadanymy_umovamy_zamovlen_nemaie') }}</td></tr>{% endfor %}
</tbody></table></div>
{% set q = '&limit=' ~ limit ~ (search ? '&search=' ~ search|url_encode : '') ~ (status ? '&status=' ~ status|url_encode : '') ~ (payment_status ? '&payment_status=' ~ payment_status|url_encode : '') ~ (fulfillment_status ? '&fulfillment_status=' ~ fulfillment_status|url_encode : '') ~ (selected_view ? '&view=' ~ selected_view : '') %}{% for c in active_columns %}{% set q = q ~ '&columns%5B%5D=' ~ c|url_encode %}{% endfor %}
<div class="admin-list-pagination"><div>{% if page > 1 %}<a href="?page=1{{ q }}">{{ ui_text('admin.orders.index.persha') }}</a> · <a href="?page={{ page-1 }}{{ q }}">{{ ui_text('admin.orders.index.poperednia') }}</a>{% endif %}</div><span>{{ ui_text('admin.orders.index.storinka') }} {{ page }} {{ ui_text('admin.orders.index.z') }} {{ pages }}</span><div>{% if page < pages %}<a href="?page={{ page+1 }}{{ q }}">{{ ui_text('admin.orders.index.nastupna') }}</a> · <a href="?page={{ pages }}{{ q }}">{{ ui_text('admin.orders.index.ostannia') }}</a>{% endif %}</div></div>
{{ shell.end() }}
