<section class="admin-preview-card"><header><div><small>{{ ui_text('admin.orders._preview.shvydkyi_preview') }}</small><h2>{{ order.order_number }}</h2><p>{{ order.status }} · {{ order.payment_status }} · {{ order.fulfillment_status }}</p></div><strong class="admin-preview-price">{{ order.total_display }}</strong></header>{% if admin_can('personal_data.view') %}<div class="admin-preview-customer"><strong>{{ order.customer_name|default('—') }}</strong><span>{{ order.customer_phone|default('') }}{% if order.customer_email %} · {{ order.customer_email }}{% endif %}</span></div>{% else %}<div class="admin-preview-customer"><strong>{{ ui_text('admin.orders._preview.personalni_dani_prykhovano') }}</strong></div>{% endif %}<div class="admin-preview-lines">{% for item in items %}<div><span>{{ item.name }}<small>{{ item.sku }} · ×{{ item.quantity }}</small></span><strong>{{ item.line_total_display }}</strong></div>{% else %}<p>{{ ui_text('admin.orders._preview.pozytsii_nemaie') }}</p>{% endfor %}</div><footer><a class="admin-primary-button" href="{{ path('admin_order_view',{publicId:order.public_id_text}) }}">{{ ui_text('admin.orders._preview.vidkryty_zamovlennia') }}</a></footer></section>
