{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{% import '@storefront/admin/_help.html.twig' as help %}{{ shell.start(ui_text('admin.ai.batch.title'),'ai_batch') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_catalog_products') }}">{{ ui_text('admin_catalog') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.ai.batch.title') }}</span></nav><h1>{{ ui_text('admin.ai.batch.title') }}</h1><p>{{ ui_text('admin.ai.batch.intro') }}</p></div>{% if review_count > 0 %}<a class="admin-button is-primary" href="{{ path('admin_ai_batch_review') }}" data-ai-review-link>{{ ui_icon('check', 16) }}<span>{{ ui_text('admin.ai.review.open', {count: review_count}) }}</span></a>{% endif %}</header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% if selection %}{% set sel_label = ui_text(selection.task == 'translate' ? 'admin.ai.bulk.translate' : (selection.task == 'seo_meta' ? 'admin.ai.bulk.seo' : 'admin.ai.bulk.descriptions')) %}
<section class="admin-panel" data-ai-selection><div class="admin-panel__header"><div><small>{{ ui_text('admin.ai.bulk.selected', {count: selection.count, action: sel_label}) }}</small><h2>{{ sel_label }}</h2></div>{{ ui_icon('sparkles', 20) }}</div>
{% if selection_providers is empty %}<p class="admin-empty">{{ ui_text(selection.task == 'translate' ? 'admin.ai.bulk.no_translator' : 'admin.ai.bulk.no_provider') }} <a href="{{ path('admin_system_ai') }}">{{ ui_text('admin.ai.batch.setup_ai') }}</a></p>
{% elseif selection.task == 'translate' and locales is empty %}<p class="admin-empty">{{ ui_text('admin.ai.batch.one_language') }} <a href="{{ path('admin_system_localization') }}#locales">{{ ui_text('admin.lang_tabs.add') }}</a></p>
{% else %}
<form method="post" action="{{ path('admin_ai_batch_start') }}" class="admin-form-grid" data-ai-selection-form><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><input type="hidden" name="selection" value="1">
<p class="admin-form-wide">{{ ui_text(selection.task == 'translate' ? 'admin.ai.bulk.selected_note_translate' : 'admin.ai.bulk.selected_note_generate') }}</p>
{% if selection.task == 'translate' %}<fieldset class="admin-form-wide"><legend>{{ ui_text('admin.ai.batch.languages', {source: default_locale ? default_locale.name : ''}) }}</legend>{% for l in locales %}<label class="admin-check"><input type="checkbox" name="locales[]" value="{{ l.code }}" checked><span>{{ l.name }} · {{ l.code }}</span></label>{% endfor %}</fieldset>{% endif %}
<label><span>{{ ui_text('admin.ai.provider') }}</span><select name="provider">{% for p in selection_providers %}<option value="{{ p.code }}">{{ p.label }}</option>{% endfor %}</select></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit" name="mode" value="missing">{{ ui_icon('play', 16) }}<span>{{ ui_text('admin.ai.bulk.start_empty') }}</span></button><button class="admin-button" type="submit" name="mode" value="overwrite" data-confirm="{{ ui_text(selection.task == 'translate' ? 'admin.ai.bulk.overwrite_confirm_translate' : 'admin.ai.bulk.overwrite_confirm')|e('html_attr') }}"><span>{{ ui_text('admin.ai.bulk.start_overwrite') }}</span></button><a class="admin-button" href="{{ path('admin_catalog_products') }}">{{ ui_text('admin.ai.bulk.back') }}</a></div>
</form>{% endif %}</section>
{% endif %}
{% set status_badge = {running: 'is-info', paused: 'is-warning', limit: 'is-warning', done: 'is-done', cancelled: 'is-cancelled'} %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.ai.batch.used_today', {used: used, limit: limit}) }}</small><h2>{{ ui_text('admin.ai.batch.new') }}</h2></div>{{ ui_icon('languages', 20) }}</div>
{% if locales is empty %}<p class="admin-empty" data-ai-batch-empty="locales">{{ ui_text('admin.ai.batch.one_language') }} <a href="{{ path('admin_system_localization') }}#locales">{{ ui_text('admin.lang_tabs.add') }}</a></p>
{% elseif providers is empty %}<p class="admin-empty" data-ai-batch-empty="provider">{{ ui_text('admin.ai.batch.no_provider') }} <a href="{{ path('admin_system_ai') }}">{{ ui_text('admin.ai.batch.setup_ai') }}</a></p>
{% else %}
<form method="post" action="{{ path('admin_ai_batch_start') }}" class="admin-form-grid" data-ai-batch-form><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}">
<fieldset class="admin-form-wide"><legend>{{ ui_text('admin.ai.batch.what') }}{{ help.tip(ui_text('admin.help.ab.types')) }}</legend>{% for type in entity_types %}<label class="admin-check"><input type="checkbox" name="entity_types[]" value="{{ type }}"{{ type == 'product' ? ' checked' : '' }}><span>{{ ui_text('admin.ai.batch.type.' ~ type) }}</span></label>{% endfor %}</fieldset>
<fieldset class="admin-form-wide"><legend>{{ ui_text('admin.ai.batch.languages', {source: default_locale ? default_locale.name : ''}) }}</legend>{% for l in locales %}<label class="admin-check"><input type="checkbox" name="locales[]" value="{{ l.code }}" checked><span>{{ l.name }} · {{ l.code }}</span></label>{% endfor %}</fieldset>
<fieldset class="admin-form-wide"><legend>{{ ui_text('admin.ai.batch.mode') }}{{ help.tip(ui_text('admin.help.ab.mode')) }}</legend>
<label class="admin-check"><input type="radio" name="mode" value="missing" checked><span>{{ ui_text('admin.ai.batch.mode_missing') }}<small>{{ ui_text('admin.ai.batch.mode_missing_hint') }}</small></span></label>
<label class="admin-check"><input type="radio" name="mode" value="overwrite"><span>{{ ui_text('admin.ai.batch.mode_overwrite') }}<small>{{ ui_text('admin.ai.batch.mode_overwrite_hint') }}</small></span></label></fieldset>
<label><span>{{ ui_text('admin.ai.provider') }} {{ help.hint(ui_text('admin.ai.batch.provider_hint'), path('admin_system_ai') ~ '#glossary', ui_text('admin.ai.glossary.title')) }}</span><select name="provider">{% for p in providers %}<option value="{{ p.code }}">{{ p.label }}</option>{% endfor %}</select></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit" data-ai-batch-start data-confirm-overwrite="{{ ui_text('admin.ai.batch.overwrite_confirm')|e('html_attr') }}">{{ ui_icon('play', 16) }}<span>{{ ui_text('admin.ai.batch.start') }}</span></button></div>
</form>{% endif %}</section>
<section class="admin-panel" data-ai-batch-list data-url="{{ path('admin_ai_batch') }}" data-run-url="{{ path('admin_ai_batch_run') }}" data-token="{{ csrf_token('admin_ai_batch') }}" data-template="{{ ui_text('admin.ai.batch.round', {done: '%done%', failed: '%failed%', pending: '%pending%'})|e('html_attr') }}">
<div class="admin-panel__header"><div><small>{{ ui_text('admin.ai.batch.background') }}</small><h2>{{ ui_text('admin.ai.batch.list') }}</h2></div>{% if batches %}<div class="admin-row-actions"><button type="button" class="admin-button" data-ai-batch-run>{{ ui_icon('refresh-cw', 16) }}<span>{{ ui_text('admin.ai.batch.run_now') }}</span></button>{{ help.tip(ui_text('admin.help.ab.run')) }}<small data-ai-batch-status role="status"></small></div>{% endif %}</div>
{% for item in batches %}{% set b = item.batch %}{% set active = b.status in ['running', 'paused', 'limit'] %}
<article class="admin-card" data-ai-batch="{{ b.public_id }}" data-status="{{ b.status }}">
<header class="admin-panel__header"><div><small>{{ b.created_at|local_datetime }} · {{ b.options.provider|default('') }} · {{ ui_text('admin.ai.batch.mode_' ~ (b.options.mode|default('missing'))) }}</small><h3>{% if b.kind == 'generate' %}{{ ui_text('admin.ai.batch.task.' ~ b.options.task) }}{% else %}{% for type in b.options.entity_types|default([]) %}{{ ui_text('admin.ai.batch.type.' ~ type) }}{{ not loop.last ? ', ' : '' }}{% endfor %}{% endif %} <span class="admin-badge {{ status_badge[b.status]|default('') }}" data-ai-batch-state>{{ ui_text('admin.ai.batch.status.' ~ b.status) }}</span></h3></div>
<div class="admin-row-actions">
{% if b.status in ['running', 'limit'] %}<form method="post" action="{{ path('admin_ai_batch_action', {publicId: b.public_id, action: 'pause'}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><button class="admin-button" type="submit">{{ ui_icon('pause', 16) }}<span>{{ ui_text('admin.ai.batch.pause') }}</span></button></form>{% endif %}
{% if b.status in ['paused', 'limit'] %}<form method="post" action="{{ path('admin_ai_batch_action', {publicId: b.public_id, action: 'resume'}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><button class="admin-button" type="submit">{{ ui_icon('play', 16) }}<span>{{ ui_text('admin.ai.batch.resume') }}</span></button></form>{% endif %}
{% if item.totals.failed > 0 %}<form method="post" action="{{ path('admin_ai_batch_action', {publicId: b.public_id, action: 'retry'}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><button class="admin-button" type="submit">{{ ui_icon('rotate-ccw', 16) }}<span>{{ ui_text('admin.ai.batch.retry') }}</span></button></form>{% endif %}
{% if active %}<form method="post" action="{{ path('admin_ai_batch_action', {publicId: b.public_id, action: 'cancel'}) }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.ai.batch.cancel_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><button class="admin-button is-danger" type="submit">{{ ui_icon('x', 16) }}<span>{{ ui_text('admin.ai.batch.cancel') }}</span></button></form>{% endif %}
</div></header>
{% if b.status == 'limit' %}<p class="admin-card-note">{{ ui_text('admin.ai.batch.limit_note', {limit: limit}) }} <a href="{{ path('admin_system_ai') }}">{{ ui_text('admin.ai.batch.setup_ai') }}</a></p>{% endif %}
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.ai.batch.col_language') }}</th><th>{{ ui_text('admin.ai.batch.col_done') }}</th><th>{{ ui_text('admin.ai.batch.col_failed') }}</th><th>{{ ui_text('admin.ai.batch.col_pending') }}</th>{% if b.kind == 'generate' %}<th>{{ ui_text('admin.ai.batch.col_review') }}</th>{% endif %}<th>{{ ui_text('admin.ai.batch.col_progress') }}</th></tr></thead><tbody>
{% for code, c in item.per_locale %}{% set total = c.done + c.failed + c.pending + c.skipped + c.review %}<tr data-locale-row="{{ code }}"><td>{{ code }}</td><td data-n="done">{{ c.done }}</td><td data-n="failed">{{ c.failed }}</td><td data-n="pending">{{ c.pending }}</td>{% if b.kind == 'generate' %}<td data-n="review">{{ c.review }}</td>{% endif %}<td><progress class="onboarding-bar" max="{{ max(total, 1) }}" value="{{ total - c.pending - c.review }}" data-bar aria-label="{{ code }}"></progress>{% if c.skipped %}<small>{{ ui_text('admin.ai.batch.skipped', {count: c.skipped}) }}</small>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
{% if item.failures %}<details><summary>{{ ui_text('admin.ai.batch.errors') }}</summary><ul>{% for f in item.failures %}<li><strong>{{ f.name }}</strong> · {{ f.locale }} — {{ f.error }}</li>{% endfor %}</ul></details>{% endif %}
</article>
{% else %}<p class="admin-empty">{{ ui_text('admin.ai.batch.empty') }}</p>{% endfor %}
</section>
{{ shell.end() }}
