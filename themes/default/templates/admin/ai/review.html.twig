{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.ai.review.title'),'ai_batch') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_ai_batch') }}">{{ ui_text('admin.ai.batch.title') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.ai.review.title') }}</span></nav><h1>{{ ui_text('admin.ai.review.title') }}</h1><p>{{ ui_text('admin.ai.review.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel" data-ai-review>
{% if items is empty %}<p class="admin-empty" data-ai-review-empty>{{ ui_text('admin.ai.review.empty') }} <a href="{{ path('admin_catalog_products') }}">{{ ui_text('admin.ai.bulk.back') }}</a></p>
{% else %}
<div class="admin-panel__header"><div><small>{{ count }}</small><h2>{{ ui_text('admin.ai.review.title') }}</h2></div><div class="admin-row-actions">
<form method="post" action="{{ path('admin_ai_batch_review_apply') }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.ai.review.apply_all_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><input type="hidden" name="all" value="1"><button class="admin-button is-primary" type="submit" data-ai-apply-all>{{ ui_icon('check', 16) }}<span>{{ ui_text('admin.ai.review.apply_all') }}</span></button></form>
<form method="post" action="{{ path('admin_ai_batch_review_reject') }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.ai.review.reject_all_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><input type="hidden" name="all" value="1"><button class="admin-button is-danger" type="submit">{{ ui_icon('x', 16) }}<span>{{ ui_text('admin.ai.review.reject_all') }}</span></button></form></div></div>
{% for item in items %}{% set overwrites = false %}{% for c in item.changes %}{% if c.before|trim != '' %}{% set overwrites = true %}{% endif %}{% endfor %}
<article class="admin-card" data-ai-review-item="{{ item.id }}">
<header class="admin-panel__header"><div><small>{{ ui_text('admin.ai.batch.task.' ~ item.task) }}</small><h3>{{ item.name }}</h3></div><div class="admin-row-actions">
<form method="post" action="{{ path('admin_ai_batch_review_apply') }}" class="admin-inline-form"{% if overwrites %} data-confirm="{{ ui_text('admin.ai.review.apply_confirm')|e('html_attr') }}"{% endif %}><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><input type="hidden" name="ids[]" value="{{ item.id }}"><button class="admin-button is-primary" type="submit" data-ai-apply>{{ ui_icon('check', 16) }}<span>{{ ui_text('admin.ai.review.apply') }}</span></button></form>
<form method="post" action="{{ path('admin_ai_batch_review_reject') }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_batch') }}"><input type="hidden" name="ids[]" value="{{ item.id }}"><button class="admin-button" type="submit" data-ai-reject>{{ ui_icon('x', 16) }}<span>{{ ui_text('admin.ai.review.reject') }}</span></button></form></div></header>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.ai.review.field') }}</th><th>{{ ui_text('admin.ai.review.before') }}</th><th>{{ ui_text('admin.ai.review.after') }}</th></tr></thead><tbody>
{% for c in item.changes %}<tr data-field="{{ c.field }}"><td>{{ ui_text('admin.ai.review.field.' ~ c.field) }}</td><td data-ai-before>{% if c.before|trim == '' %}<em>{{ ui_text('admin.ai.review.empty_field') }}</em>{% else %}{{ c.before|striptags|trim|slice(0, 600) }}{% endif %}</td><td data-ai-after>{{ c.after|striptags|trim|slice(0, 600) }}</td></tr>{% endfor %}
</tbody></table></div>
</article>
{% endfor %}
{% if pages > 1 %}<nav class="admin-pagination" aria-label="{{ ui_text('admin.ai.review.title') }}">{% for p in 1..pages %}{% if p == page %}<span aria-current="page">{{ p }}</span>{% else %}<a href="{{ path('admin_ai_batch_review', {page: p}) }}">{{ p }}</a>{% endif %}{% endfor %}</nav>{% endif %}
{% endif %}</section>
{{ shell.end() }}
