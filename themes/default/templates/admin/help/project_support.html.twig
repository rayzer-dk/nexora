{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.project_support.title'), 'project_support') }}
<header class="admin-page-header">
  <div>
    <nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}">
      <a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}
      <span aria-current="page">{{ ui_text('admin.project_support.title') }}</span>
    </nav>
    <h1>{{ ui_icon('heart-handshake', 26) }} {{ ui_text('admin.project_support.heading') }}</h1>
    <p>{{ ui_text('admin.project_support.lead') }}</p>
  </div>
</header>
<section class="admin-panel">
  <div class="admin-panel__header"><div><h2>{{ ui_text('admin.project_support.why_title') }}</h2></div></div>
  <p>{{ ui_text('admin.project_support.why_text') }}</p>
  <div class="admin-document-list">
    <article><strong>{{ ui_text('admin.project_support.reliability_title') }}</strong><p>{{ ui_text('admin.project_support.reliability_text') }}</p></article>
    <article><strong>{{ ui_text('admin.project_support.speed_title') }}</strong><p>{{ ui_text('admin.project_support.speed_text') }}</p></article>
    <article><strong>{{ ui_text('admin.project_support.open_title') }}</strong><p>{{ ui_text('admin.project_support.open_text') }}</p></article>
  </div>
</section>
<section class="admin-panel">
  <div class="admin-panel__header"><div><h2>{{ ui_text('admin.project_support.donate_title') }}</h2></div></div>
  <p>{{ ui_text('admin.project_support.donate_text') }}</p>
  <div class="admin-inline-actions">
    <a class="admin-button admin-button--primary" href="https://send.monobank.ua/jar/7eE1YTYqS3" target="_blank" rel="noopener noreferrer">{{ ui_icon('heart', 16) }} Monobank</a>
    <a class="admin-button" href="https://revolut.me/codecartpro" target="_blank" rel="noopener noreferrer">Revolut</a>
    <a class="admin-button" href="https://buy.stripe.com/6oU00j3nk0YJ2j3ecEe3e02" target="_blank" rel="noopener noreferrer">{{ ui_icon('credit-card', 16) }} {{ ui_text('admin.project_support.bank_card') }}</a>
    <a class="admin-button" href="https://ko-fi.com/codecartpro" target="_blank" rel="noopener noreferrer">Ko-fi</a>
  </div>
</section>
<section class="admin-panel">
  <div class="admin-panel__header"><div><h2>{{ ui_text('admin.project_support.help_title') }}</h2></div></div>
  <p>{{ ui_text('admin.project_support.help_text') }}</p>
  <div class="admin-inline-actions">
    <a class="admin-button admin-button--primary" href="https://github.com/rayzer-dk/nexora" target="_blank" rel="noopener noreferrer">{{ ui_icon('github', 16) }} GitHub</a>
    <a class="admin-button" href="https://github.com/rayzer-dk/nexora/issues" target="_blank" rel="noopener noreferrer">{{ ui_icon('bug', 16) }} {{ ui_text('admin.project_support.report_issue') }}</a>
    <a class="admin-button" href="https://t.me/codecartpro" target="_blank" rel="noopener noreferrer">{{ ui_icon('messages-square', 16) }} Telegram</a>
    <a class="admin-button" href="mailto:support@codecartpro.com">{{ ui_icon('mail', 16) }} support@codecartpro.com</a>
  </div>
</section>
<p>{{ ui_text('admin.project_support.thanks') }}</p>
{{ shell.end() }}
