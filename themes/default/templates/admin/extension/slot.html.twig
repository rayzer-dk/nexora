{% for contribution in extension_slot(slot) %}
  <section class="admin-panel extension-slot" data-extension-slot="{{ slot|e('html_attr') }}" data-extension-code="{{ contribution.extension_code|e('html_attr') }}" data-extension-component="{{ contribution.component|e('html_attr') }}">
    {% if contribution.title_key %}<h2>{{ ui_text(contribution.title_key) }}</h2>{% endif %}
    {% if contribution.content_key %}<p class="admin-help">{{ ui_text(contribution.content_key) }}</p>{% endif %}
  </section>
{% endfor %}
