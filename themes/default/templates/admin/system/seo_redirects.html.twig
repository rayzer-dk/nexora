{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.system.seo_redirects.title'),'seo_redirects') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.system.seo_redirects.section') }}</small><h1>{{ ui_text('admin.system.seo_redirects.title') }}</h1><p>{{ ui_text('admin.system.seo_redirects.help') }}</p></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="store-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-runtime__panel">
<form class="admin-order-filters" method="get">
<label class="admin-order-filters__search"><span>{{ ui_text('admin.system.seo_redirects.search') }}</span><input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.system.seo_redirects.search_placeholder')|e('html_attr') }}"></label>
<label><span>{{ ui_text('admin.system.seo_redirects.locale') }}</span><select name="locale"><option value="">{{ ui_text('admin.system.seo_redirects.all') }}</option>{% for item in locales %}<option value="{{ item }}"{{ locale == item ? ' selected' : '' }}>{{ item }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.system.seo_redirects.entity') }}</span><select name="entity_type"><option value="">{{ ui_text('admin.system.seo_redirects.all') }}</option>{% for item in entity_types %}<option value="{{ item }}"{{ entity_type == item ? ' selected' : '' }}>{{ item }}</option>{% endfor %}</select></label>
<button type="submit">{{ ui_text('admin.system.seo_redirects.apply') }}</button>{% if search or locale or entity_type %}<a href="{{ path('admin_system_seo_redirects') }}">{{ ui_text('admin.system.seo_redirects.reset') }}</a>{% endif %}
</form>
<div class="store-notice is-warning">{{ ui_text('admin.system.seo_redirects.delete_warning') }}</div>
<form method="post" action="{{ path('admin_system_seo_redirect_delete_selected') }}" data-confirm="{{ ui_text('admin.system.seo_redirects.delete_selected_confirm') }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_redirect_delete_selected') }}">
<div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th><input type="checkbox" data-check-all title="{{ ui_text('admin.system.seo_redirects.select_all') }}"></th><th>{{ ui_text('admin.system.seo_redirects.old_url') }}</th><th>{{ ui_text('admin.system.seo_redirects.new_url') }}</th><th>{{ ui_text('admin.system.seo_redirects.type') }}</th><th>{{ ui_text('admin.system.seo_redirects.hits') }}</th><th>{{ ui_text('admin.system.seo_redirects.created') }}</th><th>{{ ui_text('admin.system.seo_redirects.last_hit') }}</th><th>{{ ui_text('admin.system.seo_redirects.action') }}</th></tr></thead><tbody>
{% for row in rows %}<tr><td><input type="checkbox" name="ids[]" value="{{ row.id }}" data-row-check></td><td>{% set prefix = row.url_prefix|default('')|trim('/') %}<code>/{{ prefix ? prefix ~ '/' : '' }}{{ row.source_path }}</code><small>{{ row.locale }} · HTTP {{ row.status_code }}</small></td><td><code>/{{ prefix ? prefix ~ '/' : '' }}{{ row.target_path }}</code><small>{{ row.entity_type }}</small></td><td>{{ row.reason }}</td><td>{{ row.hit_count }}</td><td>{{ row.created_at }}</td><td>{{ row.last_hit_at|default('—') }}</td><td><button class="admin-icon-button is-danger" type="submit" formaction="{{ path('admin_system_seo_redirect_delete',{id:row.id}) }}" name="_row_token" value="{{ csrf_token('seo_redirect_delete_' ~ row.id) }}" formmethod="post" data-confirm="{{ ui_text('admin.system.seo_redirects.delete_confirm') }}" title="{{ ui_text('admin.system.seo_redirects.delete') }}">×</button></td></tr>{% else %}<tr><td colspan="8" class="admin-empty">{{ ui_text('admin.system.seo_redirects.empty') }}</td></tr>{% endfor %}
</tbody></table></div>
{% if rows %}<div class="admin-bulk-actions"><button class="is-danger" type="submit">{{ ui_text('admin.system.seo_redirects.delete_selected') }}</button></div>{% endif %}
</form>
<div class="admin-list-pagination"><div>{% if page > 1 %}<a href="?page={{ page-1 }}&search={{ search|url_encode }}&locale={{ locale|url_encode }}&entity_type={{ entity_type|url_encode }}">{{ ui_text('admin.system.seo_redirects.previous') }}</a>{% endif %}</div><span>{{ ui_text('admin.system.seo_redirects.page') }} {{ page }} / {{ pages }} · {{ count }}</span><div>{% if page < pages %}<a href="?page={{ page+1 }}&search={{ search|url_encode }}&locale={{ locale|url_encode }}&entity_type={{ entity_type|url_encode }}">{{ ui_text('admin.system.seo_redirects.next') }}</a>{% endif %}</div></div>
</section>{{ shell.end() }}
