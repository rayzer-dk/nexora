{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.prro.title'),'prro') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.prro.title') }}</span></nav><h1>{{ ui_text('admin.prro.title') }} {% include '@storefront/admin/_tip.html.twig' with {key:'prro'} only %}</h1><p>{{ ui_text('admin.prro.hint') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<form method="post" class="admin-form" autocomplete="off"><input type="hidden" name="_csrf_token" value="{{ csrf_token('prro_settings') }}">
<section class="admin-panel"><h2>Checkbox</h2><div class="admin-form-grid">
<label class="admin-switch admin-form-wide"><input type="checkbox" role="switch" name="enabled" value="1"{{ cfg.enabled ? ' checked' : '' }}><span>{{ ui_text('admin.prro.enabled') }}</span></label>
<label><span>{{ ui_text('admin.prro.environment') }}</span><select name="environment"><option value="test"{{ cfg.environment == 'test' ? ' selected' : '' }}>{{ ui_text('admin.prro.env_test') }}</option><option value="prod"{{ cfg.environment == 'prod' ? ' selected' : '' }}>{{ ui_text('admin.prro.env_prod') }}</option></select></label>
<label><span>{{ ui_text('admin.prro.login') }}</span><input type="text" name="login" value="{{ cfg.login }}" maxlength="190" autocomplete="off"></label>
<label><span>{{ ui_text('admin.prro.password') }}</span><input type="password" name="password" value="" maxlength="500" autocomplete="new-password" placeholder="{{ has_secrets ? '••••••••' : '' }}"><small>{{ ui_text('admin.prro.secret_hint') }}</small></label>
<label><span>{{ ui_text('admin.prro.license') }}</span><input type="password" name="license" value="" maxlength="500" autocomplete="new-password" placeholder="{{ has_secrets ? '••••••••' : '' }}"></label>
<label><span>{{ ui_text('admin.prro.auto') }}</span><select name="auto"><option value="off"{{ cfg.auto == 'off' ? ' selected' : '' }}>{{ ui_text('admin.prro.auto_off') }}</option><option value="paid"{{ cfg.auto == 'paid' ? ' selected' : '' }}>{{ ui_text('admin.prro.auto_paid') }}</option></select></label>
<label class="admin-switch admin-form-wide"><input type="checkbox" role="switch" name="send_email" value="1"{{ cfg.send_email ? ' checked' : '' }}><span>{{ ui_text('admin.prro.send_email') }}</span></label>
<fieldset class="admin-form-wide"><legend>{{ ui_text('admin.prro.skip') }}</legend>
<label class="admin-check"><input type="checkbox" name="skip_bank_transfer" value="1"{{ 'bank_transfer' in cfg.skip ? ' checked' : '' }}> {{ ui_text('admin.prro.method_bank_transfer') }}</label><label class="admin-check"><input type="checkbox" name="skip_b2b_invoice" value="1"{{ 'b2b_invoice' in cfg.skip ? ' checked' : '' }}> {{ ui_text('admin.prro.method_b2b_invoice') }}</label><label class="admin-check"><input type="checkbox" name="skip_cash_on_delivery" value="1"{{ 'cash_on_delivery' in cfg.skip ? ' checked' : '' }}> {{ ui_text('admin.prro.method_cash_on_delivery') }}</label><small>{{ ui_text('admin.prro.skip_hint') }}</small></fieldset>
</div></section>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.commerce.customers.zberehty') }}</button><button class="admin-button" type="submit" name="action" value="test">{{ ui_icon('plug', 16) }} {{ ui_text('admin.prro.test') }}</button></div></form>
<section class="admin-panel"><h2>{{ ui_text('admin.prro.recent') }}</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.prro.col_order') }}</th><th>{{ ui_text('admin.prro.col_status') }}</th><th>{{ ui_text('admin.prro.col_code') }}</th><th>{{ ui_text('admin.prro.col_updated') }}</th></tr></thead><tbody>
{% for r in recent %}<tr><td><a href="{{ path('admin_order_view', {publicId: r.order_public_id}) }}">{{ r.order_number }}</a></td><td><span class="admin-badge is-{{ r.status == 'done' ? 'active' : 'blocked' }}">{% if r.status == 'done' %}{{ ui_text('admin.prro.status_done') }}{% elseif r.status == 'error' %}{{ ui_text('admin.prro.status_error') }}{% else %}{{ ui_text('admin.prro.status_sending') }}{% endif %}</span>{% if r.error_text %}<small>{{ r.error_text }}</small>{% endif %}</td><td>{% if r.receipt_url %}<a href="{{ r.receipt_url }}" target="_blank" rel="noopener noreferrer">{{ r.fiscal_code|default('—') }}</a>{% else %}—{% endif %}</td><td>{{ r.updated_at|local_datetime }}</td></tr>{% else %}<tr><td colspan="4" class="admin-empty">{{ ui_text('admin.prro.empty') }}</td></tr>{% endfor %}
</tbody></table></div></section>{{ shell.end() }}
