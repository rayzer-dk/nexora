{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.tracking.title'),'tracking') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.tracking.title') }}</span></nav><h1>{{ ui_text('admin.tracking.title') }}</h1><p>{{ ui_text('admin.tracking.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><form method="post" action="{{ path('admin_system_tracking') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_tracking') }}">
<label>{{ ui_text('admin.tracking.ga4') }}<input type="text" name="ga4_id" value="{{ s.ga4_id }}" maxlength="16" placeholder="G-XXXXXXXXXX" autocomplete="off"><small>{{ ui_text('admin.tracking.ga4_hint') }}</small></label>
<label>{{ ui_text('admin.tracking.gtm') }}<input type="text" name="gtm_id" value="{{ s.gtm_id }}" maxlength="14" placeholder="GTM-XXXXXXX" autocomplete="off"><small>{{ ui_text('admin.tracking.gtm_hint') }}</small></label>
<label>{{ ui_text('admin.tracking.pixel') }}<input type="text" name="meta_pixel_id" value="{{ s.meta_pixel_id }}" maxlength="20" placeholder="1234567890" autocomplete="off" inputmode="numeric"><small>{{ ui_text('admin.tracking.pixel_hint') }}</small></label>
<div class="admin-form-wide"><small>{{ ui_text('admin.tracking.consent_note') }}</small></div>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.blog.save') }}</button></div></form></section>
{{ shell.end() }}
