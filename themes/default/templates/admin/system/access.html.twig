{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.system.access.administratory_ta_prava'),'access') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('ui.admin.system.access.security_rbac') }}</span></nav><h1>{{ ui_text('admin.system.access.administratory_ta_prava') }}</h1><p>{{ ui_text('admin.system.access.pryznachaite_roli_okremi_dii_ta_mahazyny_server_') }}</p></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}

<section class="admin-panel">
  <div class="admin-panel__header"><div><small>{{ ui_text('admin.system.access.komanda') }}</small><h2>{{ ui_text('admin.system.access.administratory') }}</h2><p>{{ ui_text('admin.system.access.dlia_obmezhenoho_korystuvacha_oberit_khocha_b_od') }}</p></div><span class="admin-badge">{{ ui_text('ui.admin.system.access.fail_closed') }}</span></div>
  {% for u in users %}
  <details class="admin-panel" {% if loop.first %}open{% endif %}>
    <summary><strong>{{ u.display_name }}</strong> · {{ u.email }} · <span class="admin-badge is-{{ u.status }}">{{ u.status }}</span></summary>
    <form method="post" action="{{ path('admin_access_user_save') }}" class="admin-form-grid" data-dirty-guard>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_access_user') }}"><input type="hidden" name="id" value="{{ u.id }}">
      <label><span>{{ ui_text('admin.system.access.imia') }}</span><input type="text" name="display_name" value="{{ u.display_name }}" maxlength="190" required></label>
      <label><span>Email</span><input type="email" name="email" value="{{ u.email }}" maxlength="320" required></label>
      <label><span>{{ ui_text('admin.system.access.novyi_parol') }}</span><input type="password" name="password" minlength="12" autocomplete="new-password" placeholder="{{ ui_text('admin.system.access.zalyshte_porozhnim_bez_zminy') }}"><small>{{ ui_text('admin.system.access.minimum_12_symvoliv') }}</small></label>
      <label><span>{{ ui_text('admin.system.access.status') }}</span><select name="status"><option value="active" {{ u.status=='active'?'selected':'' }}>{{ ui_text('admin.system.access.aktyvnyi') }}</option><option value="disabled" {{ u.status=='disabled'?'selected':'' }}>{{ ui_text('admin.system.access.vymknenyi') }}</option></select></label>
      <fieldset class="is-wide"><legend>{{ ui_text('admin.system.access.roli') }}</legend><div class="admin-check-grid">{% for r in roles %}<label><input type="checkbox" name="roles[]" value="{{ r.code }}" {{ r.code in u.roles?'checked':'' }}><span><strong>{{ r.name }}</strong><small>{{ r.description }}</small></span></label>{% endfor %}</div></fieldset>
      <fieldset class="is-wide"><legend>{{ ui_text('admin.system.access.mahazyny') }}</legend><div class="admin-check-grid">{% for s in stores %}<label><input type="checkbox" name="stores[]" value="{{ s.id }}" {{ s.id in u.stores?'checked':'' }}><span>{{ s.name }}</span><small>#{{ s.id }} · {{ s.status }}</small></label>{% endfor %}</div></fieldset>
      <div class="admin-form-actions is-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.system.access.zberehty_dostup') }}</button></div>
    </form>
  </details>
  {% endfor %}
  <details class="admin-panel"><summary><strong>{{ ui_text('admin.system.access.dodaty_administratora') }}</strong></summary><form method="post" action="{{ path('admin_access_user_save') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_access_user') }}"><label><span>{{ ui_text('admin.system.access.imia') }}</span><input type="text" name="display_name" maxlength="190" required></label><label><span>Email</span><input type="email" name="email" maxlength="320" required></label><label><span>{{ ui_text('admin.system.access.parol') }}</span><input type="password" name="password" minlength="12" autocomplete="new-password" required></label><label><span>{{ ui_text('admin.system.access.status') }}</span><select name="status"><option value="active">{{ ui_text('admin.system.access.aktyvnyi') }}</option></select></label><fieldset class="is-wide"><legend>{{ ui_text('admin.system.access.roli') }}</legend><div class="admin-check-grid">{% for r in roles %}<label><input type="checkbox" name="roles[]" value="{{ r.code }}" {{ r.code=='ROLE_VIEWER'?'checked':'' }}><span>{{ r.name }}</span></label>{% endfor %}</div></fieldset><fieldset class="is-wide"><legend>{{ ui_text('admin.system.access.mahazyny') }}</legend><div class="admin-check-grid">{% for s in stores %}<label><input type="checkbox" name="stores[]" value="{{ s.id }}"><span>{{ s.name }}</span></label>{% endfor %}</div></fieldset><div class="admin-form-actions is-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.system.access.stvoryty_administratora') }}</button></div></form></details>
</section>

<section class="admin-panel">
 <div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.access.permission_matrix') }}</small><h2>{{ ui_text('admin.system.access.roli_ta_dozvoly') }}</h2><p>{{ ui_text('admin.system.access.tilky_perehliad_ie_hotovym_bezpechnym_preset_kry') }}</p></div></div>
 {% set permMeta = {} %}{% for p in permissions %}{% set permMeta = permMeta|merge({(p.code):p}) %}{% endfor %}
 {% for role in roles %}
 <details class="admin-panel" {% if role.code=='ROLE_VIEWER' %}open{% endif %}><summary><strong>{{ role.name }}</strong> <code>{{ role.code }}</code>{% if role.is_system %} <span class="admin-badge">{{ ui_text('ui.admin.system.access.system') }}</span>{% endif %}</summary>
 <form method="post" action="{{ path('admin_access_role_save') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_access_role') }}"><input type="hidden" name="code" value="{{ role.code }}"><div class="admin-form-grid"><label><span>{{ ui_text('admin.system.access.nazva') }}</span><input type="text" name="name" value="{{ role.name }}" required></label><label class="is-wide"><span>{{ ui_text('admin.system.access.opys') }}</span><input type="text" name="description" value="{{ role.description }}" maxlength="500"></label></div>
 {% for group,codes in permission_groups %}<fieldset><legend>{{ group }}</legend><div class="admin-check-grid">{% for code in codes %}{% if permMeta[code] is defined %}{% set pm=permMeta[code] %}<label class="{{ pm.risk_level in ['high','critical'] ? 'is-risk' : '' }}"><input type="checkbox" name="permissions[]" value="{{ code }}" {{ code in role.permissions?'checked':'' }}><span>{{ code }}</span><small>{{ pm.description }} · {{ pm.risk_level }}</small></label>{% endif %}{% endfor %}</div></fieldset>{% endfor %}
 <div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.system.access.zberehty_rol') }}</button></div></form>{% if not role.is_system %}<form method="post" action="{{ path('admin_access_role_delete',{code:role.code}) }}" class="admin-form-actions"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_access_role_delete_' ~ role.code) }}"><button type="submit" class="is-danger" data-confirm="{{ ui_text('admin.system.access.vydalyty_rol') }}">{{ ui_text('admin.system.access.vydalyty_rol_2') }}</button></form>{% endif %}</details>
 {% endfor %}
 <details class="admin-panel"><summary><strong>{{ ui_text('admin.system.access.nova_rol') }}</strong></summary><form method="post" action="{{ path('admin_access_role_save') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_access_role') }}"><div class="admin-form-grid"><label><span>{{ ui_text('admin.system.access.kod') }}</span><input type="text" name="code" value="ROLE_" pattern="ROLE_[A-Z0-9_]{3,80}" required></label><label><span>{{ ui_text('admin.system.access.nazva') }}</span><input type="text" name="name" required></label><label class="is-wide"><span>{{ ui_text('admin.system.access.opys') }}</span><input type="text" name="description" maxlength="500"></label></div>{% for group,codes in permission_groups %}<fieldset><legend>{{ group }}</legend><div class="admin-check-grid">{% for code in codes %}{% if permMeta[code] is defined %}{% set pm=permMeta[code] %}<label><input type="checkbox" name="permissions[]" value="{{ code }}"><span>{{ code }}</span><small>{{ pm.description }}</small></label>{% endif %}{% endfor %}</div></fieldset>{% endfor %}<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.system.access.stvoryty_rol') }}</button></div></form></details>
</section>
{{ shell.end() }}
