{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.extensions.diag.title'),'extensions') }}
<header class="admin-page-header">
    <div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_system_extensions') }}">{{ ui_text('admin.system.extensions.rozshyrennia') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.extensions.diag.title') }}</span></nav><h1>{{ extension.name }}</h1><p><code>{{ extension.code }}</code> · {{ extension.version }}</p></div>
    <div class="admin-inline-actions"><a class="admin-button" href="{{ path('admin_system_extension_journal', {code: extension.code}) }}">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.extensions.diag.journal') }}</a><a class="admin-button is-primary" href="{{ path('admin_system_extensions') }}">{{ ui_text('admin.system.extension_settings.do_rozshyren') }}</a></div>
</header>
<section class="admin-panel">
    <div class="admin-table-wrap"><table class="admin-table"><tbody>
        <tr><th scope="row">{{ ui_text('admin.extensions.lifecycle.version') }}</th><td>{{ extension.version }} · {{ extension.type }} · {{ extension.execution }} <span class="admin-badge is-{{ extension.status }}">{{ extension.status }}</span>{% if extension.last_error %}<small class="admin-cell-sub">{{ extension.last_error }}</small>{% endif %}</td></tr>
        <tr><th scope="row">{{ ui_text('admin.extensions.diag.core') }}</th><td>{% if core.compatible is null %}{{ ui_text('admin.extensions.diag.core_none') }}{% else %}<span class="admin-badge is-{{ core.compatible ? 'active' : 'quarantined' }}">{{ ui_text(core.compatible ? 'admin.extensions.diag.core_ok' : 'admin.extensions.diag.core_bad') }}</span> <code>{{ core.constraint }}</code> · {{ ui_text('admin.extensions.diag.core_platform') }} {{ core.platform }}{% endif %} · API {{ extension.api_version }}</td></tr>
        <tr><th scope="row">{{ ui_text('admin.extensions.diag.signature') }}</th><td><span class="admin-badge is-{{ signature.state == 'trusted' ? 'active' : (signature.state == 'quarantined' ? 'quarantined' : 'staged') }}">{{ ui_text('admin.extensions.diag.signature_' ~ signature.state) }}</span>{% if signature.publisher %} {{ signature.publisher }}{% endif %}{% if signature.key_id %} · <code>{{ signature.key_id }}</code>{% endif %}</td></tr>
        <tr><th scope="row">{{ ui_text('admin.extensions.diag.permissions') }}</th><td>{% for permission in permissions %}<code>{{ permission }}</code>{{ loop.last ? '' : ', ' }}{% else %}{{ ui_text('admin.extensions.diag.none') }}{% endfor %}</td></tr>
        <tr><th scope="row">{{ ui_text('admin.extensions.diag.migrations') }}</th><td>{% for migration in migrations %}<div><code>{{ migration.key }}</code> <span class="admin-badge is-{{ migration.applied and not migration.changed ? 'active' : (migration.changed ? 'quarantined' : 'staged') }}">{{ ui_text(migration.changed ? 'admin.extensions.diag.migration_changed' : (migration.applied ? 'admin.extensions.diag.migration_applied' : 'admin.extensions.diag.migration_pending')) }}</span></div>{% else %}{{ ui_text('admin.extensions.diag.none') }}{% endfor %}</td></tr>
        <tr><th scope="row">{{ ui_text('admin.extensions.diag.settings') }}</th><td>{% if settings.state == 'none' %}{{ ui_text('admin.extensions.diag.settings_none') }}{% elseif settings.state == 'ok' %}<span class="admin-badge is-active">{{ ui_text('admin.extensions.diag.settings_ok') }}</span> {{ ui_text('admin.extensions.diag.settings_fields', {count: settings.fields}) }}{% else %}<span class="admin-badge is-quarantined">{{ ui_text('admin.extensions.diag.settings_error') }}</span><small class="admin-cell-sub">{{ settings.message }}</small>{% endif %}</td></tr>
    </tbody></table></div>
</section>
<section class="admin-panel">
    <div class="admin-panel__header"><div><h2>{{ ui_text('admin.extensions.diag.events') }}</h2></div></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.extensions.lifecycle.time') }}</th><th>{{ ui_text('admin.extensions.lifecycle.version') }}</th><th>{{ ui_text('admin.extensions.lifecycle.event') }}</th><th>{{ ui_text('admin.extensions.lifecycle.result') }}</th><th>{{ ui_text('admin.extensions.lifecycle.details') }}</th></tr></thead><tbody>
    {% for event in events %}<tr><td>{{ event.created_at }}</td><td>{{ event.version }}</td><td>{{ event.action }}</td><td><span class="admin-badge is-{{ event.result == 'success' ? 'active' : (event.result == 'warning' ? 'staged' : 'quarantined') }}">{{ event.result }}</span></td><td><small class="admin-cell-sub">{{ event.message|default('—') }}</small></td></tr>{% else %}<tr><td colspan="5">{{ ui_text('admin.extensions.lifecycle.empty') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>
{{ shell.end() }}
