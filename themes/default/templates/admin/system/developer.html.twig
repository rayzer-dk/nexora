{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start('Developer Tools','developer') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.system.developer.systema_diahnostyka') }}</span></nav><h1>{{ ui_text('ui.admin.system.developer.developer_tools') }}</h1><p>{{ ui_text('admin.system.developer.bezpechnyi_read_only_ohliad_platformy_marshrutiv') }}</p></div><div><a class="admin-button is-primary" href="{{ path('admin_system_developer_report') }}" target="_blank" rel="noopener">{{ ui_text('ui.admin.system.developer.json_report') }}</a></div></header>
<div class="admin-stats"><article><small>{{ ui_text('admin.system.developer.versiia') }}</small><strong>{{ platform.version }}</strong><span>schema {{ platform.schema }} · {{ platform.channel }}</span></article><article><small>PHP</small><strong>{{ runtime.php }}</strong><span>{{ runtime.sapi }} · {{ runtime.memory_limit }}</span></article><article><small>{{ ui_text('admin.system.developer.bd') }}</small><strong>{{ database.server_version }}</strong><span>{{ database.tables is null ? ui_text('admin.system.developer.tablytsi_n_a') : database.tables ~ ui_text('admin.system.developer.mc_tablyts') }}</span></article><article><small>{{ ui_text('admin.system.developer.marshruty') }}</small><strong>{{ routes|length }}</strong><span>{{ ui_text('admin.system.developer.pokazano_do_500') }}</span></article></div>
<div class="admin-split"><section class="admin-panel"><h2>{{ ui_text('admin.system.developer.operatsiinyi_stan') }}</h2><dl class="admin-kv"><dt>{{ ui_text('ui.admin.system.developer.queue_pending_retry') }}</dt><dd>{{ operations.queue_pending is null ? 'n/a' : operations.queue_pending }}</dd><dt>{{ ui_text('ui.admin.system.developer.queue_failed_dead') }}</dt><dd>{{ operations.queue_failed is null ? 'n/a' : operations.queue_failed }}</dd><dt>{{ ui_text('ui.admin.system.developer.outbox_pending') }}</dt><dd>{{ operations.outbox_pending is null ? 'n/a' : operations.outbox_pending }}</dd><dt>{{ ui_text('ui.admin.system.developer.runtime_incidents_24h') }}</dt><dd>{{ operations.runtime_incidents_24h is null ? 'n/a' : operations.runtime_incidents_24h }}</dd><dt>{{ ui_text('ui.admin.system.developer.active_extensions') }}</dt><dd>{{ operations.active_extensions is null ? 'n/a' : operations.active_extensions }}</dd></dl></section><section class="admin-panel"><h2>{{ ui_text('ui.admin.system.developer.php_extensions') }}</h2><div class="admin-chip-list">{% for name,loaded in runtime.extensions %}<span class="admin-chip {{ loaded ? 'is-success' : 'is-danger' }}">{{ name }}: {{ loaded ? 'OK' : 'missing' }}</span>{% endfor %}</div></section></div>
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('ui.admin.system.developer.capabilities') }}</h2><p>{{ ui_text('admin.system.developer.faktychnyi_maturity_iz_systemmodulecatalog') }}</p></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('ui.admin.system.developer.code') }}</th><th>{{ ui_text('admin.system.developer.nazva') }}</th><th>{{ ui_text('ui.admin.system.developer.maturity') }}</th><th>{{ ui_text('ui.admin.system.developer.default') }}</th><th>{{ ui_text('ui.admin.system.developer.dependencies') }}</th></tr></thead><tbody>{% for module in modules %}<tr><td><code>{{ module.code }}</code></td><td>{{ module.name }}</td><td><span class="admin-chip">{{ module.maturity }}</span></td><td>{{ module.enabled_by_default ? 'on' : 'off' }}</td><td>{{ module.dependencies|join(', ') ?: '—' }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('ui.admin.system.developer.route_explorer') }}</h2><p>{{ ui_text('admin.system.developer.poshuk_za_route_name_url_http_method_abo_control') }}</p></div><form method="get"><input type="search" name="q" value="{{ route_query }}" maxlength="120" placeholder="{{ ui_text('admin.system.developer.napryklad_checkout') }}"><button type="submit">{{ ui_text('admin.system.developer.znaity') }}</button></form></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('ui.admin.system.developer.route') }}</th><th>{{ ui_text('ui.admin.system.developer.methods') }}</th><th>{{ ui_text('ui.admin.system.developer.path') }}</th><th>{{ ui_text('ui.admin.system.developer.controller') }}</th></tr></thead><tbody>{% for route in routes %}<tr><td><code>{{ route.name }}</code></td><td>{{ route.methods }}</td><td><code title="{{ route.path }}">{{ route.path }}</code></td><td><code title="{{ route.controller }}">{{ route.controller }}</code></td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.system.developer.nichoho_ne_znaideno') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
