{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{% import '@storefront/admin/_help.html.twig' as help %}{{ shell.start(ui_text('admin.fraud.title'),'fraud') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.fraud.title') }}</span></nav><h1>{{ ui_text('admin.fraud.title') }}</h1><p>{{ ui_text('admin.fraud.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}
{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.fraud.settings_hint') }}</small><h2>{{ ui_text('admin.fraud.settings') }}</h2></div>{{ ui_icon('shield-check', 20) }}</div>
<form method="post" action="{{ path('admin_system_fraud_save') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_fraud') }}">
<label class="admin-check"><input type="checkbox" name="enabled" value="1" {{ settings.enabled ? 'checked' : '' }}><span>{{ ui_text('admin.fraud.enabled') }}</span></label>
<label><span>{{ ui_text('admin.fraud.review_score') }}</span><input type="number" name="review_score" min="10" max="99" value="{{ settings.review_score }}">{{ help.hint(ui_text('admin.help.fraud.review_score'), null, null, '40') }}</label>
<label><span>{{ ui_text('admin.fraud.high_score') }}</span><input type="number" name="high_score" min="11" max="100" value="{{ settings.high_score }}">{{ help.hint(ui_text('admin.help.fraud.high_score'), null, null, '80') }}</label>
<label><span>{{ ui_text('admin.fraud.velocity_limit') }}</span><input type="number" name="velocity_limit" min="1" max="50" value="{{ settings.velocity_limit }}">{{ help.hint(ui_text('admin.help.fraud.velocity_limit'), null, null, '3') }}</label>
<label><span>{{ ui_text('admin.fraud.high_value') }}</span><input type="number" name="high_value" min="0" step="1" value="{{ (settings.high_value_minor / 100)|round }}">{{ help.hint(ui_text('admin.help.fraud.high_value'), null, null, '50000') }}</label>
<label class="admin-check admin-form-wide"><input type="checkbox" name="device_confirm" value="1" {{ settings.device_confirm ? 'checked' : '' }}><span>{{ ui_text('admin.fraud.device_confirm') }}</span></label>
<p class="admin-form-wide"><small>{{ ui_text('admin.fraud.device_confirm_hint') }}</small></p>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.fraud.save') }}</button></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.fraud.queue_hint') }}</small><h2>{{ ui_text('admin.fraud.queue') }}</h2></div>{{ ui_icon('flag', 20) }}</div>
{% if queue %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.fraud.order') }}</th><th>{{ ui_text('admin.fraud.score') }}</th><th>{{ ui_text('admin.fraud.reasons') }}</th><th>{{ ui_text('admin.fraud.contact') }}</th><th></th></tr></thead><tbody>
{% for row in queue %}<tr data-fraud-row="{{ row.order_id }}"><td><a href="/admin/orders/{{ row.public_id }}">{{ row.order_number }}</a><br><small>{{ (row.total_minor / 100)|number_format(2,'.',' ') }} {{ row.currency }}</small></td>
<td><span class="admin-badge {{ row.level == 'high' ? 'is-danger' : 'is-warning' }}">{{ row.score }}</span></td>
<td>{% for code in row.reasons %}<span class="admin-badge">{{ ui_text('admin.fraud.reason.' ~ code) }}</span> {% endfor %}</td>
<td>{{ row.email }}<br><small>{{ row.phone }}</small></td>
<td>{% if row.decision %}<span class="admin-badge {{ row.decision == 'fraud' ? 'is-danger' : 'is-success' }}">{{ ui_text('admin.fraud.decision.' ~ row.decision) }}</span>{% else %}
<form method="post" action="{{ path('admin_system_fraud_decide', {orderId: row.order_id}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_fraud') }}"><button class="admin-button" name="decision" value="clear" type="submit">{{ ui_icon('check', 16) }}<span>{{ ui_text('admin.fraud.clear') }}</span></button></form>
<form method="post" action="{{ path('admin_system_fraud_decide', {orderId: row.order_id}) }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.fraud.fraud_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_fraud') }}"><input type="hidden" name="block" value="1"><button class="admin-button is-danger" name="decision" value="fraud" type="submit">{{ ui_icon('ban', 16) }}<span>{{ ui_text('admin.fraud.mark_fraud') }}</span></button></form>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p>{{ ui_text('admin.fraud.queue_empty') }}</p>{% endif %}</section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.fraud.blocklist_hint') }}</small><h2>{{ ui_text('admin.fraud.blocklist') }}</h2></div>{{ ui_icon('ban', 20) }}</div>
<form method="post" action="{{ path('admin_system_fraud_block_add') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_fraud') }}">
<label><span>{{ ui_text('admin.fraud.kind') }}</span><select name="kind">{% for k in kinds %}<option value="{{ k }}">{{ ui_text('admin.fraud.kind.' ~ k) }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.fraud.value') }}</span><input type="text" name="value" maxlength="190" required></label>
<label><span>{{ ui_text('admin.fraud.note') }}</span><input type="text" name="note" maxlength="190"></label>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('plus', 16) }}<span>{{ ui_text('admin.fraud.add') }}</span></button></div></form>
{% if blocklist %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.fraud.kind') }}</th><th>{{ ui_text('admin.fraud.value') }}</th><th>{{ ui_text('admin.fraud.note') }}</th><th></th></tr></thead><tbody>
{% for b in blocklist %}<tr><td>{{ ui_text('admin.fraud.kind.' ~ b.kind) }}</td><td><code>{{ b.value }}</code></td><td>{{ b.note }}</td><td><form method="post" action="{{ path('admin_system_fraud_block_delete', {id: b.id}) }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.fraud.remove_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_fraud') }}"><button class="admin-button" type="submit">{{ ui_icon('trash-2', 16) }}<span>{{ ui_text('admin.fraud.remove') }}</span></button></form></td></tr>{% endfor %}
</tbody></table></div>{% endif %}</section>
{{ shell.end() }}
