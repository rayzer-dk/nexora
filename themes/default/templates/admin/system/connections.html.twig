{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.conn.title_' ~ group),'integrations') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_system_integrations') }}">{{ ui_text('admin_integrations') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.conn.title_' ~ group) }}</span></nav><h1>{{ ui_text('admin.conn.title_' ~ group) }}</h1><p>{{ ui_text('admin.conn.intro') }}</p></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<nav class="admin-view-chips" aria-label="{{ ui_text('admin.conn.groups') }}">{% for g in groups %}<a href="{{ path('admin_system_integrations_connections', {group: g}) }}"{{ g == group ? ' aria-current="page"' : '' }}>{{ ui_text('admin.conn.group_' ~ g) }}</a>{% endfor %}</nav>
<section class="admin-stats">{% for p in providers %}<article class="is-tone-{{ p.state == 'on' ? 'success' : (p.state == 'incomplete' ? 'warning' : 'neutral') }}"><span>{{ ui_icon(p.state == 'on' ? 'circle-check' : (p.state == 'incomplete' ? 'circle-alert' : 'clock'), 16) }} {{ p.label }}</span><strong>{{ ui_text('admin.conn.state_' ~ p.state) }}</strong></article>{% endfor %}</section>
{% for p in providers %}<section class="admin-panel" id="conn-{{ p.code }}"><details class="admin-more"{% if p.state == 'incomplete' %} open{% endif %}><summary><strong>{{ p.label }}</strong> <span class="admin-badge {{ p.state == 'on' ? 'is-active' : (p.state == 'incomplete' ? 'is-warning' : '') }}">{{ ui_text('admin.conn.state_' ~ p.state) }}</span></summary>
<p class="admin-help">{{ ui_text('admin.conn.hint_' ~ p.code) }} <a href="{{ p.docs }}" target="_blank" rel="noopener">{{ ui_icon('external-link', 14) }} {{ ui_text('admin.conn.docs') }}</a></p>
<form method="post" action="{{ path('admin_system_integrations_connections_save', {group: group}) }}" class="admin-form-grid" autocomplete="off"><input type="hidden" name="_token" value="{{ csrf_token('connections_' ~ group) }}"><input type="hidden" name="provider" value="{{ p.code }}">
{% for f in p.fields %}<label{% if f.type == 'bool' %} class="admin-switch-label"{% endif %}><span><code>{{ f.name }}</code>{% if f.required %} <small class="admin-edited">*</small>{% endif %} {% if f.set %}<small class="admin-edited">{{ ui_text(f.stored ? 'admin.carriers.set_admin' : 'admin.carriers.set_env') }}</small>{% endif %}</span>
{% if f.type == 'bool' %}<select name="key[{{ f.name }}]"><option value="">{{ ui_text('admin.conn.keep') }}: {{ (f.value ?: f.default) == '1' ? ui_text('admin.conn.on') : ui_text('admin.conn.off') }}</option><option value="1">{{ ui_text('admin.conn.on') }}</option><option value="0">{{ ui_text('admin.conn.off') }}</option></select>
{% elseif f.type == 'select' %}<select name="key[{{ f.name }}]"><option value="">{{ ui_text('admin.conn.keep') }}: {{ f.value }}</option>{% for o in f.options %}<option value="{{ o }}">{{ o }}</option>{% endfor %}</select>
{% elseif f.type == 'secret' %}<input type="password" name="key[{{ f.name }}]" value="" maxlength="2000" autocomplete="off" placeholder="{{ f.set ? ui_text('admin.carriers.keep')|e('html_attr') : '' }}">
{% else %}<input type="text" name="key[{{ f.name }}]" value="" maxlength="2000" placeholder="{{ f.value|e('html_attr') }}">{% endif %}
{% if f.stored %}<small><label class="admin-inline-label"><input type="checkbox" name="clear[{{ f.name }}]" value="1"> {{ ui_text('admin.carriers.clear') }}</label></small>{% endif %}</label>{% endfor %}
<div class="admin-form-actions admin-form-wide"><button type="submit" class="admin-button is-primary">{{ ui_icon('check', 16) }} {{ ui_text('admin.carriers.save') }}</button></div></form></details></section>{% endfor %}
{{ shell.end() }}
