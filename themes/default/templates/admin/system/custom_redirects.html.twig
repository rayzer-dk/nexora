{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.redirects.title'),'seo_redirects') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_system_seo_redirects') }}">{{ ui_text('admin.system.seo_redirects.section') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.redirects.title') }}</span></nav><h1>{{ ui_text('admin.redirects.title') }}</h1><p>{{ ui_text('admin.redirects.intro') }}</p></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-panel"><div><small>{{ ui_text('admin.redirects.new') }}</small><h2>{{ ui_text('admin.redirects.add') }}</h2></div>
<form method="post" action="{{ path('admin_system_seo_custom_redirect_save') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_custom_redirects') }}">
<label>{{ ui_text('admin.redirects.source') }}<input name="source" required maxlength="500" placeholder="/old-page.html" value="{{ prefill }}"></label>
<label>{{ ui_text('admin.redirects.target') }}<input name="target" required maxlength="1000" placeholder="/catalog/new-page"></label>
<label>{{ ui_text('admin.redirects.code') }}<select name="status_code"><option value="301">301 — {{ ui_text('admin.redirects.permanent') }}</option><option value="302">302 — {{ ui_text('admin.redirects.temporary') }}</option><option value="307">307</option><option value="308">308</option></select></label>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.badges.save') }}</button></div></form>
<details class="admin-collapse"><summary>{{ ui_icon('upload', 16) }} {{ ui_text('admin.redirects.import') }}</summary>
<form method="post" enctype="multipart/form-data" action="{{ path('admin_system_seo_custom_redirect_import') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_custom_redirects') }}">
<label class="admin-form-wide">{{ ui_text('admin.redirects.import_lines') }}<textarea name="lines" rows="6" placeholder="/index.php?route=product/product&amp;product_id=12;/catalog/new-product&#10;/old-category;/catalog/category;301"></textarea></label>
<label class="admin-form-wide">{{ ui_text('admin.redirects.import_file') }}<input type="file" name="file" accept=".csv,.txt"></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_icon('upload', 16) }} {{ ui_text('admin.redirects.import_submit') }}</button></div></form></details></section>
<div data-tabs="redirects">
<section class="admin-panel" data-tab="own" data-tab-label="{{ ui_text('admin.redirects.own') }}" data-tab-icon="corner-down-right"><form class="admin-filters" method="get"><label class="admin-filters__search"><span>{{ ui_text('admin.subscribers.search') }}</span><input type="search" name="search" value="{{ search }}"></label><div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('list-filter', 16) }} {{ ui_text('admin.orders.index.zastosuvaty') }}</button></div></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.redirects.source') }}</th><th>{{ ui_text('admin.redirects.target') }}</th><th>{{ ui_text('admin.redirects.code') }}</th><th>{{ ui_text('admin.redirects.hits') }}</th><th>{{ ui_text('admin.commerce.notifications.status') }}</th><th class="is-actions"></th></tr></thead><tbody>
{% for r in rows %}<tr><td><code>{{ r.source_path }}</code></td><td>{{ r.target_url }}</td><td>{{ r.status_code }}</td><td>{{ r.hit_count }}{% if r.last_hit_at %}<small class="admin-cell-sub">{{ r.last_hit_at|slice(0,16) }}</small>{% endif %}</td><td><form method="post" action="{{ path('admin_system_seo_custom_redirect_toggle', {id: r.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_custom_redirects') }}"><input type="hidden" name="enabled" value="{{ r.enabled ? 0 : 1 }}"><button class="admin-button is-sm" type="submit">{{ status_badge(r.enabled ? 'active' : 'disabled') }}</button></form></td>
<td class="is-actions"><form method="post" action="{{ path('admin_system_seo_custom_redirect_delete', {id: r.id}) }}" data-confirm="{{ ui_text('admin.redirects.delete_confirm') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_custom_redirects') }}"><button class="admin-icon-button is-sm is-danger" type="submit" aria-label="{{ ui_text('admin.forum.board.delete') }}">{{ ui_icon('trash-2', 16) }}</button></form></td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.redirects.none') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel" data-tab="notfound" data-tab-label="{{ ui_text('admin.redirects.not_found') }}" data-tab-icon="circle-alert"><div class="admin-panel__header"><p class="admin-help">{{ ui_text('admin.redirects.not_found_hint') }}</p><form class="admin-filters admin-form-wide" method="get"><label class="admin-filters__search"><span>{{ ui_text('admin.redirects.nf_search') }}</span><input type="search" name="nf" value="{{ nf_search }}"></label><label><span>{{ ui_text('admin.redirects.nf_min') }}</span><input type="number" name="min" min="1" max="10000" value="{{ nf_min }}" class="admin-input-narrow"></label><label><span>{{ ui_text('admin.redirects.nf_kind') }}</span><select name="kind"><option value="all"{{ nf_kind == 'all' ? ' selected' : '' }}>{{ ui_text('admin.redirects.kind_all') }}</option><option value="humans"{{ nf_kind == 'humans' ? ' selected' : '' }}>{{ ui_text('admin.redirects.kind_humans') }}</option><option value="bots"{{ nf_kind == 'bots' ? ' selected' : '' }}>{{ ui_text('admin.redirects.kind_bots') }}</option></select></label><label class="admin-check"><input type="hidden" name="noise" value="0"><input type="checkbox" name="noise" value="1"{{ nf_noise ? ' checked' : '' }}><span>{{ ui_text('admin.redirects.nf_hide_scanners') }}</span></label><button class="admin-button" type="submit">{{ ui_text('admin.system.seo_redirects.apply') }}</button></form><p class="admin-help">{{ ui_text('admin.redirects.nf_totals', {paths: not_found_totals.paths, hits: not_found_totals.hits, scanners: not_found_totals.scanner_paths}) }}</p>{% if not_found %}<form method="post" action="{{ path('admin_system_seo_custom_redirect_clear_404') }}" data-confirm="{{ ui_text('admin.redirects.clear_confirm') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_custom_redirects') }}"><button class="admin-button is-danger" type="submit">{{ ui_icon('trash-2', 16) }} {{ ui_text('admin.redirects.clear') }}</button></form>{% endif %}</div>
{% if not_found %}<form id="nf-bulk" method="post" action="{{ path('admin_system_seo_custom_redirect_bulk') }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.redirects.bulk_confirm') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_custom_redirects') }}"><label><span>{{ ui_text('admin.redirects.bulk_target') }}</span><input name="target" required maxlength="1000" placeholder="/catalog"></label><select name="status_code" aria-label="{{ ui_text('admin.redirects.code') }}"><option value="301">301</option><option value="302">302</option><option value="307">307</option><option value="308">308</option></select><button class="admin-button is-primary" type="submit">{{ ui_icon('corner-down-right', 16) }} {{ ui_text('admin.redirects.bulk_submit') }}</button></form>{% endif %}
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th><input type="checkbox" data-check-all aria-label="{{ ui_text('admin.orders.bulk.select_all') }}"></th><th>{{ ui_text('admin.redirects.path') }}</th><th>{{ ui_text('admin.redirects.hits') }}</th><th>{{ ui_text('admin.redirects.referer') }}</th><th>{{ ui_text('admin.redirects.agent') }}</th><th class="is-actions"></th></tr></thead><tbody>
{% for n in not_found %}<tr><td><input type="checkbox" form="nf-bulk" name="ids[]" value="{{ n.id }}" data-row-check aria-label="{{ n.path }}"></td><td><code>{{ n.path }}</code><small class="admin-cell-sub">{{ n.last_seen_at|slice(0,16) }}</small></td><td>{{ n.hit_count }}</td><td>{{ n.referer|default('—') }}</td><td>{% if n.is_bot %}<span class="admin-badge">{{ ui_text('admin.redirects.kind_bot') }}</span>{% else %}{{ ui_text('admin.redirects.kind_human') }}{% endif %}{% if n.last_user_agent %}<small class="admin-cell-sub" title="{{ n.last_user_agent }}">{{ n.last_user_agent|slice(0,40) }}</small>{% endif %}</td><td class="is-actions">{% if n.suggestion %}<form method="post" action="{{ path('admin_system_seo_custom_redirect_save') }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('seo_custom_redirects') }}"><input type="hidden" name="source" value="{{ n.path }}"><input type="hidden" name="target" value="{{ n.suggestion.target }}"><input type="hidden" name="status_code" value="301"><button class="admin-button is-sm is-primary" type="submit" title="{{ n.suggestion.target }}">{{ ui_icon('sparkles', 14) }} {{ ui_text('admin.redirects.suggest') }}: {{ n.suggestion.label }} ({{ n.suggestion.score }}%)</button></form> {% endif %}<a class="admin-button is-sm" href="{{ path('admin_system_seo_custom_redirects', {source: n.path}) }}">{{ ui_icon('corner-down-right', 14) }} {{ ui_text('admin.redirects.make') }}</a></td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.redirects.none_404') }}</td></tr>{% endfor %}</tbody></table></div></section>
</div>
{{ shell.end() }}
