{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.system.cron.cron_avtomatyzatsiia'),'cron') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.system.cron.systema_avtomatyzatsiia') }}</small><h1>{{ ui_text('admin.system.cron.cron_avtomatyzatsiia') }}</h1><p>{{ ui_text('admin.system.cron.odyn_systemnyi_cron_kozhni_5_khvylyn_modern_comm') }}</p></div></header>
<section class="admin-runtime__panel admin-runtime__panel--modern"><div><small>{{ ui_text('admin.system.cron.rekomendovana_komanda') }}</small><h2>{{ ui_text('admin.system.cron.odna_komanda_dlia_vsikh_shtatnykh_zadach') }}</h2></div><div class="admin-copy-field"><code id="cron-command">{{ command }}</code><button type="button" class="admin-ghost-button" data-copy-target="#cron-command" title="{{ ui_text('admin.system.cron.kopiiuvaty_cron_komandu') }}">{{ ui_text('admin.system.cron.kopiiuvaty') }}</button></div><p class="admin-muted">{{ ui_text('admin.system.cron.mirohost_khvylyny') }} <strong>*/5</strong>{{ ui_text('admin.system.cron.hodyny') }} <strong>*</strong>{{ ui_text('admin.system.cron.dni_misiatsia') }} <strong>*</strong>{{ ui_text('admin.system.cron.misiatsi') }} <strong>*</strong>{{ ui_text('admin.system.cron.dni_tyzhnia') }} <strong>*</strong>{{ ui_text('admin.system.cron.komanda') }} <code>{{ command }}</code>.</p></section>
<section class="admin-runtime__panel admin-runtime__panel--wide"><div><small>{{ ui_text('admin.system.cron.stan_zadach') }}</small><h2>{{ ui_text('admin.system.cron.shcho_vykonuietsia_avtomatychno') }}</h2></div><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>{{ ui_text('admin.system.cron.zadacha') }}</th><th>{{ ui_text('admin.system.cron.interval') }}</th><th>{{ ui_text('admin.system.cron.ostannii_zapusk') }}</th><th>{{ ui_text('admin.system.cron.status') }}</th><th>{{ ui_text('admin.system.cron.nastupnyi') }}</th><th>{{ ui_text('admin.system.cron.rezultat') }}</th></tr></thead><tbody>{% for code,task in tasks %}{% set state=states[code]|default(null) %}<tr><td><strong>{{ task.label }}</strong><small>{{ task.description }}</small></td><td>{{ (task.interval/60)|round }} {{ ui_text('admin.system.cron.khv') }}</td><td>{{ state.last_finished_at|default(ui_text('admin.system.cron.shche_ne_zapuskalas')) }}</td><td>{% if state %}<span class="admin-status-pill {{ state.last_status=='success'?'is-active':(state.last_status=='failed'?'is-danger':'') }}">{{ state.last_status }}</span>{% else %}<span class="admin-status-pill">{{ ui_text('admin.system.cron.ochikuie') }}</span>{% endif %}</td><td>{{ state.next_due_at|default(ui_text('admin.system.cron.pry_pershomu_cron')) }}</td><td><span title="{{ state.last_message|default('') }}">{{ state.last_message|default('—') }}</span></td></tr>{% endfor %}</tbody></table></div></section>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">document.addEventListener('click',async(e)=>{const b=e.target.closest('[data-copy-target]');if(!b)return;const el=document.querySelector(b.dataset.copyTarget);if(!el)return;try{await navigator.clipboard.writeText(el.textContent.trim());b.textContent='{{ ui_text('admin.system.cron.skopiiovano') }}';setTimeout(()=>b.textContent='{{ ui_text('admin.system.cron.kopiiuvaty') }}',1200);}catch(_){}});</script>
{{ shell.end() }}
