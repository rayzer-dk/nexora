{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.storefront_contacts.title'),'storefront_contacts') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.storefront_contacts.title') }}</span></nav><h1>{{ ui_text('admin.storefront_contacts.title') }}</h1><p>{{ ui_text('admin.storefront_contacts.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.storefront_contacts.contact_page') }}</small><h2>{{ ui_text('admin.storefront_contacts.details') }}</h2></div><a class="admin-button" href="{{ path('admin_system_store') }}">{{ ui_text('admin.storefront_contacts.store_data_link') }}</a></div>
<p class="admin-hint">{{ ui_text('admin.storefront_contacts.profile_note') }}</p>
<form method="post" action="{{ path('admin_system_storefront_contacts_save') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_storefront_contacts') }}">
<label class="is-wide"><span>{{ ui_text('admin.storefront_contacts.address') }}</span><input type="text" name="address" maxlength="500" value="{{ s.address }}" placeholder="{{ ui_text('admin.storefront_contacts.address_placeholder')|e('html_attr') }}"><small>{{ ui_text('admin.storefront_contacts.address_hint') }}</small></label>
<label><span>{{ ui_text('admin.storefront_contacts.phone_secondary') }}</span><input type="tel" name="phone_secondary" maxlength="64" value="{{ s.phone_secondary }}" placeholder="+380..."></label>
<label><span>{{ ui_text('admin.storefront_contacts.hours') }}</span><textarea name="working_hours" rows="3" maxlength="1000" placeholder="{{ ui_text('admin.storefront_contacts.hours_placeholder')|e('html_attr') }}">{{ s.working_hours }}</textarea><small>{{ ui_text('admin.storefront_contacts.hours_hint') }}</small></label>
<label><span>{{ ui_text('admin.storefront_contacts.map') }}</span><input type="text" name="map_input" maxlength="500" value="{{ s.map_input }}" placeholder="50.450100, 30.523400"><small>{{ ui_text('admin.storefront_contacts.map_hint') }}</small></label>
<label><span>{{ ui_text('admin.storefront_contacts.map_zoom') }}</span><input type="number" name="map_zoom" min="3" max="19" value="{{ s.map_zoom }}"></label>
<fieldset><legend>{{ ui_text('admin.storefront_contacts.social') }}</legend><div class="admin-form-grid">{% for code in social_networks %}<label><span>{{ code|capitalize }}</span><input type="text" name="social_{{ code }}" maxlength="500" value="{{ s.social[code]|default('') }}" placeholder="https://"></label>{% endfor %}</div><small>{{ ui_text('admin.storefront_contacts.social_hint') }}</small></fieldset>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.blog.save') }}</button></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.storefront_contacts.pickup_kicker') }}</small><h2>{{ ui_text('admin.storefront_contacts.pickup_title') }}</h2></div></div>
<p class="admin-hint">{{ ui_text('admin.storefront_contacts.pickup_intro') }}</p>
{% if points %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.storefront_contacts.pickup_name') }}</th><th>{{ ui_text('admin.storefront_contacts.pickup_address') }}</th><th>{{ ui_text('admin.storefront_contacts.pickup_hours') }}</th><th>{{ ui_text('admin.storefront_contacts.pickup_status') }}</th><th></th></tr></thead><tbody>
{% for p in points %}<tr><td>{{ p.name }}</td><td>{% if p.city %}{{ p.city }}, {% endif %}{{ p.address }}</td><td>{{ p.working_hours }}</td><td>{{ p.enabled ? ui_text('admin.storefront_contacts.pickup_on') : ui_text('admin.storefront_contacts.pickup_off') }}</td><td class="admin-inline-actions"><a class="admin-button" href="{{ path('admin_system_storefront_contacts',{point:p.id}) }}#pickup-form">{{ ui_text('admin.storefront_contacts.pickup_edit') }}</a><form method="post" action="{{ path('admin_system_storefront_pickup_delete',{id:p.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_storefront_pickup') }}"><button type="submit" class="is-danger" data-confirm="{{ ui_text('admin.storefront_contacts.pickup_confirm_delete')|e('html_attr') }}">{{ ui_text('admin.storefront_contacts.pickup_delete') }}</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="admin-hint">{{ ui_text('admin.storefront_contacts.pickup_empty') }}</p>{% endif %}
<h3 id="pickup-form">{{ editing ? ui_text('admin.storefront_contacts.pickup_edit_title') : ui_text('admin.storefront_contacts.pickup_add_title') }}</h3>
<form method="post" action="{{ path('admin_system_storefront_pickup_save') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_storefront_pickup') }}"><input type="hidden" name="id" value="{{ editing.id|default(0) }}">
<label><span>{{ ui_text('admin.storefront_contacts.pickup_name') }} *</span><input type="text" name="name" maxlength="190" required value="{{ editing.name|default('') }}"></label>
<label><span>{{ ui_text('admin.storefront_contacts.pickup_city') }}</span><input type="text" name="city" maxlength="190" value="{{ editing.city|default('') }}"></label>
<label class="is-wide"><span>{{ ui_text('admin.storefront_contacts.pickup_address') }} *</span><input type="text" name="address" maxlength="500" required value="{{ editing.address|default('') }}"></label>
<label><span>{{ ui_text('admin.storefront_contacts.pickup_hours') }}</span><input type="text" name="working_hours" maxlength="500" value="{{ editing.working_hours|default('') }}"></label>
<label><span>{{ ui_text('admin.storefront_contacts.phone_secondary') }}</span><input type="tel" name="phone" maxlength="64" value="{{ editing.phone|default('') }}"></label>
<label><span>{{ ui_text('admin.storefront_contacts.pickup_sort') }}</span><input type="number" name="sort_order" value="{{ editing.sort_order|default(0) }}"></label>
<label class="admin-check"><input type="checkbox" name="enabled" value="1"{{ editing is null or editing.enabled ? ' checked' : '' }}> {{ ui_text('admin.storefront_contacts.pickup_enabled') }}</label>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.blog.save') }}</button>{% if editing %}<a class="admin-button" href="{{ path('admin_system_storefront_contacts') }}">{{ ui_text('admin.storefront_contacts.pickup_cancel') }}</a>{% endif %}</div></form></section>
{{ shell.end() }}
