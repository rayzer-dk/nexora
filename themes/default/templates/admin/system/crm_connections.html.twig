{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.crm.title'),'integrations') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_system_integrations') }}">{{ ui_text('admin_integrations') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.crm.title') }}</span></nav><h1>{{ ui_text('admin.crm.title') }}</h1><p>{{ ui_text('admin.crm.intro') }}</p></div><div class="admin-page-actions"><a class="admin-button is-primary" href="{{ path('admin_system_integrations_orders', {new: 1}) }}">{{ ui_icon('plus', 16) }}<span>{{ ui_text('admin.crm.add') }}</span></a></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.crm.list') }}</h2></div><span>{{ connections|length }}</span></div>
{% if connections %}<div class="admin-table-wrap"><table class="admin-table" data-no-table-tools><thead><tr><th>{{ ui_text('admin.crm.name') }}</th><th>{{ ui_text('admin.crm.address') }}</th><th>{{ ui_text('admin.crm.events') }}</th><th>{{ ui_text('admin.crm.last') }}</th><th class="is-actions"></th></tr></thead><tbody>
{% for c in connections %}<tr><td><strong>{{ c.name }}</strong><small class="admin-cell-sub">{{ presets[c.preset].label|default(c.preset) }}</small></td><td><code>{{ c.url|length > 60 ? c.url|slice(0, 60) ~ '…' : c.url }}</code></td><td>{% for e in c.events %}<span class="admin-badge">{{ ui_text('admin.crm.event_' ~ e) }}</span> {% endfor %}</td>
<td>{% if c.last_status %}<span class="admin-badge {{ c.last_status == 'ok' ? 'is-active' : 'is-danger' }}">{{ c.last_status == 'ok' ? ui_text('admin.crm.ok') : ui_text('admin.crm.failed') }}</span><small class="admin-cell-sub">{{ c.last_at|slice(0, 16) }}</small>{% else %}—{% endif %}</td>
<td class="is-actions"><span class="admin-row-actions"><form method="post" action="{{ path('admin_system_integrations_orders_toggle', {id: c.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('crm_connections') }}"><input type="hidden" name="enabled" value="{{ c.enabled ? 0 : 1 }}"><button class="admin-button" type="submit">{{ ui_icon(c.enabled ? 'circle-check' : 'clock', 16) }}<span>{{ c.enabled ? ui_text('admin.crm.on') : ui_text('admin.crm.off') }}</span></button></form>
<a class="admin-icon-button" href="{{ path('admin_system_integrations_orders', {edit: c.id}) }}" title="{{ ui_text('admin.crm.edit')|e('html_attr') }}" aria-label="{{ ui_text('admin.crm.edit')|e('html_attr') }}">{{ ui_icon('pencil', 16) }}</a>
<form method="post" action="{{ path('admin_system_integrations_orders_delete', {id: c.id}) }}" data-confirm="{{ ui_text('admin.crm.delete_confirm')|e('html_attr') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('crm_connections') }}"><button class="admin-icon-button is-danger" type="submit" title="{{ ui_text('admin.crm.delete')|e('html_attr') }}" aria-label="{{ ui_text('admin.crm.delete')|e('html_attr') }}">{{ ui_icon('trash-2', 16) }}</button></form></span></td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="admin-help">{{ ui_text('admin.crm.empty') }}</p>{% endif %}</section>
{% if show_form %}<section class="admin-panel" id="crm-form"><div class="admin-panel__header"><div><h2>{{ edit ? ui_text('admin.crm.edit_title') : ui_text('admin.crm.new_title') }}</h2></div></div>
<form method="post" action="{{ path('admin_system_integrations_orders_save') }}" class="admin-form-grid" autocomplete="off" data-crm-form data-presets="{{ presets_json|e('html_attr') }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('crm_connections') }}"><input type="hidden" name="id" value="{{ edit.id|default(0) }}">
<label><span>{{ ui_text('admin.crm.name') }}</span><input type="text" name="name" maxlength="120" required value="{{ edit.name|default('') }}" placeholder="KeyCRM"></label>
<label><span>{{ ui_text('admin.crm.preset') }}</span><select name="preset" data-crm-preset>{% for key, p in presets %}<option value="{{ key }}"{{ edit.preset|default('json') == key ? ' selected' : '' }}>{{ p.label }}</option>{% endfor %}</select><small>{{ ui_text('admin.crm.preset_hint') }}</small></label>
<label class="admin-form-wide"><span>{{ ui_text('admin.crm.address') }}</span><input type="text" name="url" maxlength="1000" required value="{{ edit.url|default('') }}" placeholder="https://" data-crm-url></label>
<label><span>{{ ui_text('admin.crm.method') }}</span><select name="method"><option value="POST"{{ edit.method|default('POST') == 'POST' ? ' selected' : '' }}>POST</option><option value="PUT"{{ edit.method|default('POST') == 'PUT' ? ' selected' : '' }}>PUT</option></select></label>
<label class="admin-form-wide"><span>{{ ui_text('admin.crm.headers') }}</span><textarea name="headers_text" rows="3" spellcheck="false" data-crm-headers placeholder="Authorization: Bearer ...">{{ edit.headers_text|default('') }}</textarea><small>{{ ui_text('admin.crm.headers_hint') }}</small></label>
<fieldset class="admin-fieldset admin-form-wide"><legend>{{ ui_text('admin.crm.events') }}</legend><div class="admin-check-grid">{% for e in events %}<label class="admin-check"><input type="checkbox" name="events[]" value="{{ e }}" data-crm-event{{ (edit ? e in edit.events : e == 'placed') ? ' checked' : '' }}><span>{{ ui_text('admin.crm.event_' ~ e) }}<small>{{ ui_text('admin.crm.event_hint_' ~ e) }}</small></span></label>{% endfor %}</div></fieldset>
<label class="admin-form-wide"><span>{{ ui_text('admin.crm.template') }}</span><textarea name="body_template" rows="16" spellcheck="false" required data-crm-template class="admin-code-input">{{ edit.body_template|default(presets.json.template) }}</textarea><small>{{ ui_text('admin.crm.template_hint') }}</small></label>
{% if edit %}<label class="admin-form-wide"><span>{{ ui_text('admin.crm.signing') }}</span><input type="text" readonly value="{{ edit.signing_secret }}"><small>{{ ui_text('admin.crm.signing_hint') }}</small></label>{% endif %}
<label class="admin-check admin-form-wide"><input type="checkbox" name="enabled" value="1"{{ (edit ? edit.enabled : true) ? ' checked' : '' }}><span>{{ ui_text('admin.crm.enabled') }}</span></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 16) }} {{ ui_text('admin.crm.save') }}</button>
{% if edit %}<button class="admin-button" type="submit" formaction="{{ path('admin_system_integrations_orders_test', {id: edit.id}) }}" formnovalidate>{{ ui_icon('send', 16) }} {{ ui_text('admin.crm.test') }}</button>{% endif %}
<a class="admin-button" href="{{ path('admin_system_integrations_orders') }}">{{ ui_text('admin.dashboard.layout_cancel') }}</a></div></form>
<details class="admin-more"><summary>{{ ui_text('admin.crm.vars_title') }}</summary><p class="admin-help">{{ ui_text('admin.crm.vars_text') }}</p><pre class="admin-code"><code>event, order.number, order.public_id, order.status, order.payment_status, order.fulfillment_status, order.currency, order.total, order.subtotal, order.discount, order.shipping, order.tax, order.comment, order.created_at, order.admin_url
customer.name, customer.first_name, customer.last_name, customer.phone, customer.email, customer.company, customer.tax_id
delivery.provider, delivery.service, delivery.status, delivery.tracking, delivery.country, delivery.region, delivery.city, delivery.point, delivery.manual, delivery.address_line
payment.provider, payment.status, payment.amount
items[]: sku, name, quantity, unit, price, total</code></pre></details></section>{% endif %}
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.crm.log') }}</h2></div></div>
{% if deliveries %}<div class="admin-table-wrap"><table class="admin-table" data-no-table-tools><thead><tr><th>{{ ui_text('admin.crm.when') }}</th><th>{{ ui_text('admin.crm.name') }}</th><th>{{ ui_text('admin.crm.order') }}</th><th>{{ ui_text('admin.crm.events') }}</th><th>HTTP</th><th>{{ ui_text('admin.crm.answer') }}</th></tr></thead><tbody>
{% for d in deliveries %}<tr><td>{{ d.created_at|slice(0, 19) }}</td><td>{{ d.connection_name }}</td><td>{{ d.order_number ?: '—' }}</td><td>{{ ui_text('admin.crm.event_' ~ d.event) }}</td><td><span class="admin-badge {{ d.status == 'ok' ? 'is-active' : 'is-danger' }}">{{ d.http_status ?: '—' }}</span></td><td><small>{{ d.response_excerpt }}</small></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="admin-help">{{ ui_text('admin.crm.log_empty') }}</p>{% endif %}</section>
{{ shell.end() }}
