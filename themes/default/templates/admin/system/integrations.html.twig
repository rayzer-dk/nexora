{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.system.integrations.intehratsii'),'integrations') }}
<header class="admin-page-header">
  <div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('ui.admin.system.integrations.google_commerce_ga4_meta_tiktok') }}</span></nav><h1>{{ ui_text('admin.system.integrations.intehratsii_ta_marketynh') }}</h1><p>{{ ui_text('admin.system.integrations.cherhy_diahnostyka_merchant_api_i_consent_aware_') }}</p></div>
</header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.integrations.worker') }}</small><h2>{{ ui_text('admin.system.integrations.stan_cherh') }}</h2></div><span class="admin-help">CLI: php bin/console commerce:integration:work --limit=100</span></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.system.integrations.intehratsiia') }}</th><th>{{ ui_text('admin.system.integrations.status') }}</th><th>{{ ui_text('admin.system.integrations.kilkist') }}</th><th>{{ ui_text('admin.system.integrations.onovleno') }}</th></tr></thead><tbody>{% for row in queue %}<tr><td>{{ row.integration_code }}</td><td><span class="admin-badge {{ row.status == 'completed' ? 'is-active' : '' }}">{{ row.status }}</span></td><td>{{ row.total }}</td><td>{{ row.updated_at }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.system.integrations.cherha_porozhnia') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.integrations.merchant_api') }}</small><h2>{{ ui_text('ui.admin.system.integrations.google_merchant_diagnostics') }}</h2></div><span class="admin-help">{{ ui_text('admin.system.integrations.statusy_zberihaiutsia_lokalno_dlia_perevirky_bez') }}</span></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.system.integrations.mahazyn') }}</th><th>{{ ui_text('ui.admin.system.integrations.offer_id') }}</th><th>{{ ui_text('admin.system.integrations.mova_feed') }}</th><th>{{ ui_text('admin.system.integrations.status') }}</th><th>{{ ui_text('admin.system.integrations.problemy') }}</th><th>{{ ui_text('admin.system.integrations.synkhronizovano') }}</th></tr></thead><tbody>{% for row in google %}<tr><td>{{ row.store_name }}</td><td>{{ row.offer_id }}</td><td>{{ row.content_language }} / {{ row.feed_label }}</td><td><span class="admin-badge {{ row.sync_status == 'synced' ? 'is-active' : '' }}">{{ row.sync_status }}</span></td><td title="{{ row.issues_json }}">{{ row.issues_json|length > 120 ? row.issues_json|slice(0, 120) ~ '…' : row.issues_json }}</td><td>{{ row.last_synced_at|default('—') }}</td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.system.integrations.shche_nemaie_synkhronizovanykh_tovariv') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.integrations.consent') }}</small><h2>{{ ui_text('ui.admin.system.integrations.server_side_marketing_events') }}</h2></div><span class="admin-help">{{ ui_text('admin.system.integrations.bez_iavnoi_zhody_podiia_maie_status_skipped_no_c') }}</span></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('ui.admin.system.integrations.provider') }}</th><th>{{ ui_text('admin.system.integrations.podiia') }}</th><th>{{ ui_text('ui.admin.system.integrations.consent') }}</th><th>{{ ui_text('admin.system.integrations.status') }}</th><th>{{ ui_text('admin.system.integrations.sproby') }}</th><th>HTTP</th><th>{{ ui_text('admin.system.integrations.pomylka') }}</th><th>{{ ui_text('admin.system.integrations.onovleno') }}</th></tr></thead><tbody>{% for row in marketing %}<tr><td>{{ row.provider }}</td><td>{{ row.event_name }}</td><td>{{ row.consent_scope }}</td><td><span class="admin-badge {{ row.status == 'sent' ? 'is-active' : '' }}">{{ row.status }}</span></td><td>{{ row.attempt_count }}</td><td>{{ row.response_code|default('—') }}</td><td title="{{ row.last_error }}">{{ row.last_error|default('—') }}</td><td>{{ row.updated_at }}</td></tr>{% else %}<tr><td colspan="8">{{ ui_text('admin.system.integrations.podii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.integrations.dead_letter') }}</small><h2>{{ ui_text('admin.system.integrations.zavdannia_iaki_vycherpaly_retry') }}</h2></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>{{ ui_text('admin.system.integrations.intehratsiia') }}</th><th>{{ ui_text('admin.system.integrations.obiekt') }}</th><th>{{ ui_text('admin.system.integrations.sproby') }}</th><th>{{ ui_text('admin.system.integrations.pomylka') }}</th><th class="is-actions">{{ ui_text('admin.system.integrations.diia') }}</th></tr></thead><tbody>{% for row in dead %}<tr><td>#{{ row.id }}</td><td>{{ row.integration_code }}</td><td>{{ row.aggregate_type }} · {{ row.aggregate_id }}</td><td>{{ row.attempts }}</td><td title="{{ row.last_error }}">{{ row.last_error }}</td><td class="is-actions"><form method="post" action="{{ path('admin_system_integrations_retry',{id:row.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('integration_retry_' ~ row.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text('admin.system.integrations.povtoryty_zavdannia') }}" aria-label="{{ ui_text('admin.system.integrations.povtoryty_zavdannia') }}">{{ ui_icon('refresh-cw', 16) }}</button></form></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.system.integrations.dead_letter_cherha_porozhnia') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
