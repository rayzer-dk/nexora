{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.system.activity.zhurnal_dii'),'activity') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.system.activity.systema') }}</span></nav><h1>{{ ui_text('admin.system.activity.zhurnal_dii_administratoriv') }}</h1><p>{{ count }} {{ ui_text('admin.system.activity.zapysiv_fiksuiutsia_uspishni_zminy_bez_paroliv_t') }}</p></div></header>
<section class="admin-panel">
<form class="admin-filters" method="get">
<label class="admin-filters__search"><span>{{ ui_text('admin.system.activity.poshuk') }}</span><input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.system.activity.marshrut_diia_administrator') }}"></label>
<label><span>{{ ui_text('admin.system.activity.administrator') }}</span><select name="actor"><option value="0">{{ ui_text('admin.system.activity.usi') }}</option>{% for a in admins %}<option value="{{ a.id }}"{{ actor == a.id ? ' selected' : '' }}>{{ a.display_name }} · {{ a.email }}</option>{% endfor %}</select></label>
<button type="submit">{{ ui_text('admin.system.activity.zastosuvaty') }}</button>{% if search or actor %}<a href="{{ path('admin_system_activity') }}">{{ ui_text('admin.system.activity.skynuty') }}</a>{% endif %}
</form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.system.activity.chas') }}</th><th>{{ ui_text('admin.system.activity.administrator') }}</th><th>{{ ui_text('admin.system.activity.diia') }}</th><th>{{ ui_text('admin.system.activity.obiekt') }}</th><th>{{ ui_text('admin.system.activity.rezultat') }}</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.created_at }}</td><td><strong>{{ row.display_name|default('Admin #' ~ row.actor_id) }}</strong><small>{{ row.email|default('') }}</small></td><td><code title="{{ row.action }}">{{ row.action }}</code><small>{{ row.meta.method|default('') }} · {{ row.meta.path|default('') }}</small></td><td>{{ row.entity_id|default('—') }}</td><td><span class="admin-badge is-active">HTTP {{ row.meta.status|default(200) }}</span></td></tr>{% else %}<tr><td colspan="5" class="admin-empty">{{ ui_text('admin.system.activity.zapysiv_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>
<div class="admin-pagination"><div>{% if page > 1 %}<a href="?page={{ page-1 }}&search={{ search|url_encode }}&actor={{ actor }}">{{ ui_text('admin.system.activity.poperednia') }}</a>{% endif %}</div><span>{{ ui_text('admin.system.activity.storinka') }} {{ page }} {{ ui_text('admin.system.activity.z') }} {{ pages }}</span><div>{% if page < pages %}<a href="?page={{ page+1 }}&search={{ search|url_encode }}&actor={{ actor }}">{{ ui_text('admin.system.activity.nastupna') }}</a>{% endif %}</div></div>
</section>{{ shell.end() }}
