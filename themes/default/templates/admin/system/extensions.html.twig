{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.system.extensions.rozshyrennia'),'extensions') }}
<header class="admin-runtime__header">
    <div><small>{{ ui_text('admin.system.extensions.izoliatsiia_v') }}{{ platform_version }}</small><h1>{{ ui_text('admin.system.extensions.bezpechni_rozshyrennia') }}</h1><p>{{ ui_text('admin.system.extensions.paket_spochatku_pereviriaietsia_i_hotuietsia_akt') }}</p></div>
</header>
{% include '@storefront/admin/extension/slot.html.twig' with {slot:'admin.extensions.toolbar'} only %}
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="store-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-editor-card admin-drop-card">
    <div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.system.extensions.stage_first') }}</small><h2>{{ ui_text('admin.system.extensions.pereviryty_zip_paket') }}</h2></div><span class="admin-status-pill">{{ ui_text('admin.system.extensions.ne_aktyvuietsia_avtomatychno') }}</span></div>
    <form method="post" enctype="multipart/form-data" class="admin-extension-upload">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('extension_install') }}">
        <label class="admin-dropzone"><input type="file" name="extension_package" accept=".zip,application/zip" required><strong>{{ ui_text('admin.system.extensions.oberit_zip_rozshyrennia') }}</strong><span>{{ ui_text('admin.system.extensions.pakety_z_vykonuvanym_kodom_izoliuiutsia_v_karant') }}</span></label>
        <button type="submit">{{ ui_text('admin.system.extensions.pereviryty_paket') }}</button>
    </form>
</section>
<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.system.extensions.registry') }}</small><h2>{{ ui_text('admin.system.extensions.vstanovleni_pakety') }}</h2></div><span class="admin-help">{{ ui_text('admin.system.extensions.active_pointer_peremykaietsia_lyshe_pislia_uspis') }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.system.extensions.rozshyrennia') }}</th><th>{{ ui_text('admin.system.extensions.typ') }}</th><th>{{ ui_text('admin.system.extensions.versiia') }}</th><th>{{ ui_text('admin.system.extensions.stan') }}</th><th>{{ ui_text('admin.system.extensions.pomylky') }}</th><th class="is-actions">{{ ui_text('admin.system.extensions.diia') }}</th></tr></thead><tbody>
    {% for extension in extensions %}
        <tr><td><strong>{{ extension.name }}</strong><small class="admin-cell-sub">{{ extension.code }}{% if extension.publisher_name %} · {{ extension.publisher_name }}{% endif %}</small></td><td>{{ extension.extension_type }}<small class="admin-cell-sub">{{ extension.execution }} · {{ extension.commercial_model|default('free') }}{% if extension.capabilities %} · {{ extension.capabilities|join(', ') }}{% endif %}</small></td><td><strong>{{ extension.version }}</strong>{% if extension.status == 'active' %}<small class="admin-cell-sub">{{ ui_text('admin.extensions.version.active') }}</small>{% endif %}{% if extension.rollback_version %}<small class="admin-cell-sub">{{ ui_text('admin.extensions.version.rollback') }} {{ extension.rollback_version }}</small>{% endif %}</td><td><span class="admin-status-pill is-{{ extension.status }}">{{ extension.status }}</span></td><td>{% if extension.failure_count > 0 %}<strong>{{ extension.failure_count }}</strong><small class="admin-cell-sub" title="{{ extension.last_error }}">{{ extension.last_error|default('') }}</small>{% else %}<span class="admin-muted">0</span>{% endif %}</td><td class="is-actions">
        {% if extension.has_settings and extension.status != 'quarantined' %}<a class="admin-icon-button" href="{{ path('admin_system_extension_settings',{id:extension.id}) }}" title="{{ ui_text('admin.system.extensions.nalashtuvannia') }}">{{ ui_icon('settings', 18) }}</a>{% endif %}{% if extension.status in ['staged','disabled'] %}<form method="post" action="{{ path('admin_system_extension_activate',{id:extension.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('extension_state_' ~ extension.id) }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.system.extensions.aktyvuvaty_perevirene_rozshyrennia') }}" title="{{ ui_text('admin.system.extensions.aktyvuvaty') }}">{{ ui_icon('play', 18) }}</button></form>{% elseif extension.status == 'active' %}<form method="post" action="{{ path('admin_system_extension_disable',{id:extension.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('extension_state_' ~ extension.id) }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.system.extensions.vymknuty_rozshyrennia') }}" title="{{ ui_text('admin.system.extensions.vymknuty') }}">{{ ui_icon('square', 16) }}</button></form>{% if extension.rollback_id %}<form method="post" action="{{ path('admin_system_extension_rollback',{id:extension.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('extension_state_' ~ extension.id) }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.system.extensions.povernuty_poperedniu_perevirenu_versiiu') }} {{ extension.rollback_version }}?" title="{{ ui_text('admin.system.extensions.vidkotyty_do') }} {{ extension.rollback_version }}">{{ ui_icon('rotate-ccw', 18) }}</button></form>{% endif %}{% elseif extension.status == 'quarantined' %}<span class="admin-status-pill is-quarantined" title="{{ ui_text('admin.system.extensions.kod_ne_vykonuietsia') }}">{{ ui_text('admin.system.extensions.karantyn') }}</span>{% endif %}
        </td></tr>
    {% else %}<tr><td colspan="6">{{ ui_text('admin.system.extensions.dodatkovykh_rozshyren_shche_nemaie_vbudovani_fun') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>

<section class="admin-editor-card">
    <div class="admin-card-heading"><div><small>Extension audit trail</small><h2>{{ ui_text('admin.extensions.lifecycle.title') }}</h2><p>{{ ui_text('admin.extensions.lifecycle.help') }}</p></div><span class="admin-help">{{ ui_text('admin.extensions.lifecycle.last100') }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.extensions.lifecycle.time') }}</th><th>{{ ui_text('admin.extensions.lifecycle.module') }}</th><th>{{ ui_text('admin.extensions.lifecycle.version') }}</th><th>{{ ui_text('admin.extensions.lifecycle.event') }}</th><th>{{ ui_text('admin.extensions.lifecycle.state') }}</th><th>{{ ui_text('admin.extensions.lifecycle.result') }}</th><th>{{ ui_text('admin.extensions.lifecycle.details') }}</th></tr></thead><tbody>
    {% for event in extension_lifecycle %}<tr><td>{{ event.created_at }}</td><td><code>{{ event.code }}</code></td><td>{{ event.version }}</td><td>{{ event.action }}</td><td>{{ event.from_status|default('—') }} → {{ event.to_status|default('—') }}</td><td><span class="admin-status-pill is-{{ event.result == 'success' ? 'active' : (event.result == 'warning' ? 'staged' : 'quarantined') }}">{{ event.result }}</span></td><td><small class="admin-cell-sub" title="{{ event.message|default('') }}">{{ event.message|default('—') }}</small></td></tr>{% else %}<tr><td colspan="7">{{ ui_text('admin.extensions.lifecycle.empty') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>
<section class="admin-safety-note"><strong>{{ ui_text('admin.system.extensions.fail_closed_dlia_modulia_fail_open_dlia_mahazynu') }}</strong><span>{{ ui_text('admin.system.extensions.yakshcho_paket_ne_prokhodyt_perevirku_abo_aktyva') }}</span></section>
{{ shell.end() }}
