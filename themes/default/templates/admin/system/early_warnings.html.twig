{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.warn.title'),'quality') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_system_quality') }}">{{ ui_text('admin.quality.title') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.warn.title') }}</span></nav><h1>{{ ui_text('admin.warn.title') }}</h1><p>{{ ui_text('admin.warn.intro') }}</p></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.warn.now') }}</small><h2>{{ ui_text('admin.warn.list') }}</h2></div>
<form method="post" action="{{ path('admin_system_early_warnings_certificate') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('early_warnings') }}"><button class="admin-button is-sm" type="submit">{{ ui_icon('shield-check', 14) }} {{ ui_text('admin.warn.check_cert') }}</button></form></div>
{% if warnings %}<ul class="admin-sms-history">{% for w in warnings %}<li>{{ status_badge(w.level == 'fail' ? 'failed' : 'warning') }} <a href="{{ w.url }}">{{ w.text }}</a></li>{% endfor %}</ul>{% else %}<p class="admin-help">{{ ui_text('admin.warn.all_good') }}</p>{% endif %}
{% if certificate %}<p class="admin-help">{{ ui_text('admin.warn.cert_line', {host: certificate.host, days: certificate.days}) }}{% if certificate.checked_at %} · {{ certificate.checked_at|slice(0,16)|replace({'T':' '}) }} UTC{% endif %}</p>{% endif %}</section>
<section class="admin-panel"><div><small>{{ ui_text('admin.warn.forecast') }}</small><h2>{{ ui_text('admin.warn.runout') }}</h2><p class="admin-help">{{ ui_text('admin.warn.runout_help') }}</p></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.index.tovar') }}</th><th>{{ ui_text('admin.insights.stock') }}</th><th>{{ ui_text('admin.warn.per_day') }}</th><th>{{ ui_text('admin.warn.days_left') }}</th></tr></thead><tbody>{% for r in run_out %}<tr><td><strong>{{ r.name }}</strong></td><td>{{ r.stock }}</td><td>{{ r.per_day }}</td><td>{{ r.days }}</td></tr>{% else %}<tr><td colspan="4" class="admin-empty">—</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div><small>{{ ui_text('admin.digest.small') }}</small><h2>{{ ui_text('admin.digest.title') }}</h2><p class="admin-help">{{ ui_text('admin.digest.help') }}</p></div>
<form method="post" action="{{ path('admin_system_early_warnings_save') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('early_warnings') }}">
<label class="admin-check admin-form-wide"><input type="checkbox" name="enabled" value="1"{{ settings.enabled ? ' checked' : '' }}><span><strong>{{ ui_text('admin.digest.enabled') }}</strong></span></label>
<label>{{ ui_text('admin.digest.hour') }}<input type="number" name="hour" min="0" max="23" value="{{ settings.hour }}"></label>
<label class="admin-check"><input type="checkbox" name="only_problems" value="1"{{ settings.only_problems ? ' checked' : '' }}><span>{{ ui_text('admin.digest.only_problems') }}</span></label>
<label class="admin-form-wide">{{ ui_text('admin.digest.recipients') }}<textarea name="recipients" rows="2" placeholder="owner@example.com">{{ settings.recipients|join("\n") }}</textarea></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.badges.save') }}</button></div></form>
<form method="post" action="{{ path('admin_system_early_warnings_test') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('early_warnings') }}"><button class="admin-button" type="submit"{{ settings.recipients ? '' : ' disabled' }}>{{ ui_icon('send', 16) }} {{ ui_text('admin.digest.send_test') }}</button></form></section>
{{ shell.end() }}
