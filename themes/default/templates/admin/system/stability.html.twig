{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.system.stability.stabilnist'),'stability') }}
<header class="admin-page-header">
    <div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.system.stability.health_recovery') }} · v{{ platform_version }}</span></nav><h1>{{ ui_text('admin.system.stability.stabilnist_systemy') }}</h1><p>{{ ui_text('admin.system.stability.perevirky_seredovyshcha_bd_i_zhurnal_avtomatychn') }}</p></div>
    <button class="admin-button is-primary" type="button" data-health-check>{{ ui_text('admin.system.stability.pereviryty_zaraz') }}</button>
</header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-stats">
    <article><span>{{ ui_text('admin.system.stability.instaliatsiia') }}</span><strong>{{ health.healthy ? 'OK' : ui_text('admin.system.stability.uvaha') }}</strong><small>{{ health.checks|length }} {{ ui_text('admin.system.stability.perevirok') }}</small></article>
    <article><span>{{ ui_text('admin.system.stability.runtime_php_fs') }}</span><strong>{{ runtime_checks|filter(v => not v.passed and v.level == 'required')|length == 0 ? 'OK' : ui_text('admin.system.stability.uvaha') }}</strong><small>{{ ui_text('admin.system.stability.oboviazkovi_vymohy') }}</small></article>
    <article><span>{{ ui_text('admin.system.stability.baza_danykh') }}</span><strong>{{ database_checks|filter(v => not v.passed and v.level == 'required')|length == 0 ? 'OK' : ui_text('admin.system.stability.uvaha') }}</strong><small>{{ ui_text('admin.system.stability.tsilisnist_seredovyshcha') }}</small></article>
    <article><span>{{ ui_text('admin.system.stability.fallback_podii') }}</span><strong>{{ incidents|length }}</strong><small>{{ ui_text('admin.system.stability.ostanni_50') }}</small></article>
</section>
<section class="admin-panel admin-recovery-card">
    <div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.stability.recovery') }}</small><h2>{{ ui_text('admin.system.stability.shvydke_vidnovlennia') }}</h2><p>{{ ui_text('admin.system.stability.yakshcho_problema_z_iavylas_pislia_dodatkovoho_p') }}</p></div><span class="admin-badge">{{ ui_text('ui.admin.system.stability.core_stays_on') }}</span></div>
    <form method="post" action="{{ path('admin_system_extensions_isolate_all') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('extension_isolate_all') }}">
        <button type="submit" class="admin-danger-action" data-confirm="{{ ui_text('admin.system.stability.vymknuty_vsi_aktyvni_dodatkovi_rozshyrennia_vbud') }}">{{ ui_text('admin.system.stability.uvimknuty_bezpechnyi_rezhym_rozshyren') }}</button>
    </form>
</section>

<section class="admin-panel admin-recovery-card">
    <div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.stability.rollback_points') }}</small><h2>{{ ui_text('admin.system.stability.tochky_vidnovlennia') }}</h2><p>{{ ui_text('admin.system.stability.stvoriuite_backup_bd_danykh_mahazynu_abo_vsiiei_') }}</p></div><span class="admin-badge">{{ ui_text(maintenance_state ? 'admin.system.stability.maintenance_active' : 'admin.system.stability.live_protected') }}</span></div>
    <div class="admin-inline-actions">
        <form method="post" action="{{ path('admin_system_recovery_create') }}" class="admin-inline-actions">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('recovery_snapshot_create') }}">
            <label><span>{{ ui_text('admin.system.stability.shcho_zberehty') }}</span><select name="profile"><option value="database">{{ ui_text('admin.system.stability.tilky_baza_danykh') }}</option><option value="data">{{ ui_text('admin.system.stability.dani_mahazynu_bd_media') }}</option><option value="full" selected>{{ ui_text('admin.system.stability.povnyi_backup_bd_media_systema') }}</option></select></label>
            <button type="submit" data-confirm="{{ ui_text('admin.system.stability.stvoryty_backup_zaraz_dlia_velykoho_mahazynu_ope') }}">{{ ui_text('admin.system.stability.stvoryty_backup') }}</button>
        </form>
        <form method="post" action="{{ path('admin_system_recovery_upload_restore') }}" enctype="multipart/form-data" class="admin-upload-restore"><input type="hidden" name="_csrf_token" value="{{ csrf_token('recovery_upload_restore') }}"><label><span>{{ ui_text('admin.system.stability.vidnovyty_backup_z_pk') }}</span><input type="file" name="backup_archive" accept=".zip,application/zip" required><small>{{ ui_text('admin.system.stability.adminka_bezpechno_vidnovliuie_profili_bd_ta_bd_m') }}</small></label><button type="submit" data-confirm="{{ ui_text('admin.system.stability.pereviryty_zip_ta_vidnovyty_dani_pered_operatsii') }}">{{ ui_text('admin.system.stability.zavantazhyty_i_vidnovyty') }}</button></form>
        <code class="admin-recovery-command" title="{{ ui_text('admin.system.stability.avariine_vidnovlennia_pratsiuie_bez_symfony_ta_c') }}">php bin/recovery.php --list</code>
    </div>
    {% if maintenance_state %}<div class="admin-notice is-warning"><strong>{{ ui_text('admin.system.stability.rezhym_obsluhovuvannia_aktyvnyi') }}</strong> {{ ui_text('admin.system.stability.prychyna') }} {{ maintenance_state.reason|default('maintenance') }}{{ ui_text('admin.system.stability.poky_praporets_aktyvnyi_bootstrap_ne_zapuskaie_f') }}</div>{% endif %}
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.system.stability.stvoreno') }}</th><th>{{ ui_text('admin.system.stability.kliuch') }}</th><th>{{ ui_text('admin.system.stability.versiia') }}</th><th>{{ ui_text('admin.system.stability.prychyna_2') }}</th><th>{{ ui_text('admin.system.stability.rozmir') }}</th><th>{{ ui_text('admin.system.stability.stan') }}</th><th class="is-actions">{{ ui_text('admin.system.stability.diia') }}</th></tr></thead><tbody>
    {% for snapshot in recovery_snapshots %}<tr>
        <td>{{ snapshot.created_at }}</td>
        <td><code>{{ snapshot.snapshot_key }}</code></td>
        <td>{{ snapshot.platform_version }}</td>
        <td>{{ snapshot.reason }}</td>
        <td>{{ snapshot.size_bytes ? (snapshot.size_bytes / 1048576)|number_format(1, ',', ' ') ~ ' MB' : '—' }}</td>
        <td><span class="admin-badge is-{{ snapshot.status }}">{{ snapshot.status }}</span>{% if not snapshot.archive_exists %}<small class="admin-cell-sub">{{ ui_text('admin.system.stability.arkhiv_vidsutnii') }}</small>{% endif %}</td>
        <td class="is-actions">{% if snapshot.archive_exists %}<div class="admin-inline-actions"><a class="admin-icon-button" href="{{ path('admin_system_recovery_download',{id:snapshot.id}) }}" title="{{ ui_text('admin.system.stability.skachaty_backup_na_pk') }}" aria-label="{{ ui_text('admin.system.stability.skachaty_backup_na_pk') }}">{{ ui_icon('download', 18) }}</a><form method="post" action="{{ path('admin_system_recovery_verify',{id:snapshot.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('recovery_snapshot_' ~ snapshot.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text('admin.system.stability.pereviryty_sha_256_ta_strukturu_arkhivu') }}" aria-label="{{ ui_text('admin.system.stability.pereviryty_sha_256_ta_strukturu_arkhivu') }}">{{ ui_icon('check', 18) }}</button></form>{% if 'manual-admin-database' in snapshot.reason or 'manual-admin-data' in snapshot.reason %}<form method="post" action="{{ path('admin_system_recovery_restore_data',{id:snapshot.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('recovery_restore_' ~ snapshot.id) }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.system.stability.vidnovyty_dani_z_tsoho_backup_pered_vidnovlennia') }}" title="{{ ui_text('admin.system.stability.vidnovyty_dani') }}" aria-label="{{ ui_text('admin.system.stability.vidnovyty_dani') }}">{{ ui_icon('rotate-ccw', 18) }}</button></form>{% endif %}<form method="post" action="{{ path('admin_system_recovery_delete',{id:snapshot.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('recovery_snapshot_' ~ snapshot.id) }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.system.stability.vydalyty_tsei_backup_iz_servera') }}" title="{{ ui_text('admin.system.stability.vydalyty_backup') }}" aria-label="{{ ui_text('admin.system.stability.vydalyty_backup') }}">{{ ui_icon('trash-2', 18) }}</button></form></div>{% endif %}</td>
    </tr>{% else %}<tr><td colspan="7">{{ ui_text('admin.system.stability.tochok_vidnovlennia_shche_nemaie') }}</td></tr>{% endfor %}
    </tbody></table></div>
    <div class="admin-safety-note"><strong>{{ ui_text('admin.system.stability.avariine_vidnovlennia_ne_zalezhyt_vid_framework') }}</strong><span>{{ ui_text('admin.system.stability.yakshcho_nevdale_onovlennia_poshkodylo_vendor_ab') }} <code>php bin/recovery.php --restore SNAPSHOT_KEY --yes</code> {{ ui_text('admin.system.stability.chytaie_zip_napriamu_vmykaie_maintenance_vidnovl') }}</span></div>
</section>

<section class="admin-panel">
    <div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.stability.runtime') }}</small><h2>{{ ui_text('admin.system.stability.oboviazkovi_ta_rekomendovani_perevirky') }}</h2></div></div>
    <div class="admin-health-grid">
        {% for check in runtime_checks|merge(database_checks) %}<article class="admin-health-item {{ check.passed ? 'is-ok' : (check.level == 'required' ? 'is-error' : 'is-warning') }}"><span class="admin-health-dot"></span><div><strong>{{ check.label }}</strong><small>{{ check.current }} {{ ui_text('admin.system.stability.potribno') }} {{ check.required }}</small>{% if not check.passed and check.action %}<p>{{ check.action }}</p>{% endif %}</div></article>{% endfor %}
    </div>
</section>
<section class="admin-panel">
    <div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.system.stability.fail_safe_journal') }}</small><h2>{{ ui_text('admin.system.stability.ostanni_perekhopleni_pomylky') }}</h2></div><span class="admin-help">{{ ui_text('admin.system.stability.povnyi_stack_trace_lyshaietsia_u_zakhyshchenomu_') }}</span></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.system.stability.chas') }}</th><th>{{ ui_text('admin.system.stability.zona') }}</th><th>{{ ui_text('ui.admin.system.stability.route') }}</th><th>{{ ui_text('admin.system.stability.rezervnyi_rezhym') }}</th><th>{{ ui_text('admin.system.stability.podiia') }}</th><th>{{ ui_text('ui.admin.system.stability.request_id') }}</th></tr></thead><tbody>
    {% for incident in incidents %}<tr><td>{{ incident.created_at }}</td><td>{{ incident.area }}</td><td>{{ incident.route_name|default('—') }}</td><td><span class="admin-badge">{{ incident.fallback_mode|default('—') }}</span></td><td><strong>{{ incident.error_class|split('\\')|last }}</strong><small class="admin-cell-sub" title="{{ incident.error_summary }}">{{ incident.error_summary }}</small></td><td><code>{{ incident.request_id }}</code></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.system.stability.perekhoplenykh_krytychnykh_podii_nemaie') }}</td></tr>{% endfor %}
    </tbody></table></div>
</section>
<section class="admin-safety-note"><strong>{{ ui_text('admin.system.stability.rezervnyi_rezhym_ne_prykhovuie_problemu') }}</strong><span>{{ ui_text('admin.system.stability.vin_zberihaie_dostupnist_vytryny_poky_pomylka_fi') }}</span></section>
{{ shell.end() }}
