{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{% import '@storefront/admin/_help.html.twig' as help %}
{{ shell.start(ui_text('admin.push.title'),'push') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.push.title') }}</span></nav><h1>{{ ui_text('admin.push.title') }}</h1><p>{{ ui_text('admin.push.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel push-explain"><div class="admin-panel__header"><div><small>{{ ui_text('admin.push.how_kicker') }}</small><h2>{{ ui_text('admin.push.how_title') }}</h2></div></div>
<p>{{ ui_text('admin.push.how_text') }}</p>
<ul class="push-check">{% set checks = [[app.request.secure, 'admin.push.chk_https'], [s.enabled, 'admin.push.chk_enabled'], [s.subject is not empty, 'admin.push.chk_subject'], [s.public is not empty, 'admin.push.chk_keys'], [counts.admin > 0, 'admin.push.chk_device']] %}{% for check in checks %}<li class="{{ check[0] ? 'is-ok' : 'is-todo' }}">{{ ui_icon(check[0] ? 'circle-check' : 'circle-dashed', 18) }}<span>{{ ui_text(check[1]) }}</span></li>{% endfor %}</ul>
</section>
<section class="admin-panel"><form method="post" action="{{ path('admin_system_push') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_push') }}">
<label class="admin-check"><input type="checkbox" name="enabled" value="1"{{ s.enabled ? ' checked' : '' }}> {{ ui_text('admin.push.enabled') }}</label>
<label>{{ ui_text('admin.push.subject') }}<input type="text" name="subject" value="{{ s.subject }}" maxlength="190" placeholder="mailto:shop@example.com" required>{{ help.hint(ui_text('admin.push.subject_hint'), 'https://developer.mozilla.org/docs/Web/API/Push_API', ui_text('admin.help.push.docs'), 'mailto:shop@your-domain.com') }}</label>
<label class="admin-form-wide">{{ ui_text('admin.push.public_key') }}<input type="text" value="{{ s.public }}" readonly>{{ help.hint(ui_text('admin.push.public_key_hint') ~ ' ' ~ ui_text('admin.help.push.key_note')) }}</label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.push.save') }}</button></div></form>
<form method="post" action="{{ path('admin_system_push_keys') }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_push') }}"><button class="admin-button" type="submit" data-confirm="{{ ui_text('admin.push.keys_confirm') }}">{{ ui_icon('refresh-cw', 16) }}{{ ui_text('admin.push.keys_regenerate') }}</button></form></section>
{% if s.enabled %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.push.devices_hint') }}</small><h2>{{ ui_text('admin.push.devices') }}</h2></div><span class="admin-badge">{{ ui_text('admin.push.admin_devices') }}: {{ counts.admin }}</span></div>
<div class="admin-inline-actions" data-push-enable data-push-key="{{ s.public }}" data-push-url="{{ path('admin_system_push_subscribe') }}" data-push-token="{{ csrf_token('admin_push') }}"><button class="admin-button is-primary" type="button">{{ ui_icon('bell', 16) }}{{ ui_text('admin.push.enable_here') }}</button><span data-push-status role="status"></span></div>
<form method="post" action="{{ path('admin_system_push_test') }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_push') }}"><button class="admin-button" type="submit">{{ ui_icon('send', 16) }}{{ ui_text('admin.push.test') }}</button></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.push.broadcast_hint') }}</small><h2>{{ ui_text('admin.push.broadcast') }}</h2></div><span class="admin-badge">{{ ui_text('admin.push.storefront_devices') }}: {{ counts.storefront }}</span></div>
<form method="post" action="{{ path('admin_system_push_broadcast') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_push') }}">
<label>{{ ui_text('admin.push.msg_title') }}<input type="text" name="title" maxlength="80" required></label>
<label>{{ ui_text('admin.push.msg_url') }}<input type="text" name="url" value="/" maxlength="500"></label>
<label class="admin-form-wide">{{ ui_text('admin.push.msg_body') }}<textarea name="body" rows="2" maxlength="240" required></textarea></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit" data-confirm="{{ ui_text('admin.push.broadcast_confirm') }}">{{ ui_icon('send', 16) }}{{ ui_text('admin.push.broadcast_send') }}</button></div></form></section>
{% else %}<div class="admin-notice is-info">{{ ui_text('admin.push.disabled_hint') }}</div>
{% endif %}
{{ shell.end() }}
