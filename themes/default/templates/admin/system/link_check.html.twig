{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.linkcheck.title'),'quality') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<a href="{{ path('admin_system_quality') }}">{{ ui_text('admin.quality.title') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.linkcheck.title') }}</span></nav><h1>{{ ui_text('admin.linkcheck.title') }}</h1><p>{{ ui_text('admin.linkcheck.intro') }}</p></div>
<form method="post" action="{{ path('admin_system_link_check_run') }}" class="admin-page-actions"><input type="hidden" name="_csrf_token" value="{{ csrf_token('link_check') }}"><button class="admin-button is-primary" type="submit">{{ ui_icon('rotate-ccw', 16) }} {{ ui_text('admin.linkcheck.run') }}</button></form></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
{% if last %}<section class="admin-stats"><article><span>{{ ui_text('admin.linkcheck.checked') }}</span><strong>{{ last.documents }}</strong><small>{{ ui_text('admin.linkcheck.documents') }}</small></article><article><span>{{ ui_text('admin.linkcheck.links') }}</span><strong>{{ last.links }}</strong><small>{{ ui_text('admin.linkcheck.external') }}: {{ last.external }}</small></article><article><span>{{ ui_text('admin.linkcheck.images') }}</span><strong>{{ last.images }}</strong></article><article><span>{{ ui_text('admin.linkcheck.problems') }}</span><strong>{{ last.issues }}</strong><small>{{ last.at|slice(0,16)|replace({'T':' '}) }} UTC</small></article></section>
{% else %}<div class="admin-notice is-warning">{{ ui_text('admin.linkcheck.never') }}</div>{% endif %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.linkcheck.found') }}</small><h2>{{ ui_text('admin.linkcheck.problems') }}</h2></div><a class="admin-button is-sm" href="{{ path('admin_system_link_check', {ignored: show_ignored ? 0 : 1}) }}">{{ show_ignored ? ui_text('admin.linkcheck.hide_ignored') : ui_text('admin.linkcheck.show_ignored') }}</a></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.linkcheck.where') }}</th><th>{{ ui_text('admin.linkcheck.what') }}</th><th>{{ ui_text('admin.linkcheck.reason') }}</th><th class="is-actions"></th></tr></thead><tbody>
{% for i in issues %}<tr{{ i.ignored ? ' class="is-muted"' : '' }}><td><a href="{{ i.source_url }}"><strong>{{ i.source_label ?: i.source_type }}</strong></a><small class="admin-cell-sub">{{ ui_text('admin.linkcheck.src.' ~ i.source_type) }}{% if i.locale %} · {{ i.locale }}{% endif %}</small></td><td>{{ ui_icon(i.kind == 'image' ? 'image' : 'link', 14) }} <code>{{ i.target }}</code></td><td>{{ status_badge(i.reason == 'not_found' ? 'failed' : 'warning') }} {{ ui_text('admin.linkcheck.reason.' ~ i.reason) }}</td>
<td class="is-actions">{% if i.kind == 'link' and i.reason == 'not_found' %}<a class="admin-button is-sm" href="{{ path('admin_system_seo_custom_redirects', {source: i.target}) }}">{{ ui_icon('corner-down-right', 14) }} {{ ui_text('admin.redirects.make') }}</a> {% endif %}<form method="post" action="{{ path('admin_system_link_check_ignore', {id: i.id}) }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('link_check') }}"><input type="hidden" name="ignored" value="{{ i.ignored ? 0 : 1 }}"><button class="admin-button is-sm" type="submit">{{ i.ignored ? ui_text('admin.linkcheck.unignore') : ui_text('admin.linkcheck.ignore') }}</button></form></td></tr>{% else %}<tr><td colspan="4" class="admin-empty">{{ ui_text('admin.linkcheck.none') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
