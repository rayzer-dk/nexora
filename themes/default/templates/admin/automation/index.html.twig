{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.automation.title'),'automation') }}
{% set event_labels = {stock_waiting: ui_text('admin.automation.event_stock_waiting'), order_placed: ui_text('admin.automation.event_order_placed'), order_completed: ui_text('admin.automation.event_order_completed'), order_cancelled: ui_text('admin.automation.event_order_cancelled'), customer_registered: ui_text('admin.automation.event_customer_registered'), inquiry_created: ui_text('admin.automation.event_inquiry_created'), review_created: ui_text('admin.automation.event_review_created'), return_requested: ui_text('admin.automation.event_return_requested')} %}
{% set action_labels = {email: ui_text('admin.automation.action_email'), telegram: ui_text('admin.automation.action_telegram'), push: ui_text('admin.automation.action_push'), webhook: ui_text('admin.automation.action_webhook')} %}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.automation.title') }}</span></nav><h1>{{ ui_text('admin.automation.title') }}</h1><p>{{ ui_text('admin.automation.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<div data-tabs="automation-index">
<section class="admin-panel" data-tab="t1"><div class="admin-panel__header"><div><small>{{ ui_text('admin.automation.rules_hint') }}</small><h2>{{ ui_text('admin.automation.rules') }}</h2></div></div>
{% if rules %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.automation.name') }}</th><th>{{ ui_text('admin.automation.when') }}</th><th>{{ ui_text('admin.automation.then') }}</th><th>{{ ui_text('admin.automation.runs') }}</th><th class="is-actions">{{ ui_text('admin.automation.actions_col') }}</th></tr></thead><tbody>
{% for r in rules %}<tr><td><strong>{{ r.name }}</strong>{% if r.min_total_minor is not null %}<small>≥ {{ (r.min_total_minor / 100)|number_format(2,'.',' ') }} {{ currency }}</small>{% endif %}</td><td>{{ event_labels[r.event_name]|default(r.event_name) }}</td><td>{{ action_labels[r.action_type]|default(r.action_type) }}{% if r.action_target %}<small>{{ r.action_target }}</small>{% endif %}</td><td>{{ r.run_count }}{% if r.last_run_at %}<small>{{ r.last_run_at|slice(0,16) }}</small>{% endif %}</td>
<td class="is-actions"><form method="post" action="{{ path('admin_automation_toggle',{id:r.id}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_automation') }}"><button class="admin-button" type="submit">{{ r.enabled ? ui_text('admin.automation.disable') : ui_text('admin.automation.enable') }}</button></form> <form method="post" action="{{ path('admin_automation_delete',{id:r.id}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_automation') }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.automation.delete_confirm') }}" title="{{ ui_text('admin.automation.delete') }}" aria-label="{{ ui_text('admin.automation.delete') }}">{{ ui_icon('trash-2', 16) }}</button></form></td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="admin-empty">{{ ui_text('admin.automation.empty') }}</p>{% endif %}</section>
<section class="admin-panel" data-tab="t2"><div class="admin-panel__header"><div><small>{{ ui_text('admin.automation.new_hint') }}</small><h2>{{ ui_text('admin.automation.new') }}</h2></div>{{ ui_icon('workflow', 20) }}</div>
<form method="post" action="{{ path('admin_automation_save') }}" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_automation') }}">
<div class="admin-form-grid">
<label><span>{{ ui_text('admin.automation.name') }}</span><input type="text" name="name" maxlength="160" required></label>
<label><span>{{ ui_text('admin.automation.when') }}</span><select name="event_name">{% for e in events %}<option value="{{ e }}">{{ event_labels[e] }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.automation.min_total') }}, {{ currency }}</span><input type="text" inputmode="decimal" name="min_total" maxlength="14"><small>{{ ui_text('admin.automation.min_total_hint') }}</small></label>
<label><span>{{ ui_text('admin.automation.then') }}</span><select name="action_type">{% for a in actions %}<option value="{{ a }}">{{ action_labels[a] }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.automation.target') }}</span><input type="text" name="action_target" maxlength="500"><small>{{ ui_text('admin.automation.target_hint') }}</small></label>
<label><span>{{ ui_text('admin.automation.text') }}</span><input type="text" name="action_text" maxlength="500" placeholder="{{ ui_text('admin.automation.text_placeholder')|e('html_attr') }}"><small>{{ ui_text('admin.automation.text_hint') }}</small></label>
</div>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.automation.create') }}</button></div></form></section>
<section class="admin-panel" data-tab="t3"><div class="admin-panel__header"><div><small>{{ ui_text('admin.automation.log_hint') }}</small><h2>{{ ui_text('admin.automation.log') }}</h2></div></div>
{% if runs %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.automation.name') }}</th><th>{{ ui_text('admin.automation.status') }}</th><th>{{ ui_text('admin.automation.time') }}</th></tr></thead><tbody>{% for r in runs %}<tr><td>{{ r.rule_name }}</td><td><span class="admin-badge {{ r.status == 'ok' ? 'is-ok' : 'is-danger' }}">{{ r.status }}</span>{% if r.message %}<small>{{ r.message }}</small>{% endif %}</td><td>{{ r.created_at|slice(0,16) }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="admin-empty">{{ ui_text('admin.automation.log_empty') }}</p>{% endif %}</section>
</div>
{{ shell.end() }}
