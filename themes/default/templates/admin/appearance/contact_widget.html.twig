{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.cw.title'),'contact_widget') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.cw.title') }}</span></nav><h1>{{ ui_text('admin.cw.title') }}</h1><p>{{ ui_text('admin.cw.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><form method="post" action="{{ path('admin_appearance_contact_widget') }}" class="admin-form-grid" data-contact-widget-form><input type="hidden" name="_token" value="{{ csrf_token('admin_contact_widget') }}">
<label class="admin-check"><input type="checkbox" name="enabled" value="1"{{ s.enabled ? ' checked' : '' }}> {{ ui_text('admin.cw.enabled') }}</label>
<label>{{ ui_text('admin.cw.position') }}<select name="position"><option value="right"{{ s.position == 'right' ? ' selected' : '' }}>{{ ui_text('admin.cw.position_right') }}</option><option value="left"{{ s.position == 'left' ? ' selected' : '' }}>{{ ui_text('admin.cw.position_left') }}</option></select></label>
<label class="admin-check"><input type="checkbox" name="callback_enabled" value="1"{{ s.callback_enabled ? ' checked' : '' }}> {{ ui_text('admin.cw.callback') }}</label>
<label class="admin-check"><input type="checkbox" name="write_enabled" value="1"{{ s.write_enabled ? ' checked' : '' }}> {{ ui_text('admin.cw.write') }}</label>
<label>{{ ui_text('admin.cw.phone') }}<input type="tel" name="phone" maxlength="32" value="{{ s.phone }}" placeholder="+380..."><small>{{ ui_text('admin.cw.phone_hint') }}</small></label>
<label>{{ ui_text('admin.cw.email') }}<input type="email" name="email" maxlength="190" value="{{ s.email }}"><small>{{ ui_text('admin.cw.email_hint') }}</small></label>
<label>Viber<input type="tel" name="viber" maxlength="32" value="{{ s.viber }}" placeholder="380..."><small>{{ ui_text('admin.cw.viber_hint') }}</small></label>
<label>Messenger<input type="text" name="messenger" maxlength="190" value="{{ s.messenger }}" placeholder="your.page"><small>{{ ui_text('admin.cw.messenger_hint') }}</small></label>
<label>Telegram<input type="text" name="telegram" maxlength="64" value="{{ s.telegram }}" placeholder="username"><small>{{ ui_text('admin.cw.telegram_hint') }}</small></label>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.blog.save') }}</button></div></form></section>
<section class="admin-panel" data-chat-settings><div class="admin-panel__header"><h2>{{ ui_text('admin.chat.title') }}</h2></div>
<p>{{ ui_text('admin.chat.intro') }}</p>
<form method="post" action="{{ path('admin_appearance_chat_widget_save') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_chat_widget') }}">
<label>{{ ui_text('admin.chat.provider') }}<select name="provider"><option value="none"{{ chat.provider == 'none' ? ' selected' : '' }}>{{ ui_text('admin.chat.none') }}</option>{% for p in chat_providers %}<option value="{{ p }}"{{ chat.provider == p ? ' selected' : '' }}>{{ {tawk: 'Tawk.to', jivo: 'Jivo', crisp: 'Crisp', chatwoot: 'Chatwoot'}[p] }}</option>{% endfor %}</select></label>
<label class="admin-form-wide">{{ ui_text('admin.chat.embed') }}<textarea name="embed" rows="4" spellcheck="false" placeholder="{{ chat.widget_id ?: ui_text('admin.chat.embed_placeholder') }}"></textarea><small>{{ chat.provider != 'none' ? ui_text('admin.chat.current') ~ ': ' ~ chat.widget_id : ui_text('admin.chat.embed_hint') }}</small></label>
<label class="admin-form-wide">{{ ui_text('admin.chat.base_url') }}<input type="url" name="base_url" value="{{ chat.base_url }}" placeholder="https://chat.example.com"><small>{{ ui_text('admin.chat.base_url_hint') }}</small></label>
<div class="admin-form-wide"><small>{{ ui_text('admin.chat.consent_note') }}</small></div>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.blog.save') }}</button></div></form></section>
{{ shell.end() }}
