{% macro media_field(name,value,label,help) %}<div class="admin-media-field"><label>{{ label }}<input type="hidden" name="{{ name }}" value="{{ value }}" data-media-value="{{ name }}"><span class="admin-media-choice">{% if value %}<img src="{{ value }}" alt="" data-media-preview="{{ name }}">{% else %}<span class="admin-media-placeholder" data-media-preview="{{ name }}">{{ ui_text('admin.appearance.storefront.no_image') }}</span>{% endif %}</span><small>{{ help }}</small></label><div class="admin-inline-actions"><button class="admin-button" type="button" data-media-choose="{{ name }}">{{ ui_text('admin.appearance.storefront.choose') }}</button><button class="admin-button" type="button" data-media-clear="{{ name }}">{{ ui_text('admin.appearance.storefront.clear') }}</button></div></div>{% endmacro %}
{% macro ltext(name, label, values, locales, max, textarea) %}{% for l in locales %}{% set v = values is iterable ? (values[l.code]|default('')) : (loop.first ? values : '') %}<label data-lang="{{ l.code }}" data-lang-name="{{ l.native_name }}">{{ label }}<span class="lang-suffix"> · {{ l.native_name }}</span>{% if textarea|default(false) %}<textarea name="{{ name }}[{{ l.code }}]" rows="2" maxlength="{{ max }}">{{ v }}</textarea>{% else %}<input type="text" name="{{ name }}[{{ l.code }}]" maxlength="{{ max }}" value="{{ v }}">{% endif %}</label>{% endfor %}{% endmacro %}
{% macro colour(name, label, value, fallback) %}<label class="admin-color-option"><span>{{ label }}</span><input type="color" name="{{ name }}" value="{{ value|default('') ?: fallback }}" data-color-option><span class="admin-color-option__use"><input type="checkbox" name="{{ name }}_on" value="1"{% if value|default('') %} checked{% endif %}> {{ ui_text('admin.colors.use') }}</span></label>{% endmacro %}
