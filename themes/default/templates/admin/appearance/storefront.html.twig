<section class="admin-panel"><h2>{{ ui_text('admin.appearance.storefront.pravyi_promo_baner') }}</h2><div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.zaholovok') }}<input name="promo_right_title" value="{{ settings.promo_right.title }}"></label><label>{{ ui_text('admin.appearance.storefront.tekst') }}<input name="promo_right_text" value="{{ settings.promo_right.text }}"></label>{{ _self.media_field('promo_right_image',settings.promo_right.image,ui_text('admin.appearance.storefront.zobrazhennia'),ui_text('admin.appearance.storefront.choose_from_media')) }}<label>{{ ui_text('admin.appearance.storefront.posylannia') }}<input name="promo_right_url" value="{{ settings.promo_right.url }}"></label></div></section></div>
<div class="admin-form-actions is-sticky"><span>{{ ui_text('admin.appearance.storefront.zberezhennia_stvoryt_novu_reviziiu_konfihuratsii') }}</span><button class="admin-button is-primary" type="submit">{{ ui_text('admin.appearance.storefront.zberehty') }}</button></div></form>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.appearance.storefront.recovery') }}</small><h2>{{ ui_text('admin.appearance.storefront.istoriia_oformlennia') }}</h2></div><span class="admin-help">{{ ui_text('admin.appearance.storefront.shvydkyi_vidkat_bez_ruchnoho_redahuvannia_failiv') }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.appearance.storefront.reviziia') }}</th><th>{{ ui_text('admin.appearance.storefront.status') }}</th><th>{{ ui_text('admin.appearance.storefront.khto') }}</th><th>{{ ui_text('admin.appearance.storefront.chas') }}</th><th class="is-actions">{{ ui_text('admin.appearance.storefront.diia') }}</th></tr></thead><tbody>{% for revision in revisions %}<tr><td>#{{ revision.revision_number }}</td><td><span class="admin-badge {{ revision.status == 'active' ? 'is-active' : '' }}">{{ revision.status }}</span></td><td>{{ revision.actor_subject|default('system') }}</td><td>{{ revision.created_at }}</td><td class="is-actions">{% if revision.status != 'active' %}<form method="post" action="{{ path('admin_appearance_storefront_rollback',{revisionId:revision.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('storefront_presentation_rollback') }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.appearance.storefront.vidnovyty_tsiu_versiiu_oformlennia') }}" title="{{ ui_text('admin.appearance.storefront.vidnovyty_reviziiu') }}" aria-label="{{ ui_text('admin.appearance.storefront.vidnovyty_reviziiu') }}">{{ ui_icon('rotate-ccw', 18) }}</button></form>{% else %}<span class="admin-muted">{{ ui_text('admin.appearance.storefront.aktyvna') }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5">{{ ui_text('admin.appearance.storefront.istoriia_ziavytsia_pislia_pershoho_zberezhennia') }}</td></tr>{% endfor %}</tbody></table></div></section>
<dialog class="admin-dialog media-picker" data-appearance-media-picker><form method="dialog"><header><strong>{{ ui_text('admin.appearance.storefront.choose_media') }}</strong><button value="cancel" title="{{ ui_text('admin_close') }}" aria-label="{{ ui_text('admin_close') }}">{{ ui_icon('x', 18) }}</button></header><input type="search" data-appearance-media-search placeholder="{{ ui_text('admin.appearance.storefront.search_media') }}"><div class="media-picker-grid" data-appearance-media-results></div></form></dialog>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">
(()=>{const form=document.querySelector('form[data-theme-presets-json]');if(!form)return;const source=JSON.parse(form.dataset.themePresetsJson||'{}');const presets=Object.fromEntries(Object.entries(source).map(([code,preset])=>[code,Object.fromEntries(Object.entries(preset.theme||{}).map(([key,value])=>['theme_'+key,value]))]));form.querySelectorAll('input[name="theme_preset"]').forEach(r=>r.addEventListener('change',()=>{if(!r.checked||!presets[r.value])return;Object.entries(presets[r.value]).forEach(([name,value])=>{const field=form.elements.namedItem(name);if(!field)return;field.value=value;field.dispatchEvent(new Event('input',{bubbles:true}));field.dispatchEvent(new Event('change',{bubbles:true}))})}))})();
</script>
{{ shell.end() }}