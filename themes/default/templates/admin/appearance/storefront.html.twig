{% macro media_field(name,value,label,help) %}<div class="admin-media-field"><label>{{ label }}<input type="hidden" name="{{ name }}" value="{{ value }}" data-media-value="{{ name }}"><span class="admin-media-choice">{% if value %}<img src="{{ value }}" alt="" data-media-preview="{{ name }}">{% else %}<span class="admin-media-placeholder" data-media-preview="{{ name }}">{{ ui_text('admin.appearance.storefront.no_image') }}</span>{% endif %}</span><small>{{ help }}</small></label><div class="admin-inline-actions"><button class="admin-button" type="button" data-media-choose="{{ name }}">{{ ui_text('admin.appearance.storefront.choose') }}</button><button class="admin-button" type="button" data-media-clear="{{ name }}">{{ ui_text('admin.appearance.storefront.clear') }}</button></div></div>{% endmacro %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.appearance.storefront.vytryna'),'appearance','media') }}
<header class="admin-page-header">
    <div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ store.name|default('Nexora Commerce') }} · v{{ platform_version }}</span></nav><h1>{{ ui_text('admin.appearance.storefront.vytryna_mahazynu') }}</h1><p>{{ ui_text('admin.appearance.storefront.shapka_holovna_storinka_promo_bloky_ta_vydymist_') }}</p></div>
    <a class="admin-button is-primary" href="/" target="_blank" rel="noopener">{{ ui_text('admin.appearance.storefront.vidkryty_mahazyn') }}</a>
</header>

<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.appearance.storefront.visual_store_editor') }}</small><h2>{{ ui_text('admin.appearance.storefront.redaktor_vytryny') }}</h2></div><span class="admin-help">{{ ui_text('admin.appearance.storefront.makety_versionuiutsia_ta_maiut_bezpechnyi_fallba') }}</span></div><div class="admin-inline-actions"><a class="admin-button is-primary" href="{{ path('admin_visual_store_editor') }}">{{ ui_text('admin.appearance.storefront.vidkryty_iedynyi_redaktor') }}</a></div><div class="admin-quick-grid"><a href="{{ path('admin_appearance_builder',{type:'home'}) }}"><strong>{{ ui_text('admin.appearance.storefront.holovna') }}</strong><small>{{ ui_text('admin.appearance.storefront.poriadok_i_vydymist_blokiv') }}</small></a><a href="{{ path('admin_appearance_builder',{type:'product'}) }}"><strong>{{ ui_text('admin.appearance.storefront.kartka_tovaru') }}</strong><small>{{ ui_text('admin.appearance.storefront.halereia_tsina_varianty_kupivlia_kontent') }}</small></a><a href="{{ path('admin_appearance_builder',{type:'checkout'}) }}"><strong>{{ ui_text('builder_checkout') }}</strong><small>{{ ui_text('admin.appearance.builder.drag_and_drop_vlastyvosti_adaptyvnist_mediateka_') }}</small></a><a href="{{ path('admin_appearance_builder',{type:'category'}) }}"><strong>{{ ui_text('admin.builder.category') }}</strong><small>{{ ui_text('admin.builder.category_hint') }}</small></a><a href="{{ path('admin_appearance_builder',{type:'cart'}) }}"><strong>{{ ui_text('admin.builder.cart') }}</strong><small>{{ ui_text('admin.builder.cart_hint') }}</small></a></div></section>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<form method="post" class="admin-form" data-dirty-guard data-appearance-media data-media-endpoint="{{ path('admin_media_library_json') }}" data-theme-presets-json="{{ theme_presets|json_encode|e('html_attr') }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('storefront_presentation') }}">
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.appearance.storefront.design_system') }}</small><h2>{{ ui_text('admin.appearance.storefront.styl_vytryny') }}</h2></div><span class="admin-help">{{ ui_text('admin.appearance.storefront.pochnit_iz_presetu_potim_adaptuite_kolory_radius') }}</span></div>
<div class="admin-choice-grid" data-theme-presets>
{% for code,preset in theme_presets %}<label class="admin-choice"><input type="radio" name="theme_preset" value="{{ code }}" {% if settings.theme.preset==code %}checked{% endif %}><strong>{{ preset.label }}</strong><small>{{ preset.description_key ? ui_text(preset.description_key) : '' }}</small></label>{% endfor %}</div>
<div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.osnovnyi_kolir') }}<input type="color" name="theme_primary" value="{{ settings.theme.primary }}"><small>{{ settings.theme.primary }}</small></label><label>{{ ui_text('admin.appearance.storefront.aktsentnyi_kolir') }}<input type="color" name="theme_accent" value="{{ settings.theme.accent }}"><small>{{ settings.theme.accent }}</small></label><label>{{ ui_text('admin.appearance.storefront.uspikh_naiavnist') }}<input type="color" name="theme_success" value="{{ settings.theme.success }}"><small>{{ settings.theme.success }}</small></label><label>{{ ui_text('admin.appearance.storefront.poverkhnia_kartok') }}<input type="color" name="theme_surface" value="{{ settings.theme.surface }}"></label><label>{{ ui_text('admin.appearance.storefront.zaokruhlennia') }}<input type="range" min="4" max="32" name="theme_radius" value="{{ settings.theme.radius }}"><small>{{ settings.theme.radius }} px</small></label><label>{{ ui_text('admin.appearance.storefront.tini') }}<select name="theme_shadow"><option value="none" {% if settings.theme.shadow=='none' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.bez_tinei') }}</option><option value="soft" {% if settings.theme.shadow=='soft' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.lehki') }}</option><option value="medium" {% if settings.theme.shadow=='medium' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.seredni') }}</option><option value="strong" {% if settings.theme.shadow=='strong' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.vyrazni') }}</option></select></label><label>{{ ui_text('admin.appearance.storefront.shchilnist') }}<select name="theme_density"><option value="compact" {% if settings.theme.density=='compact' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.kompaktna') }}</option><option value="comfortable" {% if settings.theme.density=='comfortable' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.zruchna') }}</option><option value="spacious" {% if settings.theme.density=='spacious' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.prostora') }}</option></select></label><label>{{ ui_text('admin.appearance.color_scheme') }}<select name="theme_color_scheme"><option value="light" {% if settings.theme.color_scheme=='light' %}selected{% endif %}>{{ ui_text('admin.appearance.color_scheme.light') }}</option><option value="auto" {% if settings.theme.color_scheme=='auto' %}selected{% endif %}>{{ ui_text('admin.appearance.color_scheme.auto') }}</option><option value="dark" {% if settings.theme.color_scheme=='dark' %}selected{% endif %}>{{ ui_text('admin.appearance.color_scheme.dark') }}</option></select><small>{{ ui_text('admin.appearance.color_scheme.help') }}</small></label><label class="admin-check"><input type="checkbox" name="theme_toggle" value="1" {% if settings.theme.toggle|default('1')=='1' %}checked{% endif %}> {{ ui_text('admin.appearance.theme_toggle') }}</label><label>{{ ui_text('admin.appearance.storefront.shyryna_konteinera') }}<input type="number" min="960" max="1920" step="16" name="theme_container" value="{{ settings.theme.container }}"></label><label>{{ ui_text('admin.appearance.storefront.typohrafika') }}<select name="theme_font"><option value="system" {% if settings.theme.font=='system' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.system_shvydka') }}</option><option value="inter" {% if settings.theme.font=='inter' %}selected{% endif %}>Inter Variable</option><option value="manrope" {% if settings.theme.font=='manrope' %}selected{% endif %}>Manrope Variable</option></select></label></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.appearance.storefront.header') }}</small><h2>{{ ui_text('admin.appearance.storefront.shapka_i_servisna_panel') }}</h2></div></div><div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.nazva_brendu') }}<input name="brand_title" value="{{ settings.brand.title }}"></label><label>{{ ui_text('admin.appearance.storefront.pidpys_brendu') }}<input name="brand_subtitle" value="{{ settings.brand.subtitle }}"></label>{{ _self.media_field('brand_logo',settings.brand.logo,ui_text('admin.appearance.storefront.logo'),ui_text('admin.appearance.storefront.logo_help')) }}{{ _self.media_field('brand_icon',settings.brand.icon,ui_text('admin.appearance.storefront.icon'),ui_text('admin.appearance.storefront.icon_help')) }}{{ _self.media_field('brand_favicon',settings.brand.favicon,ui_text('admin.appearance.storefront.favicon'),ui_text('admin.appearance.storefront.favicon_help')) }}<label class="admin-check-inline"><input type="checkbox" name="brand_pwa" value="1" {{ settings.brand.pwa == '1' ? 'checked' }}><span>{{ ui_text('admin.appearance.pwa') }}<small>{{ ui_text('admin.appearance.pwa.help') }}</small></span></label><label>{{ ui_text('admin.appearance.storefront.lokatsiia') }}<input name="utility_location" value="{{ settings.utility.location }}"></label><label>{{ ui_text('admin.appearance.storefront.dostavka') }}<input name="utility_delivery" value="{{ settings.utility.delivery }}"></label><label>{{ ui_text('admin.appearance.storefront.pidtrymka') }}<input name="utility_support" value="{{ settings.utility.support }}"></label><label>{{ ui_text('admin.appearance.storefront.pidkazka_poshuku') }}<input name="search_placeholder" value="{{ settings.header.search_placeholder }}"></label></div><label class="admin-check"><input type="checkbox" name="show_category_nav" value="1" {% if settings.header.show_category_nav %}checked{% endif %}> {{ ui_text('admin.appearance.storefront.pokazuvaty_navihatsiiu_katehorii') }}</label></section>
