<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">
(()=>{const form=document.querySelector('form[data-theme-presets-json]');if(!form)return;const source=JSON.parse(form.dataset.themePresetsJson||'{}');const presets=Object.fromEntries(Object.entries(source).map(([code,preset])=>[code,Object.fromEntries(Object.entries(preset.theme||{}).map(([key,value])=>['theme_'+key,value]))]));form.querySelectorAll('input[name="theme_preset"]').forEach(r=>r.addEventListener('change',()=>{if(!r.checked||!presets[r.value])return;Object.entries(presets[r.value]).forEach(([name,value])=>{const field=form.elements.namedItem(name);if(!field)return;field.value=value;field.dispatchEvent(new Event('input',{bubbles:true}));field.dispatchEvent(new Event('change',{bubbles:true}))})}))})();
document.querySelectorAll('[data-color-option]').forEach(i=>i.addEventListener('input',()=>{const c=i.closest('.admin-color-option')?.querySelector('input[type=checkbox]');if(c)c.checked=true;}));
</script>
