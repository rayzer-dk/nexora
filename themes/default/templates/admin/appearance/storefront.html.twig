{% macro media_field(name,value,label,help) %}<div class="admin-media-field"><label>{{ label }}<input type="hidden" name="{{ name }}" value="{{ value }}" data-media-value="{{ name }}"><span class="admin-media-choice">{% if value %}<img src="{{ value }}" alt="" data-media-preview="{{ name }}">{% else %}<span class="admin-media-placeholder" data-media-preview="{{ name }}">{{ ui_text('admin.appearance.storefront.no_image') }}</span>{% endif %}</span><small>{{ help }}</small></label><div class="admin-inline-actions"><button class="admin-ghost-button" type="button" data-media-choose="{{ name }}">{{ ui_text('admin.appearance.storefront.choose') }}</button><button class="admin-ghost-button" type="button" data-media-clear="{{ name }}">{{ ui_text('admin.appearance.storefront.clear') }}</button></div></div>{% endmacro %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.appearance.storefront.vytryna'),'appearance','media') }}
<header class="admin-runtime__header">
    <div><small>{{ store.name|default('Nexora Commerce') }} · v{{ platform_version }}</small><h1>{{ ui_text('admin.appearance.storefront.vytryna_mahazynu') }}</h1><p>{{ ui_text('admin.appearance.storefront.shapka_holovna_storinka_promo_bloky_ta_vydymist_') }}</p></div>
    <a class="admin-preview-link" href="/" target="_blank" rel="noopener">{{ ui_text('admin.appearance.storefront.vidkryty_mahazyn') }}</a>
</header>

<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.appearance.storefront.visual_store_editor') }}</small><h2>{{ ui_text('admin.appearance.storefront.redaktor_vytryny') }}</h2></div><span class="admin-help">{{ ui_text('admin.appearance.storefront.makety_versionuiutsia_ta_maiut_bezpechnyi_fallba') }}</span></div><div class="admin-inline-actions"><a class="admin-primary-link" href="{{ path('admin_visual_store_editor') }}">{{ ui_text('admin.appearance.storefront.vidkryty_iedynyi_redaktor') }}</a></div><div class="admin-quick-grid"><a href="{{ path('admin_appearance_builder',{type:'home'}) }}"><strong>{{ ui_text('admin.appearance.storefront.holovna') }}</strong><small>{{ ui_text('admin.appearance.storefront.poriadok_i_vydymist_blokiv') }}</small></a><a href="{{ path('admin_appearance_builder',{type:'product'}) }}"><strong>{{ ui_text('admin.appearance.storefront.kartka_tovaru') }}</strong><small>{{ ui_text('admin.appearance.storefront.halereia_tsina_varianty_kupivlia_kontent') }}</small></a><a href="{{ path('admin_appearance_builder',{type:'checkout'}) }}"><strong>Checkout</strong><small>{{ ui_text('admin.appearance.builder.drag_and_drop_vlastyvosti_adaptyvnist_mediateka_') }}</small></a></div></section>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="store-notice is-{{ type }}" data-toast-source>{{ message }}</div>{% endfor %}{% endfor %}
<form method="post" class="admin-editor-form admin-storefront-form" data-dirty-guard data-appearance-media data-media-endpoint="{{ path('admin_media_library_json') }}" data-theme-presets-json="{{ theme_presets|json_encode|e('html_attr') }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('storefront_presentation') }}">
<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.appearance.storefront.design_system') }}</small><h2>{{ ui_text('admin.appearance.storefront.styl_vytryny') }}</h2></div><span class="admin-help">{{ ui_text('admin.appearance.storefront.pochnit_iz_presetu_potim_adaptuite_kolory_radius') }}</span></div>
<div class="admin-preset-grid" data-theme-presets>
{% for code,preset in theme_presets %}<label class="admin-preset-card"><input type="radio" name="theme_preset" value="{{ code }}" {% if settings.theme.preset==code %}checked{% endif %}><strong>{{ preset.label }}</strong><small>{{ preset.description_key ? ui_text(preset.description_key) : '' }}</small></label>{% endfor %}</div>
<div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.osnovnyi_kolir') }}<input type="color" name="theme_primary" value="{{ settings.theme.primary }}"><small>{{ settings.theme.primary }}</small></label><label>{{ ui_text('admin.appearance.storefront.aktsentnyi_kolir') }}<input type="color" name="theme_accent" value="{{ settings.theme.accent }}"><small>{{ settings.theme.accent }}</small></label><label>{{ ui_text('admin.appearance.storefront.uspikh_naiavnist') }}<input type="color" name="theme_success" value="{{ settings.theme.success }}"><small>{{ settings.theme.success }}</small></label><label>{{ ui_text('admin.appearance.storefront.poverkhnia_kartok') }}<input type="color" name="theme_surface" value="{{ settings.theme.surface }}"></label><label>{{ ui_text('admin.appearance.storefront.zaokruhlennia') }}<input type="range" min="4" max="32" name="theme_radius" value="{{ settings.theme.radius }}"><small>{{ settings.theme.radius }} px</small></label><label>{{ ui_text('admin.appearance.storefront.tini') }}<select name="theme_shadow"><option value="none" {% if settings.theme.shadow=='none' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.bez_tinei') }}</option><option value="soft" {% if settings.theme.shadow=='soft' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.lehki') }}</option><option value="medium" {% if settings.theme.shadow=='medium' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.seredni') }}</option><option value="strong" {% if settings.theme.shadow=='strong' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.vyrazni') }}</option></select></label><label>{{ ui_text('admin.appearance.storefront.shchilnist') }}<select name="theme_density"><option value="compact" {% if settings.theme.density=='compact' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.kompaktna') }}</option><option value="comfortable" {% if settings.theme.density=='comfortable' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.zruchna') }}</option><option value="spacious" {% if settings.theme.density=='spacious' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.prostora') }}</option></select></label><label>{{ ui_text('admin.appearance.storefront.shyryna_konteinera') }}<input type="number" min="960" max="1680" step="16" name="theme_container" value="{{ settings.theme.container }}"></label><label>{{ ui_text('admin.appearance.storefront.typohrafika') }}<select name="theme_font"><option value="system" {% if settings.theme.font=='system' %}selected{% endif %}>{{ ui_text('admin.appearance.storefront.system_shvydka') }}</option><option value="inter" {% if settings.theme.font=='inter' %}selected{% endif %}>Inter Variable</option><option value="manrope" {% if settings.theme.font=='manrope' %}selected{% endif %}>Manrope Variable</option></select></label></div></section>
<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.appearance.storefront.header') }}</small><h2>{{ ui_text('admin.appearance.storefront.shapka_i_servisna_panel') }}</h2></div></div><div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.nazva_brendu') }}<input name="brand_title" value="{{ settings.brand.title }}"></label><label>{{ ui_text('admin.appearance.storefront.pidpys_brendu') }}<input name="brand_subtitle" value="{{ settings.brand.subtitle }}"></label>{{ _self.media_field('brand_logo',settings.brand.logo,ui_text('admin.appearance.storefront.logo'),ui_text('admin.appearance.storefront.logo_help')) }}{{ _self.media_field('brand_icon',settings.brand.icon,ui_text('admin.appearance.storefront.icon'),ui_text('admin.appearance.storefront.icon_help')) }}{{ _self.media_field('brand_favicon',settings.brand.favicon,ui_text('admin.appearance.storefront.favicon'),ui_text('admin.appearance.storefront.favicon_help')) }}<label>{{ ui_text('admin.appearance.storefront.lokatsiia') }}<input name="utility_location" value="{{ settings.utility.location }}"></label><label>{{ ui_text('admin.appearance.storefront.dostavka') }}<input name="utility_delivery" value="{{ settings.utility.delivery }}"></label><label>{{ ui_text('admin.appearance.storefront.pidtrymka') }}<input name="utility_support" value="{{ settings.utility.support }}"></label><label>{{ ui_text('admin.appearance.storefront.pidkazka_poshuku') }}<input name="search_placeholder" value="{{ settings.header.search_placeholder }}"></label></div><label class="admin-check"><input type="checkbox" name="show_category_nav" value="1" {% if settings.header.show_category_nav %}checked{% endif %}> {{ ui_text('admin.appearance.storefront.pokazuvaty_navihatsiiu_katehorii') }}</label></section>
<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.appearance.storefront.hero') }}</small><h2>{{ ui_text('admin.appearance.storefront.holovnyi_baner') }}</h2></div><span class="admin-help">{{ ui_text('admin.appearance.storefront.zminy_mozhna_vidkotyty_nyzhche') }}</span></div><div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.mitka') }}<input name="hero_eyebrow" value="{{ settings.hero.eyebrow }}"></label><label>{{ ui_text('admin.appearance.storefront.zaholovok') }}<input name="hero_title" value="{{ settings.hero.title }}"></label><label>{{ ui_text('admin.appearance.storefront.pidzaholovok') }}<input name="hero_subtitle" value="{{ settings.hero.subtitle }}"></label>{{ _self.media_field('hero_image',settings.hero.image,ui_text('admin.appearance.storefront.zobrazhennia'),ui_text('admin.appearance.storefront.choose_from_media')) }}<label class="full">{{ ui_text('admin.appearance.storefront.tekst') }}<textarea name="hero_text" rows="3">{{ settings.hero.text }}</textarea></label><label>{{ ui_text('admin.appearance.storefront.knopka') }}<input name="hero_button_label" value="{{ settings.hero.button_label }}"></label><label>{{ ui_text('admin.appearance.storefront.url_knopky') }}<input name="hero_button_url" value="{{ settings.hero.button_url }}"></label></div>{% if settings.hero.image %}<div class="admin-banner-preview"><img src="{{ settings.hero.image }}" alt="{{ ui_text('admin.appearance.storefront.poperednii_perehliad_banera') }}" loading="lazy"></div>{% endif %}</section>
<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.appearance.storefront.home') }}</small><h2>{{ ui_text('admin.appearance.storefront.bloky_holovnoi') }}</h2></div></div><div class="admin-checkbox-grid"><label><input type="checkbox" name="show_benefits" value="1" {% if settings.home.show_benefits %}checked{% endif %}> {{ ui_text('admin.appearance.storefront.perevahy') }}</label><label><input type="checkbox" name="show_categories" value="1" {% if settings.home.show_categories %}checked{% endif %}> {{ ui_text('admin.appearance.storefront.katehorii') }}</label><label><input type="checkbox" name="show_products" value="1" {% if settings.home.show_products %}checked{% endif %}> {{ ui_text('admin.appearance.storefront.populiarni_tovary') }}</label><label><input type="checkbox" name="show_promos" value="1" {% if settings.home.show_promos %}checked{% endif %}> {{ ui_text('admin.appearance.storefront.promo_banery') }}</label><label><input type="checkbox" name="show_articles" value="1" {% if settings.home.show_articles %}checked{% endif %}> {{ ui_text('admin.appearance.storefront.statti') }}</label></div></section>
<div class="admin-editor-split"><section class="admin-editor-card"><h2>{{ ui_text('admin.appearance.storefront.livyi_promo_baner') }}</h2><div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.zaholovok') }}<input name="promo_left_title" value="{{ settings.promo_left.title }}"></label><label>{{ ui_text('admin.appearance.storefront.tekst') }}<input name="promo_left_text" value="{{ settings.promo_left.text }}"></label>{{ _self.media_field('promo_left_image',settings.promo_left.image,ui_text('admin.appearance.storefront.zobrazhennia'),ui_text('admin.appearance.storefront.choose_from_media')) }}<label>{{ ui_text('admin.appearance.storefront.posylannia') }}<input name="promo_left_url" value="{{ settings.promo_left.url }}"></label></div></section>
<section class="admin-editor-card"><h2>{{ ui_text('admin.appearance.storefront.pravyi_promo_baner') }}</h2><div class="admin-form-grid"><label>{{ ui_text('admin.appearance.storefront.zaholovok') }}<input name="promo_right_title" value="{{ settings.promo_right.title }}"></label><label>{{ ui_text('admin.appearance.storefront.tekst') }}<input name="promo_right_text" value="{{ settings.promo_right.text }}"></label>{{ _self.media_field('promo_right_image',settings.promo_right.image,ui_text('admin.appearance.storefront.zobrazhennia'),ui_text('admin.appearance.storefront.choose_from_media')) }}<label>{{ ui_text('admin.appearance.storefront.posylannia') }}<input name="promo_right_url" value="{{ settings.promo_right.url }}"></label></div></section></div>
<div class="admin-editor-actions admin-editor-actions--sticky"><span>{{ ui_text('admin.appearance.storefront.zberezhennia_stvoryt_novu_reviziiu_konfihuratsii') }}</span><button type="submit">{{ ui_text('admin.appearance.storefront.zberehty') }}</button></div></form>
<section class="admin-editor-card"><div class="admin-card-heading"><div><small>{{ ui_text('ui.admin.appearance.storefront.recovery') }}</small><h2>{{ ui_text('admin.appearance.storefront.istoriia_oformlennia') }}</h2></div><span class="admin-help">{{ ui_text('admin.appearance.storefront.shvydkyi_vidkat_bez_ruchnoho_redahuvannia_failiv') }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.appearance.storefront.reviziia') }}</th><th>{{ ui_text('admin.appearance.storefront.status') }}</th><th>{{ ui_text('admin.appearance.storefront.khto') }}</th><th>{{ ui_text('admin.appearance.storefront.chas') }}</th><th class="is-actions">{{ ui_text('admin.appearance.storefront.diia') }}</th></tr></thead><tbody>{% for revision in revisions %}<tr><td>#{{ revision.revision_number }}</td><td><span class="admin-status-pill {{ revision.status == 'active' ? 'is-active' : '' }}">{{ revision.status }}</span></td><td>{{ revision.actor_subject|default('system') }}</td><td>{{ revision.created_at }}</td><td class="is-actions">{% if revision.status != 'active' %}<form method="post" action="{{ path('admin_appearance_storefront_rollback',{revisionId:revision.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('storefront_presentation_rollback') }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.appearance.storefront.vidnovyty_tsiu_versiiu_oformlennia') }}" title="{{ ui_text('admin.appearance.storefront.vidnovyty_reviziiu') }}">{{ ui_icon('rotate-ccw', 18) }}</button></form>{% else %}<span class="admin-muted">{{ ui_text('admin.appearance.storefront.aktyvna') }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5">{{ ui_text('admin.appearance.storefront.istoriia_ziavytsia_pislia_pershoho_zberezhennia') }}</td></tr>{% endfor %}</tbody></table></div></section>
<dialog class="media-picker" data-appearance-media-picker><form method="dialog"><header><strong>{{ ui_text('admin.appearance.storefront.choose_media') }}</strong><button value="cancel" title="{{ ui_text('admin_close') }}" aria-label="{{ ui_text('admin_close') }}">{{ ui_icon('x', 18) }}</button></header><input type="search" data-appearance-media-search placeholder="{{ ui_text('admin.appearance.storefront.search_media') }}"><div class="media-picker-grid" data-appearance-media-results></div></form></dialog>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">
(()=>{const form=document.querySelector('.admin-storefront-form');if(!form)return;const source=JSON.parse(form.dataset.themePresetsJson||'{}');const presets=Object.fromEntries(Object.entries(source).map(([code,preset])=>[code,Object.fromEntries(Object.entries(preset.theme||{}).map(([key,value])=>['theme_'+key,value]))]));form.querySelectorAll('input[name="theme_preset"]').forEach(r=>r.addEventListener('change',()=>{if(!r.checked||!presets[r.value])return;Object.entries(presets[r.value]).forEach(([name,value])=>{const field=form.elements.namedItem(name);if(!field)return;field.value=value;field.dispatchEvent(new Event('input',{bubbles:true}));field.dispatchEvent(new Event('change',{bubbles:true}))})}))})();
</script>
{{ shell.end() }}