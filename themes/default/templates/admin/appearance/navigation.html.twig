{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.appearance.navigation.navihatsiia'),'navigation') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.appearance.navigation.vyhliad') }}</small><h1>{{ ui_text('admin.appearance.navigation.navihatsiia') }}</h1><p>{{ ui_text('admin.appearance.navigation.keruvannia_meniu_bez_zminy_shablonu_pidpysy_okre') }}</p></div></header>
<nav class="admin-view-chips"><a href="{{ path('admin_appearance_navigation',{menu:'header'}) }}">{{ ui_text('ui.admin.appearance.navigation.header') }}</a><a href="{{ path('admin_appearance_navigation',{menu:'footer'}) }}">{{ ui_text('ui.admin.appearance.navigation.footer') }}</a><a href="{{ path('admin_appearance_navigation',{menu:'utility'}) }}">{{ ui_text('ui.admin.appearance.navigation.utility') }}</a></nav>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ menu }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>{{ ui_text('admin.appearance.navigation.pidpys') }}</th><th>{{ ui_text('admin.appearance.navigation.batko') }}</th><th>{{ ui_text('admin.appearance.navigation.typ') }}</th><th>{{ ui_text('ui.admin.appearance.navigation.url_target') }}</th><th>{{ ui_text('admin.appearance.navigation.poriadok') }}</th><th>{{ ui_text('admin.appearance.navigation.status') }}</th><th>{{ ui_text('admin.appearance.navigation.dii') }}</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.id }}</td><td>{% for locale,label in item.translations %}<small>{{ locale }}: {{ label }}</small>{% endfor %}</td><td>{{ item.parent_id ?: '—' }}</td><td>{{ item.item_type }}</td><td>{{ item.url ?: item.target_ref }}</td><td>{{ item.sort_order }}</td><td>{{ item.status }}</td><td><a class="admin-icon-button" href="{{ path('admin_appearance_navigation',{menu:menu,edit:item.id}) }}" title="{{ ui_text('admin.appearance.navigation.redahuvaty_punkt_2') }}">✎</a><form method="post" action="{{ path('admin_appearance_navigation_delete',{id:item.id}) }}" style="display:inline"><input type="hidden" name="_csrf_token" value="{{ csrf_token('navigation_delete_'~item.id) }}"><button class="admin-icon-button is-danger" title="{{ ui_text('admin.appearance.navigation.vydalyty_punkt') }}">×</button></form></td></tr>{% else %}<tr><td colspan="8">{{ ui_text('admin.appearance.navigation.vlasnykh_punktiv_nemaie_vitryna_vykorystovuie_ka') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ editing ? ui_text('admin.appearance.navigation.redahuvaty_punkt') ~ editing.id : ui_text('admin.appearance.navigation.dodaty_punkt') }}</h2>{% if editing %}<a class="admin-ghost-button" href="{{ path('admin_appearance_navigation',{menu:menu}) }}">{{ ui_text('admin.appearance.navigation.novyi_punkt') }}</a>{% endif %}</div><form method="post" action="{{ path('admin_appearance_navigation_save') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('navigation_save') }}"><input type="hidden" name="menu_code" value="{{ menu }}"><input type="hidden" name="id" value="{{ editing.id|default(0) }}"><label>{{ ui_text('admin.appearance.navigation.batkivskyi_punkt') }}<select name="parent_id"><option value="0">{{ ui_text('admin.appearance.navigation.korenevyi_riven') }}</option>{% for candidate in items %}{% if not editing or candidate.id != editing.id %}<option value="{{ candidate.id }}" {{ editing and editing.parent_id == candidate.id ? 'selected' : '' }}>#{{ candidate.id }} — {{ candidate.translations|first|default(candidate.item_type) }}</option>{% endif %}{% endfor %}</select><small>{{ ui_text('admin.appearance.navigation.systema_ne_dozvolyt_stvoryty_tsykl_abo_pryviazat') }}</small></label><label>{{ ui_text('admin.appearance.navigation.typ') }}<select name="item_type">{% for value,title in {'custom':ui_text('admin.nav_item.custom_url'),'category':ui_text('admin.nav_item.category'),'product':ui_text('admin.nav_item.product'),'page':ui_text('admin.nav_item.page')} %}<option value="{{ value }}" {{ editing and editing.item_type == value ? 'selected' : '' }}>{{ title }}</option>{% endfor %}</select></label><label>{{ ui_text('ui.admin.appearance.navigation.target_uuid') }}<input type="text" name="target_ref" maxlength="255" value="{{ editing.target_ref|default('') }}"></label><label>{{ ui_text('ui.admin.appearance.navigation.url_fallback') }}<input type="text" name="url" maxlength="1000" value="{{ editing.url|default('') }}" placeholder="{{ ui_text('admin.appearance.navigation.catalog_abo_https') }}"></label><label>{{ ui_text('admin.appearance.navigation.poriadok') }}<input type="number" name="sort_order" value="{{ editing.sort_order|default(0) }}"></label><label>{{ ui_text('admin.appearance.navigation.status') }}<select name="status"><option value="active" {{ not editing or editing.status == 'active' ? 'selected' : '' }}>{{ ui_text('ui.admin.appearance.navigation.active') }}</option><option value="disabled" {{ editing and editing.status == 'disabled' ? 'selected' : '' }}>{{ ui_text('ui.admin.appearance.navigation.disabled') }}</option></select></label><label><input type="checkbox" name="open_new_tab" value="1" {{ editing and editing.open_new_tab ? 'checked' : '' }}> {{ ui_text('admin.appearance.navigation.nova_vkladka') }}</label>{% for locale in locales %}<label>{{ locale.name }} ({{ locale.code }})<input type="text" name="label[{{ locale.code }}]" maxlength="190" value="{{ editing.translations[locale.code]|default('') }}"{% if loop.first %} required{% endif %}></label>{% endfor %}<button class="admin-primary-link" type="submit">{{ editing ? ui_text('admin.appearance.navigation.zberehty_zminy') : ui_text('admin.appearance.navigation.dodaty_punkt') }}</button></form></section>
{{ shell.end() }}
