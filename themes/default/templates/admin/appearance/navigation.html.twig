{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{% import '@storefront/admin/_help.html.twig' as help %}
{{ shell.start(ui_text('admin.appearance.navigation.navihatsiia'),'navigation') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.appearance.navigation.vyhliad') }}</span></nav><h1>{{ ui_text('admin.appearance.navigation.navihatsiia') }}</h1><p>{{ ui_text('admin.appearance.navigation.keruvannia_meniu_bez_zminy_shablonu_pidpysy_okre') }}</p></div></header>
<nav class="admin-view-chips"><a href="{{ path('admin_appearance_navigation',{menu:'header'}) }}"{% if menu == 'header' %} aria-current="page"{% endif %}>{{ ui_text('ui.admin.appearance.navigation.header') }}</a><a href="{{ path('admin_appearance_navigation',{menu:'footer'}) }}"{% if menu == 'footer' %} aria-current="page"{% endif %}>{{ ui_text('ui.admin.appearance.navigation.footer') }}</a><a href="{{ path('admin_appearance_navigation',{menu:'utility'}) }}"{% if menu == 'utility' %} aria-current="page"{% endif %}>{{ ui_text('ui.admin.appearance.navigation.utility') }}</a></nav>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ {'header': ui_text('admin.appearance.navigation.menu_header'), 'footer': ui_text('admin.appearance.navigation.menu_footer'), 'utility': ui_text('admin.appearance.navigation.menu_utility')}[menu]|default(menu) }}</h2>
<form method="post" action="{{ path('admin_appearance_navigation_seed') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('navigation_seed') }}"><input type="hidden" name="menu_code" value="{{ menu }}"><button class="admin-button" type="submit">{{ ui_icon('list-plus', 16) }}{{ ui_text('admin.appearance.navigation.seed_button') }}</button></form></div>
<p class="admin-help">{{ {'header': ui_text('admin.appearance.navigation.hint_menu_header'), 'footer': ui_text('admin.appearance.navigation.hint_menu_footer'), 'utility': ui_text('admin.appearance.navigation.hint_menu_utility')}[menu]|default('') }}</p>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.appearance.navigation.pidpys') }}</th><th>{{ ui_text('admin.appearance.navigation.batko') }}</th><th>{{ ui_text('admin.appearance.navigation.col_opens') }}</th><th>{{ ui_text('admin.appearance.navigation.poriadok') }}</th><th>{{ ui_text('admin.appearance.navigation.status') }}</th><th>{{ ui_text('admin.appearance.navigation.dii') }}</th></tr></thead><tbody>{% for item in items %}<tr><td><strong>{{ item.display }}</strong>{% if item.open_new_tab %} <small>{{ ui_icon('external-link', 14) }}</small>{% endif %}</td><td>{{ item.parent_id ?: '—' }}</td><td>{{ {'custom': ui_text('admin.appearance.navigation.type_custom'), 'category': ui_text('admin.appearance.navigation.type_category'), 'page': ui_text('admin.appearance.navigation.type_page'), 'product': ui_text('admin.appearance.navigation.type_product')}[item.item_type]|default(item.item_type) }}{% if item.item_type in ['custom','page'] %}: <code>{{ item.url ?: item.target_ref }}</code>{% endif %}</td><td>{{ item.sort_order }}</td><td><span class="admin-badge {{ item.status == 'active' ? 'is-active' : '' }}">{{ item.status == 'active' ? ui_text('ui.admin.appearance.navigation.active') : ui_text('ui.admin.appearance.navigation.disabled') }}</span></td><td><a class="admin-icon-button" href="{{ path('admin_appearance_navigation',{menu:menu,edit:item.id}) }}" title="{{ ui_text('admin.appearance.navigation.redahuvaty_punkt_2') }}" aria-label="{{ ui_text('admin.appearance.navigation.redahuvaty_punkt_2') }}">{{ ui_icon('pencil', 18) }}</a><form method="post" action="{{ path('admin_appearance_navigation_delete',{id:item.id}) }}" style="display:inline" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('navigation_delete_'~item.id) }}"><button class="admin-icon-button is-danger" title="{{ ui_text('admin.appearance.navigation.vydalyty_punkt') }}" aria-label="{{ ui_text('admin.appearance.navigation.vydalyty_punkt') }}">{{ ui_icon('trash-2', 18) }}</button></form></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.appearance.navigation.vlasnykh_punktiv_nemaie_vitryna_vykorystovuie_ka') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ editing ? ui_text('admin.appearance.navigation.redahuvaty_punkt') ~ editing.id : ui_text('admin.appearance.navigation.dodaty_punkt') }}</h2>{% if editing %}<a class="admin-button" href="{{ path('admin_appearance_navigation',{menu:menu}) }}">{{ ui_text('admin.appearance.navigation.novyi_punkt') }}</a>{% endif %}</div>
<form method="post" action="{{ path('admin_appearance_navigation_save') }}" class="admin-form-grid"{% if ai_providers() %} data-translate-page data-ai-token="{{ csrf_token('admin_ai') }}"{% endif %}><input type="hidden" name="_csrf_token" value="{{ csrf_token('navigation_save') }}"><input type="hidden" name="menu_code" value="{{ menu }}"><input type="hidden" name="id" value="{{ editing.id|default(0) }}">
<label>{{ ui_text('admin.appearance.navigation.opens') }}<select name="choice"><option value="custom" {{ not editing or editing.choice == 'custom' ? 'selected' : '' }}>{{ ui_text('admin.appearance.navigation.opt_custom') }}</option>{% if categories %}<optgroup label="{{ ui_text('admin.appearance.navigation.opt_group_categories') }}">{% for c in categories %}<option value="category:{{ c.uuid }}" {{ editing and editing.choice == 'category:' ~ c.uuid ? 'selected' : '' }}>{{ ('— — — ')|slice(0, c.depth * 2) }}{{ c.name }}</option>{% endfor %}</optgroup>{% endif %}<optgroup label="{{ ui_text('admin.appearance.navigation.opt_group_pages') }}">{% for path_value, key in pages %}<option value="page:{{ path_value }}" {{ editing and editing.choice == 'page:' ~ path_value ? 'selected' : '' }}>{{ ui_text(key) }} ({{ path_value }})</option>{% endfor %}</optgroup></select>{{ help.hint(ui_text('admin.appearance.navigation.hint_opens')) }}</label>
<label>{{ ui_text('admin.appearance.navigation.url_label') }}<input type="text" name="url" maxlength="1000" value="{{ editing.url|default('') }}" placeholder="/sale  https://…">{{ help.hint(ui_text('admin.appearance.navigation.hint_url')) }}</label>
<label>{{ ui_text('admin.appearance.navigation.batkivskyi_punkt') }}<select name="parent_id"><option value="0">{{ ui_text('admin.appearance.navigation.korenevyi_riven') }}</option>{% for candidate in items %}{% if not editing or candidate.id != editing.id %}<option value="{{ candidate.id }}" {{ editing and editing.parent_id == candidate.id ? 'selected' : '' }}>{{ candidate.display }}</option>{% endif %}{% endfor %}</select>{{ help.hint(ui_text('admin.appearance.navigation.hint_parent')) }}</label>
<label>{{ ui_text('admin.appearance.navigation.poriadok') }}<input type="number" name="sort_order" value="{{ editing.sort_order|default(0) }}">{{ help.hint(ui_text('admin.appearance.navigation.hint_order')) }}</label>
<label>{{ ui_text('admin.appearance.navigation.status') }}<select name="status"><option value="active" {{ not editing or editing.status == 'active' ? 'selected' : '' }}>{{ ui_text('ui.admin.appearance.navigation.active') }}</option><option value="disabled" {{ editing and editing.status == 'disabled' ? 'selected' : '' }}>{{ ui_text('ui.admin.appearance.navigation.disabled') }}</option></select></label>
<div class="admin-inline-field"><span>{{ ui_text('admin.icons.field') }}</span>{% include '@storefront/admin/_icon_field.html.twig' with {name: 'icon', value: editing ? editing.icon|default('') : '', clearable: true} only %}</div><label><input type="checkbox" name="open_new_tab" value="1" {{ editing and editing.open_new_tab ? 'checked' : '' }}> {{ ui_text('admin.appearance.navigation.nova_vkladka') }}</label>
{% for locale in locales %}<label{% if not loop.first %} data-translate-panel data-locale="{{ locale.code }}"{% endif %}>{{ ui_text('admin.appearance.navigation.label_in') }} {{ locale.name }} ({{ locale.code }})<input type="text" name="label[{{ locale.code }}]" maxlength="190"{% if not loop.first %} data-translate-field data-translate-source="{{ ('[name="label[' ~ locales[0].code ~ ']"]')|e('html_attr') }}"{% endif %} value="{{ editing.translations[locale.code]|default('') }}">{% if loop.first %}{{ help.hint(ui_text('admin.appearance.navigation.hint_labels')) }}{% endif %}</label>{% endfor %}
{% if ai_providers() and locales|length > 1 %}<div class="admin-form-wide translation-status__ai"><label><span>{{ ui_text('admin.ai.provider') }}</span><select data-ai-provider>{% for pr in ai_providers() %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endfor %}</select></label><button type="button" class="admin-button" data-translate-all>{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.navigation.translate_labels') }}</span></button><small data-bulk-status role="status"></small></div>{% endif %}
<button class="admin-button is-primary" type="submit">{{ editing ? ui_text('admin.appearance.navigation.zberehty_zminy') : ui_text('admin.appearance.navigation.dodaty_punkt') }}</button></form></section>
{{ shell.end() }}
