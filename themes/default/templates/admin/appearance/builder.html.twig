{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.appearance.builder.konstruktor') ~ type,'builder_' ~ type,'builder') }}
<header class="admin-page-header">
  <div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.appearance.builder.oformlennia') }} · {{ {'home':ui_text('admin.appearance.editor.holovna'),'product':ui_text('admin.appearance.editor.tovar'),'checkout':ui_text('builder_checkout'),'category':ui_text('admin.builder.category'),'cart':ui_text('admin.builder.cart')}[type]|default(type) }}</span></nav><h1>{{ ui_text('admin.appearance.builder.vizualnyi_konstruktor') }}</h1><p>{{ ui_text('admin.appearance.builder.drag_and_drop_vlastyvosti_adaptyvnist_mediateka_') }}</p>{% if has_draft %}<span class="builder-draft-badge">{{ ui_text('admin.appearance.builder.vidkryta_chernetka') }}</span>{% endif %}</div>
  <div class="admin-page-header__actions"><a class="admin-button" href="{{ path('admin_media_library') }}" target="_blank">{{ ui_text('admin.appearance.builder.mediateka') }}</a><button class="admin-button" name="builder_action" value="draft" type="submit" form="builder-form">{{ ui_text('admin.appearance.builder.zberehty_chernetku') }}</button><button class="admin-button is-primary" name="builder_action" value="publish" type="submit" form="builder-form">{{ ui_text('admin.appearance.builder.opublikuvaty') }}</button></div>
</header>
{% if missing_extension_components|default([]) %}<div class="admin-notice is-warning"><strong>{{ ui_text('admin_extensions') }}</strong>: {{ missing_extension_components|join(', ') }}. {{ ui_text('extension.builder.missing_component_warning') }}</div>{% endif %}
{% for typeKey,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ typeKey }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-panel mc-builder" data-builder data-builder-type="{{ type }}" data-media-endpoint="{{ path('admin_media_library_json') }}">
  <form method="post" id="builder-form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('layout_builder_' ~ type) }}">
    <textarea name="layout_json" data-layout-json hidden>{{ layout|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</textarea>
    <input type="hidden" name="snippet_block_id" data-snippet-block-id value="">
    <input type="hidden" name="snippet_name" data-snippet-name value="">
    <div class="mc-builder-toolbar"><select data-add-component><option value="">{{ ui_text('admin.appearance.builder.dodaty_blok') }}</option>{% if type == 'checkout' %}<option value="checkout_contact">{{ ui_text('admin.appearance.builder.kontakt') }}</option><option value="checkout_shipping">{{ ui_text('admin.appearance.builder.dostavka') }}</option><option value="checkout_company">{{ ui_text('admin.appearance.builder.kompaniia_fop') }}</option><option value="checkout_comment">{{ ui_text('admin.appearance.builder.komentar') }}</option><option value="checkout_payment">{{ ui_text('admin.appearance.builder.oplata') }}</option><option value="checkout_coupon">{{ ui_text('admin.appearance.builder.promokod') }}</option><option value="checkout_summary">{{ ui_text('admin.appearance.builder.pidsumok') }}</option><option value="checkout_consent">{{ ui_text('admin.appearance.builder.pidtverdzhennia') }}</option>{% elseif type == 'product' %}<option value="product_gallery">{{ ui_text('admin.appearance.builder.halereia') }}</option><option value="product_title">{{ ui_text('admin.appearance.builder.nazva') }}</option><option value="product_price">{{ ui_text('admin.appearance.builder.tsina') }}</option><option value="product_stock">{{ ui_text('admin.appearance.builder.naiavnist') }}</option><option value="product_variants">{{ ui_text('admin.appearance.builder.varianty') }}</option><option value="product_buy">{{ ui_text('admin.appearance.builder.kupivlia') }}</option><option value="product_description">{{ ui_text('admin.appearance.builder.opys') }}</option><option value="product_attributes">{{ ui_text('admin.appearance.builder.kharakterystyky') }}</option><option value="product_documents">{{ ui_text('admin.appearance.builder.dokumenty') }}</option><option value="product_reviews">{{ ui_text('admin.appearance.builder.vidhuky') }}</option><option value="related_products">{{ ui_text('admin.appearance.builder.skhozhi_tovary') }}</option><option value="rich_text">{{ ui_text('admin.appearance.builder.vlasnyi_tekst') }}</option><option value="image">{{ ui_text('admin.appearance.builder.zobrazhennia') }}</option><option value="info_card">{{ ui_text('admin.appearance.builder.info_kartka') }}</option>{% elseif type == 'cart' %}<option value="cart_heading">{{ ui_text('admin.builder.cart_heading') }}</option><option value="cart_lines">{{ ui_text('admin.builder.cart_lines') }}</option><option value="cart_summary">{{ ui_text('admin.builder.cart_summary') }}</option><option value="cart_saved">{{ ui_text('admin.builder.cart_saved') }}</option><option value="cart_recent">{{ ui_text('admin.builder.cart_recent') }}</option>{% elseif type == 'category' %}<option value="category_heading">{{ ui_text('admin.builder.category_heading') }}</option><option value="category_filters">{{ ui_text('admin.builder.category_filters') }}</option><option value="category_toolbar">{{ ui_text('admin.builder.category_toolbar') }}</option><option value="category_recommended">{{ ui_text('admin.builder.category_recommended') }}</option><option value="category_grid">{{ ui_text('admin.builder.category_grid') }}</option><option value="category_description">{{ ui_text('admin.builder.category_description') }}</option>{% elseif type == 'home' %}<option value="hero">{{ ui_text('ui.admin.appearance.builder.hero') }}</option><option value="category_grid">{{ ui_text('ui.admin.appearance.builder.category_grid') }}</option><option value="product_grid">{{ ui_text('ui.admin.appearance.builder.product_grid') }}</option><option value="article_grid">{{ ui_text('ui.admin.appearance.builder.article_grid') }}</option>{% elseif type == 'header' %}<option value="logo">{{ ui_text('ui.admin.appearance.builder.logo') }}</option><option value="search">{{ ui_text('ui.admin.appearance.builder.search') }}</option><option value="menu">{{ ui_text('ui.admin.appearance.builder.menu') }}</option>{% else %}<option value="logo">{{ ui_text('ui.admin.appearance.builder.logo') }}</option><option value="menu">{{ ui_text('ui.admin.appearance.builder.menu') }}</option><option value="contacts">{{ ui_text('ui.admin.appearance.builder.contacts') }}</option><option value="social_links">{{ ui_text('ui.admin.appearance.builder.social_links') }}</option><option value="newsletter">{{ ui_text('ui.admin.appearance.builder.newsletter') }}</option>{% endif %}{% for component in extension_components|default([]) %}<option value="{{ component.id|e('html_attr') }}">{{ ui_text(component.label_key) }}</option>{% endfor %}</select><button type="button" class="admin-button" data-add-block>{{ ui_text('admin.appearance.builder.dodaty') }}</button>{% if snippets %}<select data-add-snippet><option value="">{{ ui_text('admin.appearance.builder.zberezhena_sektsiia') }}</option>{% for snippet in snippets %}<option value="{{ snippet.id }}" data-snippet-payload="{{ snippet.block|json_encode|e('html_attr') }}">{{ snippet.name }}</option>{% endfor %}</select><button type="button" class="admin-button" data-insert-snippet>{{ ui_text('admin.appearance.builder.vstavyty_sektsiiu') }}</button>{% endif %}</div>
    <div class="mc-builder-workspace">
      <div class="mc-builder-list" data-builder-list></div>
      <aside class="mc-builder-inspector" data-inspector><div class="mc-builder-empty">{{ ui_text('admin.appearance.builder.oberit_blok_dlia_redahuvannia_vlastyvostei') }}</div></aside>
      <div class="mc-builder-preview"><div class="mc-builder-preview__top"><strong>{{ ui_text('ui.admin.appearance.builder.live_preview') }}</strong><div class="admin-segmented"><button type="button" class="is-active" data-preview-width="desktop">{{ ui_icon('monitor', 16) }}<span class="visually-hidden">{{ ui_text('ui.admin.appearance.builder.desktop') }}</span></button><button type="button" data-preview-width="tablet">{{ ui_icon('tablet', 16) }}<span class="visually-hidden">{{ ui_text('ui.admin.appearance.builder.tablet') }}</span></button><button type="button" data-preview-width="mobile">{{ ui_icon('smartphone', 16) }}<span class="visually-hidden">{{ ui_text('ui.admin.appearance.builder.mobile') }}</span></button></div></div><div class="mc-builder-preview__canvas" data-preview-canvas></div></div>
    </div>
  </form>
</section>
{% if snippets %}<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.appearance.builder.povtorno_vykorystovuvani_sektsii') }}</h2><p>{{ ui_text('admin.appearance.builder.zberezhit_nalashtovanyi_blok_odyn_raz_i_vstavlia') }}</p></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.appearance.builder.nazva') }}</th><th>{{ ui_text('admin.appearance.builder.typ') }}</th><th>{{ ui_text('admin.appearance.builder.onovleno') }}</th><th></th></tr></thead><tbody>{% for snippet in snippets %}<tr><td>{{ snippet.name }}</td><td>{{ snippet.layout_type }}</td><td>{{ snippet.updated_at }}</td><td><form method="post" action="{{ path('admin_appearance_builder_snippet_delete',{type:type,id:snippet.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('layout_snippet_delete_' ~ snippet.id) }}"><button type="submit" class="admin-icon-button is-danger is-sm" title="{{ ui_text('admin.appearance.builder.vydalyty_zberezhenu_sektsiiu') }}" aria-label="{{ ui_text('admin.appearance.builder.vydalyty_zberezhenu_sektsiiu') }}">{{ ui_icon('x', 18) }}</button></form></td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% if revisions %}<section class="admin-panel"><h2>{{ ui_text('admin.appearance.builder.istoriia_maketa') }}</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>{{ ui_text('admin.appearance.builder.status') }}</th><th>{{ ui_text('admin.appearance.builder.data') }}</th><th></th></tr></thead><tbody>{% for revision in revisions %}<tr><td>{{ revision.id }}</td><td>{{ revision.status }}</td><td>{{ revision.created_at }}</td><td><form method="post" action="{{ path('admin_appearance_builder_rollback',{type:type,revisionId:revision.id}) }}" data-confirm="{{ ui_text('admin.confirm.rollback') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('layout_builder_rollback_' ~ type) }}"><button class="admin-button" type="submit">{{ ui_text('admin.appearance.builder.vidnovyty') }}</button></form></td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
<dialog class="admin-dialog media-picker" data-media-picker><form method="dialog"><header><strong>{{ ui_text('admin.appearance.builder.oberit_fail_z_mediateky') }}</strong><button value="cancel" title="{{ ui_text('admin.appearance.builder.zakryty') }}">{{ ui_icon('x', 18) }}</button></header><input type="search" data-media-search placeholder="{{ ui_text('admin.appearance.builder.poshuk') }}"><div class="media-picker-grid" data-media-results></div></form></dialog>

{{ shell.end() }}
