{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{{ shell.start(ui_text('admin.appearance.builder.konstruktor') ~ type,'builder_' ~ type,'builder') }}
<header class="admin-page-header">
  <div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.appearance.builder.oformlennia') }} {{ {'home':ui_text('admin.appearance.editor.holovna'),'product':ui_text('admin.appearance.editor.tovar'),'checkout':ui_text('builder_checkout'),'category':ui_text('admin.builder.category'),'cart':ui_text('admin.builder.cart')}[type]|default(type) }}</span></nav><h1>{{ ui_text('admin.appearance.builder.vizualnyi_konstruktor') }}</h1><p>{{ ui_text('admin.appearance.builder.drag_and_drop_vlastyvosti_adaptyvnist_mediateka_') }}</p>{% if has_draft %}<span class="builder-draft-badge">{{ ui_text('admin.appearance.builder.vidkryta_chernetka') }}</span>{% endif %}</div>
  <div class="admin-page-header__actions"><a class="admin-button" href="{{ path('admin_media_library') }}" target="_blank">{{ ui_text('admin.appearance.builder.mediateka') }}</a><button class="admin-button" name="builder_action" value="draft" type="submit" form="builder-form">{{ ui_text('admin.appearance.builder.zberehty_chernetku') }}</button><button class="admin-button is-primary" name="builder_action" value="publish" type="submit" form="builder-form">{{ ui_text('admin.appearance.builder.opublikuvaty') }}</button></div>
</header>
{% if missing_extension_components|default([]) %}<div class="admin-notice is-warning"><strong>{{ ui_text('admin_extensions') }}</strong>: {{ missing_extension_components|join(', ') }}. {{ ui_text('extension.builder.missing_component_warning') }}</div>{% endif %}
{% for typeKey,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ typeKey }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-panel mc-builder" data-builder data-builder-type="{{ type }}" data-media-endpoint="{{ path('admin_media_library_json') }}" data-draft-endpoint="{{ path('admin_appearance_builder_draft_json', {type: type}) }}" data-publish-endpoint="{{ path('admin_appearance_builder_publish_json', {type: type}) }}" data-presence-endpoint="{{ path('admin_appearance_builder_presence', {type: type}) }}" data-builder-fields="{{ builder_fields|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}" data-builder-common-fields="{{ builder_common_fields|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}" data-builder-locales="{{ builder_locales|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}" data-builder-schema-errors="{{ builder_schema_errors|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}">
  <div class="mc-builder-notice is-info" data-builder-presence role="status" aria-live="polite" hidden></div>
  <div class="mc-builder-notice is-warning" data-builder-conflict role="alert" hidden><span data-conflict-text></span><button type="button" class="admin-button" data-conflict-reload>{{ ui_text('builder_conflict_reload') }}</button><button type="button" class="admin-button is-primary" data-conflict-overwrite>{{ ui_text('builder_conflict_overwrite') }}</button></div>
  <form method="post" id="builder-form" novalidate>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('layout_builder_' ~ type) }}">
    <input type="hidden" name="base_version" value="{{ layout_version }}" data-base-version-input>
    <textarea name="layout_json" data-layout-json hidden>{{ layout|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</textarea>
    <input type="hidden" name="snippet_block_id" data-snippet-block-id value="">
    <input type="hidden" name="snippet_name" data-snippet-name value="">
    <div class="mc-builder-toolbar"><select data-add-component><option value="">{{ ui_text('admin.appearance.builder.dodaty_blok') }}</option>{% for component in builder_components %}<option value="{{ component.component }}">{{ ui_text(component.label_key) }}</option>{% endfor %}{% for component in extension_components|default([]) %}<option value="{{ component.id|e('html_attr') }}">{{ ui_text(component.label_key) }}</option>{% endfor %}</select><button type="button" class="admin-button" data-add-block>{{ ui_text('admin.appearance.builder.dodaty') }}</button>{% if snippets %}<select data-add-snippet><option value="">{{ ui_text('admin.appearance.builder.zberezhena_sektsiia') }}</option>{% for snippet in snippets %}<option value="{{ snippet.id }}" data-snippet-payload="{{ snippet.block|json_encode|e('html_attr') }}">{{ snippet.name }}</option>{% endfor %}</select><button type="button" class="admin-button" data-insert-snippet>{{ ui_text('admin.appearance.builder.vstavyty_sektsiiu') }}</button>{% endif %}<span class="mc-builder-history"><button type="button" class="admin-button" data-builder-undo disabled title="{{ ui_text('builder_undo_hint') }}">{{ ui_icon('undo-2', 16) }}{{ ui_text('builder_undo') }}</button><button type="button" class="admin-button" data-builder-redo disabled title="{{ ui_text('builder_redo_hint') }}">{{ ui_icon('redo-2', 16) }}{{ ui_text('builder_redo') }}</button></span><span class="mc-builder-save-status" data-builder-save-status role="status" aria-live="polite"></span></div>
    <div class="mc-builder-workspace">
      <div class="mc-builder-list" data-builder-list></div>
      <aside class="mc-builder-inspector" data-inspector><div class="mc-builder-empty">{{ ui_text('admin.appearance.builder.oberit_blok_dlia_redahuvannia_vlastyvostei') }}</div></aside>
      <div class="mc-builder-preview"><div class="mc-builder-preview__top"><div class="admin-segmented" data-preview-modes><button type="button" class="is-active" data-preview-mode="page">{{ ui_text('builder_preview_page') }}</button><button type="button" data-preview-mode="schema">{{ ui_text('builder_preview_schema') }}</button></div><div class="admin-segmented"><button type="button" class="is-active" data-preview-width="desktop">{{ ui_icon('monitor', 16) }}<span class="visually-hidden">{{ ui_text('ui.admin.appearance.builder.desktop') }}</span></button><button type="button" data-preview-width="tablet">{{ ui_icon('tablet', 16) }}<span class="visually-hidden">{{ ui_text('ui.admin.appearance.builder.tablet') }}</span></button><button type="button" data-preview-width="mobile">{{ ui_icon('smartphone', 16) }}<span class="visually-hidden">{{ ui_text('ui.admin.appearance.builder.mobile') }}</span></button></div></div><div class="mc-builder-preview__frame" data-real-preview><iframe src="{{ preview_url }}" title="{{ ui_text('admin.builderreal.title')|e('html_attr') }}"></iframe></div><div class="mc-builder-preview__canvas" data-preview-canvas hidden></div><p class="mc-builder-preview__foot"><small>{{ ui_text('builder_preview_help') }}</small> <a href="{{ preview_url }}" target="_blank" rel="noopener">{{ ui_text('admin.builderreal.open') }}</a></p></div>
    </div>
  </form>
</section>
{% if snippets %}<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.appearance.builder.povtorno_vykorystovuvani_sektsii') }}</h2><p>{{ ui_text('admin.appearance.builder.zberezhit_nalashtovanyi_blok_odyn_raz_i_vstavlia') }}</p></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.appearance.builder.nazva') }}</th><th>{{ ui_text('admin.appearance.builder.typ') }}</th><th>{{ ui_text('admin.appearance.builder.onovleno') }}</th><th></th></tr></thead><tbody>{% for snippet in snippets %}<tr><td>{{ snippet.name }}</td><td>{{ snippet.layout_type }}</td><td>{{ snippet.updated_at }}</td><td><form method="post" action="{{ path('admin_appearance_builder_snippet_delete',{type:type,id:snippet.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('layout_snippet_delete_' ~ snippet.id) }}"><button type="submit" class="admin-icon-button is-danger is-sm" title="{{ ui_text('admin.appearance.builder.vydalyty_zberezhenu_sektsiiu') }}" aria-label="{{ ui_text('admin.appearance.builder.vydalyty_zberezhenu_sektsiiu') }}">{{ ui_icon('x', 18) }}</button></form></td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% if revisions %}<section class="admin-panel"><h2>{{ ui_text('admin.appearance.builder.istoriia_maketa') }}</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>{{ ui_text('admin.appearance.builder.status') }}</th><th>{{ ui_text('admin.appearance.builder.data') }}</th><th></th></tr></thead><tbody>{% for revision in revisions %}<tr><td>{{ revision.id }}</td><td>{{ status_badge(revision.status) }}</td><td>{{ revision.created_at }}</td><td><form method="post" action="{{ path('admin_appearance_builder_rollback',{type:type,revisionId:revision.id}) }}" data-confirm="{{ ui_text('admin.confirm.rollback') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('layout_builder_rollback_' ~ type) }}"><input type="hidden" name="base_version" value="{{ layout_version }}" data-base-version-input><button class="admin-button" type="submit">{{ ui_text('admin.appearance.builder.vidnovyty') }}</button></form></td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
<dialog class="admin-dialog media-picker" data-media-picker><form method="dialog"><header><strong>{{ ui_text('admin.appearance.builder.oberit_fail_z_mediateky') }}</strong><button value="cancel" title="{{ ui_text('admin.appearance.builder.zakryty') }}">{{ ui_icon('x', 18) }}</button></header><input type="search" data-media-search placeholder="{{ ui_text('admin.appearance.builder.poshuk') }}"><div class="media-picker-grid" data-media-results></div></form></dialog>

{{ shell.end() }}
