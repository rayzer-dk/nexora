{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.appearance.editor.redaktor_vytryny'),'appearance','builder') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.appearance.editor.oformlennia') }}</small><h1>{{ ui_text('ui.admin.appearance.editor.visual_store_editor') }}</h1><p>{{ ui_text('admin.appearance.editor.odyn_robochyi_prostir_dlia_struktury_preview_ta_') }}</p></div><a class="admin-preview-link" href="/" target="_blank" rel="noopener">{{ ui_text('admin.appearance.editor.vidkryty_mahazyn') }}</a></header>
<div class="visual-editor-shell" data-visual-editor>
<aside class="visual-editor-tree"><h2>{{ ui_text('admin.appearance.editor.storinka') }}</h2>{% for code,label in {'home':ui_text('admin.appearance.editor.holovna'),'header':ui_text('admin.appearance.editor.shapka'),'footer':ui_text('admin.appearance.editor.pidval'),'product':ui_text('admin.appearance.editor.tovar'),'checkout':'Checkout'} %}<a class="{{ type==code?'is-active':'' }}" href="{{ path('admin_visual_store_editor',{type:code}) }}"><strong>{{ label }}</strong><small>{{ type==code and has_draft?ui_text('admin.appearance.editor.ye_chernetka'):ui_text('admin.appearance.editor.redahuvannia_blokiv') }}</small></a>{% endfor %}<hr><a href="{{ path('admin_appearance_storefront') }}"><strong>{{ ui_text('ui.admin.appearance.editor.design_system') }}</strong><small>{{ ui_text('admin.appearance.editor.kolory_tini_radiusy_typohrafika') }}</small></a></aside>
<section class="visual-editor-canvas"><div class="visual-editor-toolbar"><div><button type="button" data-preview-size="desktop" class="is-active">{{ ui_text('ui.admin.appearance.editor.desktop') }}</button><button type="button" data-preview-size="tablet">{{ ui_text('ui.admin.appearance.editor.tablet') }}</button><button type="button" data-preview-size="mobile">{{ ui_text('ui.admin.appearance.editor.mobile') }}</button></div><button type="button" data-preview-refresh>{{ ui_text('admin.appearance.editor.onovyty_preview') }}</button></div><div class="visual-editor-frame is-desktop" data-preview-frame-wrap><iframe src="{{ preview_url }}" title="{{ ui_text('admin.appearance.editor.poperednii_perehliad_vytryny') }}" data-preview-frame loading="eager"></iframe></div></section>
<aside class="visual-editor-properties"><h2>{{ ui_text('admin.appearance.editor.vlastyvosti') }}</h2><p>{{ ui_text('admin.appearance.editor.vybrano') }} <strong>{{ type }}</strong></p><a class="admin-primary-link" href="{{ path('admin_appearance_builder',{type:type}) }}">{{ ui_text('admin.appearance.editor.redahuvaty_bloky') }}</a><a class="admin-ghost-button" href="{{ path('admin_appearance_storefront') }}">{{ ui_text('admin.appearance.editor.styl_i_kolory') }}</a><dl><dt>{{ ui_text('ui.admin.appearance.editor.preset') }}</dt><dd>{{ presentation.theme.preset }}</dd><dt>{{ ui_text('admin.appearance.editor.osnovnyi') }}</dt><dd><span class="visual-color-dot" style="background:{{ presentation.theme.primary }}"></span>{{ presentation.theme.primary }}</dd><dt>{{ ui_text('admin.appearance.editor.shchilnist') }}</dt><dd>{{ presentation.theme.density }}</dd><dt>{{ ui_text('admin.appearance.editor.tini') }}</dt><dd>{{ presentation.theme.shadow }}</dd></dl><h3>{{ ui_text('admin.appearance.editor.istoriia') }}</h3><p>{{ history|length }} {{ ui_text('admin.appearance.editor.ostannikh_revizii_published_layout_maie_bezpechn') }}</p></aside>
</div>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">(()=>{const root=document.querySelector('[data-visual-editor]');if(!root)return;const wrap=root.querySelector('[data-preview-frame-wrap]'),frame=root.querySelector('[data-preview-frame]');root.addEventListener('click',e=>{const b=e.target.closest('[data-preview-size]');if(b){root.querySelectorAll('[data-preview-size]').forEach(x=>x.classList.remove('is-active'));b.classList.add('is-active');wrap.className='visual-editor-frame is-'+b.dataset.previewSize;}if(e.target.closest('[data-preview-refresh]'))frame.src=frame.src;});})();</script>
{{ shell.end() }}
