{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.analytics.index.analityka'),'analytics') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.analytics.index.prodazhi_ta_popyt') }}</span></nav><h1>{{ ui_text('admin.analytics.index.analityka_mahazynu') }}</h1><p>{{ ui_text('admin.analytics.index.faktychni_zamovlennia_povernennia_koshyky_dzhere') }}</p></div><form method="get" class="admin-filters admin-analytics-range"><label><span>{{ ui_text('admin.analytics.index.period') }}</span><select name="days" data-autosubmit>{% for d in [7,30,90,180,365] %}<option value="{{ d }}"{{ report.days == d ? ' selected' : '' }}>{{ d }} {{ ui_text('admin.analytics.index.dniv') }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.analytics.range_from') }}</span><input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label><span>{{ ui_text('admin.analytics.range_to') }}</span><input type="date" name="to" value="{{ app.request.query.get('to') }}"></label>
<div class="admin-filters__actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.orders.index.zastosuvaty') }}</button><a class="admin-button" href="{{ path('admin_analytics_export', {days: report.days, from: app.request.query.get('from'), to: app.request.query.get('to')}) }}">{{ ui_icon('download', 16) }} CSV</a></div></form></header>
{% macro delta(value) %}{% if value is not null %}<span class="admin-delta is-{{ value > 0 ? 'up' : (value < 0 ? 'down' : 'flat') }}">{{ value > 0 ? '+' : '' }}{{ value }}%</span>{% endif %}{% endmacro %}
<section class="admin-stats">
<article><span>{{ ui_text('admin.analytics.index.chystyi_dokhid') }}</span><strong>{{ (report.metrics.net_minor / 100)|number_format(2,'.',' ') }} {{ report.currency }}</strong><small>{{ ui_text('admin.analytics.index.pislia_uspishnykh_refund') }} {{ _self.delta(report.compare.revenue) }}</small></article>
<article><span>{{ ui_text('admin.analytics.index.zamovlennia') }}</span><strong>{{ report.metrics.orders }}</strong><small>{{ ui_text('admin.analytics.index.oplacheni_povernuti') }} {{ report.metrics.paid_orders }} {{ _self.delta(report.compare.orders) }}</small></article>
<article><span>{{ ui_text('admin.analytics.index.serednii_chek') }}</span><strong>{{ (report.metrics.aov_minor / 100)|number_format(2,'.',' ') }} {{ report.currency }}</strong><small>{{ ui_text('ui.admin.analytics.index.net_revenue_paid_orders') }} {{ _self.delta(report.compare.aov) }}</small></article>
<article><span>{{ ui_text('admin.analytics.index.koshyk_zamovlennia') }}</span><strong>{{ report.metrics.cart_to_order_pct }}%</strong><small>{{ ui_text('admin.analytics.index.koshyky_z_tovaramy') }} {{ report.metrics.carts_with_items }}</small></article>
</section>
{% set max_rev = 1 %}{% for d in report.daily %}{% if d.revenue_minor > max_rev %}{% set max_rev = d.revenue_minor %}{% endif %}{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ report.from }} — {{ report.to }}</small><h2>{{ ui_text('admin.analytics.daily') }}</h2></div></div>
<div class="admin-bars" role="img" aria-label="{{ ui_text('admin.analytics.daily') }}">{% for d in report.daily %}<span class="admin-bars__bar" style="--h:{{ (d.revenue_minor * 100 / max_rev)|round }}" title="{{ d.day }}: {{ (d.revenue_minor / 100)|number_format(2,'.',' ') }} {{ report.currency }} · {{ d.orders }}"></span>{% endfor %}</div></section>
<div class="admin-grid-2">
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.split') }}</small><h2>{{ ui_text('admin.analytics.payment') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.method') }}</th><th>{{ ui_text('admin.analytics.index.zamovlen') }}</th><th>{{ ui_text('admin.analytics.index.vyruchka') }}</th></tr></thead><tbody>{% for r in report.by_payment %}<tr><td>{{ ui_text('method.payment.' ~ r.code) != 'method.payment.' ~ r.code ? ui_text('method.payment.' ~ r.code) : r.code }}</td><td>{{ r.orders }}</td><td>{{ (r.revenue_minor / 100)|number_format(2,'.',' ') }}</td></tr>{% else %}<tr><td colspan="3" class="admin-empty">—</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.split') }}</small><h2>{{ ui_text('admin.analytics.delivery') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.method') }}</th><th>{{ ui_text('admin.analytics.index.zamovlen') }}</th><th>{{ ui_text('admin.analytics.index.vyruchka') }}</th></tr></thead><tbody>{% for r in report.by_delivery %}<tr><td>{{ ui_text('method.delivery.' ~ r.code) != 'method.delivery.' ~ r.code ? ui_text('method.delivery.' ~ r.code) : r.code }}</td><td>{{ r.orders }}</td><td>{{ (r.revenue_minor / 100)|number_format(2,'.',' ') }}</td></tr>{% else %}<tr><td colspan="3" class="admin-empty">—</td></tr>{% endfor %}</tbody></table></div></section>
</div>
<div class="admin-grid-2">
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.split') }}</small><h2>{{ ui_text('admin.analytics.statuses') }}</h2></div></div><div class="admin-inline-actions">{% for r in report.by_status %}{{ status_badge(r.code) }} <strong>{{ r.orders }}</strong>{% else %}—{% endfor %}</div>
<p class="admin-help">{{ ui_text('admin.analytics.buyers') }}: {{ ui_text('admin.analytics.buyers_new') }} <strong>{{ report.customers_split.new }}</strong> · {{ ui_text('admin.analytics.buyers_returning') }} <strong>{{ report.customers_split.returning }}</strong></p></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.split') }}</small><h2>{{ ui_text('admin.analytics.top_customers') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.customer') }}</th><th>{{ ui_text('admin.analytics.index.zamovlen') }}</th><th>{{ ui_text('admin.analytics.index.vyruchka') }}</th></tr></thead><tbody>{% for r in report.top_customers %}<tr><td><strong>{{ admin_can('personal_data.view') ? r.name : '—' }}</strong>{% if admin_can('personal_data.view') %}<small class="admin-cell-sub">{{ r.email }}</small>{% endif %}</td><td>{{ r.orders }}</td><td>{{ (r.revenue_minor / 100)|number_format(2,'.',' ') }}</td></tr>{% else %}<tr><td colspan="3" class="admin-empty">—</td></tr>{% endfor %}</tbody></table></div></section>
</div>
<section class="admin-panel" data-tab="lost" data-tab-label="{{ ui_text('admin.analytics.lost_title') }}" data-tab-icon="trending-down"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.lost_small') }}</small><h2>{{ ui_text('admin.analytics.lost_title') }}</h2><p class="admin-help">{{ ui_text('admin.analytics.lost_help') }}</p></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.index.tovar') }}</th><th>{{ ui_text('admin.analytics.lost_views') }}</th><th>{{ ui_text('admin.analytics.lost_waiting') }}</th><th>{{ ui_text('admin.analytics.lost_revenue') }}</th><th class="is-actions"></th></tr></thead><tbody>
{% for r in lost_demand %}<tr><td><strong>{{ r.name ?: r.sku }}</strong><small class="admin-cell-sub">{{ r.sku }}</small></td><td>{{ r.views }}</td><td>{{ r.waiting }}</td><td>{{ r.lost_minor > 0 ? (r.lost_minor / 100)|number_format(2,'.',' ') ~ ' ' ~ report.currency : '—' }}</td><td class="is-actions"><a class="admin-button is-sm" href="{{ path('admin_catalog_product_edit', {publicId: r.public_id}) }}">{{ ui_icon('pencil', 14) }} {{ ui_text('admin.analytics.lost_restock') }}</a></td></tr>{% else %}<tr><td colspan="5" class="admin-empty">{{ ui_text('admin.analytics.lost_none') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.index.prodazhi') }}</small><h2>{{ ui_text('admin.analytics.index.naisylnishi_tovary') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>SKU</th><th>{{ ui_text('admin.analytics.index.tovar') }}</th><th>{{ ui_text('admin.analytics.index.k_st') }}</th><th>{{ ui_text('admin.analytics.index.vyruchka') }}</th></tr></thead><tbody>{% for row in report.top_products %}<tr><td>{{ row.sku }}</td><td>{{ row.name }}</td><td>{{ row.quantity * 1 }}</td><td>{{ (row.revenue_minor / 100)|number_format(2,'.',' ') }} {{ report.currency }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.analytics.index.danykh_za_period_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.index.atrybutsiia') }}</small><h2>{{ ui_text('admin.analytics.index.dzherela_zamovlen') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('ui.admin.analytics.index.source') }}</th><th>{{ ui_text('ui.admin.analytics.index.medium') }}</th><th>{{ ui_text('admin.analytics.index.zamovlen') }}</th><th>{{ ui_text('admin.analytics.index.vyruchka') }}</th></tr></thead><tbody>{% for row in report.sources %}<tr><td>{{ row.source }}</td><td>{{ row.medium }}</td><td>{{ row.orders }}</td><td>{{ (row.revenue_minor / 100)|number_format(2,'.',' ') }} {{ report.currency }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.analytics.index.utm_referrer_attribution_shche_ne_nakopychena') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.index.poshuk') }}</small><h2>{{ ui_text('admin.analytics.index.shcho_shukaiut_pokuptsi') }}</h2></div><span>{{ ui_text('admin.analytics.index.pokynutykh_koshykiv_24h') }} {{ report.metrics.abandoned_carts }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.index.zapyt') }}</th><th>{{ ui_text('admin.analytics.index.poshukiv') }}</th><th>{{ ui_text('admin.analytics.index.ser_rezultativ') }}</th><th>{{ ui_text('admin.analytics.index.bez_rezultatu') }}</th></tr></thead><tbody>{% for row in report.searches %}<tr><td>{{ row.query_text }}</td><td>{{ row.searches }}</td><td>{{ row.avg_results }}</td><td>{{ row.zero_results }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.analytics.index.poshukovykh_danykh_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.analytics.index.mozhlyvosti_asortymentu') }}</small><h2>{{ ui_text('ui.admin.analytics.index.zero_result_search') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.analytics.index.zapyt') }}</th><th>{{ ui_text('admin.analytics.index.skilky_raziv_ne_znaideno') }}</th><th>{{ ui_text('admin.analytics.synonym_title') }}</th></tr></thead><tbody>{% for row in report.zero_searches %}<tr><td>{{ row.query_text }}</td><td>{{ row.searches }}</td><td>{% if admin_can('catalog.manage') %}<form method="post" action="{{ path('admin_catalog_search_synonym_create') }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_search_synonym_create') }}"><input type="hidden" name="label" value="{{ row.query_text }}"><input type="hidden" name="terms" value="{{ row.query_text }}"><input name="alt" required maxlength="120" placeholder="{{ ui_text('admin.analytics.synonym_ph') }}" aria-label="{{ ui_text('admin.analytics.synonym_ph') }}"><button class="admin-button is-sm" type="submit">{{ ui_icon('plus', 14) }} {{ ui_text('admin.analytics.synonym_add') }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="2">{{ ui_text('admin.analytics.index.za_vybranyi_period_zero_result_zapytiv_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
