{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{% set b2b_ctx = admin_context_switcher().current %}{{ shell.start('B2B','b2b') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.b2b.index.kompanii_ta_hurtovi_umovy') }}</span></nav><h1>{{ ui_text('admin.b2b.index.b2b_torhivlia') }}</h1><p>{{ ui_text('admin.b2b.index.kompanii_spivrobitnyky_kredytni_umovy_prais_lyst') }}</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="admin-notice is-{{ type == 'success' ? 'success' : 'error' }}">{{ message }}</div>{% endfor %}{% endfor %}
<div data-tabs="b2b-index">
<section class="admin-panel" data-tab="t1"><div class="admin-panel__header"><div><small>{{ ui_text('admin.b2b.index.novyi_kontrahent') }}</small><h2>{{ ui_text('admin.b2b.index.kompaniia') }}</h2></div></div><form method="post" action="/admin/b2b/company" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('b2b_company') }}"><label>{{ ui_text('admin.b2b.index.nazva') }}<input type="text" name="name" required maxlength="190"></label><label>{{ ui_text('admin.b2b.index.yurydychna_nazva') }}<input type="text" name="legal_name" maxlength="255"></label><label>{{ ui_text('admin.b2b.index.yedrpou_tax_id') }}<input type="text" name="tax_id" maxlength="64"></label><label>VAT ID<input type="text" name="vat_id" maxlength="64"></label><label>{{ ui_text('admin.b2b.index.valiuta') }}<input type="text" name="currency" value="{{ b2b_ctx.currency }}" maxlength="3"></label><label>{{ ui_text('admin.b2b.index.kredytnyi_limit') }}<input type="text" name="credit_limit" value="0"></label><label>{{ ui_text('admin.b2b.index.vidstrochka_dniv') }}<input type="number" name="payment_terms_days" min="0" max="365" value="0"></label><label>{{ ui_text('admin.b2b.index.porih_pohodzhennia') }}<input type="text" name="approval_threshold" placeholder="{{ ui_text('admin.b2b.index.porozhno_bez_porohu') }}"></label><label>{{ ui_text('admin.b2b.index.status') }}<select name="status"><option value="active">{{ ui_text('admin.b2b.index.aktyvna') }}</option><option value="pending">{{ ui_text('admin.b2b.index.ochikuie') }}</option><option value="suspended">{{ ui_text('admin.b2b.index.pryzupynena') }}</option></select></label><div><button class="admin-button is-primary" type="submit">{{ ui_text('admin.b2b.index.stvoryty_kompaniiu') }}</button></div></form></section>
<section class="admin-panel" data-tab="t2"><div class="admin-panel__header"><div><small>{{ ui_text('admin.b2b.index.kontrahenty') }}</small><h2>{{ ui_text('admin.b2b.index.kompanii') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.b2b.index.kompaniia') }}</th><th>{{ ui_text('ui.admin.b2b.index.tax_vat') }}</th><th>{{ ui_text('admin.b2b.index.umovy') }}</th><th>{{ ui_text('admin.b2b.index.spivrobitnyky') }}</th><th>{{ ui_text('admin.b2b.index.praisy') }}</th><th>{{ ui_text('admin.b2b.index.status') }}</th></tr></thead><tbody>{% for c in companies %}<tr><td><strong>{{ c.name }}</strong><br><small>{{ c.legal_name }}</small></td><td>{{ c.tax_id ?: '—' }}<br><small>{{ c.vat_id ?: '' }}</small></td><td>{{ c.currency }} · {{ (c.credit_limit_minor/100)|number_format(2,'.',' ') }}<br><small>{{ c.payment_terms_days }} {{ ui_text('admin.b2b.index.dniv_pohodzhennia') }} {{ c.approval_threshold_minor is null ? ui_text('admin.b2b.index.ne_zadano') : (c.approval_threshold_minor/100)|number_format(2,'.',' ') }}</small></td><td>{{ c.member_count }}</td><td>{{ c.price_list_count }}</td><td>{{ c.status }}</td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.b2b.index.b2b_kompanii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel" data-tab="t3"><div class="admin-panel__header"><div><small>{{ ui_text('admin.b2b.index.dostup_kompanii') }}</small><h2>{{ ui_text('admin.b2b.index.spivrobitnyk') }}</h2></div></div><form method="post" action="/admin/b2b/member" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('b2b_member') }}"><label>{{ ui_text('admin.b2b.index.kompaniia') }}<select name="company_id" required>{% for c in companies %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label><label>{{ ui_text('admin.b2b.index.email_pokuptsia') }}<input type="email" name="email" required></label><label>{{ ui_text('admin.b2b.index.rol') }}<select name="role"><option value="buyer">{{ ui_text('ui.admin.b2b.index.buyer') }}</option><option value="approver">{{ ui_text('ui.admin.b2b.index.approver') }}</option><option value="admin">{{ ui_text('ui.admin.b2b.index.company_admin') }}</option></select></label><label>{{ ui_text('admin.b2b.index.limit_spivrobitnyka') }}<input type="text" name="spending_limit" placeholder="{{ ui_text('admin.b2b.index.bez_limitu') }}"></label><div><button class="admin-button is-primary" type="submit">{{ ui_text('admin.b2b.index.dodaty_onovyty') }}</button></div></form><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.b2b.index.kompaniia') }}</th><th>{{ ui_text('admin.b2b.index.korystuvach') }}</th><th>{{ ui_text('admin.b2b.index.rol') }}</th><th>{{ ui_text('admin.b2b.index.limit') }}</th></tr></thead><tbody>{% for m in members %}<tr><td>{{ m.company_name }}</td><td>{{ m.display_name ?: m.email }}<br><small>{{ m.email }}</small></td><td>{{ m.role }}</td><td>{{ m.spending_limit_minor is null ? '—' : (m.spending_limit_minor/100)|number_format(2,'.',' ') }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.b2b.index.spivrobitnykiv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel" data-tab="t4"><div class="admin-panel__header"><div><small>{{ ui_text('admin.b2b.index.indyvidualni_tsiny') }}</small><h2>{{ ui_text('admin.b2b.index.prais_lysty') }}</h2></div></div><form method="post" action="/admin/b2b/price-list" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('b2b_price_list') }}"><label>{{ ui_text('admin.b2b.index.nazva') }}<input type="text" name="name" required></label><label>{{ ui_text('admin.b2b.index.valiuta') }}<input type="text" name="currency" value="{{ b2b_ctx.currency }}" maxlength="3"></label><label>{{ ui_text('admin.b2b.index.priorytet') }}<input type="number" name="priority" value="100" min="0"></label><fieldset><legend>{{ ui_text('admin.b2b.index.kompanii') }}</legend>{% for c in companies %}<label><input type="checkbox" name="company_ids[]" value="{{ c.id }}"> {{ c.name }}</label>{% endfor %}</fieldset><div><button class="admin-button is-primary" type="submit">{{ ui_text('admin.b2b.index.stvoryty_prais') }}</button></div></form><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.b2b.index.prais') }}</th><th>{{ ui_text('admin.b2b.index.valiuta') }}</th><th>{{ ui_text('admin.b2b.index.priorytet') }}</th><th>{{ ui_text('admin.b2b.index.kompanii_2') }}</th><th>{{ ui_text('admin.b2b.index.tsin') }}</th></tr></thead><tbody>{% for p in lists %}<tr><td>{{ p.name }}</td><td>{{ p.currency }}</td><td>{{ p.priority }}</td><td>{{ p.company_count }}</td><td>{{ p.tier_count }}</td></tr>{% else %}<tr><td colspan="5">{{ ui_text('admin.b2b.index.prais_lystiv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel" data-tab="t5"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.b2b.index.quantity_tier') }}</small><h2>{{ ui_text('admin.b2b.index.tsina_sku') }}</h2></div></div><form method="post" action="/admin/b2b/price-tier" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('b2b_price_tier') }}"><label>{{ ui_text('admin.b2b.index.prais') }}<select name="price_list_id" required>{% for p in lists %}<option value="{{ p.id }}">{{ p.name }} · {{ p.currency }}</option>{% endfor %}</select></label><label>SKU<input type="text" name="sku" required></label><label>{{ ui_text('admin.b2b.index.vid_kilkosti') }}<input type="text" name="min_quantity" value="1"></label><label>{{ ui_text('admin.b2b.index.do_kilkosti') }}<input type="text" name="max_quantity" placeholder="{{ ui_text('admin.b2b.index.bez_verkhnoi_mezhi') }}"></label><label>{{ ui_text('admin.b2b.index.tsina') }}<input type="text" name="price" required></label><div><button class="admin-button is-primary" type="submit">{{ ui_text('admin.b2b.index.zberehty_tsinu') }}</button></div></form><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.b2b.index.prais') }}</th><th>SKU</th><th>{{ ui_text('admin.b2b.index.kilkist') }}</th><th>{{ ui_text('admin.b2b.index.tsina') }}</th></tr></thead><tbody>{% for t in tiers %}<tr><td>{{ t.price_list_name }}</td><td>{{ t.sku }}</td><td>{{ t.min_quantity }}{% if t.max_quantity %}–{{ t.max_quantity }}{% else %}+{% endif %}</td><td>{{ (t.amount_minor/100)|number_format(2,'.',' ') }}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.b2b.index.indyvidualnykh_tsin_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel" data-tab="t6"><div class="admin-panel__header"><div><small>{{ ui_text('ui.admin.b2b.index.approval_workflow') }}</small><h2>{{ ui_text('admin.b2b.index.ochikuiut_pohodzhennia') }}</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.b2b.index.zamovlennia') }}</th><th>{{ ui_text('admin.b2b.index.kompaniia') }}</th><th>PO</th><th>{{ ui_text('admin.b2b.index.suma') }}</th><th>{{ ui_text('admin.b2b.index.data') }}</th><th>{{ ui_text('admin.b2b.index.diia') }}</th></tr></thead><tbody>{% for o in pending %}<tr><td>{{ o.order_number }}</td><td>{{ o.company_name }}</td><td>{{ o.purchase_order_number ?: '—' }}</td><td>{{ (o.total_minor/100)|number_format(2,'.',' ') }} {{ o.currency }}</td><td>{{ o.created_at }}</td><td><form method="post" action="/admin/b2b/order/{{ o.id }}/decision"><input type="hidden" name="_csrf_token" value="{{ csrf_token('b2b_order_' ~ o.id) }}"><button class="admin-button is-primary is-sm" name="decision" value="approve">{{ ui_text('admin.b2b.index.pohodyty') }}</button> <button class="admin-button is-danger is-sm" name="decision" value="reject">{{ ui_text('admin.b2b.index.vidkhylyty') }}</button></form></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.b2b.index.zamovlen_na_pohodzhenni_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
</div>
{{ shell.end() }}
