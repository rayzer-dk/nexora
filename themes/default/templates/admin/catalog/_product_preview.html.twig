<section class="admin-preview-card"><header><div><small>{{ ui_text('admin.catalog._product_preview.shvydkyi_preview') }}</small><h2>{{ product.name }}</h2><p>{{ product.sku }} · {{ product.status }}</p></div><strong class="admin-preview-price">{{ product.price_display }}</strong></header>{% if images %}<div class="admin-preview-media">{% for image in images %}<img src="{{ image.url }}" alt="{{ image.alt_text|default(product.name) }}">{% endfor %}</div>{% endif %}<dl class="admin-preview-meta"><div><dt>GTIN</dt><dd>{{ product.gtin|default('—') }}</dd></div><div><dt>MPN</dt><dd>{{ product.mpn|default('—') }}</dd></div><div><dt>{{ ui_text('admin.catalog._product_preview.zalyshok') }}</dt><dd>{{ product.stock_quantity|qty|default('0') }}</dd></div><div><dt>{{ ui_text('admin.catalog._product_preview.prodazh') }}</dt><dd>{{ product.purchase_mode|default('auto') }}{% if product.purchase_eta_text %} · {{ product.purchase_eta_text }}{% endif %}</dd></div></dl>{% if product.short_description %}<p>{{ product.short_description }}</p>{% endif %}<footer><a class="admin-button is-primary" href="{{ path('admin_catalog_product_edit',{publicId:product.public_id}) }}">{{ ui_text('admin.catalog._product_preview.vidkryty_tovar') }}</a><a class="admin-button" href="/catalog?q={{ product.sku|url_encode }}" target="_blank" rel="noopener">{{ ui_text('admin.catalog._product_preview.vidkryty_vytrynu') }}</a></footer></section>
