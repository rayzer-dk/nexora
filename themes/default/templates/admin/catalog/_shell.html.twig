{% macro start(title, section, feature = null) %}
{% import _self as nav %}
<!doctype html>
<html lang="{{ app.request.attributes.get('_ui_locale', 'uk-UA') }}" data-color-scheme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex,nofollow">
    <title>{{ title }} · Nexora Commerce</title>
    <link rel="icon" type="image/svg+xml" href="/assets/branding/nexora-mark.svg">
    <meta name="color-scheme" content="light dark">
    <meta name="mc-media-csrf" content="{{ csrf_token('media_upload') }}">
    <script nonce="{{ app.request.attributes.get('_csp_nonce') }}">try{var t=localStorage.getItem('mc_admin_theme');if(t==='light'||t==='dark'){document.documentElement.dataset.theme=t;}if(localStorage.getItem('mc_admin_sidebar')==='collapsed'){document.documentElement.dataset.sidebar='collapsed';}}catch(e){}</script>
    <link rel="stylesheet" href="{{ vite_asset('assets/admin/admin-runtime.css', '/assets/admin-runtime.css') }}">
    <script type="module" src="{{ vite_asset('assets/admin/main.ts', '/assets/admin.js') }}"></script>
    {% if feature in ['builder','media'] %}<link rel="stylesheet" href="{{ vite_asset('assets/admin/admin-builder-media.css', '/assets/admin-builder-media.css') }}">{% endif %}
</head>
<body class="admin-app" data-admin-runtime>
<div class="admin-shell">
    <aside class="admin-sidebar" id="admin-sidebar" data-admin-sidebar>
        <a class="admin-sidebar__brand" href="/admin" aria-label="Nexora Commerce"><img src="/assets/branding/nexora-mark.svg" alt="" width="32" height="32"><span><strong>Nexora Commerce</strong><small>{{ ui_text('admin_manage') }}</small></span></a>
        <nav class="admin-nav" aria-label="{{ ui_text('admin_manage') }}" data-command-source>
            {% if admin_can('dashboard.view') %}{{ nav.link(section, 'dashboard', '/admin', 'layout-dashboard', ui_text('admin_overview')) }}{% endif %}
            {% if admin_can('analytics.view') %}{{ nav.link(section, 'analytics', '/admin/analytics', 'chart-column', ui_text('admin_analytics')) }}{% endif %}
            {% if admin_can('analytics.view') %}{{ nav.link(section, 'traffic', '/admin/analytics/traffic', 'trending-up', ui_text('admin.traffic.title')) }}{% endif %}
            {% if admin_can('catalog.view') or admin_can('search.view') %}<span class="admin-nav__label">{{ ui_text('admin_catalog') }}</span>{% endif %}
            {% if admin_can('catalog.view') %}{{ nav.link(section, 'products', '/admin/catalog/products', 'package', ui_text('admin_products')) }}{{ nav.link(section, 'categories', '/admin/catalog/categories', 'folder-tree', ui_text('admin_categories')) }}{{ nav.link(section, 'suppliers', '/admin/catalog/suppliers', 'truck', ui_text('admin.suppliers.title')) }}{{ nav.link(section, 'metadata', '/admin/catalog/metadata', 'tags', ui_text('admin_brands_attributes')) }}{% endif %}
            {% if admin_can('catalog.view') %}{{ nav.link(section, 'fields', '/admin/catalog/fields', 'sliders-horizontal', ui_text('admin.fields.title')) }}{{ nav.link(section, 'units', '/admin/catalog/units', 'ruler', ui_text('admin.units.title')) }}{% endif %}
            {% if admin_can('search.view') %}{{ nav.link(section, 'search', '/admin/catalog/search', 'search', ui_text('admin_search_recommendations')) }}{% endif %}
            {% if admin_can('catalog.view') %}{{ nav.link(section, 'merchandising', '/admin/catalog/merchandising', 'arrow-up-down', ui_text('admin_merchandising')) }}{{ nav.link(section, 'badges', '/admin/catalog/badges', 'tag', ui_text('admin.badges.title')) }}{{ nav.link(section, 'import_export', '/admin/commerce/import-export', 'file-spreadsheet', ui_text('admin_import_export')) }}{% endif %}
            {% if admin_can('orders.view') or admin_can('customers.view') or admin_can('b2b.view') %}<span class="admin-nav__label">{{ ui_text('admin_sales') }}</span>{% endif %}
            {% if admin_can('orders.view') %}{{ nav.link(section, 'orders', '/admin/orders', 'receipt', ui_text('admin_orders')) }}{{ nav.link(section, 'shipments', '/admin/shipments', 'truck', ui_text('admin_shipments')) }}{{ nav.link(section, 'shipping_countries', '/admin/shipments/countries', 'globe', ui_text('admin.shipping_countries.title')) }}{{ nav.link(section, 'shipping_methods', '/admin/shipments/methods', 'wallet', ui_text('admin.checkout_methods.title')) }}{% endif %}
            {% if admin_can('customers.view') %}{{ nav.link(section, 'customers', '/admin/commerce/customers', 'users', ui_text('admin_customers')) }}{{ nav.link(section, 'customer_groups', '/admin/commerce/customer-groups', 'users', ui_text('admin.customer_groups.nav')) }}{{ nav.link(section, 'inquiries', '/admin/commerce/inquiries', 'inbox', ui_text('admin_inquiries')) }}{{ nav.link(section, 'stock_requests', '/admin/commerce/stock-requests', 'bell', ui_text('admin.stockrequests.title')) }}{{ nav.link(section, 'customer_experience', '/admin/customer-experience', 'rotate-ccw', ui_text('admin_returns_feedback')) }}{% endif %}
            {% if admin_can('b2b.view') %}{{ nav.link(section, 'b2b', '/admin/b2b', 'building', ui_text('admin_b2b')) }}{% endif %}
            {% if admin_can('marketing.view') or admin_can('feeds.view') or admin_can('notifications.view') or admin_can('rewards.view') %}<span class="admin-nav__label">{{ ui_text('admin.nav.marketing') }}</span>{% endif %}
            {% if admin_can('marketing.view') %}{{ nav.link(section, 'promotions', '/admin/commerce/promotions', 'badge-percent', ui_text('admin_promotions')) }}{{ nav.link(section, 'campaigns', '/admin/commerce/campaigns', 'megaphone', ui_text('admin_campaigns')) }}{{ nav.link(section, 'subscribers', '/admin/commerce/subscribers', 'users', ui_text('admin.subscribers.nav')) }}{{ nav.link(section, 'marketing_automation', '/admin/commerce/marketing-automation', 'workflow', ui_text('admin_automation')) }}{{ nav.link(section, 'automation', '/admin/automation', 'zap', ui_text('admin.automation.title')) }}{% endif %}
            {% if admin_can('rewards.view') %}{{ nav.link(section, 'rewards', '/admin/rewards', 'star', ui_text('admin.rewards.index.podarunkovi_kartky_ta_loialnist')) }}{% endif %}
            {% if admin_can('feeds.view') %}{{ nav.link(section, 'feeds', '/admin/commerce/feeds', 'rss', ui_text('admin_commerce_feeds')) }}{% endif %}
            {% if admin_can('notifications.view') %}{{ nav.link(section, 'notifications', '/admin/commerce/notifications', 'bell', ui_text('admin_notifications')) }}{{ nav.link(section, 'notification_templates', '/admin/commerce/notification-templates', 'mail', ui_text('admin.tpl.title')) }}{{ nav.link(section, 'notification_channels', '/admin/commerce/notification-channels', 'plug', ui_text('admin.notify_channels.nav')) }}{{ nav.link(section, 'sms', '/admin/commerce/sms', 'smartphone', ui_text('admin.sms.nav')) }}{% endif %}
            {% if admin_can('content.view') or admin_can('forum.view') or admin_can('appearance.view') or admin_can('media.view') %}<span class="admin-nav__label">{{ ui_text('admin.nav.content') }}</span>{% endif %}
            {% if admin_can('appearance.view') %}{{ nav.link(section, 'appearance', '/admin/appearance/storefront', 'palette', ui_text('admin_storefront')) }}{{ nav.link(section, 'landing', '/admin/appearance/landing', 'layout-template', ui_text('admin.landing.title')) }}{{ nav.link(section, 'editor', '/admin/appearance/editor', 'monitor', ui_text('ui.admin.dashboard.visual_store_editor')) }}{{ nav.link(section, 'contact_widget', '/admin/appearance/contact-widget', 'headset', ui_text('admin.cw.title')) }}{{ nav.link(section, 'support_chat', '/admin/appearance/support-chat', 'messages-square', ui_text('admin.support_chat.title')) }}{{ nav.link(section, 'builder_home', '/admin/appearance/builder/home', 'layout-template', ui_text('ui.admin.catalog._shell.page_builder')) }}{{ nav.link(section, 'builder_product', '/admin/appearance/builder/product', 'layout-grid', ui_text('ui.admin.catalog._shell.product_builder')) }}{{ nav.link(section, 'builder_checkout', '/admin/appearance/builder/checkout', 'shopping-cart', ui_text('ui.admin.catalog._shell.checkout_builder')) }}{{ nav.link(section, 'builder_category', '/admin/appearance/builder/category', 'layout-dashboard', ui_text('admin.builder.category_nav')) }}{{ nav.link(section, 'builder_cart', '/admin/appearance/builder/cart', 'shopping-bag', ui_text('admin.builder.cart_nav')) }}{{ nav.link(section, 'navigation', '/admin/appearance/navigation', 'list-tree', ui_text('admin_navigation')) }}{% endif %}
            {% if admin_can('content.view') %}{{ nav.link(section, 'content', '/admin/content/pages', 'file-text', ui_text('admin_pages')) }}{{ nav.link(section, 'blog', '/admin/content/blog', 'pencil', ui_text('admin.blog.title')) }}{% endif %}
            {% if admin_can('media.view') %}{{ nav.link(section, 'media', '/admin/media', 'image', ui_text('admin_media_library')) }}{{ nav.link(section, 'files', '/admin/files', 'folder-open', ui_text('admin.files.page_title')) }}{% endif %}
            {% if admin_can('content.view') %}{{ nav.link(section, 'forms', '/admin/content/forms', 'clipboard-list', ui_text('admin.forms.title')) }}{% endif %}
            {% if admin_can('content.view') %}{{ nav.link(section, 'downloads', '/admin/content/downloads', 'download', ui_text('admin.downloads.title')) }}{% endif %}
            {% if admin_can('forum.view') %}{{ nav.link(section, 'forum', '/admin/forum', 'messages-square', ui_text('admin_forum')) }}{% endif %}
            {% if admin_can('system.settings') or admin_can('extensions.manage') or admin_can('integrations.manage') or admin_can('system.cron.view') or admin_can('admin_users.manage') or admin_can('system.audit.view') or admin_can('developer_tools.view') or admin_can('system.update') %}<span class="admin-nav__label">{{ ui_text('admin_system') }}</span>{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'store', '/admin/system/store', 'store', ui_text('admin_store_data')) }}{{ nav.link(section, 'site', '/admin/system/site', 'globe', ui_text('admin_site_profile')) }}{{ nav.link(section, 'localization', '/admin/system/localization', 'languages', ui_text('admin.localization.nav')) }}{{ nav.link(section, 'tax', '/admin/system/tax', 'receipt', ui_text('admin.tax.nav')) }}{% endif %}
            {% if admin_can('extensions.manage') %}{{ nav.link(section, 'extensions', '/admin/system/extensions', 'puzzle', ui_text('admin_extensions')) }}{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'modules', '/admin/system/modules', 'layout-grid', ui_text('admin.system.modules.nav')) }}{{ nav.link(section, 'maintenance', '/admin/system/maintenance', 'refresh-cw', ui_text('admin.system.maintenance.nav')) }}{% endif %}
            {% if admin_can('integrations.manage') %}{{ nav.link(section, 'integrations', '/admin/system/integrations', 'plug', ui_text('admin_integrations')) }}{% endif %}
            {% if admin_can('system.update') %}{{ nav.link(section, 'migration', '/admin/system/migration', 'database-zap', ui_text('admin_migration')) }}{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'prro', '/admin/system/prro', 'receipt', ui_text('admin.prro.nav')) }}{{ nav.link(section, 'seo_redirects', '/admin/system/seo-redirects', 'git-branch', ui_text('admin.system.seo_redirects.nav')) }}{{ nav.link(section, 'seo_templates', '/admin/system/seo-templates', 'file-text', ui_text('admin.seotemplates.title')) }}{{ nav.link(section, 'indexnow', '/admin/system/seo-indexnow', 'refresh-cw', ui_text('admin.indexnow.title')) }}{{ nav.link(section, 'bots', '/admin/system/bots', 'ban', ui_text('admin.bots.title')) }}{{ nav.link(section, 'ai_ready', '/admin/system/ai-ready', 'sparkles', ui_text('admin.ai_ready.title')) }}{{ nav.link(section, 'network', '/admin/system/network', 'shield-check', ui_text('admin.network.title')) }}{{ nav.link(section, 'captcha', '/admin/system/captcha', 'shield-check', ui_text('admin.captcha.title')) }}{{ nav.link(section, 'push', '/admin/system/push', 'smartphone', ui_text('admin.push.title')) }}{{ nav.link(section, 'tracking', '/admin/system/tracking', 'chart-column', ui_text('admin.tracking.title')) }}{{ nav.link(section, 'stability', '/admin/system/stability', 'heart-pulse', ui_text('admin_stability')) }}{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'quality', '/admin/system/quality', 'gauge', ui_text('admin.quality.title')) }}{{ nav.link(section, 'data', '/admin/system/data', 'database', ui_text('admin.data.title')) }}{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'fraud', '/admin/system/fraud', 'shield-check', ui_text('admin.fraud.title')) }}{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'ai', '/admin/system/ai', 'sparkles', ui_text('admin.ai.title')) }}{% endif %}
            {% if admin_can('system.cron.view') %}{{ nav.link(section, 'cron', '/admin/system/cron', 'clock', ui_text('admin_cron_automation')) }}{% endif %}
            {% if admin_can('system.audit.view') %}{{ nav.link(section, 'activity', '/admin/system/activity', 'scroll-text', ui_text('admin_activity_log')) }}{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'logs', '/admin/system/logs', 'triangle-alert', ui_text('admin.logs.nav')) }}{% endif %}
            {% if admin_can('system.settings') %}{{ nav.link(section, 'demo', '/admin/system/demo', 'package', ui_text('admin.demo.nav')) }}{% endif %}
            {% if admin_can('developer_tools.view') %}{{ nav.link(section, 'developer', '/admin/system/developer', 'terminal', ui_text('ui.admin.catalog._shell.developer_tools')) }}{% endif %}
            {% if admin_can('admin_users.manage') %}{{ nav.link(section, 'access', '/admin/system/access', 'shield-user', ui_text('admin_admins_permissions')) }}{% endif %}
        </nav>
        <script nonce="{{ app.request.attributes.get('_csp_nonce') }}">try{var mcNav=document.querySelector('.admin-nav'),mcNavY=sessionStorage.getItem('mc_admin_nav_scroll');if(mcNav&&mcNavY!==null){mcNav.scrollTop=parseInt(mcNavY,10)||0;}}catch(e){}</script>
        <div class="admin-sidebar__footer">
            <button class="admin-nav__link admin-nav__collapse" type="button" data-sidebar-collapse aria-pressed="false" title="{{ ui_text('admin.nav.collapse') }}">{{ ui_icon('panel-left-close', 20) }}<span>{{ ui_text('admin.nav.collapse') }}</span></button>
            {{ nav.link(section, 'security', '/admin/account/security', 'shield-check', ui_text('admin.mfa.nav')) }}
            <form method="post" action="/admin/logout"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="admin-nav__link" type="submit">{{ ui_icon('log-out', 20) }}<span>{{ ui_text('admin_logout') }}</span></button></form>
        </div>
    </aside>
    <div class="admin-scrim" data-sidebar-scrim></div>
    <div class="admin-main">
        {% set context_switcher = admin_context_switcher() %}
        {% set context_sections = ['products','categories','metadata','fields','units','search','merchandising','badges','import_export','feeds','notification_templates','notification_channels','content','blog','forms','downloads','navigation','builder_home','builder_product','builder_checkout','builder_category','builder_cart','appearance','editor','seo_redirects','indexnow','promotions','campaigns','subscribers'] %}
        {% set show_context = section in context_sections %}
        <header class="admin-topbar">
            <button class="admin-icon-button admin-topbar__menu" type="button" data-sidebar-toggle aria-controls="admin-sidebar" aria-expanded="false" aria-label="{{ ui_text('admin_open_menu') }}" title="{{ ui_text('admin_open_menu') }}">{{ ui_icon('menu', 20) }}</button>
            <button class="admin-search-trigger" type="button" data-command-open title="{{ ui_text('admin_quick_jump') }}">{{ ui_icon('search', 16) }}<span>{{ ui_text('admin_jump_placeholder') }}</span><kbd>Ctrl K</kbd></button>
            {% if context_switcher.current %}
            <div class="admin-context" role="group" aria-label="{{ ui_text('admin_store_context') }}">
                {% if show_context %}
                {% if context_switcher.stores|length > 1 %}
                <form method="get" action="{{ app.request.pathInfo }}">
                    <label>{{ ui_text('admin_store') }}<select name="store_id" data-autosubmit>{% for store in context_switcher.stores %}<option value="{{ store.id }}"{{ store.id == context_switcher.current.store_id ? ' selected' : '' }}>{{ store.name }}{% if store.code %} · {{ store.code }}{% endif %}</option>{% endfor %}</select></label>
                </form>
                {% endif %}
                <form method="get" action="{{ app.request.pathInfo }}">
                    {% if context_switcher.markets|length > 1 %}<label>{{ ui_text('admin_market') }}<select name="market_id" data-autosubmit>{% for market in context_switcher.markets %}<option value="{{ market.id }}"{{ market.id == context_switcher.current.market_id ? ' selected' : '' }}>{{ market.name }}</option>{% endfor %}</select></label>{% endif %}
                    {% if context_switcher.locales|length > 1 %}<label title="{{ ui_text('admin.context.content_language_help') }}">{{ ui_text('admin.context.content_language') }}<select name="locale" data-autosubmit>{% for locale in context_switcher.locales %}<option value="{{ locale.locale_code }}"{{ locale.locale_code == context_switcher.current.locale ? ' selected' : '' }}>{{ locale.locale_code }}</option>{% endfor %}</select></label>{% endif %}
                    {% if context_switcher.currencies|length > 1 %}<label>{{ ui_text('admin_currency') }}<select name="currency" data-autosubmit>{% for currency in context_switcher.currencies %}<option value="{{ currency.currency_code }}"{{ currency.currency_code == context_switcher.current.currency ? ' selected' : '' }}>{{ currency.currency_code }}</option>{% endfor %}</select></label>{% endif %}
                </form>
                {% endif %}
                {% set ui_languages = admin_interface_languages() %}
                {% if ui_languages.available|length > 1 %}<form method="post" action="/admin/interface-language"><input type="hidden" name="_token" value="{{ csrf_token('admin_interface_language') }}"><input type="hidden" name="back" value="{{ app.request.requestUri }}"><label title="{{ ui_text('admin.context.interface_language_help') }}">{{ ui_icon('languages', 16) }}<span class="visually-hidden">{{ ui_text('admin.context.interface_language') }}</span><select name="ui_locale" data-autosubmit aria-label="{{ ui_text('admin.context.interface_language') }}">{% for code, name in ui_languages.available %}<option value="{{ code }}"{{ code == ui_languages.current ? ' selected' : '' }}>{{ name }}</option>{% endfor %}</select></label></form>{% endif %}
            </div>
            {% endif %}
            {% for quick in admin_quick_links() %}<a class="admin-icon-button admin-quick-link" href="{{ quick.href }}" title="{{ quick.label }}" aria-label="{{ quick.label }}">{{ ui_icon(quick.icon, 20) }}</a>{% endfor %}
            {% if admin_can('customers.view') %}{% set attention = admin_attention() %}<a class="admin-icon-button admin-attention{{ attention.total > 0 ? ' has-items' : '' }}" href="/admin/customer-experience" aria-label="{{ ui_text('admin.attention.title') }}" title="{{ ui_text('admin.attention.title') }}: {{ ui_text('admin.attention.detail', {returns: attention.returns, reviews: attention.reviews, questions: attention.questions, withdrawals: attention.withdrawals, stock: attention.stock}) }}">{{ ui_icon('bell', 20) }}{% if attention.total > 0 %}<span class="admin-attention__count">{{ attention.total > 99 ? '99+' : attention.total }}</span>{% endif %}</a>{% endif %}{% if admin_can('forum.view') %}{% set fa = admin_attention().forum %}<a class="admin-icon-button admin-forum-attention{{ fa > 0 ? ' has-items' : '' }}" href="/admin/forum" aria-label="{{ ui_text('admin.forum.attention') }}" title="{{ ui_text('admin.forum.attention') }}">{{ ui_icon('messages-square', 20) }}{% if fa > 0 %}<span class="admin-attention__count">{{ fa > 99 ? '99+' : fa }}</span>{% endif %}</a>{% endif %}
            <button class="admin-icon-button admin-theme-toggle" type="button" data-theme-toggle aria-label="{{ ui_text('admin.theme_toggle') }}" title="{{ ui_text('admin.theme_toggle') }}"><span class="admin-theme-toggle__moon" aria-hidden="true">{{ ui_icon('sun-moon', 20) }}</span></button>
            {% set admin_user = app.user %}
            <details class="admin-user-menu" data-user-menu><summary class="admin-user" title="{{ admin_user.displayName|default('') }}" aria-label="{{ ui_text('admin.account.menu') }}">{{ ui_icon('circle-user-round', 24) }}<span class="admin-user__name">{{ admin_user.displayName|default('') }}</span>{{ ui_icon('chevron-down', 16) }}</summary>
                <div class="admin-user-menu__panel" data-command-source>
                    <a href="{{ path('admin_account') }}">{{ ui_icon('key-round', 18) }}<span>{{ ui_text('admin.account.title') }}</span></a>
                    <a href="{{ path('admin_account_security') }}">{{ ui_icon('shield-check', 18) }}<span>{{ ui_text('admin.mfa.nav') }}</span></a>
                    <a href="{{ path('admin_account_quick_links') }}">{{ ui_icon('star', 18) }}<span>{{ ui_text('admin.quicklinks.title') }}</span></a>
                    <a href="{{ path('admin_help') }}">{{ ui_icon('file-text', 18) }}<span>{{ ui_text('admin.help.title') }}</span></a>
                    {% if admin_can('system.update') %}<a href="{{ path('admin_system_update') }}">{{ ui_icon('refresh-cw', 18) }}<span>{{ ui_text('admin.update.title') }}</span></a>{% endif %}
                    {% if admin_can('system.settings') %}<a href="{{ path('admin_system_stability') }}">{{ ui_icon('life-buoy', 18) }}<span>{{ ui_text('admin.help.recovery') }}</span></a>{% endif %}
                    {% if admin_can('extensions.manage') %}<a href="{{ path('admin_system_extensions') }}">{{ ui_icon('puzzle', 18) }}<span>{{ ui_text('admin_extensions') }}</span></a>{% endif %}
                    <form method="post" action="/admin/logout"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button type="submit">{{ ui_icon('log-out', 18) }}<span>{{ ui_text('admin_logout') }}</span></button></form>
                </div></details>
        </header>
        <main class="admin-content">
{% set pending_migrations = admin_can('system.update') ? admin_pending_migrations() : 0 %}{% if pending_migrations > 0 %}<div class="admin-status is-warning" role="status">{{ ui_text('admin.update.banner', {count: pending_migrations}) }} <a href="{{ path('admin_system_update') }}">{{ ui_text('admin.update.banner_link') }}</a></div>{% endif %}
{% set undo_pending = admin_undo_pending() %}{% if undo_pending %}<form class="admin-undo" method="post" action="{{ path('admin_undo', {id: undo_pending.id}) }}" data-undo-form><input type="hidden" name="_token" value="{{ csrf_token('admin_undo') }}"><span>{{ ui_icon('undo-2', 16) }} {{ undo_pending.label }}</span><button class="admin-button" type="submit" title="Ctrl+Z">{{ ui_text('admin.undo.button') }}</button></form>{% endif %}
{% endmacro %}
{% macro link(current, key, href, icon, label) %}{% set tone = 'blue' %}{% for prefix in ['/admin/orders', '/admin/shipments', '/admin/b2b', '/admin/customer-experience', '/admin/commerce/customers', '/admin/commerce/inquiries', '/admin/commerce/stock-requests', '/admin/returns'] %}{% if href starts with prefix %}{% set tone = 'green' %}{% endif %}{% endfor %}{% for prefix in ['/admin/commerce/promotions', '/admin/commerce/campaigns', '/admin/commerce/marketing', '/admin/commerce/feeds', '/admin/commerce/notification', '/admin/rewards'] %}{% if href starts with prefix %}{% set tone = 'orange' %}{% endif %}{% endfor %}{% for prefix in ['/admin/appearance', '/admin/content', '/admin/media', '/admin/forum'] %}{% if href starts with prefix %}{% set tone = 'violet' %}{% endif %}{% endfor %}{% if href starts with '/admin/system' or href starts with '/admin/account' %}{% set tone = 'teal' %}{% endif %}<a class="admin-nav__link{{ current == key ? ' is-active' : '' }}" data-tone="{{ tone }}" href="{{ href }}" title="{{ label }}"{{ current == key ? ' aria-current="page"' : '' }}>{{ ui_icon(icon, 20) }}<span>{{ label }}</span></a>{% endmacro %}
{% macro flashes(flashes) %}{% for type,messages in flashes %}{% for message in messages %}<div class="admin-notice is-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}{% endmacro %}
{% macro end() %}
        </main>
    </div>
</div>
<div class="admin-modal admin-command" data-command-palette hidden aria-hidden="true">
    <div class="admin-modal__backdrop" data-command-close></div>
    <section class="admin-modal__dialog" role="dialog" aria-modal="true" aria-label="{{ ui_text('admin_quick_jump') }}">
        <div class="admin-command__search">{{ ui_icon('search', 20) }}<input type="search" placeholder="{{ ui_text('admin_jump_placeholder') }}" autocomplete="off" data-command-input><kbd>Esc</kbd><button type="button" class="admin-icon-button is-sm" data-command-close title="{{ ui_text('admin_close') }}" aria-label="{{ ui_text('admin_close') }}">{{ ui_icon('x', 16) }}</button></div>
