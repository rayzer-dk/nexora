{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.fields.title'),'fields') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.fields.title') }}</span></nav><h1>{{ ui_text('admin.fields.title') }}</h1><p>{{ ui_text('admin.fields.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.fields.new') }}</h2></div>{{ ui_icon('plus', 20) }}</div>
<form method="post" action="{{ path('admin_catalog_fields_save') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_fields') }}">
<label><span>{{ ui_text('admin.fields.label') }}</span><input type="text" name="label" maxlength="160" required></label>

<label><span>{{ ui_text('admin.fields.type') }}</span><select name="field_type">{% for t in types %}<option value="{{ t }}">{{ {'text':ui_text('admin.fields.type_text'),'number':ui_text('admin.fields.type_number'),'url':ui_text('admin.fields.type_url'),'date':ui_text('admin.fields.type_date')}[t] }}</option>{% endfor %}</select></label>
<input type="hidden" name="sort_order" value="100">
<label class="admin-check"><input type="checkbox" name="show_on_storefront" value="1" checked><span>{{ ui_text('admin.fields.show') }}</span></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.fields.add') }}</button></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.fields.list') }}</h2></div></div>
{% if definitions %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.fields.label') }}</th><th>{{ ui_text('admin.fields.type') }}</th><th>{{ ui_text('admin.fields.show') }}</th><th class="is-actions">{{ ui_text('admin.automation.actions_col') }}</th></tr></thead><tbody>
{% for d in definitions %}<tr><td>{{ d.label }}</td><td>{{ {'text':ui_text('admin.fields.type_text'),'number':ui_text('admin.fields.type_number'),'url':ui_text('admin.fields.type_url'),'date':ui_text('admin.fields.type_date')}[d.field_type] }}</td><td>{{ d.show_on_storefront ? ui_text('admin.fields.yes') : ui_text('admin.fields.no') }}</td><td class="is-actions"><form method="post" action="{{ path('admin_catalog_fields_delete',{id:d.id}) }}" class="admin-inline-form" data-confirm="{{ ui_text('admin.fields.delete_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_fields') }}"><button class="admin-button is-danger" type="submit">{{ ui_icon('trash-2', 16) }}<span>{{ ui_text('admin.fields.delete') }}</span></button></form></td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="admin-empty">{{ ui_text('admin.fields.empty') }}</p>{% endif %}</section>
{{ shell.end() }}
