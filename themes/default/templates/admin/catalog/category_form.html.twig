{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{% import '@storefront/admin/_help.html.twig' as help %}
{% set editing = category is not null %}
{{ shell.start(editing ? ui_text('admin.catalog.category_form.redahuvaty_katehoriiu') : ui_text('admin.catalog.category_form.nova_katehoriia'),'categories') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.category_form.katehorii') }}</span></nav><h1>{{ editing ? ui_text('admin.catalog.category_form.redahuvaty_katehoriiu') : ui_text('admin.catalog.category_form.nova_katehoriia') }}</h1></div><div class="admin-page-actions">{% if editing %}<a class="admin-button" href="{{ path('admin_catalog_category_translations', {publicId: category.public_id}) }}">{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.translations.title') }}</span></a>{% endif %}<a href="{{ path('admin_catalog_categories') }}">{{ ui_text('admin.catalog.category_form.nazad') }}</a></div></header>
{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<form class="admin-form" method="post" data-dirty-guard data-lang-scope><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
{% set content_locale = admin_context_switcher().current.locale|default('') %}{% set tr_locales = [] %}{% for l in admin_context_switcher().locales %}{% if l.locale_code != content_locale %}{% set tr_locales = tr_locales|merge([l]) %}{% endif %}{% endfor %}{% set tr_data = tr_texts|default({}) %}{% set multi_lang = tr_locales|length > 0 %}{% set lp = 'lang-' ~ content_locale %}
{% if multi_lang %}{% import '@storefront/admin/_lang_tabs.html.twig' as langs %}{% set done = {} %}{% for l in admin_context_switcher().locales %}{% set done = done|merge({(l.locale_code): ((l.locale_code == content_locale ? category.name|default('') : tr_data[l.locale_code].name|default('')) != '')}) %}{% endfor %}{{ langs.form_bar(store_lang_tabs(done), content_locale, ui_text('admin.lang_tabs.form_hint')) }}{% endif %}
<section class="admin-panel"><h2>{{ ui_text('admin.catalog.category_form.osnovne') }}</h2>
<label data-lang-panel="{{ lp }}"{% if multi_lang %} data-lang-required="name"{% endif %}><span>{{ ui_text('admin.catalog.category_form.nazva') }}</span><input type="text" name="name" data-lang-field="name" maxlength="255" value="{{ category.name|default('') }}" required autofocus></label>{% for l in tr_locales %}{% set tx = tr_data[l.locale_code]|default({}) %}<label data-lang-panel="lang-{{ l.locale_code }}" data-lang-required="tr[{{ l.locale_code }}][name]" hidden><span>{{ ui_text('admin.catalog.category_form.nazva') }}</span><input type="text" name="tr[{{ l.locale_code }}][name]" data-lang-field="name" maxlength="255" value="{{ tx.name|default('') }}" lang="{{ l.locale_code }}"></label>{% endfor %}
<label data-lang-panel="{{ lp }}"><span>SEO URL <small>{{ ui_text('admin.catalog.category_form.neoboviazkovo_pislia_pershoho_stvorennia_ne_zmin') }}</small> {{ help.hint(ui_text('admin.help.cf.slug'), null, null, ui_text('admin.help.cf.slug.ex')) }}</span><input type="text" name="slug" value="{{ category.slug|default('') }}" placeholder="{{ ui_text('ui.admin.catalog.category_form.fuel_pumps')|e('html_attr') }}"></label>{% for l in tr_locales %}<label data-lang-panel="lang-{{ l.locale_code }}" hidden><span>SEO URL</span><input type="text" name="tr[{{ l.locale_code }}][slug]" maxlength="190" value="{{ tr_slugs[l.locale_code]|default('') }}" lang="{{ l.locale_code }}"></label>{% endfor %}
<label><span>{{ ui_text('admin.catalog.category_form.batkivska_katehoriia') }}</span><select name="parent_id"><option value="0">{{ ui_text('admin.catalog.category_form.bez_batkivskoi') }}</option>{% for option in categories %}<option value="{{ option.id }}" {{ category.parent_id|default(0) == option.id ? 'selected' : '' }}>{{ option.name }}</option>{% endfor %}</select></label>
<div class="admin-inline-field"><span>{{ ui_text('admin.icons.field') }}</span>{% include '@storefront/admin/_icon_field.html.twig' with {name: 'icon', value: category.icon|default(''), clearable: true} only %}</div>
<label><span>{{ ui_text('admin.catalog.category_form.poriadok') }} {{ help.hint(ui_text('admin.help.cf.sort'), null, null, ui_text('admin.help.cf.sort.ex')) }}</span><input type="number" name="sort_order" value="{{ category.sort_order|default(0) }}" min="0"></label>
{% if editing %}<label><span>{{ ui_text('admin.catalog.category_form.status') }}</span><select name="status"><option value="active" {{ category.status == 'active' ? 'selected' : '' }}>{{ ui_text('admin.catalog.category_form.aktyvna') }}</option><option value="inactive" {{ category.status == 'inactive' ? 'selected' : '' }}>{{ ui_text('admin.catalog.category_form.vymknena') }}</option></select></label>{% endif %}
<div class="admin-form-wide"><span class="admin-field-label">{{ ui_text('admin.category.image') }}</span><input type="hidden" name="category_image_present" value="1"><div class="admin-media-actions-row"><button type="button" class="admin-button" data-media-pick="single" data-media-target="#category-image-picked">{{ ui_icon('folder-open', 16) }}<span>{{ ui_text('js_media_pick_choose') }}</span></button><small>{{ ui_text('admin.category.image_hint') }}</small></div><div class="admin-media-picked" id="category-image-picked" data-input-name="category_image_id">{% if category.image|default(null) %}<figure><img src="{{ category.image.url }}" alt="{{ category.image.alt }}" loading="lazy"><input type="hidden" name="category_image_id" value="{{ category.image.asset_id }}"><button type="button" data-media-picked-remove aria-label="{{ ui_text('js_media_pick_remove') }}" title="{{ ui_text('js_media_pick_remove') }}">{{ ui_icon('x', 12) }}</button></figure>{% endif %}</div></div>
</section><div data-lang-panel="{{ lp }}">{% include '@storefront/admin/_ai_box.html.twig' with {task:'category_text', label: ui_text('admin.ai.generate_category'), inputs:{name:'[name=name]', current:'[name=description]'}, outputs:{top:'[name=description]', bottom:'[name=description]'}} only %}</div>
<section class="admin-panel"><h2>{{ ui_text('admin.category.texts') }}</h2><p class="admin-help">{{ ui_text('admin.category.texts_hint') }}</p>
<label data-lang-panel="{{ lp }}"><span>{{ ui_text('admin.category.text_single') }}</span><textarea name="description" data-lang-field="description" rows="8" maxlength="100000" data-rich-editor>{{ (category.description|default('')) ~ (category.description_bottom|default('')) }}</textarea><small>{{ ui_text('admin.category.text_single_hint') }}</small></label>{% for l in tr_locales %}{% set tx = tr_data[l.locale_code]|default({}) %}<label data-lang-panel="lang-{{ l.locale_code }}" hidden><span>{{ ui_text('admin.category.text_single') }}</span><textarea name="tr[{{ l.locale_code }}][description]" data-lang-field="description" rows="8" maxlength="100000" data-rich-editor lang="{{ l.locale_code }}">{{ (tx.description|default('')) ~ (tx.description_bottom|default('')) }}</textarea></label>{% endfor %}
</section>
<section class="admin-panel"><h2>{{ ui_text('admin.category.seo') }} {% include '@storefront/admin/_seo_tip.html.twig' %}</h2><p class="admin-help">{{ ui_text('admin.category.seo_hint') }}</p><div class="admin-form-grid">
<label data-lang-panel="{{ lp }}"><span>H1 {{ help.hint(ui_text('admin.help.cf.h1'), null, null, ui_text('admin.help.cf.h1.ex')) }}</span><input type="text" name="h1" data-lang-field="h1" maxlength="255" value="{{ category.h1|default('') }}" placeholder="{{ category.name|default('')|e('html_attr') }}"><small>{{ ui_text('admin.category.h1_hint') }}</small></label>{% for l in tr_locales %}{% set tx = tr_data[l.locale_code]|default({}) %}<label data-lang-panel="lang-{{ l.locale_code }}" hidden><span>H1</span><input type="text" name="tr[{{ l.locale_code }}][h1]" data-lang-field="h1" maxlength="255" value="{{ tx.h1|default('') }}" placeholder="{{ tx.name|default('')|e('html_attr') }}" lang="{{ l.locale_code }}"></label>{% endfor %}
<label data-lang-panel="{{ lp }}"><span>Title {{ help.hint(ui_text('admin.help.cf.title'), null, null, ui_text('admin.help.cf.title.ex')) }}</span><input type="text" name="meta_title" data-lang-field="meta_title" maxlength="255" value="{{ category.meta_title|default('') }}" placeholder="{{ ui_text('admin.category.meta_placeholder')|e('html_attr') }}"><small>{{ ui_text('admin.category.title_hint') }}</small></label>{% for l in tr_locales %}{% set tx = tr_data[l.locale_code]|default({}) %}<label data-lang-panel="lang-{{ l.locale_code }}" hidden><span>Title</span><input type="text" name="tr[{{ l.locale_code }}][meta_title]" data-lang-field="meta_title" maxlength="255" value="{{ tx.meta_title|default('') }}" lang="{{ l.locale_code }}"></label>{% endfor %}
<label class="admin-form-wide" data-lang-panel="{{ lp }}"><span>{{ ui_text('admin.catalog.product_form.meta_description') }} {{ help.hint(ui_text('admin.help.cf.description')) }}</span><textarea name="meta_description" data-lang-field="meta_description" rows="3" maxlength="500" placeholder="{{ ui_text('admin.category.meta_placeholder')|e('html_attr') }}">{{ category.meta_description|default('') }}</textarea><small>{{ ui_text('admin.category.description_hint') }}</small></label>{% for l in tr_locales %}{% set tx = tr_data[l.locale_code]|default({}) %}<label class="admin-form-wide" data-lang-panel="lang-{{ l.locale_code }}" hidden><span>{{ ui_text('admin.catalog.product_form.meta_description') }}</span><textarea name="tr[{{ l.locale_code }}][meta_description]" data-lang-field="meta_description" rows="3" maxlength="500" lang="{{ l.locale_code }}">{{ tx.meta_description|default('') }}</textarea></label>{% endfor %}
{% if editing %}<label class="admin-switch admin-form-wide"><input type="hidden" name="seo_present" value="1"><input type="checkbox" role="switch" name="indexable" value="1"{{ category.indexable|default(1) ? ' checked' : '' }}><span>{{ ui_text('admin.catalog.product_form.indexable') }}</span></label>{% endif %}
</div></section><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ editing ? ui_text('admin.catalog.category_form.zberehty_katehoriiu') : ui_text('admin.catalog.category_form.stvoryty_katehoriiu') }}</button></div></form>
{% include '@storefront/admin/extension/slot.html.twig' with {slot:'admin.category.after_main'} only %}
{{ shell.end() }}
