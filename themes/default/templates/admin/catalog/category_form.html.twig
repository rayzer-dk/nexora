{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{% set editing = category is not null %}
{{ shell.start(editing ? ui_text('admin.catalog.category_form.redahuvaty_katehoriiu') : ui_text('admin.catalog.category_form.nova_katehoriia'),'categories') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.category_form.katehorii') }}</span></nav><h1>{{ editing ? ui_text('admin.catalog.category_form.redahuvaty_katehoriiu') : ui_text('admin.catalog.category_form.nova_katehoriia') }}</h1></div><div class="admin-page-actions">{% if editing %}<a class="admin-button" href="{{ path('admin_catalog_category_translations', {publicId: category.public_id}) }}">{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.translations.title') }}</span></a>{% endif %}<a href="{{ path('admin_catalog_categories') }}">{{ ui_text('admin.catalog.category_form.nazad') }}</a></div></header>
{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% if editing %}{% import '@storefront/admin/_lang_tabs.html.twig' as langs %}{% set lang_tabs = [] %}{% for tab in content_lang_tabs('category', category.public_id) %}{% set lang_tabs = lang_tabs|merge([tab|merge({href: tab.current ? '' : (tab.is_default ? path('admin_catalog_category_edit', {publicId: category.public_id, locale: tab.code}) : path('admin_catalog_category_translations', {publicId: category.public_id}) ~ '#lang-' ~ tab.code)})]) %}{% endfor %}{% if lang_tabs|length > 0 %}<div class="admin-panel admin-panel--tabs">{{ langs.bar(lang_tabs) }}{% if lang_tabs|length > 1 and ai_providers() %}<div class="admin-inline-actions"><small>{{ ui_text('admin.translations.all_hint') }}</small><a class="admin-button" href="{{ path('admin_catalog_category_translations', {publicId: category.public_id}) }}?auto=1">{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.translations.translate_all') }}</span></a></div>{% endif %}</div>{% endif %}{% endif %}
<form class="admin-form" method="post" data-dirty-guard><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><section class="admin-panel"><h2>{{ ui_text('admin.catalog.category_form.osnovne') }}</h2>
<label><span>{{ ui_text('admin.catalog.category_form.nazva') }}</span><input type="text" name="name" maxlength="255" value="{{ category.name|default('') }}" required autofocus></label>
<label><span>SEO URL <small>{{ ui_text('admin.catalog.category_form.neoboviazkovo_pislia_pershoho_stvorennia_ne_zmin') }}</small></span><input type="text" name="slug" value="{{ category.slug|default('') }}" placeholder="{{ ui_text('ui.admin.catalog.category_form.fuel_pumps')|e('html_attr') }}"></label>
<label><span>{{ ui_text('admin.catalog.category_form.batkivska_katehoriia') }}</span><select name="parent_id"><option value="0">{{ ui_text('admin.catalog.category_form.bez_batkivskoi') }}</option>{% for option in categories %}<option value="{{ option.id }}" {{ category.parent_id|default(0) == option.id ? 'selected' : '' }}>{{ option.name }}</option>{% endfor %}</select></label>
<div class="admin-inline-field"><span>{{ ui_text('admin.icons.field') }}</span>{% include '@storefront/admin/_icon_field.html.twig' with {name: 'icon', value: category.icon|default(''), clearable: true} only %}</div>
<label><span>{{ ui_text('admin.catalog.category_form.poriadok') }}</span><input type="number" name="sort_order" value="{{ category.sort_order|default(0) }}" min="0"></label>
{% if editing %}<label><span>{{ ui_text('admin.catalog.category_form.status') }}</span><select name="status"><option value="active" {{ category.status == 'active' ? 'selected' : '' }}>{{ ui_text('admin.catalog.category_form.aktyvna') }}</option><option value="inactive" {{ category.status == 'inactive' ? 'selected' : '' }}>{{ ui_text('admin.catalog.category_form.vymknena') }}</option></select></label>{% endif %}
<div class="admin-form-wide"><span class="admin-field-label">{{ ui_text('admin.category.image') }}</span><input type="hidden" name="category_image_present" value="1"><div class="admin-media-actions-row"><button type="button" class="admin-button" data-media-pick="single" data-media-target="#category-image-picked">{{ ui_icon('folder-open', 16) }}<span>{{ ui_text('js_media_pick_choose') }}</span></button><small>{{ ui_text('admin.category.image_hint') }}</small></div><div class="admin-media-picked" id="category-image-picked" data-input-name="category_image_id">{% if category.image|default(null) %}<figure><img src="{{ category.image.url }}" alt="{{ category.image.alt }}" loading="lazy"><input type="hidden" name="category_image_id" value="{{ category.image.asset_id }}"><button type="button" data-media-picked-remove aria-label="{{ ui_text('js_media_pick_remove') }}" title="{{ ui_text('js_media_pick_remove') }}">{{ ui_icon('x', 12) }}</button></figure>{% endif %}</div></div>
</section>{% include '@storefront/admin/_ai_box.html.twig' with {task:'category_text', label: ui_text('admin.ai.generate_category'), inputs:{name:'[name=name]'}, outputs:{top:'[name=description]'}} only %}
<section class="admin-panel"><h2>{{ ui_text('admin.category.texts') }}</h2><p class="admin-help">{{ ui_text('admin.category.texts_hint') }}</p>
<label><span>{{ ui_text('admin.category.text_single') }}</span><textarea name="description" rows="8" maxlength="100000" data-rich-editor>{{ (category.description|default('')) ~ (category.description_bottom|default('')) }}</textarea><small>{{ ui_text('admin.category.text_single_hint') }}</small></label>
</section>
<section class="admin-panel"><h2>{{ ui_text('admin.category.seo') }}</h2><p class="admin-help">{{ ui_text('admin.category.seo_hint') }}</p><div class="admin-form-grid">
<label><span>H1</span><input type="text" name="h1" maxlength="255" value="{{ category.h1|default('') }}" placeholder="{{ category.name|default('')|e('html_attr') }}"><small>{{ ui_text('admin.category.h1_hint') }}</small></label>
<label><span>Title</span><input type="text" name="meta_title" maxlength="255" value="{{ category.meta_title|default('') }}" placeholder="{{ ui_text('admin.category.meta_placeholder')|e('html_attr') }}"><small>{{ ui_text('admin.category.title_hint') }}</small></label>
<label class="admin-form-wide"><span>Description</span><textarea name="meta_description" rows="3" maxlength="500" placeholder="{{ ui_text('admin.category.meta_placeholder')|e('html_attr') }}">{{ category.meta_description|default('') }}</textarea><small>{{ ui_text('admin.category.description_hint') }}</small></label>
{% if editing %}<label class="admin-switch admin-form-wide"><input type="hidden" name="seo_present" value="1"><input type="checkbox" role="switch" name="indexable" value="1"{{ category.indexable|default(1) ? ' checked' : '' }}><span>{{ ui_text('admin.catalog.product_form.indexable') }}</span></label>{% endif %}
</div></section><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ editing ? ui_text('admin.catalog.category_form.zberehty_katehoriiu') : ui_text('admin.catalog.category_form.stvoryty_katehoriiu') }}</button></div></form>
{% include '@storefront/admin/extension/slot.html.twig' with {slot:'admin.category.after_main'} only %}
{{ shell.end() }}
