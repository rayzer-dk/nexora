{% import '@storefront/admin/_pager.html.twig' as pager %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.categories.katehorii'),'categories') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.categories.kataloh') }}</span></nav><h1>{{ ui_text('admin.catalog.categories.katehorii') }}</h1></div><a class="admin-button is-primary" href="{{ path('admin_catalog_category_new') }}">{{ ui_text('admin.catalog.categories.dodaty_katehoriiu') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<form class="admin-panel admin-category-url" method="post" action="{{ path('admin_catalog_category_url_settings') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_category_url_settings') }}"><label class="admin-check"><input type="checkbox" name="category_path" value="1"{% if category_path_in_url %} checked{% endif %}><span><strong>{{ ui_text('admin.catalog.categories.url_path') }}</strong><small>{{ ui_text('admin.catalog.categories.url_path_hint') }}</small></span></label><button class="admin-button" type="submit">{{ ui_text('admin.catalog.categories.url_save') }}</button></form>
<form class="admin-toolbar" method="get"><label class="admin-search">{{ ui_icon('search', 16) }}<input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.catalog.categories.nazva_katehorii') }}" aria-label="{{ ui_text('admin.catalog.categories.nazva_katehorii') }}"></label><button type="submit" class="admin-button is-primary">{{ ui_text('admin.catalog.categories.poshuk') }}</button>{% if search %}<a class="admin-button is-ghost" href="{{ path('admin_catalog_categories') }}">{{ ui_icon('x', 16) }}{{ ui_text('admin.catalog.categories.skynuty') }}</a>{% endif %}</form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog.categories.katehoriia') }}</th><th>{{ ui_text('admin.catalog.categories.parent') }}</th><th>{{ ui_text('admin.catalog.categories.products') }}</th><th>{{ ui_text('admin.catalog.categories.status') }}</th><th>{{ ui_text('admin.catalog.categories.sortuvannia') }}</th><th class="is-actions" aria-label="{{ ui_text('admin.catalog.categories.dii') }}"></th></tr></thead><tbody>{% for item in result.items %}<tr><td><div class="admin-tree-cell" style="--depth: {{ item.depth|default(0) }}">{% if item.depth|default(0) > 0 %}<span class="admin-tree-cell__branch" aria-hidden="true">{{ ui_icon('corner-down-right', 14) }}</span>{% endif %}<div><strong>{{ item.name }}</strong><small>{{ item.public_id }}</small></div></div></td><td>{{ item.parent_name|default('') ?: '—' }}</td><td>{{ item.product_count|default('—') }}</td><td><span class="admin-badge is-{{ item.status == 'active' ? 'success' : 'muted' }}">{{ item.status == 'active' ? ui_text('admin.catalog.categories.aktyvna') : ui_text('admin.catalog.categories.vymknena') }}</span></td><td>{% if admin_can('catalog.manage') %}<span class="admin-quick-order" data-quick-order data-url="{{ path('admin_catalog_category_quick_order', {publicId:item.public_id}) }}" data-token="{{ csrf_token('admin_category_quick_order') }}"><input type="number" min="0" max="100000" step="1" value="{{ item.sort_order }}" data-original="{{ item.sort_order }}" data-quick-order-input aria-label="{{ ui_text('admin.catalog.categories.sortuvannia') }}"></span>{% else %}{{ item.sort_order }}{% endif %}</td><td class="is-actions"><div class="admin-row-actions"><a class="admin-icon-button is-sm" href="{{ path('admin_catalog_category_edit', {publicId:item.public_id}) }}" title="{{ ui_text('admin.catalog.categories.redahuvaty_katehoriiu') }}" aria-label="{{ ui_text('admin.catalog.categories.redahuvaty_katehoriiu') }}">{{ ui_icon('pencil', 16) }}</a><a class="admin-icon-button is-sm" href="{{ path('admin_catalog_category_translations', {publicId:item.public_id}) }}" title="{{ ui_text('admin.translations.title') }}" aria-label="{{ ui_text('admin.translations.title') }}">{{ ui_icon('languages', 16) }}</a><form method="post" action="{{ path('admin_catalog_category_delete', {publicId:item.public_id}) }}" data-confirm="{{ ui_text('admin.catalog.categories.return_confirm_vydalyty_katehoriiu_katehorii_z_d') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_category_delete_' ~ item.public_id) }}"><button type="submit" class="admin-icon-button is-sm is-danger" title="{{ ui_text('admin.catalog.categories.vydalyty_porozhniu_katehoriiu') }}" aria-label="{{ ui_text('admin.catalog.categories.vydalyty') }}">{{ ui_icon('trash-2', 16) }}</button></form></div></td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.catalog.categories.katehorii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>
{% if not is_tree|default(false) %}{{ pager.render(result.page, result.total, result.limit) }}{% else %}<p class="admin-help">{{ ui_text('admin.catalog.categories.order_hint') }}</p>{% endif %}
{{ shell.end() }}
