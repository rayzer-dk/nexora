{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.categories.katehorii'),'categories') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.catalog.categories.kataloh') }}</small><h1>{{ ui_text('admin.catalog.categories.katehorii') }}</h1></div><a class="admin-primary-link" href="{{ path('admin_catalog_category_new') }}">{{ ui_text('admin.catalog.categories.dodaty_katehoriiu') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<form class="admin-list-toolbar" method="get"><input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.catalog.categories.nazva_katehorii') }}"><button type="submit">{{ ui_text('admin.catalog.categories.poshuk') }}</button>{% if search %}<a href="{{ path('admin_catalog_categories') }}">{{ ui_text('admin.catalog.categories.skynuty') }}</a>{% endif %}</form>
<div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>{{ ui_text('admin.catalog.categories.katehoriia') }}</th><th>{{ ui_text('admin.catalog.categories.batkivska_id') }}</th><th>{{ ui_text('admin.catalog.categories.status') }}</th><th>{{ ui_text('admin.catalog.categories.sortuvannia') }}</th><th aria-label="{{ ui_text('admin.catalog.categories.dii') }}"></th></tr></thead><tbody>{% for item in result.items %}<tr><td><strong>{{ item.name }}</strong><small>{{ item.public_id }}</small></td><td>{{ item.parent_id|default('—') }}</td><td><span class="admin-status">{{ item.status == 'active' ? ui_text('admin.catalog.categories.aktyvna') : ui_text('admin.catalog.categories.vymknena') }}</span></td><td>{{ item.sort_order }}</td><td><div class="admin-row-actions"><a href="{{ path('admin_catalog_category_edit', {publicId:item.public_id}) }}" title="{{ ui_text('admin.catalog.categories.redahuvaty_katehoriiu') }}">{{ ui_text('admin.catalog.categories.redahuvaty') }}</a><form method="post" action="{{ path('admin_catalog_category_delete', {publicId:item.public_id}) }}" onsubmit="{{ ui_text('admin.catalog.categories.return_confirm_vydalyty_katehoriiu_katehorii_z_d') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_category_delete_' ~ item.public_id) }}"><button type="submit" class="admin-link-button is-danger" title="{{ ui_text('admin.catalog.categories.vydalyty_porozhniu_katehoriiu') }}">{{ ui_text('admin.catalog.categories.vydalyty') }}</button></form></div></td></tr>{% else %}<tr><td colspan="5" class="admin-empty">{{ ui_text('admin.catalog.categories.katehorii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>
<div class="admin-list-pagination">{% if result.page > 1 %}<a href="?page={{ result.page - 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}">{{ ui_text('admin.catalog.categories.poperednia') }}</a>{% endif %}<span>{{ ui_text('admin.catalog.categories.storinka') }} {{ result.page }} · {{ result.total }} {{ ui_text('admin.catalog.categories.zapysiv') }}</span>{% if result.page * result.limit < result.total %}<a href="?page={{ result.page + 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}">{{ ui_text('admin.catalog.categories.nastupna') }}</a>{% endif %}</div>
{{ shell.end() }}
