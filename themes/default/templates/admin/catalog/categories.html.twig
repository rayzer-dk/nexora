{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.categories.katehorii'),'categories') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.categories.kataloh') }}</span></nav><h1>{{ ui_text('admin.catalog.categories.katehorii') }}</h1></div><a class="admin-button is-primary" href="{{ path('admin_catalog_category_new') }}">{{ ui_text('admin.catalog.categories.dodaty_katehoriiu') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<form class="admin-toolbar" method="get"><label class="admin-search">{{ ui_icon('search', 16) }}<input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.catalog.categories.nazva_katehorii') }}" aria-label="{{ ui_text('admin.catalog.categories.nazva_katehorii') }}"></label><button type="submit" class="admin-button is-primary">{{ ui_text('admin.catalog.categories.poshuk') }}</button>{% if search %}<a class="admin-button is-ghost" href="{{ path('admin_catalog_categories') }}">{{ ui_icon('x', 16) }}{{ ui_text('admin.catalog.categories.skynuty') }}</a>{% endif %}</form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog.categories.katehoriia') }}</th><th>{{ ui_text('admin.catalog.categories.batkivska_id') }}</th><th>{{ ui_text('admin.catalog.categories.status') }}</th><th>{{ ui_text('admin.catalog.categories.sortuvannia') }}</th><th class="is-actions" aria-label="{{ ui_text('admin.catalog.categories.dii') }}"></th></tr></thead><tbody>{% for item in result.items %}<tr><td><strong>{{ item.name }}</strong><small>{{ item.public_id }}</small></td><td>{{ item.parent_id|default('—') }}</td><td><span class="admin-badge is-{{ item.status == 'active' ? 'success' : 'muted' }}">{{ item.status == 'active' ? ui_text('admin.catalog.categories.aktyvna') : ui_text('admin.catalog.categories.vymknena') }}</span></td><td>{{ item.sort_order }}</td><td class="is-actions"><div class="admin-row-actions"><a class="admin-icon-button is-sm" href="{{ path('admin_catalog_category_edit', {publicId:item.public_id}) }}" title="{{ ui_text('admin.catalog.categories.redahuvaty_katehoriiu') }}" aria-label="{{ ui_text('admin.catalog.categories.redahuvaty_katehoriiu') }}">{{ ui_icon('pencil', 16) }}</a><a class="admin-icon-button is-sm" href="{{ path('admin_catalog_category_translations', {publicId:item.public_id}) }}" title="{{ ui_text('admin.translations.title') }}" aria-label="{{ ui_text('admin.translations.title') }}">{{ ui_icon('languages', 16) }}</a><form method="post" action="{{ path('admin_catalog_category_delete', {publicId:item.public_id}) }}" data-confirm="{{ ui_text('admin.catalog.categories.return_confirm_vydalyty_katehoriiu_katehorii_z_d') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_category_delete_' ~ item.public_id) }}"><button type="submit" class="admin-icon-button is-sm is-danger" title="{{ ui_text('admin.catalog.categories.vydalyty_porozhniu_katehoriiu') }}" aria-label="{{ ui_text('admin.catalog.categories.vydalyty') }}">{{ ui_icon('trash-2', 16) }}</button></form></div></td></tr>{% else %}<tr><td colspan="5" class="admin-empty">{{ ui_text('admin.catalog.categories.katehorii_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>
<div class="admin-pagination">{% if result.page > 1 %}<a class="admin-button is-sm" href="?page={{ result.page - 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}">{{ ui_icon('chevron-left', 16) }}{{ ui_text('admin.catalog.categories.poperednia') }}</a>{% endif %}<span>{{ ui_text('admin.catalog.categories.storinka') }} {{ result.page }} · {{ result.total }} {{ ui_text('admin.catalog.categories.zapysiv') }}</span>{% if result.page * result.limit < result.total %}<a class="admin-button is-sm" href="?page={{ result.page + 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}">{{ ui_text('admin.catalog.categories.nastupna') }}{{ ui_icon('chevron-right', 16) }}</a>{% endif %}</div>
{{ shell.end() }}
