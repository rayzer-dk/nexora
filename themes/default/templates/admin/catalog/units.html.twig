{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.units.title'),'units') }}{% set dim_labels = {'count':ui_text('admin.units.dim_count'),'mass':ui_text('admin.units.dim_mass'),'volume':ui_text('admin.units.dim_volume'),'length':ui_text('admin.units.dim_length'),'area':ui_text('admin.units.dim_area'),'time':ui_text('admin.units.dim_time')} %}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.units.title') }}</span></nav><h1>{{ ui_text('admin.units.title') }}</h1><p>{{ ui_text('admin.units.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.units.new') }}</h2></div>{{ ui_icon('plus', 20) }}</div>
<form method="post" action="{{ path('admin_catalog_units_create') }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_units') }}">
{% for locale in locales %}<label><span>{{ ui_text('admin.units.name') }} ({{ locale }})</span><input type="text" name="name[{{ locale }}]" maxlength="128"></label><label><span>{{ ui_text('admin.units.short') }} ({{ locale }})</span><input type="text" name="short[{{ locale }}]" maxlength="32"></label>{% endfor %}
<label><span>{{ ui_text('admin.units.dimension') }}</span><select name="dimension">{% for d in dimensions %}<option value="{{ d }}">{{ dim_labels[d] }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.units.scale') }}</span><input type="number" name="decimal_scale" min="0" max="6" value="0"><small>{{ ui_text('admin.units.scale_hint') }}</small></label>
<label><span>{{ ui_text('admin.units.code') }}</span><input type="text" name="code" maxlength="32" pattern="[a-z][a-z0-9_]{1,31}" placeholder="bottle"><small>{{ ui_text('admin.units.code_hint') }}</small></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.units.add') }}</button></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.units.list') }}</h2></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.units.name') }}</th><th>{{ ui_text('admin.units.short') }}</th><th>{{ ui_text('admin.units.code') }}</th><th>{{ ui_text('admin.units.dimension') }}</th><th>{{ ui_text('admin.units.status') }}</th><th class="is-actions">{{ ui_text('admin.automation.actions_col') }}</th></tr></thead><tbody>
{% for u in units %}<tr><td>{{ u.name }}{% if not u.builtin %} <span class="admin-badge is-info">{{ ui_text('admin.units.custom') }}</span>{% endif %}</td><td>{{ u.short }}</td><td><code>{{ u.code }}</code></td><td>{{ dim_labels[u.dimension] }}</td><td><span class="admin-badge {{ u.enabled ? 'is-success' : '' }}">{{ u.enabled ? ui_text('admin.tax.on') : ui_text('admin.tax.off') }}</span></td>
<td class="is-actions"><form method="post" action="{{ path('admin_catalog_units_toggle', {code: u.code}) }}" class="admin-inline-actions"><input type="hidden" name="_token" value="{{ csrf_token('admin_units') }}"><input type="hidden" name="enabled" value="{{ u.enabled ? '0' : '1' }}"><button type="submit">{{ u.enabled ? ui_text('admin.units.disable') : ui_text('admin.units.enable') }}</button></form>
{% if not u.builtin %}<form method="post" action="{{ path('admin_catalog_units_delete', {code: u.code}) }}" class="admin-inline-actions"><input type="hidden" name="_token" value="{{ csrf_token('admin_units') }}"><button type="submit" class="is-danger" data-confirm="{{ ui_text('admin.units.confirm_delete') }}">{{ ui_text('admin.fields.delete') }}</button></form>{% endif %}</td></tr>{% endfor %}
</tbody></table></div></section>
{{ shell.end() }}
