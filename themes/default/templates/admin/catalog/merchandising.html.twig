{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.merchandising.merchandaizynh'),'merchandising') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.merchandising.kataloh') }}</span></nav><h1>{{ ui_text('admin.catalog.merchandising.vizualnyi_merchandaizynh') }}</h1><p>{{ ui_text('admin.catalog.merchandising.vyznachaite_poriadok_tovariv_u_katehorii_vruchnu') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}
<section class="admin-panel"><form method="get" class="admin-toolbar"><select name="category" required><option value="">{{ ui_text('admin.catalog.merchandising.oberit_katehoriiu') }}</option>{% for c in categories %}<option value="{{ c.id }}" {% if category_id==c.id %}selected{% endif %}>{{ c.name }}</option>{% endfor %}</select><button type="submit">{{ ui_text('admin.catalog.merchandising.vidkryty') }}</button></form></section>
{% if category_id %}<form method="post" class="admin-panel" data-merch-form><input type="hidden" name="_csrf_token" value="{{ csrf_token('category_merchandising') }}"><input type="hidden" name="category_id" value="{{ category_id }}"><input type="hidden" name="product_order" data-merch-order value="{{ products|map(p=>p.id)|join(',') }}"><div class="admin-panel__header"><div><small>{{ ui_text('admin.catalog.merchandising.poriadok') }}</small><h2>{{ ui_text('admin.catalog.merchandising.tovary_katehorii') }}</h2></div><label>{{ ui_text('admin.catalog.merchandising.avtomatychne_pravylo') }} <select name="mode"><option value="manual" {% if mode=='manual' %}selected{% endif %}>{{ ui_text('admin.catalog.merchandising.ruchnyi_poriadok') }}</option><option value="newest" {% if mode=='newest' %}selected{% endif %}>{{ ui_text('admin.catalog.merchandising.spochatku_novi') }}</option><option value="price_desc" {% if mode=='price_desc' %}selected{% endif %}>{{ ui_text('admin.catalog.merchandising.spochatku_dorozhchi') }}</option><option value="rating" {% if mode=='rating' %}selected{% endif %}>{{ ui_text('admin.catalog.merchandising.spochatku_z_vysokym_reitynhom') }}</option><option value="stock" {% if mode=='stock' %}selected{% endif %}>{{ ui_text('admin.catalog.merchandising.spochatku_v_naiavnosti') }}</option></select></label></div><div class="merch-grid" data-merch-list>{% for p in products %}<article class="merch-card" draggable="true" data-product-id="{{ p.id }}"><span class="merch-handle" title="{{ ui_text('admin.catalog.merchandising.peretiahnit') }}">{{ ui_icon('grip-vertical', 16) }}</span><div><strong>{{ p.name }}</strong><small>{{ p.sku }} · {{ p.status }}</small></div></article>{% else %}<p>{{ ui_text('admin.catalog.merchandising.u_katehorii_nemaie_tovariv') }}</p>{% endfor %}</div><div class="admin-form-actions"><span>{{ ui_text('admin.catalog.merchandising.ruchne_peretiahuvannia_vykorystovuietsia_lyshe_v') }}</span><button class="admin-button is-primary" type="submit">{{ ui_text('admin.catalog.merchandising.zberehty_poriadok') }}</button></div></form>
<script nonce="{{ app.request.attributes.get('_csp_nonce') }}">(()=>{const list=document.querySelector('[data-merch-list]'),input=document.querySelector('[data-merch-order]');if(!list||!input)return;let drag=null;const sync=()=>input.value=[...list.querySelectorAll('[data-product-id]')].map(x=>x.dataset.productId).join(',');list.addEventListener('dragstart',e=>{drag=e.target.closest('[data-product-id]');if(drag)drag.classList.add('is-dragging')});list.addEventListener('dragend',()=>{drag?.classList.remove('is-dragging');drag=null;sync()});list.addEventListener('dragover',e=>{e.preventDefault();if(!drag)return;const over=e.target.closest('[data-product-id]');if(over&&over!==drag){const r=over.getBoundingClientRect();list.insertBefore(drag,e.clientY<r.top+r.height/2?over:over.nextSibling)}});})();</script>{% endif %}
{{ shell.end() }}
