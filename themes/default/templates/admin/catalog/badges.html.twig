{% macro color_field(tones, tone_labels, current) %}{% set is_custom = current starts with '#' %}<div class="admin-tone" data-tone-field><input type="hidden" name="tone" value="{{ is_custom ? 'custom' : current }}" data-tone-value><div class="admin-tone__swatches" role="group" aria-label="{{ ui_text('admin.badges.tone') }}">{% for t in tones %}<button type="button" class="admin-tone__swatch admin-tone__swatch--{{ t }}{{ t == current ? ' is-active' : '' }}" data-tone-preset="{{ t }}" title="{{ tone_labels[t] }}" aria-label="{{ tone_labels[t] }}" aria-pressed="{{ t == current ? 'true' : 'false' }}"></button>{% endfor %}</div><span class="admin-tone__custom"><input type="color" value="{{ is_custom ? current : '#0b63f6' }}" data-tone-picker aria-label="{{ ui_text('admin.color.pick') }}"><input type="text" name="tone_custom" value="{{ is_custom ? current : '' }}" maxlength="7" pattern="#[0-9a-fA-F]{6}" placeholder="#0b63f6" spellcheck="false" autocomplete="off" data-tone-hex aria-label="{{ ui_text('admin.color.hex') }}"></span></div>{% endmacro %}
{% macro label_fields(locales, labels) %}<div class="admin-form-wide admin-label-langs">{% for l in locales %}<label>{{ ui_text('admin.badges.label_text') }} · {{ l.native_name }}<input type="text" name="label[{{ l.code }}]" maxlength="40" value="{{ labels[l.code]|default('') }}"></label>{% endfor %}</div>{% endmacro %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.badges.title'),'badges') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.badges.title') }}</span></nav><h1>{{ ui_text('admin.badges.title') }}</h1><p>{{ ui_text('admin.badges.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% set kind_labels = {new: ui_text('admin.badges.kind_new'), sale: ui_text('admin.badges.kind_sale'), bestseller: ui_text('admin.badges.kind_bestseller'), manual: ui_text('admin.badges.kind_manual')} %}{% set tone_labels = {primary: ui_text('admin.badges.tone_primary'), success: ui_text('admin.badges.tone_success'), danger: ui_text('admin.badges.tone_danger'), warning: ui_text('admin.badges.tone_warning'), info: ui_text('admin.badges.tone_info'), neutral: ui_text('admin.badges.tone_neutral')} %}
{% for rule in rules %}
<section class="admin-panel" data-badge-rule="{{ rule.code }}"><div class="admin-panel__header"><h2>{{ rule.code }} <small>({{ kind_labels[rule.kind] }})</small></h2></div>
<form method="post" action="{{ path('admin_catalog_badge_save') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_badges') }}"><input type="hidden" name="id" value="{{ rule.id }}">
{{ _self.label_fields(locales, rule.labels) }}
<div class="admin-form-wide"><span class="admin-field-label">{{ ui_text('admin.badges.tone') }}</span>{{ _self.color_field(tones, tone_labels, rule.tone) }}</div>
<label>{{ ui_text('admin.badges.priority') }}<input type="number" name="priority" value="{{ rule.priority }}" min="-1000" max="1000"></label>
{% if rule.kind in ['new','bestseller'] %}<label>{{ ui_text('admin.badges.window_days') }}<input type="number" name="window_days" value="{{ rule.window_days }}" min="1" max="3650"></label>{% endif %}
{% if rule.kind == 'bestseller' %}<label>{{ ui_text('admin.badges.min_sold') }}<input type="number" name="min_sold" value="{{ rule.min_sold }}" min="1"></label>{% endif %}
{% if rule.kind == 'manual' %}<label class="admin-form-wide">{{ ui_text('admin.badges.skus') }}<textarea name="skus" rows="3">{{ rule.skus }}</textarea><small>{{ ui_text('admin.badges.skus_hint') }}</small></label>{% endif %}
<label class="admin-check"><input type="checkbox" name="enabled" value="1"{{ rule.enabled ? ' checked' : '' }}> {{ ui_text('admin.badges.enabled') }}</label>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.badges.save') }}</button></div></form>
{% if rule.kind == 'manual' %}<form method="post" action="{{ path('admin_catalog_badge_delete',{id:rule.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_badges') }}"><button class="admin-button is-danger" type="submit">{{ ui_icon('trash-2', 18) }} {{ ui_text('admin.badges.delete') }}</button></form>{% endif %}
</section>
{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.badges.new_manual') }}</h2></div>
<form method="post" action="{{ path('admin_catalog_badge_save') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_badges') }}"><input type="hidden" name="kind" value="manual">
<label>{{ ui_text('admin.badges.code') }}<input type="text" name="code" required pattern="[a-z0-9_-]{1,32}" maxlength="32"></label>
{{ _self.label_fields(locales, {}) }}
<div class="admin-form-wide"><span class="admin-field-label">{{ ui_text('admin.badges.tone') }}</span>{{ _self.color_field(tones, tone_labels, 'primary') }}</div>
<label>{{ ui_text('admin.badges.priority') }}<input type="number" name="priority" value="100"></label>
<label class="admin-form-wide">{{ ui_text('admin.badges.skus') }}<textarea name="skus" rows="2"></textarea><small>{{ ui_text('admin.badges.skus_hint') }}</small></label>
<input type="hidden" name="enabled" value="1"><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('plus', 18) }} {{ ui_text('admin.badges.create') }}</button></div></form></section>
{{ shell.end() }}
