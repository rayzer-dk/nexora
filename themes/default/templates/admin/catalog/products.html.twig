{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.products.tovary'),'products') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.products.kataloh') }}</span></nav><h1>{{ ui_text('admin.catalog.products.tovary') }}</h1><p>{{ ui_text('admin.catalog.products.shvydkyi_spysok_zberezheni_predstavlennia_vlasni') }}</p></div>{% if admin_can('catalog.manage') %}<div class="admin-page-header__actions"><a class="admin-button is-primary" href="{{ path('admin_catalog_product_new') }}">{{ ui_icon('plus', 16) }}{{ ui_text('admin.catalog.products.dodaty_tovar') }}</a></div>{% endif %}</header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('warning') %}<div class="admin-notice is-warning">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel">
<div class="admin-toolbar">
<form method="get" class="admin-toolbar">
<label class="admin-search">{{ ui_icon('search', 16) }}<input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.catalog.products.nazva_abo_sku') }}" aria-label="{{ ui_text('admin.catalog.products.nazva_abo_sku') }}"></label>
<details class="admin-column-picker"><summary>{{ ui_icon('columns-3', 16) }}{{ ui_text('admin.catalog.products.kolonky') }}</summary><div>{% set labels={name:ui_text('admin.catalog.products.tovar'),sku:'SKU',status:ui_text('admin.catalog.products.status'),price:ui_text('admin.catalog.products.tsina'),type:ui_text('admin.catalog.products.typ'),quality:ui_text('admin.catalog.products.yakist')} %}{% for c in allowed_columns %}<label class="admin-check"><input type="checkbox" name="columns[]" value="{{ c }}"{{ c in active_columns ? ' checked' : '' }}> {{ labels[c] }}</label>{% endfor %}</div></details>
<button type="submit" class="admin-button is-primary">{{ ui_text('admin.catalog.products.zastosuvaty') }}</button>{% if search %}<a class="admin-button is-ghost" href="{{ path('admin_catalog_products') }}">{{ ui_icon('x', 16) }}{{ ui_text('admin.catalog.products.skynuty') }}</a>{% endif %}</form>
{% if admin_can('catalog.view') %}<form method="post" action="{{ path('admin_catalog_saved_view_save') }}" class="admin-toolbar admin-toolbar__end"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_saved_view_save') }}"><input type="hidden" name="search" value="{{ search }}">{% for c in active_columns %}<input type="hidden" name="columns[]" value="{{ c }}">{% endfor %}<input type="text" name="name" maxlength="190" required placeholder="{{ ui_text('admin.catalog.products.nazva_predstavlennia') }}" aria-label="{{ ui_text('admin.catalog.products.nazva_predstavlennia') }}"><button type="submit" class="admin-button">{{ ui_icon('bookmark', 16) }}{{ ui_text('admin.catalog.products.zberehty_vyhliad') }}</button></form>{% endif %}
</div>
{% if saved_views %}<div class="admin-view-chips">{% for v in saved_views %}<span><a href="{{ path('admin_catalog_products',{view:v.id,search:v.search}) }}">{{ v.name }}</a>{% if admin_can('catalog.view') %}<form method="post" action="{{ path('admin_catalog_saved_view_delete',{id:v.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_saved_view_delete_' ~ v.id) }}"><button title="{{ ui_text('admin.catalog.products.vydalyty_predstavlennia') }}" aria-label="{{ ui_text('admin.catalog.products.vydalyty_predstavlennia') }}">{{ ui_icon('x',14) }}</button></form>{% endif %}</span>{% endfor %}</div>{% endif %}
</section>
{% if admin_can('catalog.bulk') %}<form method="post" action="{{ path('admin_commerce_products_bulk') }}" class="admin-form">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('products_bulk') }}">
<div class="admin-bulk-actions"><select name="action" required aria-label="{{ ui_text('admin.catalog.products.masova_diia') }}"><option value="">{{ ui_text('admin.catalog.products.masova_diia') }}</option><option value="publish">{{ ui_text('admin.catalog.products.opublikuvaty') }}</option><option value="draft">{{ ui_text('admin.catalog.products.u_chernetky') }}</option><option value="archive">{{ ui_text('admin.catalog.products.arkhivuvaty') }}</option></select><button type="submit" class="admin-button" data-confirm="{{ ui_text('admin.catalog.products.zastosuvaty_diiu_do_vybranykh_tovariv') }}">{{ ui_icon('check', 16) }}{{ ui_text('admin.catalog.products.zastosuvaty') }}</button><button type="submit" formaction="{{ path('admin_catalog_products_bulk_edit') }}" formmethod="post" class="admin-button" formnovalidate>{{ ui_icon('square-pen', 16) }}{{ ui_text('admin.catalog.products.redahuvaty_tablytseiu') }}</button></div>{% endif %}
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{% if admin_can('catalog.bulk') %}<input type="checkbox" data-check-all title="{{ ui_text('admin.catalog.products.vybraty_vsi_na_storintsi') }}" aria-label="{{ ui_text('admin.catalog.products.vybraty_vsi_na_storintsi') }}">{% endif %}</th>{% if 'name' in active_columns %}<th>{{ ui_text('admin.catalog.products.tovar') }}</th>{% endif %}{% if 'sku' in active_columns %}<th>SKU</th>{% endif %}{% if 'status' in active_columns %}<th>{{ ui_text('admin.catalog.products.status') }}</th>{% endif %}{% if 'price' in active_columns %}<th>{{ ui_text('admin.catalog.products.tsina') }}</th>{% endif %}{% if 'type' in active_columns %}<th>{{ ui_text('admin.catalog.products.typ') }}</th>{% endif %}{% if 'quality' in active_columns %}<th>{{ ui_text('admin.catalog.products.yakist') }}</th>{% endif %}<th class="is-actions" aria-label="{{ ui_text('admin.catalog.products.dii') }}"></th></tr></thead><tbody>{% for item in result.items %}<tr>
<td>{% if admin_can('catalog.bulk') %}<input type="checkbox" name="product_ids[]" value="{{ item.public_id }}" data-row-check aria-label="{{ item.name }}">{% endif %}</td>{% if 'name' in active_columns %}<td class="admin-cell-main"><strong>{{ item.name }}</strong><small>{{ item.public_id }}</small></td>{% endif %}{% if 'sku' in active_columns %}<td class="admin-cell-code">{{ item.sku|default('—') }}</td>{% endif %}{% if 'status' in active_columns %}<td><span class="admin-badge is-{{ item.status == 'published' ? 'success' : (item.status == 'archived' ? 'muted' : 'warning') }}">{{ item.status == 'published' ? ui_text('admin.catalog.products.opublikovano') : (item.status == 'archived' ? ui_text('admin.catalog.products.arkhiv') : ui_text('admin.catalog.products.chernetka')) }}</span></td>{% endif %}{% if 'price' in active_columns %}<td class="admin-nowrap">{{ item.price_display }}</td>{% endif %}{% if 'type' in active_columns %}<td class="admin-nowrap">{{ item.product_type == 'digital' ? ui_text('admin.catalog.products.tsyfrovyi') : ui_text('admin.catalog.products.fizychnyi') }}</td>{% endif %}{% if 'quality' in active_columns %}<td><div class="admin-quality" aria-label="{{ ui_text('admin.catalog.products.yakist_kartky_tovaru') }}"><span class="admin-badge is-{{ item.quality.image ? 'success' : 'danger' }}" title="{{ ui_text('admin.catalog.products.foto') }} {{ item.quality.image ? ui_text('admin.catalog.products.ie') : ui_text('admin.catalog.products.vidsutnie') }}">{{ ui_text('admin.catalog.products.foto_2') }}</span><span class="admin-badge is-{{ item.quality.seo ? 'success' : 'danger' }}" title="SEO URL: {{ item.quality.seo ? ui_text('admin.catalog.products.hotovo') : ui_text('admin.catalog.products.potribna_uvaha') }}">SEO</span><span class="admin-badge is-{{ item.quality.gtin ? 'success' : 'warning' }}" title="GTIN: {{ item.quality.gtin ? ui_text('admin.catalog.products.ie') : ui_text('admin.catalog.products.ne_zadano') }}">GTIN</span><span class="admin-badge is-{{ item.quality.content ? 'success' : 'warning' }}" title="{{ ui_text('admin.catalog.products.opys') }} {{ item.quality.content ? ui_text('admin.catalog.products.dostatnii') : ui_text('admin.catalog.products.korotkyi_abo_porozhnii') }}">{{ ui_text('admin.catalog.products.tekst') }}</span></div></td>{% endif %}
<td class="is-actions"><div class="admin-row-actions">{% if admin_can('catalog.manage') %}<a class="admin-icon-button is-sm" href="{{ path('admin_catalog_product_edit', {publicId:item.public_id}) }}" title="{{ ui_text('admin.catalog.products.redahuvaty_tovar') }}" aria-label="{{ ui_text('admin.catalog.products.redahuvaty_tovar') }}">{{ ui_icon('pencil', 16) }}</a>{% endif %}<button type="button" class="admin-icon-button is-sm" data-quick-preview="{{ path('admin_catalog_product_preview',{publicId:item.public_id}) }}" title="{{ ui_text('admin.catalog.products.shvydkyi_preview_tovaru') }}" aria-label="{{ ui_text('admin.catalog.products.shvydkyi_preview_tovaru') }}">{{ ui_icon('eye', 16) }}</button>{% if admin_can('catalog.manage') %}<form method="post" action="{{ path('admin_catalog_product_duplicate', {publicId:item.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_duplicate_' ~ item.public_id) }}"><button type="submit" class="admin-icon-button is-sm" title="{{ ui_text('admin.catalog.products.stvoryty_bezpechnu_kopiiu_tovaru_iak_chernetku') }}" aria-label="{{ ui_text('admin.catalog.products.kopiiuvaty') }}">{{ ui_icon('copy', 16) }}</button></form>{% endif %}{% if admin_can('catalog.delete') %}<form method="post" action="{{ path('admin_catalog_product_delete', {publicId:item.public_id}) }}" data-confirm="{{ ui_text('admin.catalog.products.return_confirm_vydalyty_tovar_tovary_z_istoriiei') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_delete_' ~ item.public_id) }}"><button type="submit" class="admin-icon-button is-sm is-danger" title="{{ ui_text('admin.catalog.products.vydalyty_tovar_iakshcho_vin_ne_vykorystovuietsia') }}" aria-label="{{ ui_text('admin.catalog.products.vydalyty') }}">{{ ui_icon('trash-2', 16) }}</button></form>{% endif %}</div></td>
</tr>{% else %}<tr><td colspan="{{ active_columns|length + 2 }}" class="admin-empty">{{ ui_text('admin.catalog.products.tovariv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>{% if admin_can('catalog.bulk') %}</form>{% endif %}
{% set col_q = '' %}{% for c in active_columns %}{% set col_q = col_q ~ '&columns%5B%5D=' ~ c|url_encode %}{% endfor %}{% set view_q = selected_view ? '&view=' ~ selected_view : '' %}<div class="admin-pagination"><div>{% if result.page > 1 %}<a class="admin-button is-sm" href="?page={{ result.page - 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}{{ view_q }}{{ col_q }}">{{ ui_icon('chevron-left', 16) }}{{ ui_text('admin.catalog.products.poperednia') }}</a>{% endif %}</div><span>{{ ui_text('admin.catalog.products.storinka') }} {{ result.page }} · {{ result.total }} {{ ui_text('admin.catalog.products.zapysiv') }}</span><div>{% if result.page * result.limit < result.total %}<a class="admin-button is-sm" href="?page={{ result.page + 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}{{ view_q }}{{ col_q }}">{{ ui_text('admin.catalog.products.nastupna') }}{{ ui_icon('chevron-right', 16) }}</a>{% endif %}</div></div>
{{ shell.end() }}
