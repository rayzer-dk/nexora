{% import '@storefront/admin/_pager.html.twig' as pager %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.products.tovary'),'products') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.products.kataloh') }}</span></nav><h1>{{ ui_text('admin.catalog.products.tovary') }}</h1><p>{{ ui_text('admin.catalog.products.shvydkyi_spysok_zberezheni_predstavlennia_vlasni') }}</p></div><a class="admin-button" href="{{ path('admin_catalog_quality') }}">{{ ui_icon('shield-check', 16) }}<span>{{ ui_text('admin.catalog_quality.title') }}</span></a>{% if admin_can('catalog.manage') %}<div class="admin-page-header__actions"><a class="admin-button is-primary" href="{{ path('admin_catalog_product_new') }}">{{ ui_icon('plus', 16) }}{{ ui_text('admin.catalog.products.dodaty_tovar') }}</a></div>{% endif %}</header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('warning') %}<div class="admin-notice is-warning">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel">
<div class="admin-toolbar">
<form method="get" class="admin-toolbar">
<label class="admin-search">{{ ui_icon('search', 16) }}<input type="search" name="search" value="{{ search }}" placeholder="{{ ui_text('admin.catalog.products.nazva_abo_sku') }}" aria-label="{{ ui_text('admin.catalog.products.nazva_abo_sku') }}"></label>
{% import '@storefront/admin/_multiselect.html.twig' as ms %}{% set status_opts = [{value:'draft',label:ui_text('admin.catalog.product_form.chernetka')},{value:'published',label:ui_text('admin.catalog.product_form.opublikovano')},{value:'archived',label:ui_text('admin.catalog.product_form.arkhiv')}] %}{% set category_opts = [] %}{% for c in filter_categories %}{% set category_opts = category_opts|merge([{value:c.id,label:c.name}]) %}{% endfor %}{% set brand_opts = [] %}{% for b in filter_brands %}{% set brand_opts = brand_opts|merge([{value:b.id,label:b.name}]) %}{% endfor %}
{{ ms.field('status', ui_text('admin.catalog.products.status'), status_opts, list_filters.status) }}{% if category_opts %}{{ ms.field('category', ui_text('admin.catalog.products.category'), category_opts, list_filters.category) }}{% endif %}{% if brand_opts %}{{ ms.field('brand', ui_text('admin.catalog.product_form.brend'), brand_opts, list_filters.brand) }}{% endif %}
<details class="admin-column-picker"><summary>{{ ui_icon('columns-3', 16) }}{{ ui_text('admin.catalog.products.kolonky') }}</summary><div>{% set labels={name:ui_text('admin.catalog.products.tovar'),sku:'SKU',status:ui_text('admin.catalog.products.status'),price:ui_text('admin.catalog.products.tsina'),type:ui_text('admin.catalog.products.typ'),quality:ui_text('admin.catalog.products.yakist')} %}{% for c in allowed_columns %}<label class="admin-check"><input type="checkbox" name="columns[]" value="{{ c }}"{{ c in active_columns ? ' checked' : '' }}> {{ labels[c] }}</label>{% endfor %}</div></details>
<button type="submit" class="admin-button is-primary">{{ ui_icon('list-filter', 16) }}{{ ui_text('admin.catalog.products.zastosuvaty') }}</button>{% if search %}<a class="admin-button is-ghost" href="{{ path('admin_catalog_products') }}">{{ ui_icon('x', 16) }}{{ ui_text('admin.catalog.products.skynuty') }}</a>{% endif %}</form>
{% if admin_can('catalog.view') %}<details class="admin-save-view admin-save-view--inline"><summary class="admin-button">{{ ui_icon('bookmark', 16) }}{{ ui_text('admin.catalog.products.zberehty_vyhliad') }}</summary><form method="post" action="{{ path('admin_catalog_saved_view_save') }}" class="admin-save-view__form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_saved_view_save') }}"><input type="hidden" name="search" value="{{ search }}">{% for c in active_columns %}<input type="hidden" name="columns[]" value="{{ c }}">{% endfor %}<input type="text" name="name" maxlength="190" required placeholder="{{ ui_text('admin.catalog.products.nazva_predstavlennia') }}" aria-label="{{ ui_text('admin.catalog.products.nazva_predstavlennia') }}"><button type="submit" class="admin-button is-primary">{{ ui_text('admin.common.save') }}</button></form></details>{% endif %}
</div>
{% if saved_views %}<div class="admin-view-chips">{% for v in saved_views %}<span><a href="{{ path('admin_catalog_products',{view:v.id,search:v.search}) }}">{{ v.name }}</a>{% if admin_can('catalog.view') %}<form method="post" action="{{ path('admin_catalog_saved_view_delete',{id:v.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_saved_view_delete_' ~ v.id) }}"><button title="{{ ui_text('admin.catalog.products.vydalyty_predstavlennia') }}" aria-label="{{ ui_text('admin.catalog.products.vydalyty_predstavlennia') }}">{{ ui_icon('x',14) }}</button></form>{% endif %}</span>{% endfor %}</div>{% endif %}
</section>
{% if admin_can('catalog.bulk') %}<form method="post" action="{{ path('admin_commerce_products_bulk') }}" class="admin-form">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('products_bulk') }}">
<div class="admin-bulk-actions"><select name="action" required aria-label="{{ ui_text('admin.catalog.products.masova_diia') }}"><option value="">{{ ui_text('admin.catalog.products.masova_diia') }}</option><option value="publish">{{ ui_text('admin.catalog.products.opublikuvaty') }}</option><option value="draft">{{ ui_text('admin.catalog.products.u_chernetky') }}</option><option value="archive">{{ ui_text('admin.catalog.products.arkhivuvaty') }}</option><option value="duplicate">{{ ui_text('admin.catalog.products.kopiiuvaty') }}</option></select><button type="submit" class="admin-button" data-confirm="{{ ui_text('admin.catalog.products.zastosuvaty_diiu_do_vybranykh_tovariv') }}">{{ ui_icon('check', 16) }}{{ ui_text('admin.catalog.products.zastosuvaty') }}</button><button type="submit" formaction="{{ path('admin_catalog_products_bulk_edit') }}" formmethod="post" class="admin-button" formnovalidate>{{ ui_icon('square-pen', 16) }}{{ ui_text('admin.catalog.products.redahuvaty_tablytseiu') }}</button></div>{% endif %}
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{% if admin_can('catalog.bulk') %}<input type="checkbox" data-check-all title="{{ ui_text('admin.catalog.products.vybraty_vsi_na_storintsi') }}" aria-label="{{ ui_text('admin.catalog.products.vybraty_vsi_na_storintsi') }}">{% endif %}</th>{% if 'name' in active_columns %}<th class="is-thumb" aria-hidden="true"></th><th data-sort-key="name">{{ ui_text('admin.catalog.products.tovar') }}</th>{% endif %}{% if 'sku' in active_columns %}<th data-sort-key="sku">SKU</th>{% endif %}{% if 'status' in active_columns %}<th data-sort-key="status">{{ ui_text('admin.catalog.products.status') }}</th>{% endif %}{% if 'price' in active_columns %}<th data-sort-key="price">{{ ui_text('admin.catalog.products.tsina') }}</th>{% endif %}{% if 'type' in active_columns %}<th data-sort-key="type">{{ ui_text('admin.catalog.products.typ') }}</th>{% endif %}{% if 'quality' in active_columns %}<th>{{ ui_text('admin.catalog.products.yakist') }}</th>{% endif %}<th class="is-actions">{{ ui_text('admin.catalog.products.dii') }}</th></tr></thead><tbody>{% for item in result.items %}<tr>
<td>{% if admin_can('catalog.bulk') %}<input type="checkbox" name="product_ids[]" value="{{ item.public_id }}" data-row-check aria-label="{{ item.name }}">{% endif %}</td>{% if 'name' in active_columns %}<td class="admin-cell-thumb">{% if item.image_key %}<span class="admin-thumb" data-zoom="{{ ('/media/' ~ item.image_key)|media_variant('card') }}"><img src="{{ ('/media/' ~ item.image_key)|media_variant('thumb') }}" alt="" width="40" height="40" loading="lazy"></span>{% else %}<span class="admin-thumb is-empty" aria-hidden="true">{{ ui_icon('image', 16) }}</span>{% endif %}</td><td class="admin-cell-main"><strong title="{{ item.name }}">{{ item.name }}</strong><small>{{ item.public_id }}</small></td>{% endif %}{% if 'sku' in active_columns %}<td class="admin-cell-code">{{ item.sku|default('—') }}</td>{% endif %}{% if 'status' in active_columns %}<td><span class="admin-badge is-{{ item.status == 'published' ? 'success' : (item.status == 'archived' ? 'muted' : 'warning') }}">{{ item.status == 'published' ? ui_text('admin.catalog.products.opublikovano') : (item.status == 'archived' ? ui_text('admin.catalog.products.arkhiv') : ui_text('admin.catalog.products.chernetka')) }}</span>{% if admin_can('catalog.manage') and item.status != 'archived' %} <label class="admin-switch admin-quick-status" data-quick-status data-url="{{ path('admin_catalog_product_quick_status', {publicId:item.public_id}) }}" data-token="{{ csrf_token('admin_quick_status') }}"><input type="checkbox" role="switch" {{ item.status == 'published' ? 'checked' : '' }} aria-label="{{ ui_text('admin.catalog.products.quick_status') }}" title="{{ ui_text('admin.catalog.products.quick_status') }}"></label>{% endif %}</td>{% endif %}{% if 'price' in active_columns %}<td class="admin-nowrap">{% if admin_can('catalog.manage') %}<span class="admin-quick-price" data-quick-price data-url="{{ path('admin_catalog_product_quick_price', {publicId:item.public_id}) }}" data-token="{{ csrf_token('admin_quick_price') }}"><input type="text" inputmode="decimal" form="quick-price-none" value="{{ item.amount_minor is null ? '' : (item.amount_minor / 100)|number_format(2, '.', '') }}" aria-label="{{ ui_text('admin.catalog.products.tsina') }}" data-quick-price-input data-original="{{ item.amount_minor is null ? '' : (item.amount_minor / 100)|number_format(2, '.', '') }}"><small>{{ item.currency|default('') }}</small></span>{% else %}{{ item.price_display }}{% endif %}</td>{% endif %}{% if 'type' in active_columns %}<td class="admin-nowrap">{{ item.product_type == 'digital' ? ui_text('admin.catalog.products.tsyfrovyi') : ui_text('admin.catalog.products.fizychnyi') }}</td>{% endif %}{% if 'quality' in active_columns %}<td><div class="admin-quality" aria-label="{{ ui_text('admin.catalog.products.yakist_kartky_tovaru') }}"><span class="admin-badge is-{{ item.quality.image ? 'success' : 'danger' }}" title="{{ ui_text('admin.catalog.products.foto') }} {{ item.quality.image ? ui_text('admin.catalog.products.ie') : ui_text('admin.catalog.products.vidsutnie') }}">{{ ui_text('admin.catalog.products.foto_2') }}</span><span class="admin-badge is-{{ item.quality.seo ? 'success' : 'danger' }}" title="SEO URL: {{ item.quality.seo ? ui_text('admin.catalog.products.hotovo') : ui_text('admin.catalog.products.potribna_uvaha') }}">SEO</span><span class="admin-badge is-{{ item.quality.gtin ? 'success' : 'warning' }}" title="GTIN: {{ item.quality.gtin ? ui_text('admin.catalog.products.ie') : ui_text('admin.catalog.products.ne_zadano') }}">GTIN</span><span class="admin-badge is-{{ item.quality.content ? 'success' : 'warning' }}" title="{{ ui_text('admin.catalog.products.opys') }} {{ item.quality.content ? ui_text('admin.catalog.products.dostatnii') : ui_text('admin.catalog.products.korotkyi_abo_porozhnii') }}">{{ ui_text('admin.catalog.products.tekst') }}</span></div></td>{% endif %}
<td class="is-actions"><div class="admin-row-actions">{% if admin_can('catalog.manage') %}<a class="admin-icon-button is-sm" href="{{ path('admin_catalog_product_edit', {publicId:item.public_id}) }}" title="{{ ui_text('admin.catalog.products.redahuvaty_tovar') }}" aria-label="{{ ui_text('admin.catalog.products.redahuvaty_tovar') }}">{{ ui_icon('pencil', 16) }}</a><a class="admin-icon-button is-sm" href="{{ path('admin_catalog_product_translations', {publicId:item.public_id}) }}" title="{{ ui_text('admin.translations.title') }}" aria-label="{{ ui_text('admin.translations.title') }}">{{ ui_icon('languages', 16) }}</a>{% endif %}<button type="button" class="admin-icon-button is-sm" data-quick-preview="{{ path('admin_catalog_product_preview',{publicId:item.public_id}) }}" title="{{ ui_text('admin.catalog.products.shvydkyi_preview_tovaru') }}" aria-label="{{ ui_text('admin.catalog.products.shvydkyi_preview_tovaru') }}">{{ ui_icon('eye', 16) }}</button>{% if admin_can('catalog.manage') %}<button type="submit" form="dup-{{ item.public_id }}" class="admin-icon-button is-sm" title="{{ ui_text('admin.catalog.products.stvoryty_bezpechnu_kopiiu_tovaru_iak_chernetku') }}" aria-label="{{ ui_text('admin.catalog.products.kopiiuvaty') }}">{{ ui_icon('copy', 16) }}</button>{% endif %}{% if admin_can('catalog.delete') %}<button type="submit" form="del-{{ item.public_id }}" class="admin-icon-button is-sm is-danger" title="{{ ui_text('admin.catalog.products.vydalyty_tovar_iakshcho_vin_ne_vykorystovuietsia') }}" aria-label="{{ ui_text('admin.catalog.products.vydalyty') }}">{{ ui_icon('trash-2', 16) }}</button>{% endif %}</div></td>
</tr>{% else %}<tr><td colspan="{{ active_columns|length + 4 }}" class="admin-empty">{{ ui_text('admin.catalog.products.tovariv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div>{% if admin_can('catalog.bulk') %}</form>{% endif %}
{% if admin_can('catalog.manage') %}{% for item in result.items %}<form id="dup-{{ item.public_id }}" method="post" action="{{ path('admin_catalog_product_duplicate', {publicId:item.public_id}) }}" hidden><input type="hidden" name="_token" value="{{ csrf_token('admin_product_duplicate_' ~ item.public_id) }}"></form>{% endfor %}{% endif %}{% if admin_can('catalog.delete') %}{% for item in result.items %}<form id="del-{{ item.public_id }}" method="post" action="{{ path('admin_catalog_product_delete', {publicId:item.public_id}) }}" data-confirm="{{ ui_text('admin.catalog.products.return_confirm_vydalyty_tovar_tovary_z_istoriiei') }}" hidden><input type="hidden" name="_token" value="{{ csrf_token('admin_product_delete_' ~ item.public_id) }}"></form>{% endfor %}{% endif %}
{{ pager.render(result.page, result.total, result.limit) }}
{{ shell.end() }}
