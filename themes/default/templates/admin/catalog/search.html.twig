{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.search.poshuk_i_rekomendatsii'),'search') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.search.kataloh') }} {{ locale }}</span></nav><h1>{{ ui_text('admin.catalog.search.poshuk_i_rekomendatsii') }}</h1><p class="admin-list-summary">{{ ui_text('admin.catalog.search.synonimy_ruchni_boosts_ta_tovary_razom_kupuiut_u') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><h2>{{ ui_text('admin.catalog.search.avtomatychni_rekomendatsii') }}</h2><p class="admin-muted">{{ ui_text('admin.catalog.search.manual_tilky_zadani_vruchnu_zviazky_hybrid_ruchn') }}</p><form class="admin-form" method="post" action="{{ path('admin_catalog_recommendation_settings') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_recommendation_settings') }}"><label>{{ ui_text('admin.catalog.search.skhozhi_tovary') }}<select name="related_mode"><option value="manual"{{ recommendation_settings.related_mode=='manual'?' selected':'' }}>{{ ui_text('ui.admin.catalog.search.manual') }}</option><option value="hybrid"{{ recommendation_settings.related_mode=='hybrid'?' selected':'' }}>{{ ui_text('ui.admin.catalog.search.hybrid') }}</option><option value="auto"{{ recommendation_settings.related_mode=='auto'?' selected':'' }}>Auto</option></select></label><label>{{ ui_text('admin.catalog.search.razom_kupuiut') }}<select name="complementary_mode"><option value="manual"{{ recommendation_settings.complementary_mode=='manual'?' selected':'' }}>{{ ui_text('ui.admin.catalog.search.manual') }}</option><option value="hybrid"{{ recommendation_settings.complementary_mode=='hybrid'?' selected':'' }}>{{ ui_text('ui.admin.catalog.search.hybrid') }}</option><option value="auto"{{ recommendation_settings.complementary_mode=='auto'?' selected':'' }}>Auto</option></select></label><label>{{ ui_text('admin.catalog.search.maksymum_avtomatychnykh_tovariv') }}<input type="number" name="auto_limit" min="1" max="8" value="{{ recommendation_settings.auto_limit|default(8) }}"></label><label><input type="checkbox" name="in_stock_only" value="1"{{ recommendation_settings.in_stock_only?' checked':'' }}> {{ ui_text('admin.catalog.search.avtomatychno_rekomenduvaty_tilky_tovary_v_naiavn') }}</label><button type="submit">{{ ui_text('admin.catalog.search.zberehty_nalashtuvannia') }}</button></form></section><div class="admin-split"><section class="admin-panel"><h2>{{ ui_text('admin.catalog.search.nova_hrupa_synonimiv') }}</h2><p class="admin-muted">{{ ui_text('admin.catalog.search.napryklad_motopompa_vodianyi_nasos_nasos_dlia_vo') }}</p><form class="admin-form" method="post" action="{{ path('admin_catalog_search_synonym_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_search_synonym_create') }}"><label>{{ ui_text('admin.catalog.search.nazva') }}<input name="label" maxlength="190" required></label><label>{{ ui_text('admin.catalog.search.synonimy') }}<textarea name="terms" rows="4" required></textarea></label><button type="submit">{{ ui_text('admin.catalog.search.zberehty') }}</button></form></section>
<section class="admin-panel"><h2>{{ ui_text('admin.catalog.search.pidsylyty_tovar_u_poshuku') }}</h2><p class="admin-muted">{{ ui_text('admin.catalog.search.dlia_konkretnoi_frazy_potribnyi_tovar_bude_vyshc') }}</p><form class="admin-form" method="post" action="{{ path('admin_catalog_search_boost_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_search_boost_create') }}"><label>{{ ui_text('admin.catalog.search.poshukova_fraza') }}<input name="query_text" maxlength="190" required placeholder="{{ ui_text('admin.catalog.search.nasos_12v') }}"></label><label>{{ ui_text('admin.catalog.search.sku_tovaru') }}<input name="sku" maxlength="190" required></label><label>{{ ui_text('admin.catalog.search.vaha') }}<input type="number" name="weight" min="1" max="1000" value="100"></label><button type="submit">{{ ui_text('admin.catalog.search.dodaty_boost') }}</button></form></section></div>
<section class="admin-panel"><div><small>{{ ui_text('admin.catalog.search.kerovanyi_slovnyk') }}</small><h2>{{ ui_text('admin.catalog.search.synonimy') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog.search.hrupa') }}</th><th>{{ ui_text('admin.catalog.search.synonimy') }}</th><th>{{ ui_text('admin.catalog.search.status') }}</th><th aria-label="{{ ui_text('admin.catalog.search.dii') }}"></th></tr></thead><tbody>{% for group in groups %}<tr><td><strong>{{ group.label }}</strong></td><td>{{ group.terms|join(', ') }}</td><td><span class="admin-badge is-active">{{ group.status }}</span></td><td><form method="post" action="{{ path('admin_catalog_search_synonym_delete',{id:group.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_search_synonym_delete_' ~ group.id) }}"><button class="admin-icon-button is-danger" title="{{ ui_text('admin.catalog.search.vydalyty') }}" aria-label="{{ ui_text('admin.catalog.search.vydalyty') }}">{{ ui_icon('x',16) }}</button></form></td></tr>{% else %}<tr><td colspan="4" class="admin-empty">{{ ui_text('admin.catalog.search.hrup_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div><form method="post" action="{{ path('admin_catalog_search_synonym_bulk') }}" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_search_synonym_create') }}"><label>{{ ui_text('admin.search.bulk_label') }}<textarea name="pairs" rows="4" placeholder="{{ ui_text('admin.search.bulk_placeholder')|e('html_attr') }}"></textarea><small>{{ ui_text('admin.search.bulk_hint') }}</small></label><div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('plus', 18) }} {{ ui_text('admin.search.bulk_add') }}</button></div></form></section>
<section class="admin-panel"><div><small>{{ ui_text('ui.admin.catalog.search.search_boosts') }}</small><h2>{{ ui_text('admin.catalog.search.ruchni_pidsylennia') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog.search.fraza') }}</th><th>{{ ui_text('admin.catalog.search.tovar') }}</th><th>SKU</th><th>{{ ui_text('admin.catalog.search.vaha') }}</th><th></th></tr></thead><tbody>{% for b in boosts %}<tr><td>{{ b.query_text }}</td><td>{{ b.name }}</td><td>{{ b.sku }}</td><td>{{ b.weight }}</td><td><form method="post" action="{{ path('admin_catalog_search_boost_delete',{id:b.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_search_boost_delete_' ~ b.id) }}"><button class="admin-icon-button is-danger" title="{{ ui_text('admin.catalog.search.vydalyty_boost') }}" aria-label="{{ ui_text('admin.catalog.search.vydalyty_boost') }}">{{ ui_icon('x',16) }}</button></form></td></tr>{% else %}<tr><td colspan="5" class="admin-empty">{{ ui_text('admin.catalog.search.boosts_shche_ne_nalashtovani') }}</td></tr>{% endfor %}</tbody></table></div></section>
<div class="admin-split"><section class="admin-panel"><h2>{{ ui_text('admin.catalog.search.poviazani_ta_suputni_tovary') }}</h2><form class="admin-form" method="post" action="{{ path('admin_catalog_relation_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_relation_create') }}"><label>{{ ui_text('admin.catalog.search.sku_osnovnoho_tovaru') }}<input name="source_sku" required></label><label>{{ ui_text('admin.catalog.search.sku_rekomendovanoho') }}<input name="target_sku" required></label><label>{{ ui_text('admin.catalog.search.typ') }}<select name="relation_type"><option value="complementary">{{ ui_text('admin.catalog.search.razom_kupuiut') }}</option><option value="related">{{ ui_text('admin.catalog.search.skhozhyi_tovar') }}</option></select></label><label>{{ ui_text('admin.catalog.search.poriadok') }}<input type="number" name="sort_order" min="0" max="999" value="100"></label><button type="submit">{{ ui_text('admin.catalog.search.dodaty_rekomendatsiiu') }}</button></form></section><section class="admin-panel"><h2>{{ ui_text('admin.catalog.search.aktyvni_rekomendatsii') }}</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog.search.osnovnyi') }}</th><th>{{ ui_text('admin.catalog.search.rekomenduiemo') }}</th><th>{{ ui_text('admin.catalog.search.typ') }}</th><th></th></tr></thead><tbody>{% for r in relations %}<tr><td>{{ r.product_name }}<small>{{ r.product_sku }}</small></td><td>{{ r.related_name }}<small>{{ r.related_sku }}</small></td><td>{{ r.relation_type=='complementary'?ui_text('admin.catalog.search.razom_kupuiut'):ui_text('admin.catalog.search.skhozhyi') }}</td><td><form method="post" action="{{ path('admin_catalog_relation_delete') }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_relation_delete') }}"><input type="hidden" name="product_id" value="{{ r.product_id }}"><input type="hidden" name="related_product_id" value="{{ r.related_product_id }}"><input type="hidden" name="relation_type" value="{{ r.relation_type }}"><button class="admin-icon-button is-danger" title="{{ ui_text('admin.catalog.search.vydalyty_rekomendatsiiu') }}" aria-label="{{ ui_text('admin.catalog.search.vydalyty_rekomendatsiiu') }}">{{ ui_icon('x',16) }}</button></form></td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.catalog.search.shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section></div>
{{ shell.end() }}
