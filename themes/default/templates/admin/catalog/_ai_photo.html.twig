{% if ai_providers() %}<div class="admin-ai-helper admin-form-wide" data-ai-photo data-ai-photo-token="{{ csrf_token('admin_ai') }}" data-ai-photo-url="{{ path('admin_ai_product_from_photo') }}"><div><strong>{{ ui_icon('camera', 16) }} {{ ui_text('admin.ai.photo_title') }}</strong><small>{{ ui_text('admin.ai.photo_hint') }}</small></div><select data-ai-photo-provider aria-label="{{ ui_text('admin.ai.provider')|e('html_attr') }}">{% for pr in ai_providers() %}{% if not pr.translation_only|default(false) %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endif %}{% endfor %}</select><input type="file"{{ quick|default(false) ? ' hidden' : '' }} accept="image/jpeg,image/png,image/webp" data-ai-photo-file aria-label="{{ ui_text('admin.ai.photo_title')|e('html_attr') }}"><input type="text" maxlength="200" data-ai-photo-hint placeholder="{{ ui_text('admin.ai.photo_hint_field')|e('html_attr') }}"><button type="button" class="admin-button" data-ai-photo-run>{{ ui_icon('sparkles', 16) }} {{ ui_text('admin.ai.photo_run') }}</button><small data-ai-photo-status role="status"></small><pre class="admin-help" data-ai-photo-notes hidden style="white-space:pre-wrap;margin:0"></pre></div>{% endif %}
