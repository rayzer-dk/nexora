{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.metadata.brendy_ta_kharakterystyky'),'metadata') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.catalog.metadata.kataloh') }}</small><h1>{{ ui_text('admin.catalog.metadata.brendy_ta_kharakterystyky') }}</h1><p>{{ ui_text('admin.catalog.metadata.yedyne_mistse_dlia_dovidnykiv_iaki_vykorystovuiu') }}</p></div></header>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.catalog.metadata.brendy') }}</h2><span>{{ brands|length }}</span></div>
<form method="post" action="{{ path('admin_catalog_brand_create') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_metadata_brand_create') }}"><label>{{ ui_text('admin.catalog.metadata.nazva') }}<input type="text" name="name" maxlength="190" required></label><label>{{ ui_text('ui.admin.catalog.metadata.slug') }}<input type="text" name="slug" maxlength="255"></label><label>{{ ui_text('admin.catalog.metadata.sait') }}<input type="url" name="website_url" maxlength="2048"></label><label>{{ ui_text('admin.catalog.metadata.poriadok') }}<input type="number" name="sort_order" value="0"></label><label class="admin-form-grid__wide">{{ ui_text('admin.catalog.metadata.opys') }}<textarea name="description" rows="3" maxlength="20000"></textarea></label><label>{{ ui_text('ui.admin.catalog.metadata.meta_title') }}<input type="text" name="meta_title" maxlength="255"></label><label>{{ ui_text('ui.admin.catalog.metadata.meta_description') }}<input type="text" name="meta_description" maxlength="500"></label><div class="admin-form-grid__wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.catalog.metadata.dodaty_brend') }}</button></div></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog.metadata.nazva') }}</th><th>{{ ui_text('ui.admin.catalog.metadata.slug') }}</th><th>{{ ui_text('admin.catalog.metadata.sait') }}</th><th>{{ ui_text('admin.catalog.metadata.status') }}</th><th>{{ ui_text('admin.catalog.metadata.poriadok') }}</th><th>{{ ui_text('admin.catalog.metadata.seo_opys') }}</th><th>{{ ui_text('admin.catalog.metadata.diia') }}</th></tr></thead><tbody>{% for brand in brands %}<tr><form method="post" action="{{ path('admin_catalog_brand_update',{id:brand.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_metadata_brand_' ~ brand.id) }}"><td><input type="text" name="name" maxlength="190" value="{{ brand.name }}" required></td><td><input type="text" name="slug" maxlength="255" value="{{ brand.slug|default('') }}"></td><td><input type="url" name="website_url" maxlength="2048" value="{{ brand.website_url|default('') }}"></td><td><select name="status"><option value="active"{{ brand.status=='active'?' selected':'' }}>{{ ui_text('admin.catalog.metadata.aktyvnyi') }}</option><option value="disabled"{{ brand.status=='disabled'?' selected':'' }}>{{ ui_text('admin.catalog.metadata.vymknenyi') }}</option></select></td><td><input type="number" name="sort_order" value="{{ brand.sort_order }}"></td><td><details><summary>{{ ui_text('admin.catalog.metadata.redahuvaty') }}</summary><textarea name="description" rows="3" maxlength="20000" placeholder="{{ ui_text('admin.catalog.metadata.opys') }}">{{ brand.description|default('') }}</textarea><input type="text" name="meta_title" maxlength="255" value="{{ brand.meta_title|default('') }}" placeholder="{{ ui_text('ui.admin.catalog.metadata.meta_title')|e('html_attr') }}"><input type="text" name="meta_description" maxlength="500" value="{{ brand.meta_description|default('') }}" placeholder="{{ ui_text('ui.admin.catalog.metadata.meta_description')|e('html_attr') }}"></details></td><td><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.catalog.metadata.zberehty_brend') }}">✓</button></td></form></tr>{% else %}<tr><td colspan="7">{{ ui_text('admin.catalog.metadata.brendiv_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.catalog.metadata.kharakterystyky') }}</h2><span>{{ attributes|length }} · {{ locale }}</span></div>
<form method="post" action="{{ path('admin_catalog_attribute_create') }}" class="admin-form-grid"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_metadata_attribute_create') }}"><label>{{ ui_text('admin.catalog.metadata.kod') }}<input type="text" name="code" maxlength="127" pattern="[a-z][a-z0-9_]{1,126}" required></label><label>{{ ui_text('admin.catalog.metadata.nazva') }}<input type="text" name="name" maxlength="190" required></label><label>{{ ui_text('admin.catalog.metadata.typ') }}<select name="data_type">{% for type in attribute_types %}<option value="{{ type }}">{{ type }}</option>{% endfor %}</select></label><label>{{ ui_text('admin.catalog.metadata.odynytsia') }}<input type="text" name="unit_label" maxlength="64"></label><label>{{ ui_text('admin.catalog.metadata.poriadok') }}<input type="number" name="sort_order" value="0"></label><label><input type="checkbox" name="filterable" value="1"> {{ ui_text('admin.catalog.metadata.vykorystovuvaty_u_filtrakh') }}</label><label><input type="checkbox" name="comparable" value="1"> {{ ui_text('admin.catalog.metadata.pokazuvaty_u_porivnianni') }}</label><div class="admin-form-grid__wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.catalog.metadata.dodaty_kharakterystyku') }}</button></div></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog.metadata.kod') }}</th><th>{{ ui_text('admin.catalog.metadata.nazva') }}</th><th>{{ ui_text('admin.catalog.metadata.typ') }}</th><th>{{ ui_text('admin.catalog.metadata.odynytsia') }}</th><th>{{ ui_text('admin.catalog.metadata.filtr') }}</th><th>{{ ui_text('admin.catalog.metadata.porivniannia') }}</th><th>{{ ui_text('admin.catalog.metadata.vykorystano') }}</th><th>{{ ui_text('admin.catalog.metadata.poriadok') }}</th><th>{{ ui_text('admin.catalog.metadata.dii') }}</th></tr></thead><tbody>{% for a in attributes %}<tr><form method="post" action="{{ path('admin_catalog_attribute_update',{id:a.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_metadata_attribute_' ~ a.id) }}"><td><input type="text" name="code" maxlength="127" value="{{ a.code }}" required></td><td><input type="text" name="name" maxlength="190" value="{{ a.name }}" required></td><td><select name="data_type">{% for type in attribute_types %}<option value="{{ type }}"{{ type==a.data_type?' selected':'' }}>{{ type }}</option>{% endfor %}</select></td><td><input type="text" name="unit_label" maxlength="64" value="{{ a.unit_label|default('') }}"></td><td><input type="checkbox" name="filterable" value="1"{{ a.filterable?' checked':'' }}></td><td><input type="checkbox" name="comparable" value="1"{{ a.comparable?' checked':'' }}></td><td>{{ a.usage_count }}</td><td><input type="number" name="sort_order" value="{{ a.sort_order }}"></td><td><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.catalog.metadata.zberehty_kharakterystyku') }}">✓</button></form>{% if a.usage_count == 0 %}<form method="post" action="{{ path('admin_catalog_attribute_delete',{id:a.id}) }}" onsubmit="{{ ui_text('admin.catalog.metadata.return_confirm_vydalyty_nevykorystanu_kharaktery') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('catalog_metadata_attribute_delete_' ~ a.id) }}"><button class="admin-icon-button" type="submit" title="{{ ui_text('admin.catalog.metadata.vydalyty_kharakterystyku') }}">×</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="9">{{ ui_text('admin.catalog.metadata.kharakterystyk_shche_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
