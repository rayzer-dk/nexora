{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{% set editing = product is not null %}
{{ shell.start(editing ? ui_text('admin.catalog.product_form.redahuvaty_tovar') : ui_text('admin.catalog.product_form.novyi_tovar'),'products') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.product_form.tovary') }}</span></nav><h1>{{ editing ? ui_text('admin.catalog.product_form.redahuvaty_tovar') : ui_text('admin.catalog.product_form.novyi_tovar') }}</h1></div><a href="{{ path('admin_catalog_products') }}">{{ ui_text('admin.catalog.product_form.nazad') }}</a></header>
{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<form class="admin-form" method="post" enctype="multipart/form-data" data-dirty-guard><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
<section class="admin-panel"><h2>{{ ui_text('admin.catalog.product_form.osnovne') }}</h2><div class="admin-form-grid">
<label><span>{{ ui_text('admin.catalog.product_form.nazva') }}</span><input type="text" name="name" maxlength="255" value="{{ product.name|default('') }}" required autofocus></label>
<label><span>SKU</span><input type="text" name="sku" maxlength="190" value="{{ product.sku|default('') }}" required></label>
{% if editing %}<label><span>{{ ui_text('admin.catalog.product_form.typ') }}</span><input type="text" value="{{ product.product_type == 'digital' ? ui_text('admin.catalog.product_form.tsyfrovyi_tovar') : ui_text('admin.catalog.product_form.fizychnyi_tovar') }}" disabled></label>{% else %}<label><span>{{ ui_text('admin.catalog.product_form.typ') }}</span><select name="product_type"><option value="physical">{{ ui_text('admin.catalog.product_form.fizychnyi_tovar') }}</option><option value="digital">{{ ui_text('admin.catalog.product_form.tsyfrovyi_tovar') }}</option></select></label>{% endif %}
<label><span>{{ ui_text('admin.catalog.product_form.brend') }}</span><select name="brand_id"><option value="0">{{ ui_text('admin.catalog.product_form.bez_brendu') }}</option>{% for brand in brands|default([]) %}<option value="{{ brand.id }}" {{ product.brand_id|default(0) == brand.id ? 'selected' : '' }}>{{ brand.name }}</option>{% endfor %}</select></label>
<label><span>SEO URL</span><input type="text" name="slug" value="{{ product.slug|default('') }}" placeholder="{{ ui_text('ui.admin.catalog.product_form.automatic_from_name')|e('html_attr') }}"><small>{{ ui_text('admin.catalog.product_form.nazva_mozhe_zminiuvatysia_bez_zminy_url_vidredah') }}</small></label>
{% if editing %}<label><span>{{ ui_text('admin.catalog.product_form.status') }}</span><select name="status"><option value="draft" {{ product.status == 'draft' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.chernetka') }}</option><option value="published" {{ product.status == 'published' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.opublikovano') }}</option><option value="archived" {{ product.status == 'archived' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.arkhiv') }}</option></select></label>{% endif %}
</div>
<label><span>{{ ui_text('admin.catalog.product_form.korotkyi_opys') }}</span><textarea name="short_description" rows="3">{{ product.short_description|default('') }}</textarea></label>
<label><span>{{ ui_text('admin.catalog.product_form.opys') }}</span><textarea name="description" rows="7" data-rich-editor>{{ product.description|default('') }}</textarea><small>{{ ui_text('admin.catalog.product_form.html_ochyshchaietsia_serverom_pered_zberezhennia') }}</small></label>{% if ai_providers() %}<div class="admin-ai-helper"><input type="hidden" data-ai-token value="{{ csrf_token('admin_ai_product') }}"><div><strong>{{ ui_text('admin.catalog.product_form.ai_pomichnyk') }}</strong><small>{{ ui_text('admin.catalog.product_form.optsionalno_heneruie_lyshe_chernetku_nichoho_ne_') }}</small></div><select data-ai-provider>{% for pr in ai_providers() %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endfor %}</select><button type="button" data-ai-product-draft>{{ ui_text('admin.catalog.product_form.pidhotuvaty_opys') }}</button><span data-ai-status></span></div>{% endif %}</section>
<section class="admin-panel"><h2>{{ ui_text('admin.catalog.product_form.prodazh') }}</h2><div class="admin-form-grid">
<label><span>{{ ui_text('admin.catalog.product_form.tsina') }} {{ currency|default(product.currency|default('UAH')) }}</span><input type="text" inputmode="decimal" name="price" value="{{ product.price_input|default('0.00') }}" required></label>
<label><span>{{ ui_text('admin.catalog.product_form.zalyshok') }}</span><input type="text" inputmode="decimal" name="stock_quantity" value="{{ product.stock_quantity|default('0') }}" {{ editing and product.product_type == 'digital' ? 'disabled' : '' }} required></label>
<label><span>{{ ui_text('admin.catalog.product_form.odynytsia') }}</span><select name="unit_code">{% set unit = product.sale_unit_code|default('item') %}<option value="item" {{ unit == 'item' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.sht') }}</option><option value="pack" {{ unit == 'pack' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.upakovka') }}</option><option value="set" {{ unit == 'set' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.komplekt') }}</option><option value="pair" {{ unit == 'pair' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.para') }}</option><option value="kg" {{ unit == 'kg' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.kh') }}</option><option value="g" {{ unit == 'g' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.h') }}</option><option value="l" {{ unit == 'l' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.l') }}</option><option value="ml" {{ unit == 'ml' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.ml') }}</option><option value="m" {{ unit == 'm' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.m') }}</option><option value="sqm" {{ unit == 'sqm' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.m_2') }}</option></select></label>
<label><span>GTIN</span><input type="text" name="gtin" value="{{ product.gtin|default('') }}"></label><label><span>MPN</span><input type="text" name="mpn" value="{{ product.mpn|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.stan_pokupky') }}</span><select name="purchase_mode">{% set purchase_mode = product.purchase_mode|default('auto') %}<option value="auto" {{ purchase_mode == 'auto' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.avtomatychno_za_zalyshkom') }}</option><option value="in_stock" {{ purchase_mode == 'in_stock' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.kupyty_iakshcho_ie_v_naiavnosti') }}</option><option value="backorder" {{ purchase_mode == 'backorder' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.pid_zamovlennia') }}</option><option value="preorder" {{ purchase_mode == 'preorder' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.peredzamovlennia') }}</option><option value="coming_soon" {{ purchase_mode == 'coming_soon' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.ochikuiemo_nadkhodzhennia') }}</option><option value="notify" {{ purchase_mode == 'notify' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.nemaie_v_naiavnosti_povidomyty') }}</option><option value="sold_out" {{ purchase_mode == 'sold_out' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.prodano') }}</option><option value="price_request" {{ purchase_mode == 'price_request' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.tsina_za_zapytom') }}</option></select><small>{{ ui_text('admin.catalog.product_form.keruie_knopkoiu_ta_dostupnistiu_pokupky_server_v') }}</small></label>
<label><span>{{ ui_text('admin.catalog.product_form.tekst_knopky') }}</span><input type="text" name="purchase_button_label" maxlength="120" value="{{ product.purchase_button_label|default('') }}" placeholder="{{ ui_text('admin.catalog.product_form.avtomatychno') }}"><small>{{ ui_text('admin.catalog.product_form.napryklad_zamovyty_peredzamovyty') }}</small></label>
<label><span>{{ ui_text('admin.catalog.product_form.termin_poiasnennia') }}</span><input type="text" name="purchase_eta_text" maxlength="190" value="{{ product.purchase_eta_text|default('') }}" placeholder="{{ ui_text('admin.catalog.product_form.ochikuiemo_3_5_dniv') }}"><small>{{ ui_text('admin.catalog.product_form.pokazuietsia_poruch_zi_statusom_tovaru') }}</small></label></div></section>

{% if editing and product.product_type == 'digital' %}
<section class="admin-panel" id="digital-files"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.tsyfrovi_faily') }}</h2><small>{{ ui_text('admin.catalog.product_form.faily_zberihaiutsia_poza_public_i_vydaiutsia_lys') }}</small></div></div>
{% if digital_assets|default([]) %}<div class="admin-document-list">{% for asset in digital_assets %}<article><div><strong>{{ asset.title }}</strong><small>{{ asset.original_filename }} · {{ (asset.bytes / 1048576)|round(2) }} MB · {{ asset.download_count|default(0) }}{% if asset.max_downloads %} {{ ui_text('admin.catalog.product_form.do') }} {{ asset.max_downloads }} {{ ui_text('admin.catalog.product_form.zavantazhen') }}{% endif %}{% if asset.access_days %} · {{ asset.access_days }} {{ ui_text('admin.catalog.product_form.dniv') }}{% else %} {{ ui_text('admin.catalog.product_form.bez_stroku') }}{% endif %} · {{ asset.status }}</small></div>{% if asset.status == 'active' %}<form method="post" action="{{ path('admin_catalog_product_digital_deactivate',{publicId:product.public_id,assetPublicId:asset.public_id}) }}"><input type="hidden" name="_digital_token" value="{{ csrf_token('admin_product_digital_' ~ product.public_id) }}"><button class="is-danger" type="submit" data-confirm="{{ ui_text('admin.catalog.product_form.prypynyty_vydachu_tsoho_failu_novym_pokuptsiam_v') }}">{{ ui_text('admin.catalog.product_form.vymknuty') }}</button></form>{% endif %}</article>{% endfor %}</div>{% endif %}
<div class="admin-form-grid admin-form-grid--dense"><label><span>{{ ui_text('admin.catalog.product_form.fail') }}</span><input type="file" name="digital_file"></label><label><span>{{ ui_text('admin.catalog.product_form.nazva') }}</span><input type="text" name="digital_title" maxlength="255" placeholder="{{ ui_text('admin.catalog.product_form.osnovnyi_fail') }}"></label><label><span>{{ ui_text('admin.catalog.product_form.maks_zavantazhen') }}</span><input type="number" name="digital_max_downloads" min="1" max="1000" value="5"></label><label><span>{{ ui_text('admin.catalog.product_form.dniv_dostupu') }}</span><input type="number" name="digital_access_days" min="1" max="3650" value="365"><small>{{ ui_text('admin.catalog.product_form.zalyshte_porozhnim_dlia_bezstrokovoho_dostupu') }}</small></label></div>
<button type="submit" formaction="{{ path('admin_catalog_product_digital_upload',{publicId:product.public_id}) }}" formmethod="post" name="_digital_token" value="{{ csrf_token('admin_product_digital_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.dodaty_tsyfrovyi_fail') }}</button>
</section>
{% endif %}

{% if editing %}
<section class="admin-panel" id="variants"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.varianty_tovaru') }}</h2><small>{{ ui_text('admin.catalog.product_form.dodatkovi_sku_iz_vlasnoiu_tsinoiu_ta_zalyshkom_p') }}</small></div></div>
<div class="admin-variant-stack">
{% for variant in variants|default([]) %}
{% if variant.sort_order == 0 %}
<article class="admin-variant-row is-default"><div><strong>{{ ui_text('admin.catalog.product_form.osnovnyi_variant') }}</strong><small>SKU {{ variant.sku }} {{ ui_text('admin.catalog.product_form.redahuietsia_u_blotsi_prodazh_vyshche') }}</small></div><span class="admin-badge">{{ ui_text('admin.catalog.product_form.osnovnyi') }}</span></article>
{% else %}
<article class="admin-variant-editor">
<div class="admin-form-grid admin-form-grid--dense">
<label><span>SKU</span><input type="text" name="variant[{{ variant.id }}][sku]" value="{{ variant.sku }}" maxlength="190" required></label>
<label><span>{{ ui_text('admin.catalog.product_form.tsina_2') }}</span><input type="text" inputmode="decimal" name="variant[{{ variant.id }}][price]" value="{{ variant.price_input }}" required></label>
<label><span>{{ ui_text('admin.catalog.product_form.zalyshok') }}</span><input type="text" inputmode="decimal" name="variant[{{ variant.id }}][stock_quantity]" value="{{ variant.stock_quantity }}" required></label>
<label><span>{{ ui_text('admin.catalog.product_form.odynytsia') }}</span><select name="variant[{{ variant.id }}][unit_code]">{% for code,label in {'item':ui_text('admin.catalog.product_form.sht'),'pack':ui_text('admin.catalog.product_form.upakovka'),'set':ui_text('admin.catalog.product_form.komplekt'),'pair':ui_text('admin.catalog.product_form.para'),'kg':ui_text('admin.catalog.product_form.kh'),'g':ui_text('admin.catalog.product_form.h'),'l':ui_text('admin.catalog.product_form.l'),'ml':ui_text('admin.catalog.product_form.ml'),'m':ui_text('admin.catalog.product_form.m'),'sqm':ui_text('admin.catalog.product_form.m_2')} %}<option value="{{ code }}" {{ variant.sale_unit_code == code ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label><span>GTIN</span><input type="text" name="variant[{{ variant.id }}][gtin]" value="{{ variant.gtin|default('') }}"></label>
<label><span>MPN</span><input type="text" name="variant[{{ variant.id }}][mpn]" value="{{ variant.mpn|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.status') }}</span><select name="variant[{{ variant.id }}][status]"><option value="active" {{ variant.status == 'active' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.aktyvnyi') }}</option><option value="disabled" {{ variant.status == 'disabled' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.vymknenyi') }}</option></select></label>
<label><span>{{ ui_text('admin.catalog.product_form.vaha_kh') }}</span><input type="text" inputmode="decimal" name="variant[{{ variant.id }}][weight_kg]" value="{{ variant.weight_kg|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.dovzhyna_mm') }}</span><input type="number" min="0" name="variant[{{ variant.id }}][length_mm]" value="{{ variant.length_mm|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.shyryna_mm') }}</span><input type="number" min="0" name="variant[{{ variant.id }}][width_mm]" value="{{ variant.width_mm|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.vysota_mm') }}</span><input type="number" min="0" name="variant[{{ variant.id }}][height_mm]" value="{{ variant.height_mm|default('') }}"></label>
</div>
<div class="admin-inline-actions"><button type="submit" formaction="{{ path('admin_catalog_product_variant_update', {publicId: product.public_id, variantId: variant.id}) }}" formmethod="post" name="_variant_token" value="{{ csrf_token('admin_product_variants_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.zberehty_variant') }}</button><button class="is-danger" type="submit" formaction="{{ path('admin_catalog_product_variant_delete', {publicId: product.public_id, variantId: variant.id}) }}" formmethod="post" name="_variant_token" value="{{ csrf_token('admin_product_variants_' ~ product.public_id) }}" data-confirm="{{ ui_text('admin.catalog.product_form.vydalyty_tsei_variant_varianty_z_istoriieiu_zamo') }}">{{ ui_text('admin.catalog.product_form.vydalyty') }}</button></div>
</article>
{% endif %}
{% endfor %}
</div>
<details class="admin-inline-create"><summary>{{ ui_text('admin.catalog.product_form.dodaty_variant') }}</summary><div class="admin-form-grid admin-form-grid--dense">
<label><span>SKU</span><input type="text" name="new_variant[sku]" maxlength="190"></label>
<label><span>{{ ui_text('admin.catalog.product_form.tsina_2') }}</span><input type="text" inputmode="decimal" name="new_variant[price]" value="0.00"></label>
<label><span>{{ ui_text('admin.catalog.product_form.zalyshok') }}</span><input type="text" inputmode="decimal" name="new_variant[stock_quantity]" value="0"></label>
<label><span>{{ ui_text('admin.catalog.product_form.odynytsia') }}</span><select name="new_variant[unit_code]"><option value="item">{{ ui_text('admin.catalog.product_form.sht') }}</option><option value="pack">{{ ui_text('admin.catalog.product_form.upakovka') }}</option><option value="set">{{ ui_text('admin.catalog.product_form.komplekt') }}</option><option value="pair">{{ ui_text('admin.catalog.product_form.para') }}</option><option value="kg">{{ ui_text('admin.catalog.product_form.kh') }}</option><option value="g">{{ ui_text('admin.catalog.product_form.h') }}</option><option value="l">{{ ui_text('admin.catalog.product_form.l') }}</option><option value="ml">{{ ui_text('admin.catalog.product_form.ml') }}</option><option value="m">{{ ui_text('admin.catalog.product_form.m') }}</option><option value="sqm">{{ ui_text('admin.catalog.product_form.m_2') }}</option></select></label>
<label><span>GTIN</span><input type="text" name="new_variant[gtin]"></label><label><span>MPN</span><input type="text" name="new_variant[mpn]"></label>
<label><span>{{ ui_text('admin.catalog.product_form.vaha_kh') }}</span><input type="text" inputmode="decimal" name="new_variant[weight_kg]"></label><label><span>{{ ui_text('admin.catalog.product_form.dovzhyna_mm') }}</span><input type="number" min="0" name="new_variant[length_mm]"></label><label><span>{{ ui_text('admin.catalog.product_form.shyryna_mm') }}</span><input type="number" min="0" name="new_variant[width_mm]"></label><label><span>{{ ui_text('admin.catalog.product_form.vysota_mm') }}</span><input type="number" min="0" name="new_variant[height_mm]"></label>
</div><button type="submit" formaction="{{ path('admin_catalog_product_variant_create', {publicId: product.public_id}) }}" formmethod="post" name="_variant_token" value="{{ csrf_token('admin_product_variants_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.dodaty_variant') }}</button></details>
</section>

<section class="admin-panel" id="attributes"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.kharakterystyky') }}</h2><small>{{ ui_text('admin.catalog.product_form.typizovani_znachennia_zberihaiutsia_okremo_vid_o') }}</small></div></div>
{% if attributes|default([]) %}<div class="admin-form-grid">{% for attribute in attributes %}<label><span>{{ attribute.name }}{% if attribute.unit_label %}, {{ attribute.unit_label }}{% endif %}</span>{% if attribute.data_type in ['boolean','bool'] %}<select name="attribute[{{ attribute.id }}]"><option value="">—</option><option value="1" {{ attribute.value == '1' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.tak') }}</option><option value="0" {{ attribute.value == '0' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.ni') }}</option></select>{% else %}<input type="text" name="attribute[{{ attribute.id }}]" value="{{ attribute.value }}"{% if attribute.data_type in ['decimal','number'] %} inputmode="decimal"{% endif %}>{% endif %}<small>{{ attribute.code }}</small></label>{% endfor %}</div><button type="submit" formaction="{{ path('admin_catalog_product_attributes_update', {publicId: product.public_id}) }}" formmethod="post" name="_attributes_token" value="{{ csrf_token('admin_product_attributes_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.zberehty_kharakterystyky') }}</button>{% else %}<p class="admin-muted">{{ ui_text('admin.catalog.product_form.u_dovidnyku_shche_nemaie_kharakterystyk_tovar_mo') }}</p>{% endif %}
</section>

<section class="admin-panel" id="documents"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.dokumenty') }}</h2><small>{{ ui_text('admin.catalog.product_form.instruktsii_sertyfikaty_sds_ta_tekhnichni_faily_') }}</small></div></div>
{% if documents|default([]) %}<div class="admin-document-list">{% for document in documents %}<article><div><strong>{{ document.title }}</strong><small>{{ document.document_type }}{% if document.locale %} · {{ document.locale }}{% endif %} · {{ (document.bytes / 1024)|round }} KB</small></div><div class="admin-inline-actions"><a href="{{ document.url }}" target="_blank" rel="noopener">{{ ui_text('admin.catalog.product_form.vidkryty') }}</a><button class="is-danger" type="submit" formaction="{{ path('admin_catalog_product_document_remove', {publicId: product.public_id, documentPublicId: document.public_id}) }}" formmethod="post" name="_document_token" value="{{ csrf_token('admin_product_documents_' ~ product.public_id) }}" data-confirm="{{ ui_text('admin.catalog.product_form.vidviazaty_dokument_vid_tovaru') }}">{{ ui_text('admin.catalog.product_form.vydalyty') }}</button></div></article>{% endfor %}</div>{% endif %}
<div class="admin-form-grid admin-form-grid--dense"><label><span>{{ ui_text('admin.catalog.product_form.fail_pdf_txt') }}</span><input type="file" name="document_file" accept="application/pdf,text/plain"></label><label><span>{{ ui_text('admin.catalog.product_form.nazva') }}</span><input type="text" name="document_title" maxlength="255"></label><label><span>{{ ui_text('admin.catalog.product_form.typ') }}</span><select name="document_type"><option value="document">{{ ui_text('admin.catalog.product_form.dokument') }}</option><option value="manual">{{ ui_text('admin.catalog.product_form.instruktsiia') }}</option><option value="certificate">{{ ui_text('admin.catalog.product_form.sertyfikat') }}</option><option value="sds">SDS</option><option value="datasheet">{{ ui_text('admin.catalog.product_form.tekhnichnyi_opys') }}</option><option value="warranty">{{ ui_text('admin.catalog.product_form.harantiia') }}</option></select></label><label><span>{{ ui_text('admin.catalog.product_form.mova') }}</span><select name="document_locale"><option value="">{{ ui_text('admin.catalog.product_form.dlia_vsikh_mov') }}</option>{% for locale in locales|default([]) %}<option value="{{ locale.code }}">{{ locale.name }} ({{ locale.code }})</option>{% endfor %}</select></label><label><span>{{ ui_text('admin.catalog.product_form.poriadok') }}</span><input type="number" min="0" max="65535" name="document_sort" value="100"></label></div><button type="submit" formaction="{{ path('admin_catalog_product_document_upload', {publicId: product.public_id}) }}" formmethod="post" name="_document_token" value="{{ csrf_token('admin_product_documents_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.dodaty_dokument') }}</button>
</section>
{% endif %}

<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.zobrazhennia') }}</h2><small>{{ ui_text('admin.catalog.product_form.oryhinal_pereviriaietsia_pislia_choho_avtomatych') }}</small></div></div>
<label class="admin-media-dropzone" data-media-dropzone><input type="file" name="images[]" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-image-upload><span><strong>{{ ui_text('admin.catalog.product_form.dodaty_foto') }}</strong><small>{{ ui_text('admin.catalog.product_form.jpeg_png_webp_abo_avif_do_20_mb_mozhna_vybraty_k') }}</small></span></label>
<div class="admin-media-preview" data-image-preview></div>
{% if images|default([]) %}<div class="admin-media-grid">{% for image in images %}<article class="admin-media-item {{ image.role == 'primary' ? 'is-primary' : '' }}"><img src="{{ image.url }}" alt="{{ image.alt_text ?: product.name }}" loading="lazy" style="object-position:{{ (image.focal_point.x|default(0.5) * 100)|round }}% {{ (image.focal_point.y|default(0.5) * 100)|round }}%"><div><strong>{{ image.role == 'primary' ? ui_text('admin.catalog.product_form.holovne') : ui_text('admin.catalog.product_form.halereia') }}</strong><small>{{ image.width }}×{{ image.height }}</small></div><details class="admin-media-meta"><summary>{{ ui_text('admin.catalog.product_form.parametry') }}</summary><label>ALT<input type="text" name="media_alt[{{ image.id }}]" value="{{ image.alt_text }}" maxlength="500"></label><div><label>{{ ui_text('admin.catalog.product_form.poriadok') }}<input type="number" min="0" max="100000" name="media_sort[{{ image.id }}]" value="{{ image.sort_order }}"></label><label>{{ ui_text('admin.catalog.product_form.fokus_x') }}<input type="number" min="0" max="1" step="0.01" name="media_focal_x[{{ image.id }}]" value="{{ image.focal_point.x|default(0.5) }}"></label><label>{{ ui_text('admin.catalog.product_form.fokus_y') }}<input type="number" min="0" max="1" step="0.01" name="media_focal_y[{{ image.id }}]" value="{{ image.focal_point.y|default(0.5) }}"></label></div></details><div class="admin-media-actions">{% if image.role != 'primary' %}<button type="submit" formaction="{{ path('admin_catalog_product_media_primary', {publicId: product.public_id, assetId: image.id}) }}" formmethod="post" name="_media_token" value="{{ csrf_token('admin_product_media_' ~ product.public_id) }}" title="{{ ui_text('admin.catalog.product_form.zrobyty_holovnym') }}">{{ ui_text('admin.catalog.product_form.holovne') }}</button>{% endif %}<button class="is-danger" type="submit" formaction="{{ path('admin_catalog_product_media_remove', {publicId: product.public_id, assetId: image.id}) }}" formmethod="post" name="_media_token" value="{{ csrf_token('admin_product_media_' ~ product.public_id) }}" data-confirm="{{ ui_text('admin.catalog.product_form.vidviazaty_tse_zobrazhennia_vid_tovaru') }}" title="{{ ui_text('admin.catalog.product_form.vydalyty_z_halerei') }}">{{ ui_text('admin.catalog.product_form.vydalyty') }}</button></div></article>{% endfor %}</div>{% endif %}</section>
<section class="admin-panel"><h2>{{ ui_text('admin.catalog.product_form.katehorii') }}</h2><div class="admin-check-grid">{% set selected_categories = product.category_ids|default([]) %}{% for category in categories %}<label><input type="checkbox" name="category_ids[]" value="{{ category.id }}" {{ category.id in selected_categories ? 'checked' : '' }}><span>{{ category.name }}</span></label>{% else %}<p>{{ ui_text('admin.catalog.product_form.spochatku_stvorit_katehoriiu_abo_zberezhit_tovar') }}</p>{% endfor %}</div></section>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ editing ? ui_text('admin.catalog.product_form.zberehty_tovar') : ui_text('admin.catalog.product_form.stvoryty_chernetku') }}</button></div></form>
{% if editing and custom_definitions|default([]) %}<section class="admin-panel" id="custom-fields"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.fields.product_panel') }}</h2><small>{{ ui_text('admin.fields.product_panel_hint') }}</small></div><a class="admin-button" href="/admin/catalog/fields">{{ ui_icon('settings', 16) }}<span>{{ ui_text('admin.fields.manage') }}</span></a></div>
<form method="post" action="{{ path('admin_catalog_product_fields_save', {publicId: product.public_id}) }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_fields_' ~ product.public_id) }}">
{% for d in custom_definitions %}<label><span>{{ d.label }}</span><input type="{{ d.field_type == 'number' ? 'text' : (d.field_type == 'date' ? 'date' : (d.field_type == 'url' ? 'url' : 'text')) }}" name="field[{{ d.id }}]" maxlength="2000" value="{{ custom_values[d.id]|default('') }}"></label>{% endfor %}
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.fields.save_values') }}</button></div></form></section>{% endif %}
{% include '@storefront/admin/extension/slot.html.twig' with {slot:'admin.product.after_main'} only %}
{{ shell.end() }}
