{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{% set editing = product is not null %}
{{ shell.start(editing ? ui_text('admin.catalog.product_form.redahuvaty_tovar') : ui_text('admin.catalog.product_form.novyi_tovar'),'products') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog.product_form.tovary') }}</span></nav><h1>{{ editing ? ui_text('admin.catalog.product_form.redahuvaty_tovar') : ui_text('admin.catalog.product_form.novyi_tovar') }}</h1></div><div class="admin-page-actions"><button class="admin-button is-primary" type="submit" form="product-form">{{ ui_icon('save', 16) }}<span>{{ editing ? ui_text('admin.catalog.product_form.zberehty_tovar') : ui_text('admin.catalog.product_form.stvoryty_chernetku') }}</span></button>{% if editing %}<a class="admin-button" href="{{ path('admin_catalog_product_translations', {publicId: product.public_id}) }}">{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.translations.title') }}</span></a>{% endif %}<a href="{{ path('admin_catalog_products') }}">{{ ui_text('admin.catalog.product_form.nazad') }}</a></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}
{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
{% if editing %}{% import '@storefront/admin/_lang_tabs.html.twig' as langs %}{% set lang_tabs = [] %}{% for tab in content_lang_tabs('product', product.public_id) %}{% set lang_tabs = lang_tabs|merge([tab|merge({href: tab.current ? '' : (tab.is_default ? path('admin_catalog_product_edit', {publicId: product.public_id, locale: tab.code}) : path('admin_catalog_product_translations', {publicId: product.public_id}) ~ '#lang-' ~ tab.code)})]) %}{% endfor %}{% if lang_tabs|length > 0 %}<div class="admin-panel admin-panel--tabs">{{ langs.bar(lang_tabs) }}{% if lang_tabs|length > 1 and ai_providers() %}<div class="admin-inline-actions"><small>{{ ui_text('admin.translations.all_hint') }}</small><a class="admin-button" href="{{ path('admin_catalog_product_translations', {publicId: product.public_id}) }}?auto=1">{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.translations.translate_all') }}</span></a></div>{% endif %}</div>{% endif %}{% endif %}
<form class="admin-form" id="product-form" method="post" enctype="multipart/form-data" data-dirty-guard data-default-submit="[data-primary-submit]" data-product-tabs='{{ {general: ui_text('admin.product.tabs.general'), sales: ui_text('admin.product.tabs.sales'), media: ui_text('admin.product.tabs.media'), details: ui_text('admin.product.tabs.details'), files: ui_text('admin.product.tabs.files'), seo: ui_text('admin.product.tabs.seo')}|json_encode|e('html_attr') }}'><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
{% set content_locale = admin_context_switcher().current.locale|default('') %}<p class="admin-help admin-locale-note">{{ ui_icon('languages', 18) }}<span>{{ ui_text('admin.product.locale_note', {locale: content_locale}) }}</span></p>
<section class="admin-panel" data-product-tab="general"><h2>{{ ui_text('admin.catalog.product_form.osnovne') }}</h2><div class="admin-form-grid">
<label><span>{{ ui_text('admin.catalog.product_form.nazva') }}</span><input type="text" name="name" maxlength="255" value="{{ product.name|default('') }}" required autofocus></label>
<label class="admin-sku-field"><span>{{ ui_text('admin.catalog.product_form.sku_code') }}</span><span class="admin-sku-field__row"><input type="text" name="sku" maxlength="190" value="{{ product.sku|default('') }}"{% if editing or not sku_template %} required{% endif %}{% if not editing and sku_template %} placeholder="{{ sku_template|e('html_attr') }}"{% endif %}><button class="admin-icon-button" type="button" data-sku-generate data-url="{{ path('admin_catalog_sku_next') }}" data-token="{{ csrf_token('admin_sku') }}" title="{{ ui_text('admin.catalog.product_form.sku_generate') }}" aria-label="{{ ui_text('admin.catalog.product_form.sku_generate') }}">{{ ui_icon('wand-sparkles', 16) }}</button><input class="admin-sku-template" type="text" data-sku-template maxlength="60" value="{{ sku_template|default('') }}" placeholder="GTR-###" title="{{ ui_text('admin.catalog.product_form.sku_template_hint') }}" aria-label="{{ ui_text('admin.catalog.product_form.sku_template_hint') }}"></span><small>{{ ui_text('admin.catalog.product_form.sku_template_hint') }}</small></label>
<label><span>{{ ui_text('admin.catalog.product_form.typ') }}</span><select name="product_type" data-product-type><option value="physical"{{ editing and product.product_type == 'digital' ? '' : ' selected' }}>{{ ui_text('admin.catalog.product_form.fizychnyi_tovar') }}</option><option value="digital"{{ editing and product.product_type == 'digital' ? ' selected' : '' }}>{{ ui_text('admin.catalog.product_form.tsyfrovyi_tovar') }}</option></select>{% if editing %}<small>{{ ui_text('admin.catalog.product_form.type_change_hint') }}</small>{% endif %}</label>
<label><span>{{ ui_text('admin.catalog.product_form.brend') }}</span><select name="brand_id"><option value="0">{{ ui_text('admin.catalog.product_form.bez_brendu') }}</option>{% for brand in brands|default([]) %}<option value="{{ brand.id }}" {{ product.brand_id|default(0) == brand.id ? 'selected' : '' }}>{{ brand.name }}</option>{% endfor %}</select></label>

{% if editing %}<label><span>{{ ui_text('admin.catalog.product_form.status') }}</span><select name="status"><option value="draft" {{ product.status == 'draft' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.chernetka') }}</option><option value="published" {{ product.status == 'published' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.opublikovano') }}</option><option value="archived" {{ product.status == 'archived' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.arkhiv') }}</option></select></label>{% endif %}
</div>
<details class="admin-more"><summary>{{ ui_text('admin.product.more') }}</summary><div class="admin-form-grid"><label><span>SEO URL</span><input type="text" name="slug" value="{{ product.slug|default('') }}" placeholder="{{ ui_text('ui.admin.catalog.product_form.automatic_from_name')|e('html_attr') }}"><small>{{ ui_text('admin.catalog.product_form.nazva_mozhe_zminiuvatysia_bez_zminy_url_vidredah') }}</small></label></div></details>
<label><span>{{ ui_text('admin.catalog.product_form.korotkyi_opys') }}</span><textarea name="short_description" rows="3">{{ product.short_description|default('') }}</textarea></label>
<label><span>{{ ui_text('admin.catalog.product_form.opys') }}</span><textarea name="description" rows="7" data-rich-editor>{{ product.description|default('') }}</textarea><small>{{ ui_text('admin.catalog.product_form.html_ochyshchaietsia_serverom_pered_zberezhennia') }}</small></label>{% if ai_providers() %}<div class="admin-ai-helper"><input type="hidden" data-ai-token value="{{ csrf_token('admin_ai_product') }}"><div><strong>{{ ui_text('admin.catalog.product_form.ai_pomichnyk') }}</strong><small>{{ ui_text('admin.catalog.product_form.optsionalno_heneruie_lyshe_chernetku_nichoho_ne_') }}</small></div><select data-ai-provider>{% for pr in ai_providers() %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endfor %}</select><button type="button" data-ai-product-draft>{{ ui_text('admin.catalog.product_form.pidhotuvaty_opys') }}</button><span data-ai-status></span></div>{% endif %}</section>
<section class="admin-panel" data-product-tab="seo"><h2>{{ ui_text('admin.catalog.product_form.seo_block') }} {% include '@storefront/admin/_seo_tip.html.twig' %}</h2><p class="admin-help">{{ ui_text('admin.catalog.product_form.seo_block_hint') }}</p><div class="admin-form-grid">
<label><span>{{ ui_text('admin.catalog.product_form.h1') }}</span><input type="text" name="h1" maxlength="255" value="{{ product.h1|default('') }}" placeholder="{{ product.name|default('')|e('html_attr') }}"><small>{{ ui_text('admin.catalog.product_form.h1_hint') }}</small></label>
<label><span>{{ ui_text('admin.catalog.product_form.meta_title') }}</span><input type="text" name="meta_title" maxlength="255" value="{{ product.meta_title|default('') }}" placeholder="{{ ui_text('admin.catalog.product_form.meta_title_placeholder')|e('html_attr') }}"><small>{{ ui_text('admin.catalog.product_form.meta_title_hint') }}</small></label>
<label class="admin-switch admin-form-wide"><input type="hidden" name="seo_present" value="1"><input type="checkbox" role="switch" name="indexable" value="1"{{ product.indexable|default(1) ? ' checked' : '' }}><span>{{ ui_text('admin.catalog.product_form.indexable') }}</span></label>
<small class="admin-form-wide">{{ ui_text('admin.catalog.product_form.indexable_hint') }}</small>
<label class="admin-form-wide"><span>{{ ui_text('admin.catalog.product_form.meta_description') }}</span><textarea name="meta_description" rows="2" maxlength="500" placeholder="{{ ui_text('admin.catalog.product_form.meta_description_placeholder')|e('html_attr') }}">{{ product.meta_description|default('') }}</textarea><small>{{ ui_text('admin.catalog.product_form.meta_description_hint') }}</small></label></div>{% include '@storefront/admin/_ai_box.html.twig' with {task:'seo_meta', label: ui_text('admin.ai.generate_meta'), inputs:{title:'[name=name]', body:'[name=description]'}, outputs:{meta_title:'[name=meta_title]', meta_description:'[name=meta_description]'}} only %}</section>
<section class="admin-panel" data-product-tab="sales"><h2>{{ ui_text('admin.catalog.product_form.prodazh') }}</h2><div class="admin-form-grid">
<label><span>{{ ui_text('admin.catalog.product_form.tsina') }} {{ currency|default(product.currency|default('UAH')) }}</span><input type="text" inputmode="decimal" name="price" value="{{ product.price_input|default('0.00') }}" required></label>
<input type="hidden" name="compare_at_price" value="{{ product.compare_at_input|default('')|e('html_attr') }}">
{% if tax_classes|default([]) %}<label><span>{{ ui_text('admin.tax.product_class') }}</span><select name="tax_class_id" data-tax-class>{% for c in tax_classes %}<option value="{{ c.id }}"{% if c.id == product.tax_class_id|default(0) or (not product.tax_class_id|default(0) and c.code == 'standard') %} selected{% endif %}>{{ c.name }}</option>{% endfor %}</select><small>{{ ui_text('admin.tax.product_class_hint') }}</small></label>{% endif %}
<label><span>{{ ui_text('admin.catalog.product_form.zalyshok') }}</span><input type="text" inputmode="decimal" name="stock_quantity" value="{{ product.stock_quantity|default('0') }}" {{ editing and product.product_type == 'digital' ? 'disabled' : '' }} required></label>




<details class="admin-more"><summary>{{ ui_text('admin.product.more') }}</summary><div class="admin-form-grid"><label><span>{{ ui_text('admin.catalog.product_form.odynytsia') }}</span><select name="unit_code">{% set dim_labels = {'count':ui_text('admin.units.dim_count'),'mass':ui_text('admin.units.dim_mass'),'volume':ui_text('admin.units.dim_volume'),'length':ui_text('admin.units.dim_length'),'area':ui_text('admin.units.dim_area'),'time':ui_text('admin.units.dim_time')} %}{% set _u = product.sale_unit_code|default('item') %}{% for group in ["count","mass","volume","length","area","time"] %}{% set _items = measurement_units()|filter(u => u.dimension == group) %}{% if _items|length %}<optgroup label="{{ dim_labels[group] }}">{% for u in _items %}<option value="{{ u.code }}"{{ u.code == _u ? ' selected' : '' }}>{{ u.name }} ({{ u.short }})</option>{% endfor %}</optgroup>{% endif %}{% endfor %}</select></label><label><span>GTIN</span><input type="text" name="gtin" value="{{ product.gtin|default('') }}"></label><label><span>MPN</span><input type="text" name="mpn" value="{{ product.mpn|default('') }}"></label><label><span>{{ ui_text('admin.catalog.product_form.stan_pokupky') }}</span><select name="purchase_mode">{% set purchase_mode = product.purchase_mode|default('auto') %}<option value="auto" {{ purchase_mode == 'auto' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.avtomatychno_za_zalyshkom') }}</option><option value="in_stock" {{ purchase_mode == 'in_stock' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.kupyty_iakshcho_ie_v_naiavnosti') }}</option><option value="backorder" {{ purchase_mode == 'backorder' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.pid_zamovlennia') }}</option><option value="preorder" {{ purchase_mode == 'preorder' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.peredzamovlennia') }}</option><option value="coming_soon" {{ purchase_mode == 'coming_soon' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.ochikuiemo_nadkhodzhennia') }}</option><option value="notify" {{ purchase_mode == 'notify' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.nemaie_v_naiavnosti_povidomyty') }}</option><option value="sold_out" {{ purchase_mode == 'sold_out' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.prodano') }}</option><option value="price_request" {{ purchase_mode == 'price_request' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.tsina_za_zapytom') }}</option></select><small>{{ ui_text('admin.catalog.product_form.keruie_knopkoiu_ta_dostupnistiu_pokupky_server_v') }}</small></label><label><span>{{ ui_text('admin.catalog.product_form.tekst_knopky') }}</span><input type="text" name="purchase_button_label" maxlength="120" value="{{ product.purchase_button_label|default('') }}" placeholder="{{ ui_text('admin.catalog.product_form.avtomatychno') }}"><small>{{ ui_text('admin.catalog.product_form.napryklad_zamovyty_peredzamovyty') }}</small></label><label><span>{{ ui_text('admin.catalog.product_form.termin_poiasnennia') }}</span><input type="text" name="purchase_eta_text" maxlength="190" value="{{ product.purchase_eta_text|default('') }}" placeholder="{{ ui_text('admin.catalog.product_form.ochikuiemo_3_5_dniv') }}"><small>{{ ui_text('admin.catalog.product_form.pokazuietsia_poruch_zi_statusom_tovaru') }}</small></label></div></details></div></section>

{% if editing and product.product_type == 'digital' %}
<section class="admin-panel" data-product-tab="files" id="digital-files"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.tsyfrovi_faily') }}</h2><small>{{ ui_text('admin.catalog.product_form.faily_zberihaiutsia_poza_public_i_vydaiutsia_lys') }}</small></div></div>
{% if digital_assets|default([]) %}<div class="admin-document-list">{% for asset in digital_assets %}<article><div><strong>{{ asset.title }}</strong><small>{{ asset.original_filename }} · {{ (asset.bytes / 1048576)|round(2) }} MB · {{ asset.download_count|default(0) }}{% if asset.max_downloads %} {{ ui_text('admin.catalog.product_form.do') }} {{ asset.max_downloads }} {{ ui_text('admin.catalog.product_form.zavantazhen') }}{% endif %}{% if asset.access_days %} · {{ asset.access_days }} {{ ui_text('admin.catalog.product_form.dniv') }}{% else %} {{ ui_text('admin.catalog.product_form.bez_stroku') }}{% endif %} · {{ asset.status }}</small></div>{% if asset.status == 'active' %}<form method="post" action="{{ path('admin_catalog_product_digital_deactivate',{publicId:product.public_id,assetPublicId:asset.public_id}) }}"><input type="hidden" name="_digital_token" value="{{ csrf_token('admin_product_digital_' ~ product.public_id) }}"><button class="is-danger" type="submit" data-confirm="{{ ui_text('admin.catalog.product_form.prypynyty_vydachu_tsoho_failu_novym_pokuptsiam_v') }}">{{ ui_text('admin.catalog.product_form.vymknuty') }}</button></form>{% endif %}</article>{% endfor %}</div>{% endif %}
<div class="admin-form-grid admin-form-grid--dense"><label><span>{{ ui_text('admin.catalog.product_form.fail') }}</span><input type="file" name="digital_file"></label><label><span>{{ ui_text('admin.catalog.product_form.nazva') }}</span><input type="text" name="digital_title" maxlength="255" placeholder="{{ ui_text('admin.catalog.product_form.osnovnyi_fail') }}"></label><label><span>{{ ui_text('admin.catalog.product_form.maks_zavantazhen') }}</span><input type="number" name="digital_max_downloads" min="1" max="1000" value="5"></label><label><span>{{ ui_text('admin.catalog.product_form.dniv_dostupu') }}</span><input type="number" name="digital_access_days" min="1" max="3650" value="365"><small>{{ ui_text('admin.catalog.product_form.zalyshte_porozhnim_dlia_bezstrokovoho_dostupu') }}</small></label></div>
<button type="submit" formaction="{{ path('admin_catalog_product_digital_upload',{publicId:product.public_id}) }}" formmethod="post" name="_digital_token" value="{{ csrf_token('admin_product_digital_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.dodaty_tsyfrovyi_fail') }}</button>
</section>
{% endif %}

{% if editing %}
{% if editing and extras is defined %}<input type="hidden" name="extras_present" value="1">
<section class="admin-panel" data-product-tab="sales" id="promo"><h2>{{ ui_text('admin.product.extras.promo') }}</h2><p class="admin-help">{{ ui_text('admin.product.extras.promo_hint') }}</p><div class="admin-form-grid">
<label><span>{{ ui_text('admin.product.extras.sale_price') }} {{ currency|default(product.currency|default('UAH')) }}</span><input type="text" inputmode="decimal" name="sale_price" value="{{ extras.sale_price }}" placeholder="0.00"><small>{{ ui_text('admin.product.extras.sale_price_hint') }}</small></label>
<label><span>{{ ui_text('admin.product.extras.sale_starts') }}</span><input type="datetime-local" name="sale_starts" value="{{ extras.sale_starts }}"></label>
<label><span>{{ ui_text('admin.product.extras.sale_ends') }}</span><input type="datetime-local" name="sale_ends" value="{{ extras.sale_ends }}"><small>{{ ui_text('admin.product.extras.sale_ends_hint') }}</small></label>
<label><span>{{ ui_text('admin.product.extras.cost') }} {{ currency|default(product.currency|default('UAH')) }}</span><input type="text" inputmode="decimal" name="cost_price" value="{{ extras.cost }}" placeholder="0.00"><small>{{ ui_text('admin.product.extras.cost_hint') }}</small></label>
<label><span>{{ ui_text('admin.product.extras.available_from') }}</span><input type="datetime-local" name="available_from" value="{{ extras.available_from }}"><small>{{ ui_text('admin.product.extras.available_from_hint') }}</small></label>
<label class="admin-form-wide"><span>{{ ui_text('admin.product.extras.tiers') }}</span><input type="text" name="price_tiers" value="{{ extras.tiers }}" data-pair-repeater="qty" data-pair-key-label="{{ ui_text('admin.product.pairs.qty_from')|e('html_attr') }}" data-pair-value-label="{{ ui_text('admin.product.pairs.price')|e('html_attr') }}" data-pair-add="{{ ui_text('admin.product.pairs.add_tier')|e('html_attr') }}" data-pair-remove="{{ ui_text('admin.product.pairs.remove')|e('html_attr') }}"><small>{{ ui_text('admin.product.extras.tiers_hint') }}</small></label>
{% if product.product_type|default('physical') == 'physical' %}<label class="admin-switch admin-form-wide"><input type="checkbox" role="switch" name="track_stock" value="1"{{ extras.track_stock ? ' checked' : '' }}><span>{{ ui_text('admin.product.extras.track_stock') }}</span></label>
<small class="admin-form-wide">{{ ui_text('admin.product.extras.track_stock_hint') }}</small>{% endif %}
<label class="admin-form-wide"><span>{{ ui_text('admin.product.extras.group_prices') }}</span><input type="text" name="group_prices" value="{{ extras.group_prices }}" data-pair-repeater="group" data-pair-options="{{ admin_customer_groups()|json_encode|e('html_attr') }}" data-pair-key-label="{{ ui_text('admin.product.pairs.group')|e('html_attr') }}" data-pair-value-label="{{ ui_text('admin.product.pairs.price')|e('html_attr') }}" data-pair-add="{{ ui_text('admin.product.pairs.add_group')|e('html_attr') }}" data-pair-remove="{{ ui_text('admin.product.pairs.remove')|e('html_attr') }}"><small>{{ ui_text('admin.product.extras.group_prices_hint') }}</small></label>
<label><span>{{ ui_text('admin.product.extras.min_qty') }}</span><input type="text" inputmode="decimal" name="min_qty" value="{{ extras.min_qty }}" placeholder="1"></label>
<label><span>{{ ui_text('admin.product.extras.step') }}</span><input type="text" inputmode="decimal" name="qty_step" value="{{ extras.step }}" placeholder="1"></label>
<label><span>{{ ui_text('admin.product.extras.max_qty') }}</span><input type="text" inputmode="decimal" name="max_qty" value="{{ extras.max_qty }}" placeholder="—"></label>
<label><span>{{ ui_text('admin.product.extras.points') }}</span><input type="text" inputmode="numeric" name="points_percent" value="{{ extras.points_percent }}" placeholder="100"><small>{{ ui_text('admin.product.extras.points_hint') }}</small></label>
<label class="admin-switch admin-form-wide"><input type="checkbox" role="switch" name="hidden" value="1"{{ extras.hidden ? ' checked' : '' }}><span>{{ ui_text('admin.product.extras.hidden') }}</span></label>
<small class="admin-form-wide">{{ ui_text('admin.product.extras.hidden_hint') }}</small>
<label class="admin-switch admin-form-wide"><input type="checkbox" role="switch" name="reviews_off" value="1"{{ extras.reviews_off ? ' checked' : '' }}><span>{{ ui_text('admin.product.extras.reviews_off') }}</span></label>
<label class="admin-form-wide"><span>{{ ui_text('admin.product.extras.related') }}</span><input type="text" name="related_skus" value="{{ extras.related }}" data-sku-picker data-lookup-url="{{ path('admin_catalog_product_lookup') }}" data-product-id="{{ product.public_id }}" data-search-placeholder="{{ ui_text('admin.product.pairs.search')|e('html_attr') }}" data-suggest-label="{{ ui_text('admin.product.pairs.suggest')|e('html_attr') }}" data-pair-remove="{{ ui_text('admin.product.pairs.remove')|e('html_attr') }}"><small>{{ ui_text('admin.product.extras.related_hint') }}</small></label>
<label class="admin-form-wide"><span>{{ ui_text('admin.product.extras.complementary') }}</span><input type="text" name="complementary_skus" value="{{ extras.complementary }}" data-sku-picker data-lookup-url="{{ path('admin_catalog_product_lookup') }}" data-product-id="{{ product.public_id }}" data-search-placeholder="{{ ui_text('admin.product.pairs.search')|e('html_attr') }}" data-suggest-label="{{ ui_text('admin.product.pairs.suggest')|e('html_attr') }}" data-pair-remove="{{ ui_text('admin.product.pairs.remove')|e('html_attr') }}"><small>{{ ui_text('admin.product.extras.complementary_hint') }}</small></label>
</div></section>
<section class="admin-panel" data-product-tab="seo" id="seo-extra"><h2>{{ ui_text('admin.product.extras.seo_extra') }}</h2><div class="admin-form-grid">
<label class="admin-form-wide"><span>Canonical URL</span><input type="url" name="canonical_url" maxlength="500" value="{{ extras.canonical_url }}" placeholder="https://"><small>{{ ui_text('admin.product.extras.canonical_hint') }}</small></label>
<label class="admin-form-wide"><span>{{ ui_text('admin.product.extras.tags') }}</span><input type="text" name="tags" maxlength="500" value="{{ extras.tags }}"><small>{{ ui_text('admin.product.extras.tags_hint') }}</small></label>
{% for i in 0..4 %}<label><span>Google custom label {{ i }}</span><input type="text" name="custom_label[{{ i }}]" maxlength="100" value="{{ extras.labels[i]|default('') }}"></label>{% endfor %}
<small class="admin-form-wide">{{ ui_text('admin.product.extras.labels_hint') }}</small>
</div></section>{% endif %}
{% if editing %}<section class="admin-panel" data-product-tab="sales" id="options"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.options.title') }}</h2><small>{{ ui_text('admin.catalog.options.help') }} {{ ui_text('admin.catalog.options.currency_note') }}</small></div></div>
<input type="hidden" name="_options_token" value="{{ csrf_token('admin_product_options_' ~ product.public_id) }}">
{% set options_action = path('admin_catalog_product_options', {publicId: product.public_id}) %}
<h3 class="admin-subhead">{{ ui_text('admin.catalog.options.variants_title') }}</h3><div class="admin-option-stack">{% for option in product_options|default([]) %}
<article class="admin-option"><div class="admin-option__head"><input type="text" name="option[{{ option.id }}][name]" value="{{ option.name }}" maxlength="190" aria-label="{{ ui_text('admin.catalog.options.name') }}"><select name="option[{{ option.id }}][display]" aria-label="{{ ui_text('admin.catalog.options.display') }}"><option value="buttons"{{ option.display == 'buttons' ? ' selected' : '' }}>{{ ui_text('admin.catalog.options.display_buttons') }}</option><option value="dropdown"{{ option.display == 'dropdown' ? ' selected' : '' }}>{{ ui_text('admin.catalog.options.display_dropdown') }}</option><option value="radio"{{ option.display == 'radio' ? ' selected' : '' }}>{{ ui_text('admin.catalog.options.display_radio') }}</option></select><button class="admin-icon-button is-sm is-danger" type="submit" formaction="{{ options_action }}" formmethod="post" name="_option_action" value="delete_option:{{ option.id }}" data-confirm="{{ ui_text('admin.catalog.options.confirm_delete')|e('html_attr') }}" title="{{ ui_text('admin.catalog.options.delete_option')|e('html_attr') }}" aria-label="{{ ui_text('admin.catalog.options.delete_option')|e('html_attr') }}">{{ ui_icon('trash-2', 14) }}</button></div>
<div class="admin-option__values"><div class="admin-option__row is-head"><span>{{ ui_text('admin.catalog.options.value') }}</span><span>{{ ui_text('admin.catalog.options.mode') }}</span><span>{{ ui_text('admin.catalog.options.delta') }} {{ currency|default('') }}</span><span>{{ ui_text('admin.catalog.options.weight_g') }}</span><span>{{ ui_text('admin.catalog.options.start_qty') }}</span><span>{{ ui_text('admin.catalog.options.swatch') }}</span><span>{{ ui_text('admin.catalog.options.picture') }}</span><span></span></div>
{% for value in option.values %}<div class="admin-option__row"><input type="text" name="option_value[{{ value.id }}][label]" value="{{ value.label }}" maxlength="190" aria-label="{{ ui_text('admin.catalog.options.value') }}"><select name="option_value[{{ value.id }}][mode]" aria-label="{{ ui_text('admin.catalog.options.mode') }}"><option value="add"{{ value.mode == 'add' ? ' selected' : '' }}>+</option><option value="sub"{{ value.mode == 'sub' ? ' selected' : '' }}>−</option><option value="set"{{ value.mode == 'set' ? ' selected' : '' }}>=</option></select><input type="text" inputmode="decimal" name="option_value[{{ value.id }}][delta]" value="{{ value.delta }}" aria-label="{{ ui_text('admin.catalog.options.delta') }}"><input type="number" step="1" name="option_value[{{ value.id }}][weight_g]" value="{{ value.weight_g }}" aria-label="{{ ui_text('admin.catalog.options.weight_g') }}"><input type="number" step="1" min="0" name="option_value[{{ value.id }}][quantity]" value="{{ value.quantity }}" aria-label="{{ ui_text('admin.catalog.options.start_qty') }}"><input type="color" name="option_value[{{ value.id }}][swatch]" value="{{ value.swatch ?: '#cccccc' }}" aria-label="{{ ui_text('admin.catalog.options.swatch') }}"><select name="option_value[{{ value.id }}][media]" aria-label="{{ ui_text('admin.catalog.options.picture') }}"><option value="0">—</option>{% for picture in option_pictures|default([]) %}<option value="{{ picture.id }}"{{ value.media_id == picture.id ? ' selected' : '' }}>{{ picture.label }}</option>{% endfor %}</select><button class="admin-icon-button is-sm" type="submit" formaction="{{ options_action }}" formmethod="post" name="_option_action" value="delete_value:{{ value.id }}" title="{{ ui_text('admin.catalog.options.delete_value')|e('html_attr') }}" aria-label="{{ ui_text('admin.catalog.options.delete_value')|e('html_attr') }}">{{ ui_icon('x', 14) }}</button></div>{% endfor %}</div>
<label class="admin-option__add"><span>{{ ui_text('admin.catalog.options.add_values') }}</span><input type="text" name="option[{{ option.id }}][new_value]" maxlength="400" placeholder="{{ ui_text('admin.catalog.options.add_values_hint')|e('html_attr') }}"></label></article>{% endfor %}</div>

{% set addons_action = path('admin_catalog_product_addons', {publicId: product.public_id}) %}
{% set addon_kinds = {select: ui_text('admin.catalog.addons.kind_select'), radio: ui_text('admin.catalog.addons.kind_radio'), checkbox: ui_text('admin.catalog.addons.kind_checkbox'), text: ui_text('admin.catalog.addons.kind_text'), textarea: ui_text('admin.catalog.addons.kind_textarea'), date: ui_text('admin.catalog.addons.kind_date'), time: ui_text('admin.catalog.addons.kind_time'), datetime: ui_text('admin.catalog.addons.kind_datetime')} %}
<h3 class="admin-subhead">{{ ui_text('admin.catalog.addons.title') }}</h3><p class="admin-help">{{ ui_text('admin.catalog.addons.help') }}</p>
<div class="admin-option-stack">{% for addon in product_addons|default([]) %}
<article class="admin-option"><div class="admin-option__head"><input type="text" name="addon[{{ addon.id }}][name]" value="{{ addon.name }}" maxlength="190" aria-label="{{ ui_text('admin.catalog.options.name') }}">
<select name="addon[{{ addon.id }}][kind]" aria-label="{{ ui_text('admin.catalog.addons.kind') }}">{% for kind, kind_label in addon_kinds %}<option value="{{ kind }}"{{ addon.kind == kind ? ' selected' : '' }}>{{ kind_label }}</option>{% endfor %}</select>
<label class="admin-inline-label"><input type="checkbox" name="addon[{{ addon.id }}][required]" value="1"{{ addon.required ? ' checked' : '' }}> {{ ui_text('admin.catalog.addons.required') }}</label>
<button class="admin-icon-button is-sm is-danger" type="submit" formaction="{{ options_action }}" formmethod="post" name="_option_action" value="delete_addon:{{ addon.id }}" data-confirm="{{ ui_text('admin.catalog.options.confirm_delete')|e('html_attr') }}" title="{{ ui_text('admin.catalog.options.delete_option')|e('html_attr') }}" aria-label="{{ ui_text('admin.catalog.options.delete_option')|e('html_attr') }}">{{ ui_icon('trash-2', 14) }}</button></div>
{% if addon.kind in ['select','radio','checkbox'] %}
<div class="admin-option__values"><div class="admin-option__row is-head"><span>{{ ui_text('admin.catalog.options.value') }}</span><span>{{ ui_text('admin.catalog.options.mode') }}</span><span>{{ ui_text('admin.catalog.addons.amount') }}</span><span>{{ ui_text('admin.catalog.options.weight_g') }}</span><span>{{ ui_text('admin.catalog.addons.default') }}</span><span>{{ ui_text('admin.catalog.addons.stock') }}</span><span>{{ ui_text('admin.catalog.options.picture') }}</span><span></span></div>
{% for value in addon.values %}<div class="admin-option__row admin-option__row--addon"><input type="text" name="addon_value[{{ value.id }}][name]" value="{{ value.name }}" maxlength="190" aria-label="{{ ui_text('admin.catalog.options.value') }}"><select name="addon_value[{{ value.id }}][mode]" aria-label="{{ ui_text('admin.catalog.options.mode') }}"><option value="add"{{ value.mode == 'add' ? ' selected' : '' }}>+</option><option value="sub"{{ value.mode == 'sub' ? ' selected' : '' }}>−</option><option value="set"{{ value.mode == 'set' ? ' selected' : '' }}>=</option></select><input type="text" inputmode="decimal" name="addon_value[{{ value.id }}][delta]" value="{{ value.delta }}" aria-label="{{ ui_text('admin.catalog.addons.amount') }}"><input type="number" step="1" name="addon_value[{{ value.id }}][weight_g]" value="{{ value.weight_g }}" aria-label="{{ ui_text('admin.catalog.options.weight_g') }}"><input type="checkbox" name="addon_value[{{ value.id }}][default]" value="1"{{ value.default ? ' checked' : '' }} aria-label="{{ ui_text('admin.catalog.addons.default') }}"><input type="number" step="1" min="0" name="addon_value[{{ value.id }}][stock]" value="{{ value.stock }}" placeholder="∞" aria-label="{{ ui_text('admin.catalog.addons.stock') }}"><select name="addon_value[{{ value.id }}][media]" aria-label="{{ ui_text('admin.catalog.options.picture') }}"><option value="0">—</option>{% for picture in option_pictures|default([]) %}<option value="{{ picture.id }}"{{ value.media_id == picture.id ? ' selected' : '' }}>{{ picture.label }}</option>{% endfor %}</select><button class="admin-icon-button is-sm" type="submit" formaction="{{ options_action }}" formmethod="post" name="_option_action" value="delete_addon_value:{{ value.id }}" title="{{ ui_text('admin.catalog.options.delete_value')|e('html_attr') }}" aria-label="{{ ui_text('admin.catalog.options.delete_value')|e('html_attr') }}">{{ ui_icon('x', 14) }}</button></div>{% endfor %}</div>
<label class="admin-option__add"><span>{{ ui_text('admin.catalog.options.add_values') }}</span><input type="text" name="addon[{{ addon.id }}][new_value]" maxlength="400" placeholder="{{ ui_text('admin.catalog.options.add_values_hint')|e('html_attr') }}"></label>
{% else %}
<div class="admin-form-grid admin-form-grid--dense"><label><span>{{ ui_text('admin.catalog.options.mode') }}</span><select name="addon[{{ addon.id }}][mode]"><option value="add"{{ addon.mode == 'add' ? ' selected' : '' }}>+</option><option value="sub"{{ addon.mode == 'sub' ? ' selected' : '' }}>−</option><option value="set"{{ addon.mode == 'set' ? ' selected' : '' }}>=</option></select></label><label><span>{{ ui_text('admin.catalog.addons.amount') }}</span><input type="text" inputmode="decimal" name="addon[{{ addon.id }}][delta]" value="{{ addon.delta }}"></label><label><span>{{ ui_text('admin.catalog.options.weight_g') }}</span><input type="number" step="1" name="addon[{{ addon.id }}][weight_g]" value="{{ addon.weight_g }}"></label>{% if addon.kind in ['text','textarea'] %}<label><span>{{ ui_text('admin.catalog.addons.max_length') }}</span><input type="number" min="1" max="2000" name="addon[{{ addon.id }}][max_length]" value="{{ addon.max_length }}"></label>{% endif %}</div>
{% endif %}</article>{% endfor %}</div>

<details class="admin-inline-create"{% if not product_options|default([]) and not product_addons|default([]) %} open{% endif %}><summary>{{ ui_text('admin.catalog.options.add_option') }}</summary><div class="admin-form-grid admin-form-grid--dense"><label><span>{{ ui_text('admin.catalog.options.name') }}</span><input type="text" name="new_entry[name]" maxlength="190" placeholder="{{ ui_text('admin.catalog.options.name_hint')|e('html_attr') }}"></label><label><span>{{ ui_text('admin.catalog.addons.kind') }}</span><select name="new_entry[type]"><optgroup label="{{ ui_text('admin.catalog.options.variants_title')|e('html_attr') }}"><option value="variant:buttons">{{ ui_text('admin.catalog.options.display_buttons') }}</option><option value="variant:dropdown">{{ ui_text('admin.catalog.options.display_dropdown') }}</option><option value="variant:radio">{{ ui_text('admin.catalog.options.display_radio') }}</option></optgroup><optgroup label="{{ ui_text('admin.catalog.addons.title')|e('html_attr') }}">{% for kind, kind_label in addon_kinds %}<option value="addon:{{ kind }}">{{ kind_label }}</option>{% endfor %}</optgroup></select></label><label><span>{{ ui_text('admin.catalog.options.values') }}</span><input type="text" name="new_entry[values]" maxlength="400" placeholder="{{ ui_text('admin.catalog.options.values_hint')|e('html_attr') }}"></label></div></details>
<div class="admin-inline-actions"><button class="admin-button" type="submit" formaction="{{ options_action }}" formmethod="post" name="_option_action" value="save">{{ ui_text('admin.catalog.options.save') }}</button>{% if product_options|default([]) %}<button class="admin-button is-primary" type="submit" formaction="{{ options_action }}" formmethod="post" name="_option_action" value="generate">{{ ui_icon('wand-sparkles', 16) }} {{ ui_text('admin.catalog.options.generate') }}</button>{% endif %}</div></section>{% endif %}
<section class="admin-panel" data-product-tab="sales" id="variants"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.varianty_tovaru') }}</h2><small>{{ ui_text('admin.catalog.product_form.dodatkovi_sku_iz_vlasnoiu_tsinoiu_ta_zalyshkom_p') }}</small></div></div>
<div class="admin-variant-stack">
{% for variant in variants|default([]) %}
{% if variant.sort_order == 0 %}
<article class="admin-variant-row is-default"><div><strong>{{ ui_text('admin.catalog.product_form.osnovnyi_variant') }}{% if variant_labels[variant.id] is defined %} · {{ variant_labels[variant.id] }}{% endif %}</strong><small>SKU {{ variant.sku }} {{ ui_text('admin.catalog.product_form.redahuietsia_u_blotsi_prodazh_vyshche') }}</small></div><span class="admin-badge">{{ ui_text('admin.catalog.product_form.osnovnyi') }}</span></article>
{% else %}
<article class="admin-variant-editor">{% if variant_labels[variant.id] is defined %}<h3 class="admin-variant-editor__title">{{ variant_labels[variant.id] }}</h3>{% endif %}
<div class="admin-form-grid admin-form-grid--dense">
<label><span>SKU</span><input type="text" name="variant[{{ variant.id }}][sku]" value="{{ variant.sku }}" maxlength="190" required></label>
<label><span>{{ ui_text('admin.catalog.product_form.tsina_2') }}</span><input type="text" inputmode="decimal" name="variant[{{ variant.id }}][price]" value="{{ variant.price_input }}" required></label>
<label><span>{{ ui_text('admin.catalog.product_form.zalyshok') }}</span><input type="text" inputmode="decimal" name="variant[{{ variant.id }}][stock_quantity]" value="{{ variant.stock_quantity }}" required></label>
<label><span>{{ ui_text('admin.catalog.product_form.odynytsia') }}</span><select name="variant[{{ variant.id }}][unit_code]">{% set dim_labels = {'count':ui_text('admin.units.dim_count'),'mass':ui_text('admin.units.dim_mass'),'volume':ui_text('admin.units.dim_volume'),'length':ui_text('admin.units.dim_length'),'area':ui_text('admin.units.dim_area'),'time':ui_text('admin.units.dim_time')} %}{% set _u = variant.sale_unit_code|default('item') %}{% for group in ["count","mass","volume","length","area","time"] %}{% set _items = measurement_units()|filter(u => u.dimension == group) %}{% if _items|length %}<optgroup label="{{ dim_labels[group] }}">{% for u in _items %}<option value="{{ u.code }}"{{ u.code == _u ? ' selected' : '' }}>{{ u.name }} ({{ u.short }})</option>{% endfor %}</optgroup>{% endif %}{% endfor %}</select></label>
<label><span>GTIN</span><input type="text" name="variant[{{ variant.id }}][gtin]" value="{{ variant.gtin|default('') }}"></label>
<label><span>MPN</span><input type="text" name="variant[{{ variant.id }}][mpn]" value="{{ variant.mpn|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.status') }}</span><select name="variant[{{ variant.id }}][status]"><option value="active" {{ variant.status == 'active' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.aktyvnyi') }}</option><option value="disabled" {{ variant.status == 'disabled' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.vymknenyi') }}</option></select></label>
<label><span>{{ ui_text('admin.catalog.product_form.vaha_kh') }}</span><input type="text" inputmode="decimal" name="variant[{{ variant.id }}][weight_kg]" value="{{ variant.weight_kg|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.dovzhyna_mm') }}</span><input type="number" min="0" name="variant[{{ variant.id }}][length_mm]" value="{{ variant.length_mm|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.shyryna_mm') }}</span><input type="number" min="0" name="variant[{{ variant.id }}][width_mm]" value="{{ variant.width_mm|default('') }}"></label>
<label><span>{{ ui_text('admin.catalog.product_form.vysota_mm') }}</span><input type="number" min="0" name="variant[{{ variant.id }}][height_mm]" value="{{ variant.height_mm|default('') }}"></label>
</div>
<div class="admin-inline-actions"><button type="submit" formaction="{{ path('admin_catalog_product_variant_update', {publicId: product.public_id, variantId: variant.id}) }}" formmethod="post" name="_variant_token" value="{{ csrf_token('admin_product_variants_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.zberehty_variant') }}</button><button class="is-danger" type="submit" formaction="{{ path('admin_catalog_product_variant_delete', {publicId: product.public_id, variantId: variant.id}) }}" formmethod="post" name="_variant_token" value="{{ csrf_token('admin_product_variants_' ~ product.public_id) }}" data-confirm="{{ ui_text('admin.catalog.product_form.vydalyty_tsei_variant_varianty_z_istoriieiu_zamo') }}">{{ ui_text('admin.catalog.product_form.vydalyty') }}</button></div>
</article>
{% endif %}
{% endfor %}
</div>
<details class="admin-inline-create"><summary>{{ ui_text('admin.catalog.product_form.dodaty_variant') }}</summary><div class="admin-form-grid admin-form-grid--dense">
<label><span>SKU</span><input type="text" name="new_variant[sku]" maxlength="190"></label>
<label><span>{{ ui_text('admin.catalog.product_form.tsina_2') }}</span><input type="text" inputmode="decimal" name="new_variant[price]" value="0.00"></label>
<label><span>{{ ui_text('admin.catalog.product_form.zalyshok') }}</span><input type="text" inputmode="decimal" name="new_variant[stock_quantity]" value="0"></label>
<label><span>{{ ui_text('admin.catalog.product_form.odynytsia') }}</span><select name="new_variant[unit_code]">{% set dim_labels = {'count':ui_text('admin.units.dim_count'),'mass':ui_text('admin.units.dim_mass'),'volume':ui_text('admin.units.dim_volume'),'length':ui_text('admin.units.dim_length'),'area':ui_text('admin.units.dim_area'),'time':ui_text('admin.units.dim_time')} %}{% set _u = 'item' %}{% for group in ["count","mass","volume","length","area","time"] %}{% set _items = measurement_units()|filter(u => u.dimension == group) %}{% if _items|length %}<optgroup label="{{ dim_labels[group] }}">{% for u in _items %}<option value="{{ u.code }}"{{ u.code == _u ? ' selected' : '' }}>{{ u.name }} ({{ u.short }})</option>{% endfor %}</optgroup>{% endif %}{% endfor %}</select></label>
<label><span>GTIN</span><input type="text" name="new_variant[gtin]"></label><label><span>MPN</span><input type="text" name="new_variant[mpn]"></label>
<label><span>{{ ui_text('admin.catalog.product_form.vaha_kh') }}</span><input type="text" inputmode="decimal" name="new_variant[weight_kg]"></label><label><span>{{ ui_text('admin.catalog.product_form.dovzhyna_mm') }}</span><input type="number" min="0" name="new_variant[length_mm]"></label><label><span>{{ ui_text('admin.catalog.product_form.shyryna_mm') }}</span><input type="number" min="0" name="new_variant[width_mm]"></label><label><span>{{ ui_text('admin.catalog.product_form.vysota_mm') }}</span><input type="number" min="0" name="new_variant[height_mm]"></label>
</div><button type="submit" formaction="{{ path('admin_catalog_product_variant_create', {publicId: product.public_id}) }}" formmethod="post" name="_variant_token" value="{{ csrf_token('admin_product_variants_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.dodaty_variant') }}</button></details>
</section>

<section class="admin-panel" data-product-tab="details" id="attributes"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.kharakterystyky') }}</h2><small>{{ ui_text('admin.catalog.product_form.typizovani_znachennia_zberihaiutsia_okremo_vid_o') }}</small></div></div>
{% if attributes|default([]) %}<div class="admin-attr-add"><input type="search" list="attr-options" data-attr-search placeholder="{{ ui_text('admin.catalog.product_form.attr_search')|e('html_attr') }}" aria-label="{{ ui_text('admin.catalog.product_form.attr_search')|e('html_attr') }}" autocomplete="off"><datalist id="attr-options">{% for attribute in attributes %}<option value="{{ attribute.name }}" data-attr-id="{{ attribute.id }}"></option>{% endfor %}</datalist></div>
<div class="admin-form-grid admin-attr-grid">{% for attribute in attributes %}<label class="admin-attr-row" data-attr-row="{{ attribute.id }}" data-attr-name="{{ attribute.name }}"{% if attribute.value is same as(null) or attribute.value == '' %} hidden{% endif %}><span>{{ attribute.name }}{% if attribute.unit_label %}, {{ attribute.unit_label }}{% endif %}</span><span class="admin-attr-row__field">{% if attribute.data_type in ['boolean','bool'] %}<select name="attribute[{{ attribute.id }}]"><option value="">—</option><option value="1" {{ attribute.value == '1' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.tak') }}</option><option value="0" {{ attribute.value == '0' ? 'selected' : '' }}>{{ ui_text('admin.catalog.product_form.ni') }}</option></select>{% else %}<input type="text" name="attribute[{{ attribute.id }}]" value="{{ attribute.value }}"{% if attribute.data_type in ['decimal','number'] %} inputmode="decimal"{% endif %}>{% endif %}<button class="admin-icon-button is-sm" type="button" data-attr-remove title="{{ ui_text('admin.catalog.product_form.attr_remove')|e('html_attr') }}" aria-label="{{ ui_text('admin.catalog.product_form.attr_remove')|e('html_attr') }}">{{ ui_icon('x', 14) }}</button></span></label>{% endfor %}</div><button type="submit" formaction="{{ path('admin_catalog_product_attributes_update', {publicId: product.public_id}) }}" formmethod="post" name="_attributes_token" value="{{ csrf_token('admin_product_attributes_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.zberehty_kharakterystyky') }}</button>{% else %}<p class="admin-muted">{{ ui_text('admin.catalog.product_form.u_dovidnyku_shche_nemaie_kharakterystyk_tovar_mo') }}</p>{% endif %}
</section>

<section class="admin-panel" data-product-tab="files" id="documents"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.dokumenty') }}</h2><small>{{ ui_text('admin.catalog.product_form.instruktsii_sertyfikaty_sds_ta_tekhnichni_faily_') }}</small></div></div>
{% if documents|default([]) %}<div class="admin-document-list">{% for document in documents %}<article><div><strong>{{ document.title }}</strong><small>{{ {'document':ui_text('admin.catalog.product_form.dokument'),'manual':ui_text('admin.catalog.product_form.instruktsiia'),'certificate':ui_text('admin.catalog.product_form.sertyfikat'),'sds':'SDS','datasheet':ui_text('admin.catalog.product_form.tekhnichnyi_opys'),'warranty':ui_text('admin.catalog.product_form.harantiia')}[document.document_type]|default(document.document_type) }}{% if document.locale %} · {{ document.locale }}{% endif %} · {{ (document.bytes / 1024)|round }} KB</small></div><div class="admin-inline-actions"><a href="{{ document.url }}" target="_blank" rel="noopener">{{ ui_text('admin.catalog.product_form.vidkryty') }}</a><button class="is-danger" type="submit" formaction="{{ path('admin_catalog_product_document_remove', {publicId: product.public_id, documentPublicId: document.public_id}) }}" formmethod="post" name="_document_token" value="{{ csrf_token('admin_product_documents_' ~ product.public_id) }}" data-confirm="{{ ui_text('admin.catalog.product_form.vidviazaty_dokument_vid_tovaru') }}">{{ ui_text('admin.catalog.product_form.vydalyty') }}</button></div></article>{% endfor %}</div>{% endif %}
<div class="admin-form-grid admin-form-grid--dense"><label><span>{{ ui_text('admin.catalog.product_form.fail_pdf_txt') }}</span><input type="file" name="document_file" accept="application/pdf,text/plain"></label><label><span>{{ ui_text('admin.catalog.product_form.nazva') }}</span><input type="text" name="document_title" maxlength="255"></label><label><span>{{ ui_text('admin.catalog.product_form.typ') }}</span><select name="document_type" data-custom-select="[data-doc-type-custom]"><option value="document">{{ ui_text('admin.catalog.product_form.dokument') }}</option><option value="manual">{{ ui_text('admin.catalog.product_form.instruktsiia') }}</option><option value="certificate">{{ ui_text('admin.catalog.product_form.sertyfikat') }}</option><option value="sds">SDS</option><option value="datasheet">{{ ui_text('admin.catalog.product_form.tekhnichnyi_opys') }}</option><option value="warranty">{{ ui_text('admin.catalog.product_form.harantiia') }}</option>{% for custom_type in custom_document_types() %}<option value="{{ custom_type }}">{{ custom_type }}</option>{% endfor %}<option value="__custom">{{ ui_text('admin.docs.custom_type') }}</option></select></label><label data-doc-type-custom hidden><span>{{ ui_text('admin.docs.custom_type_name') }}</span><input type="text" name="document_type_custom" maxlength="32" placeholder="{{ ui_text('admin.docs.custom_type_example')|e('html_attr') }}"></label><label><span>{{ ui_text('admin.catalog.product_form.mova') }}</span><select name="document_locale"><option value="">{{ ui_text('admin.catalog.product_form.dlia_vsikh_mov') }}</option>{% for locale in locales|default([]) %}<option value="{{ locale.code }}">{{ locale.name }} ({{ locale.code }})</option>{% endfor %}</select></label><label><span>{{ ui_text('admin.catalog.product_form.poriadok') }}</span><input type="number" min="0" max="65535" name="document_sort" value="100"></label></div><button type="submit" formaction="{{ path('admin_catalog_product_document_upload', {publicId: product.public_id}) }}" formmethod="post" name="_document_token" value="{{ csrf_token('admin_product_documents_' ~ product.public_id) }}">{{ ui_text('admin.catalog.product_form.dodaty_dokument') }}</button>
</section>
{% endif %}

<section class="admin-panel" data-product-tab="media"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog.product_form.zobrazhennia') }}</h2><small>{{ ui_text('admin.catalog.product_form.oryhinal_pereviriaietsia_pislia_choho_avtomatych') }}</small></div></div>
<div class="admin-media-toolbar">
  <button type="button" class="admin-button is-primary" data-media-pick="multiple" data-media-target="#product-media-picked">{{ ui_icon('folder-open', 16) }}<span>{{ ui_text('js_media_pick_choose') }}</span></button>
  <label class="admin-button" data-media-upload-button title="{{ ui_text('js_media_upload_pc') }}">{{ ui_icon('upload', 16) }}<span>{{ ui_text('js_media_upload_pc') }}</span><input type="file" name="images[]" accept="image/jpeg,image/png,image/webp,image/avif,image/heic,image/heif,.heic,.heif" multiple data-image-upload hidden></label>
  <label class="admin-media-toolbar__folder"><span>{{ ui_text('admin.media.upload_to') }}</span><select name="upload_folder" data-upload-folder><option value="">{{ ui_text('admin.media.library.bez_papky') }}</option>{% for f in media_folders|default([]) %}<option value="{{ f.id }}"{{ upload_folder == f.id ? ' selected' : '' }}>{{ f.label }}</option>{% endfor %}</select></label>
  <small>{{ ui_text('admin.media.pick_hint') }}</small>
</div>
<div class="admin-media-picked" id="product-media-picked" data-input-name="existing_media[]"></div>
<div class="admin-media-preview" data-image-preview></div>
{% if media_items|default([]) %}<p class="admin-hint">{{ ui_text('admin.media.order_hint') }}</p>
<div class="admin-media-grid" data-media-sortable{% if editing %} data-order-url="{{ path('admin_catalog_product_media_order', {publicId: product.public_id}) }}" data-order-token="{{ csrf_token('admin_product_media_' ~ product.public_id) }}"{% endif %} data-label-main="{{ ui_text('admin.catalog.product_form.holovne')|e('html_attr') }}">{% for it in media_items %}{% if it.kind == 'photo' %}{% set image = it.row %}<article class="admin-media-item{{ image.role == 'primary' ? ' is-primary' : '' }}" draggable="true" data-media-token="{{ it.token }}" data-media-kind="photo"><input type="hidden" name="media_order[]" value="{{ it.token }}"><img src="{{ image.url|media_variant('card') }}" alt="{{ image.alt_text ?: product.name }}" loading="lazy" draggable="false" style="object-position:{{ (image.focal_point.x|default(0.5) * 100)|round }}% {{ (image.focal_point.y|default(0.5) * 100)|round }}%"><div><strong data-media-badge>{{ image.role == 'primary' ? ui_text('admin.catalog.product_form.holovne') : ui_text('admin.catalog.product_form.halereia') }}</strong><small>{{ image.width }}×{{ image.height }}</small><span class="admin-media-move"><button type="button" data-media-move="-1" aria-label="{{ ui_text('admin.media.move_earlier')|e('html_attr') }}">{{ ui_icon('arrow-left', 14) }}</button><span class="admin-media-handle" aria-hidden="true">{{ ui_icon('grip-vertical', 14) }}</span><button type="button" data-media-move="1" aria-label="{{ ui_text('admin.media.move_later')|e('html_attr') }}">{{ ui_icon('arrow-right', 14) }}</button></span></div><details class="admin-media-meta"><summary>{{ ui_text('admin.catalog.product_form.parametry') }}</summary><label>ALT<input type="text" name="media_alt[{{ image.id }}]" value="{{ image.alt_text }}" maxlength="500"></label><div><label>{{ ui_text('admin.catalog.product_form.fokus_x') }}<input type="number" min="0" max="1" step="0.01" name="media_focal_x[{{ image.id }}]" value="{{ image.focal_point.x|default(0.5) }}"></label><label>{{ ui_text('admin.catalog.product_form.fokus_y') }}<input type="number" min="0" max="1" step="0.01" name="media_focal_y[{{ image.id }}]" value="{{ image.focal_point.y|default(0.5) }}"></label></div></details><div class="admin-media-actions"><button class="is-danger" type="submit" formaction="{{ path('admin_catalog_product_media_remove', {publicId: product.public_id, assetId: image.id}) }}" formmethod="post" name="_media_token" value="{{ csrf_token('admin_product_media_' ~ product.public_id) }}" data-confirm="{{ ui_text('admin.catalog.product_form.vidviazaty_tse_zobrazhennia_vid_tovaru') }}" title="{{ ui_text('admin.catalog.product_form.vydalyty_z_halerei') }}">{{ ui_text('admin.catalog.product_form.vydalyty') }}</button></div></article>{% else %}{% set video = it.row %}<article class="admin-media-item is-video" draggable="true" data-media-token="{{ it.token }}" data-media-kind="video"><input type="hidden" name="media_order[]" value="{{ it.token }}"><img src="{{ video.poster }}" alt="" loading="lazy" draggable="false"><div><strong>{{ ui_text('admin.catalog.video.badge') }} · {{ video.provider|upper }}</strong><span class="admin-media-move"><button type="button" data-media-move="-1" aria-label="{{ ui_text('admin.media.move_earlier')|e('html_attr') }}">{{ ui_icon('arrow-left', 14) }}</button><span class="admin-media-handle" aria-hidden="true">{{ ui_icon('grip-vertical', 14) }}</span><button type="button" data-media-move="1" aria-label="{{ ui_text('admin.media.move_later')|e('html_attr') }}">{{ ui_icon('arrow-right', 14) }}</button></span></div><details class="admin-media-meta"><summary>{{ ui_text('admin.catalog.product_form.parametry') }}</summary><label>{{ ui_text('admin.catalog.video.name') }}<input type="text" name="video_title[{{ video.id }}]" value="{{ video.title }}" maxlength="190"></label><small><a href="{{ video.url }}" target="_blank" rel="noopener noreferrer">{{ video.url|length > 40 ? video.url|slice(0, 40) ~ '…' : video.url }}</a></small></details><div class="admin-media-actions"><button class="is-danger" type="submit" formaction="{{ path('admin_catalog_product_video_remove', {publicId: product.public_id, videoId: video.id}) }}" formmethod="post" name="_media_token" value="{{ csrf_token('admin_product_media_' ~ product.public_id) }}" data-confirm="{{ ui_text('admin.catalog.video.remove_confirm') }}">{{ ui_text('admin.catalog.product_form.vydalyty') }}</button></div></article>{% endif %}{% endfor %}</div>{% endif %}
<div class="admin-video" data-product-videos>
<h3>{{ ui_text('admin.catalog.video.title') }}</h3>
<p class="admin-hint">{{ ui_text('admin.catalog.video.hint') }}</p>
<div class="admin-video-add"><label>{{ ui_text('admin.catalog.video.link') }}<input type="url" name="video_url" maxlength="500" placeholder="https://www.youtube.com/watch?v=…" autocomplete="off"></label><label>{{ ui_text('admin.catalog.video.name') }}<input type="text" name="video_new_title" maxlength="190"></label><label>{{ ui_text('admin.catalog.video.poster') }}<input type="file" name="video_poster" accept="image/jpeg,image/png,image/webp,image/avif"></label></div>
</div></section>
<section class="admin-panel" data-product-tab="general"><h2>{{ ui_text('admin.catalog.product_form.katehorii') }}</h2>{% import '@storefront/admin/_multiselect.html.twig' as ms %}{% if categories %}{% set category_options = [] %}{% for category in categories %}{% set category_options = category_options|merge([{value: category.id, label: category.name}]) %}{% endfor %}{{ ms.field('category_ids', ui_text('admin.catalog.product_form.katehorii_pick'), category_options, product.category_ids|default([]), true, ui_text('admin.catalog.product_form.katehorii_none')) }}<label class="admin-primary-category" data-primary-category><span>{{ ui_text('admin.catalog.product_form.primary_category') }}</span><select name="primary_category_id" data-primary-category-select>{% for option in category_options %}<option value="{{ option.value }}"{% if ((product.category_ids|default([]))|first) == option.value %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select><small>{{ ui_text('admin.catalog.product_form.primary_category_hint') }}</small></label>{% else %}<p>{{ ui_text('admin.catalog.product_form.spochatku_stvorit_katehoriiu_abo_zberezhit_tovar') }}</p>{% endif %}</section>
<div class="admin-form-actions admin-save-bar"><span class="admin-save-bar__state" data-dirty-state>{{ ui_text('admin.product.save_hint') }}</span><button class="admin-button is-primary is-lg" type="submit" data-primary-submit>{{ ui_icon('save', 16) }}<span>{{ editing ? ui_text('admin.catalog.product_form.zberehty_tovar') : ui_text('admin.catalog.product_form.stvoryty_chernetku') }}</span></button></div></form>
{% if editing and custom_definitions|default([]) %}<section class="admin-panel" data-product-tab="details" id="custom-fields"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.fields.product_panel') }}</h2><small>{{ ui_text('admin.fields.product_panel_hint') }}</small><p class="admin-help">{{ ui_text('admin.product.tabs.own_save') }}</p></div><a class="admin-button" href="/admin/catalog/fields">{{ ui_icon('settings', 16) }}<span>{{ ui_text('admin.fields.manage') }}</span></a></div>
<form method="post" action="{{ path('admin_catalog_product_fields_save', {publicId: product.public_id}) }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_fields_' ~ product.public_id) }}">
{% for d in custom_definitions %}<label><span>{{ d.label }}</span><input type="{{ d.field_type == 'number' ? 'text' : (d.field_type == 'date' ? 'date' : (d.field_type == 'url' ? 'url' : 'text')) }}" name="field[{{ d.id }}]" maxlength="2000" value="{{ custom_values[d.id]|default('') }}"></label>{% endfor %}
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.fields.save_values') }}</button></div></form></section>{% endif %}
{% if editing %}<section class="admin-panel" data-product-tab="details" id="info-blocks"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.infoblocks.title') }}</h2><small>{{ ui_text('admin.infoblocks.hint') }}</small><p class="admin-help">{{ ui_text('admin.product.tabs.own_save') }}</p></div>{{ ui_icon('table', 20) }}</div>
<form method="post" action="{{ path('admin_catalog_product_info_save', {publicId: product.public_id}) }}" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_product_info_' ~ product.public_id) }}">
{% set rows = info_blocks|default([])|merge([{type:'info',title:'',locale:'',text:''},{type:'list',title:'',locale:'',text:''},{type:'table',title:'',locale:'',text:''}]) %}
{% for b in rows %}<fieldset class="admin-form-wide admin-info-block"><legend>{{ loop.index }}</legend>
<label><span>{{ ui_text('admin.infoblocks.type') }}</span><select name="block[{{ loop.index0 }}][type]">{% for t in ['info','list','table'] %}<option value="{{ t }}" {{ b.type == t ? 'selected' : '' }}>{{ ui_text('admin.infoblocks.type.' ~ t) }}</option>{% endfor %}</select></label>
<label><span>{{ ui_text('admin.infoblocks.block_title') }}</span><input type="text" name="block[{{ loop.index0 }}][title]" maxlength="190" value="{{ b.title }}"></label>
<label><span>{{ ui_text('admin.infoblocks.locale') }}</span><select name="block[{{ loop.index0 }}][locale]"><option value="">{{ ui_text('admin.infoblocks.all_locales') }}</option>{% for l in locales|default([]) %}<option value="{{ l.code }}" {{ b.locale == l.code ? 'selected' : '' }}>{{ l.code }}</option>{% endfor %}</select></label>
<label class="admin-form-wide"><span>{{ ui_text('admin.infoblocks.content') }}</span><textarea name="block[{{ loop.index0 }}][text]" rows="5" maxlength="100000">{{ b.text }}</textarea></label></fieldset>{% endfor %}
<p class="admin-form-wide"><small>{{ ui_text('admin.infoblocks.format_help') }}</small></p>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.infoblocks.save') }}</button></div></form></section>{% endif %}
{% include '@storefront/admin/extension/slot.html.twig' with {slot:'admin.product.after_main'} only %}
{{ shell.end() }}
