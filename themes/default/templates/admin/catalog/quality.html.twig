{% import '@storefront/admin/_pager.html.twig' as pager %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog_quality.title'),'products') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.catalog_quality.title') }}</span></nav><h1>{{ ui_text('admin.catalog_quality.title') }}</h1><p>{{ ui_text('admin.catalog_quality.intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}
{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel catalog-quality" data-catalog-quality data-score="{{ summary.score }}">
<div class="catalog-quality__score"><strong>{{ summary.score }}%</strong><span>{{ ui_text('admin.catalog_quality.score', {clean: summary.clean, total: summary.total}) }}</span><progress class="onboarding-bar" max="100" value="{{ summary.score }}"></progress></div>
<ul class="catalog-quality__issues">
{% for f in core|merge(extra) %}<li class="catalog-quality__issue{{ summary.counts[f] > 0 ? (f in core ? ' is-bad' : ' is-warn') : ' is-ok' }}" data-issue="{{ f }}" data-count="{{ summary.counts[f] }}"><a href="{{ path('admin_catalog_quality', {issue: f}) }}"><strong>{{ summary.counts[f] }}</strong><span>{{ ui_text('admin.catalog_quality.issue.' ~ f) }}</span></a></li>{% endfor %}
</ul>
<h2>{{ ui_text('admin.catalog_quality.languages') }}</h2>
<ul class="catalog-quality__langs">{% for l in summary.locales %}<li data-locale="{{ l.code }}"><span>{{ l.name }} <small>{{ l.code }}</small></span><progress class="onboarding-bar" max="100" value="{{ l.percent }}"></progress><small>{{ l.complete }} / {{ summary.total }}</small></li>{% endfor %}</ul>
</section>
{% if admin_can('catalog.manage') %}<section class="admin-panel"><form method="post" action="{{ path('admin_catalog_quality_policy') }}" class="admin-form-stack" data-content-policy><input type="hidden" name="_token" value="{{ csrf_token('admin_catalog_quality') }}"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.catalog_quality.policy') }}</h2><small>{{ ui_text('admin.catalog_quality.policy_hint') }}</small></div></div>
<div class="admin-form-grid"><label><span>{{ ui_text('admin.catalog_quality.policy_label') }}</span><select name="mode">{% for m in modes %}<option value="{{ m }}"{% if m == policy %} selected{% endif %}>{{ ui_text('admin.catalog_quality.policy.' ~ m) }}</option>{% endfor %}</select></label></div>
<div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.common.save') }}</button></div></form></section>{% endif %}
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ issue ? ui_text('admin.catalog_quality.issue.' ~ issue) : ui_text('admin.catalog_quality.needs_work') }}</h2><small>{{ list.total }}</small></div>{% if issue %}<a class="admin-button" href="{{ path('admin_catalog_quality') }}">{{ ui_text('admin.catalog_quality.all_issues') }}</a>{% endif %}</div>
{% if list.items %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.catalog_quality.product') }}</th><th>SKU</th><th>{{ ui_text('admin.catalog_quality.problems') }}</th><th></th></tr></thead><tbody>
{% for p in list.items %}<tr data-product-row><td>{{ p.name ?: p.sku }}</td><td>{{ p.sku }}</td><td>{% for i in p.issues %}<span class="admin-badge {{ i in core ? 'is-danger' : 'is-warning' }}">{{ ui_text('admin.catalog_quality.issue.' ~ i) }}</span> {% endfor %}</td><td class="is-actions"><div class="admin-row-actions"><a class="admin-icon-button is-sm" href="{{ path('admin_catalog_product_edit', {publicId: p.public_id}) }}" title="{{ ui_text('admin.catalog_quality.edit') }}" aria-label="{{ ui_text('admin.catalog_quality.edit') }}">{{ ui_icon('pencil', 16) }}</a><a class="admin-icon-button is-sm" href="{{ path('admin_catalog_product_translations', {publicId: p.public_id}) }}" title="{{ ui_text('admin.translations.title') }}" aria-label="{{ ui_text('admin.translations.title') }}">{{ ui_icon('languages', 16) }}</a></div></td></tr>{% endfor %}
</tbody></table></div>
{{ pager.render(list.page, list.total, list.limit) }}
{% else %}<p>{{ ui_text('admin.catalog_quality.all_good') }}</p>{% endif %}
</section>
{{ shell.end() }}
