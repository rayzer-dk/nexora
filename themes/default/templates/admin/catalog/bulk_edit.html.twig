{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.catalog.bulk_edit.masove_redahuvannia'),'products') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.catalog.bulk_edit.kataloh_bulk_editor') }}</small><h1>{{ ui_text('admin.catalog.bulk_edit.masove_redahuvannia') }}</h1><p>{{ ui_text('admin.catalog.bulk_edit.redahuite_do_100_tovariv_iak_u_tablytsi_kozhen_r') }}</p></div><a class="admin-preview-link" href="{{ path('admin_catalog_products') }}">{{ ui_text('admin.catalog.bulk_edit.nazad_do_tovariv') }}</a></header>
{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('products_bulk_editor') }}"><input type="hidden" name="bulk_editor_save" value="1"><div class="admin-table-wrap bulk-sheet"><table class="admin-data-table"><thead><tr><th>{{ ui_text('admin.catalog.bulk_edit.nazva') }}</th><th>SKU</th><th>{{ ui_text('admin.catalog.bulk_edit.tsina') }}</th><th>{{ ui_text('admin.catalog.bulk_edit.zalyshok') }}</th><th>{{ ui_text('admin.catalog.bulk_edit.status') }}</th></tr></thead><tbody>{% for p in rows %}<tr><td><input type="text" name="rows[{{ p.public_id }}][name]" value="{{ p.name }}" required maxlength="255"></td><td><input type="text" name="rows[{{ p.public_id }}][sku]" value="{{ p.sku }}" required maxlength="190"></td><td><input type="text" inputmode="decimal" name="rows[{{ p.public_id }}][price]" value="{{ p.amount_minor is null?'0.00':(p.amount_minor/100)|number_format(2,'.','') }}"></td><td><input type="text" inputmode="decimal" name="rows[{{ p.public_id }}][stock]" value="{{ p.stock_quantity|default('0') }}"></td><td><select name="rows[{{ p.public_id }}][status]"><option value="draft" {% if p.status=='draft' %}selected{% endif %}>{{ ui_text('admin.catalog.bulk_edit.chernetka') }}</option><option value="published" {% if p.status=='published' %}selected{% endif %}>{{ ui_text('admin.catalog.bulk_edit.opublikovano') }}</option><option value="archived" {% if p.status=='archived' %}selected{% endif %}>{{ ui_text('admin.catalog.bulk_edit.arkhiv') }}</option></select></td></tr>{% endfor %}</tbody></table></div><div class="admin-editor-actions admin-editor-actions--sticky"><span>{{ ui_text('admin.catalog.bulk_edit.zminy_zapuskaiut_standartni_podii_katalohu_ta_sy') }}</span><button type="submit">{{ ui_text('admin.catalog.bulk_edit.zberehty_zminy') }}</button></div></form>
{{ shell.end() }}
