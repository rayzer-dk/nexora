{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin_manage'),'dashboard') }}
<header class="admin-runtime__header"><div><small>{{ store.name|default(ui_text('admin_store')) }} · Nexora Commerce v{{ platform_version }}</small><h1>{{ ui_text('admin_dashboard_title') }}</h1><p>{{ ui_text('admin_dashboard_intro') }}</p></div><div class="admin-header-actions"><button class="admin-ghost-button" type="button" data-command-open title="{{ ui_text('admin_quick_jump') }}">{{ ui_text('admin_quick_search') }}</button><strong>{{ admin_name }}</strong></div></header>
<section class="admin-action-center"><div class="admin-card-heading"><div><small>{{ ui_text('admin_attention') }}</small><h2>{{ ui_text('admin_do_now') }}</h2></div>{% if backup_age_days is null %}<span class="admin-attention-badge is-danger">{{ ui_text('admin_backup_missing') }}</span>{% elseif backup_age_days > 7 %}<span class="admin-attention-badge is-warning">{{ ui_text('admin_backup_days_ago', {'days': backup_age_days}) }}</span>{% else %}<span class="admin-attention-badge is-ok">{{ ui_text('admin_backup_current') }}</span>{% endif %}</div><div class="admin-attention-grid">{% for item in attention %}<a class="admin-attention-card is-{{ item.tone }}" href="{{ item.url }}"><span>{{ item.label }}</span><strong>{{ item.count }}</strong><small>{{ item.hint }}</small></a>{% endfor %}</div></section>
{% include '@storefront/admin/extension/slot.html.twig' with {slot:'admin.dashboard'} only %}
<section class="admin-runtime__metrics"><article><span>{{ ui_text('admin_products') }}</span><strong>{{ counts.products }}</strong><small>{{ ui_text('admin_catalog') }}</small></article><article><span>{{ ui_text('admin_categories') }}</span><strong>{{ counts.categories }}</strong><small>{{ ui_text('admin_structure') }}</small></article><article><span>{{ ui_text('admin_orders') }}</span><strong>{{ counts.orders }}</strong><small>{{ ui_text('admin_sales') }}</small></article><article><span>{{ ui_text('admin_store') }}</span><strong>{{ store.default_currency|default('UAH') }}</strong><small>{{ store.default_locale|default('uk-UA') }} · {{ store.timezone|default('Europe/Kyiv') }}</small></article></section>
<section class="admin-quick-grid"><a href="/admin/catalog/products/new"><span class="admin-quick-icon">+</span><strong>{{ ui_text('admin_new_product') }}</strong><small>{{ ui_text('admin_create_product') }}</small></a><a href="/admin/catalog/merchandising"><span class="admin-quick-icon">⇅</span><strong>{{ ui_text('admin_merchandising') }}</strong><small>{{ ui_text('admin_product_ordering') }}</small></a><a href="/admin/appearance/editor"><span class="admin-quick-icon">◫</span><strong>{{ ui_text('ui.admin.dashboard.visual_store_editor') }}</strong><small>{{ ui_text('admin_visual_editor_hint') }}</small></a><a href="/admin/system/cron"><span class="admin-quick-icon">↻</span><strong>{{ ui_text('ui.admin.dashboard.cron') }}</strong><small>{{ ui_text('admin_cron_state') }}</small></a><a href="/admin/system/stability"><span class="admin-quick-icon">{{ ui_icon('check-circle', 20) }}</span><strong>{{ ui_text('admin_stability') }}</strong><small>{{ ui_text('admin_backup_health_recovery') }}</small></a></section>
<section class="admin-runtime__panel admin-runtime__panel--modern"><div><small>{{ ui_text('admin_first_run') }}</small><h2>{{ ui_text('admin_short_checklist') }}</h2></div><div class="admin-onboarding-grid"><a href="/admin/system/store">{{ ui_text('admin_check_company') }}</a><a href="/admin/appearance/editor">{{ ui_text('admin_check_storefront') }}</a><a href="/admin/catalog/products">{{ ui_text('admin_check_products') }}</a><a href="/admin/commerce/notifications">{{ ui_text('admin_check_notifications') }}</a><a href="/admin/commerce/feeds">{{ ui_text('admin_check_feeds') }}</a><a href="/" target="_blank" rel="noopener">{{ ui_text('admin_check_store') }}</a></div></section>
{{ shell.end() }}
