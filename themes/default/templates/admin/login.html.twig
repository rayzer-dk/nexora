{% extends '@storefront/admin/auth_base.html.twig' %}
{% block card %}
        <h1 id="login-title">{{ ui_text('admin.login.vkhid_do_keruvannia') }}</h1>
        <p>{{ ui_text('admin.login.vykorystovuite_oblikovyi_zapys_administratora_ma') }}</p>
        {% for message in app.flashes('success') %}<div class="admin-notice is-success" role="status">{{ ui_icon('check', 20) }}<span>{{ message }}</span></div>{% endfor %}
        {% if error %}<div class="admin-notice is-error" role="alert">{{ ui_icon('circle-alert', 20) }}<span>{% if error_code == 'throttled' %}{{ ui_text('admin.login.error_throttled') }}{% elseif error_code == 'csrf' %}{{ ui_text('admin.login.error_csrf') }}{% else %}{{ ui_text('admin.login.nevirna_elektronna_adresa_abo_parol') }}{% endif %}</span></div>{% endif %}
        <form method="post" action="{{ path('admin_login') }}" autocomplete="on">
            <label><span>Email</span><input type="email" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus></label>
            <label><span>{{ ui_text('admin.login.parol') }}</span>{% include '@storefront/admin/_password_field.html.twig' with {name: '_password', autocomplete: 'current-password'} only %}</label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="admin-button is-primary is-lg">{{ ui_text('admin.login.uviity') }}</button>
        </form>
        <p class="admin-login-links"><a href="{{ path('admin_login_forgot') }}">{{ ui_text('admin.login.forgot') }}</a></p>
{% endblock %}
