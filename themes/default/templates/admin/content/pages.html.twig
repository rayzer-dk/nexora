{% import '@storefront/admin/_multiselect.html.twig' as ms %}
{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.content.pages.informatsiini_storinky'),'content') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.content.pages.informatsiini_storinky') }}</span></nav><h1>{{ ui_text('admin.content.pages.informatsiini_storinky') }}</h1><p>{{ ui_text('admin.pages.intro') }}</p></div>
<div class="admin-page-actions"><a class="admin-button is-primary" href="{{ path('admin_content_page_new') }}">{{ ui_icon('plus', 18) }}<span>{{ ui_text('admin.pages.new') }}</span></a></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'error') }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="admin-toolbar"><form class="admin-filters" method="get">
  <label class="admin-filters__search"><span>{{ ui_text('admin.pages.search') }}</span><input type="search" name="q" value="{{ filters.q }}" placeholder="{{ ui_text('admin.pages.search_placeholder')|e('html_attr') }}"></label>
  {{ ms.field('status', ui_text('admin.content.pages.status'), [{value: 'published', label: ui_text('admin.pages.state_published')}, {value: 'draft', label: ui_text('admin.pages.state_draft')}], filters.status) }}
  <button type="submit">{{ ui_text('admin.pages.apply') }}</button>
</form></section>
<div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table" data-pages-table><thead><tr><th>{{ ui_text('admin.content.pages.storinka') }}</th><th>URL</th><th>{{ ui_text('admin.pages.placement') }}</th><th>{{ ui_text('admin.content.pages.status') }}</th><th>{{ ui_text('admin.pages.languages') }}</th><th class="is-actions"></th></tr></thead><tbody>
{% for item in items %}<tr data-page-row="{{ item.ref }}">
<td><a href="{{ path('admin_content_page_edit', {ref: item.ref}) }}"><strong>{{ item.title ?: ui_text('admin.pages.untitled') }}</strong></a>{% if item.is_system %} <span class="admin-badge is-muted" title="{{ ui_text('admin.pages.system_hint')|e('html_attr') }}">{{ ui_text('admin.pages.system') }}</span>{% endif %}</td>
<td>{% if item.url %}<code>{{ item.url }}</code>{% else %}<span class="admin-muted">—</span>{% endif %}</td>
<td>{% if item.show_in_footer %}<span class="admin-badge is-info">{{ ui_text('admin.pages.in_footer') }}</span> {% endif %}{% if item.show_in_menu %}<span class="admin-badge is-info">{{ ui_text('admin.pages.in_menu') }}</span> {% endif %}{% if not item.show_in_footer and not item.show_in_menu %}<span class="admin-muted">{{ ui_text('admin.pages.in_none') }}</span>{% endif %}</td>
<td><span class="admin-badge is-{{ item.status == 'published' ? 'success' : 'muted' }}">{{ item.status == 'published' ? ui_text('admin.pages.state_published') : ui_text('admin.pages.state_draft') }}</span></td>
<td><code>{{ item.locales|join(', ') }}</code></td>
<td class="is-actions"><span class="admin-row-actions">
<a class="admin-icon-button is-sm" href="{{ path('admin_content_page_edit', {ref: item.ref}) }}" title="{{ ui_text('admin.content.pages.redahuvaty') }}" aria-label="{{ ui_text('admin.content.pages.redahuvaty') }}">{{ ui_icon('pencil', 16) }}</a>
<form method="post" action="{{ path('admin_content_page_toggle', {ref: item.ref}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_content_pages') }}"><button class="admin-icon-button is-sm" type="submit" title="{{ item.status == 'published' ? ui_text('admin.pages.unpublish') : ui_text('admin.pages.publish') }}" aria-label="{{ item.status == 'published' ? ui_text('admin.pages.unpublish') : ui_text('admin.pages.publish') }}">{{ ui_icon(item.status == 'published' ? 'eye-off' : 'eye', 16) }}</button></form>
<form method="post" action="{{ path('admin_content_page_duplicate', {ref: item.ref}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_content_pages') }}"><button class="admin-icon-button is-sm" type="submit" title="{{ ui_text('admin.pages.duplicate') }}" aria-label="{{ ui_text('admin.pages.duplicate') }}">{{ ui_icon('copy', 16) }}</button></form>
{% if not item.is_system %}<form method="post" action="{{ path('admin_content_page_delete', {ref: item.ref}) }}" data-confirm="{{ ui_text('admin.pages.delete_confirm')|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_content_pages') }}"><button class="admin-icon-button is-sm is-danger" type="submit" title="{{ ui_text('admin.pages.delete') }}" aria-label="{{ ui_text('admin.pages.delete') }}">{{ ui_icon('trash-2', 16) }}</button></form>{% endif %}
</span></td></tr>{% else %}<tr><td colspan="6" class="admin-empty">{{ ui_text('admin.content.pages.storinky_ne_znaideno') }}</td></tr>{% endfor %}
</tbody></table></div></div>{{ shell.end() }}
