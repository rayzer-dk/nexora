{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.content.pages.informatsiini_storinky'),'content') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.content.pages.informatsiini_storinky') }}</span></nav><h1>{{ ui_text('admin.content.pages.informatsiini_storinky') }}</h1><p>{{ ui_text('admin.content.pages.zapovnit_i_opublikuite_bazovi_storinky_mahazynu_') }}</p></div></header>
<div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.content.pages.storinka') }}</th><th>URL</th><th>{{ ui_text('admin.content.pages.status') }}</th><th></th></tr></thead><tbody>
{% for item in items %}<tr><td>{{ item.title }}</td><td><code>{{ item.url|default('—') }}</code></td><td><span class="admin-badge is-{{ item.status }}">{{ item.status }}</span></td><td><span class="admin-row-actions"><a class="admin-icon-button is-sm" href="/admin/content/pages/{{ item.system_key }}" title="{{ ui_text('admin.content.pages.redahuvaty') }}" aria-label="{{ ui_text('admin.content.pages.redahuvaty') }}">{{ ui_icon('pencil', 16) }}</a></span></td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.content.pages.storinky_ne_znaideno') }}</td></tr>{% endfor %}
</tbody></table></div></div>{{ shell.end() }}
