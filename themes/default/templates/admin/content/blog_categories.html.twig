{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.blog.categories'),'blog') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="{{ path('admin_content_blog') }}">{{ ui_text('admin.blog.title') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.blog.categories') }}</span></nav><h1>{{ ui_text('admin.blog.categories') }}</h1><p>{{ ui_text('admin.blog.categories_intro') }}</p></div></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ editing ? ui_text('admin.blog.category_edit') : ui_text('admin.blog.category_new') }} ({{ locale }})</h2></div>
<form method="post" action="{{ path('admin_content_blog_category_save') }}" class="admin-form-grid" data-blog-category-form><input type="hidden" name="_token" value="{{ csrf_token('admin_content_blog_categories') }}"><input type="hidden" name="id" value="{{ editing ? editing.id : '' }}">
<label>{{ ui_text('admin.blog.category_name') }}<input type="text" name="name" maxlength="190" required value="{{ editing ? editing.name : '' }}"></label>
<label>{{ ui_text('admin.blog.category_parent') }}<select name="parent_id"><option value="0">{{ ui_text('admin.blog.category_parent_none') }}</option>{% for c in categories %}{% if not editing or c.id != editing.id %}<option value="{{ c.id }}"{{ editing and editing.parent_id == c.id ? ' selected' : '' }}>{{ '— — — — — '|slice(0, c.depth * 2) }}{{ c.name }}</option>{% endif %}{% endfor %}</select></label>
<label>{{ ui_text('admin.blog.slug') }}<input type="text" name="slug" maxlength="120" value="{{ editing ? editing.slug : '' }}" placeholder="{{ ui_text('admin.blog.slug_auto') }}"></label>
<label>{{ ui_text('admin.blog.sort') }}<input type="number" name="sort_order" value="{{ editing ? editing.sort_order : 0 }}"></label>
<label>{{ ui_text('admin.blog.status') }}<select name="status"><option value="active"{{ editing and editing.status == 'hidden' ? '' : ' selected' }}>{{ ui_text('admin.blog.category_active') }}</option><option value="hidden"{{ editing and editing.status == 'hidden' ? ' selected' : '' }}>{{ ui_text('admin.blog.category_hidden') }}</option></select></label>
<label class="admin-form-wide">{{ ui_text('admin.blog.category_description') }}<textarea name="description" rows="3" maxlength="5000">{{ editing ? editing.description : '' }}</textarea></label>
<label>{{ ui_text('admin.blog.meta_title') }}<input type="text" name="meta_title" maxlength="255" value="{{ editing ? editing.meta_title : '' }}"></label>
<label>{{ ui_text('admin.blog.meta_description') }}<input type="text" name="meta_description" maxlength="500" value="{{ editing ? editing.meta_description : '' }}"></label>
<div class="admin-form-actions">{% if editing %}<a class="admin-button" href="{{ path('admin_content_blog_categories') }}">{{ ui_text('admin.blog.cancel') }}</a>{% endif %}<button class="admin-button is-primary" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.blog.save') }}</button></div></form></section>
<div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.blog.category_name') }}</th><th>{{ ui_text('admin.blog.slug') }}</th><th>{{ ui_text('admin.blog.status') }}</th><th>{{ ui_text('admin.blog.articles_count') }}</th><th></th></tr></thead><tbody>
{% for c in categories %}<tr data-blog-category="{{ c.slug }}"><td><div class="admin-tree-cell" style="--depth: {{ c.depth }}">{% if c.depth > 0 %}<span class="admin-tree-cell__branch" aria-hidden="true">{{ ui_icon('corner-down-right', 14) }}</span>{% endif %}<strong>{{ c.name }}</strong></div></td><td><code>{{ c.slug }}</code></td><td><span class="admin-badge is-{{ c.status == 'active' ? 'active' : 'disabled' }}">{{ c.status == 'active' ? ui_text('admin.blog.category_active') : ui_text('admin.blog.category_hidden') }}</span> <label class="admin-switch admin-quick-status" data-quick-status data-url="{{ path('admin_content_blog_category_quick_status', {id:c.id}) }}" data-token="{{ csrf_token('admin_quick_status') }}" data-on="active" data-off="hidden" data-label-on="{{ ui_text('admin.blog.category_active') }}" data-label-off="{{ ui_text('admin.blog.category_hidden') }}" data-on-tone="active" data-off-tone="disabled"><input type="checkbox" role="switch"{{ c.status == 'active' ? ' checked' : '' }} aria-label="{{ ui_text('admin.catalog.products.quick_status') }}" title="{{ ui_text('admin.catalog.products.quick_status') }}"></label></td><td>{{ c.articles }}</td>
<td><span class="admin-row-actions"><a class="admin-icon-button is-sm" href="?edit={{ c.id }}" title="{{ ui_text('admin.blog.edit') }}" aria-label="{{ ui_text('admin.blog.edit') }}">{{ ui_icon('pencil', 16) }}</a>
<form method="post" action="{{ path('admin_content_blog_category_delete', {id: c.id}) }}" data-confirm="{{ ui_text('admin.confirm.delete') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_content_blog_categories') }}"><button class="admin-icon-button is-sm is-danger" type="submit" title="{{ ui_text('admin.blog.delete') }}" aria-label="{{ ui_text('admin.blog.delete') }}">{{ ui_icon('trash-2', 16) }}</button></form></span></td></tr>
{% else %}<tr><td colspan="5">{{ ui_text('admin.blog.categories_empty') }}</td></tr>{% endfor %}
</tbody></table></div></div>
{{ shell.end() }}
