{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.content.page_form.redahuvannia_storinky'),'content') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin/content/pages">{{ ui_text('admin.content.pages.informatsiini_storinky') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ page.title }}</span></nav><h1>{{ page.title }}</h1><p>{{ ui_text('admin.content.page_form.publichna_adresa') }} <code>{{ public_url }}</code></p></div><a class="admin-button" href="{{ public_url }}" target="_blank" rel="noopener">{{ ui_text('admin.content.page_form.perehlianuty') }}</a></header>
<form method="post" class="admin-panel admin-form"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
<label>{{ ui_text('admin.content.page_form.nazva') }}<input type="text" name="title" value="{{ page.title }}" required maxlength="255"></label>
<label>{{ ui_text('admin.content.page_form.korotkyi_vstup') }}<textarea name="excerpt" rows="3">{{ page.excerpt }}</textarea></label>
<label>{{ ui_text('admin.content.page_form.zmist') }}<textarea name="body_html" rows="16" data-rich-editor>{{ page.body_html }}</textarea><small>{{ ui_text('admin.content.page_form.html_ochyshchaietsia_na_serveri_pered_zberezhenn') }}</small></label>
{% include '@storefront/admin/_ai_box.html.twig' with {task:'seo_meta', label: ui_text('admin.ai.generate_meta'), inputs:{title:'[name=title]', body:'[name=body_html]'}, outputs:{meta_title:'[name=meta_title]', meta_description:'[name=meta_description]'}} only %}
  <label>{{ ui_text('ui.admin.content.page_form.meta_title') }}<input type="text" name="meta_title" value="{{ page.meta_title }}" maxlength="255"></label>
<label>{{ ui_text('ui.admin.content.page_form.meta_description') }}<textarea name="meta_description" rows="3" maxlength="500">{{ page.meta_description }}</textarea></label>
<label>{{ ui_text('admin.content.page_form.status') }}<select name="status"><option value="draft" {{ page.status == 'draft' ? 'selected' : '' }}>{{ ui_text('admin.content.page_form.chernetka') }}</option><option value="published" {{ page.status == 'published' ? 'selected' : '' }}>{{ ui_text('admin.content.page_form.opublikovano') }}</option></select></label>
<div class="admin-form-actions"><a class="admin-button" href="/admin/content/pages">{{ ui_text('admin.content.page_form.nazad') }}</a><button class="admin-button is-primary" type="submit">{{ ui_text('admin.content.page_form.zberehty') }}</button></div></form>{{ shell.end() }}
