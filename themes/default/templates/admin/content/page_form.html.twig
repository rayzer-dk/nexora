{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}
{% import '@storefront/admin/_lang_tabs.html.twig' as langs %}
{% set is_new = page.id == 0 %}
{% set form_url = is_new ? path('admin_content_page_new') : path('admin_content_page_edit', {ref: page.ref, locale: locale}) %}
{{ shell.start(is_new ? ui_text('admin.pages.new') : ui_text('admin.content.page_form.redahuvannia_storinky'),'content') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="{{ path('admin_content_pages') }}">{{ ui_text('admin.content.pages.informatsiini_storinky') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ page.title ?: ui_text('admin.pages.new') }}</span></nav><h1>{{ is_new ? ui_text('admin.pages.new') : (page.title ?: ui_text('admin.pages.untitled')) }}</h1>{% if page.path %}<p>{{ ui_text('admin.content.page_form.publichna_adresa') }} <code>{{ page.path }}</code></p>{% endif %}</div>
<div class="admin-page-actions">{% if page.path and page.status == 'published' %}<a class="admin-button" href="{{ page.path }}" target="_blank" rel="noopener">{{ ui_icon('external-link', 16) }}<span>{{ ui_text('admin.content.page_form.perehlianuty') }}</span></a>{% endif %}<a class="admin-button" href="{{ path('admin_content_pages') }}">{{ ui_icon('arrow-left', 16) }}<span>{{ ui_text('admin.content.page_form.nazad') }}</span></a></div></header>
{% for type in ['success','warning','error'] %}{% for message in app.flashes(type) %}<div class="admin-notice is-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
{% if lang_tabs|length > 0 %}<div class="admin-panel admin-panel--tabs">{{ langs.bar(lang_tabs) }}
{% if not page.has_translation and not page.prefilled|default(false) %}<div class="admin-notice is-info admin-notice--inline"><span>{{ ui_text('admin.pages.translation_new', {language: locale}) }}</span>
<span class="admin-row-actions">{% if page.default_text %}<a class="admin-button" href="{{ path('admin_content_page_edit', {ref: page.ref, locale: locale, prefill: 'default'}) }}">{{ ui_icon('copy', 16) }}<span>{{ ui_text('admin.lang_tabs.copy_default') }}</span></a>{% if ai_providers() %}<form method="post" action="{{ path('admin_content_page_translate', {ref: page.ref, locale: locale}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><select name="provider" aria-label="{{ ui_text('admin.ai.provider')|e('html_attr') }}">{% for pr in ai_providers() %}<option value="{{ pr.code }}">{{ pr.label }}</option>{% endfor %}</select><button class="admin-button" type="submit">{{ ui_icon('languages', 16) }}<span>{{ ui_text('admin.translations.translate') }}</span></button></form>{% endif %}{% endif %}</span></div>{% elseif page.prefilled|default('') == 'default' %}<div class="admin-notice is-info admin-notice--inline"><span>{{ ui_text('admin.pages.prefilled_default') }}</span></div>{% elseif page.prefilled|default('') == 'ai' %}<div class="admin-notice is-info admin-notice--inline"><span>{{ ui_text('admin.pages.prefilled_ai') }}</span></div>{% endif %}</div>{% endif %}
<form method="post" action="{{ form_url }}" class="admin-panel admin-form admin-page-editor" data-dirty-guard data-lang-scope>
<input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}"><input type="hidden" name="placement_present" value="1">
<div class="admin-page-editor__main">
  <label><span>{{ ui_text('admin.content.page_form.nazva') }}</span><input type="text" name="title" value="{{ page.title }}" required maxlength="255"{% if is_new %} data-slug-from="slug"{% endif %}></label>
  {% if page.is_system %}
    <label><span>{{ ui_text('admin.pages.slug') }}</span><input type="text" value="{{ page.path }}" readonly aria-readonly="true"><small>{{ ui_text('admin.pages.slug_system_hint') }}</small></label>
  {% else %}
    <label class="admin-page-editor__slug"><span>{{ ui_text('admin.pages.slug') }}</span><span class="admin-input-prefix"><span>{{ app.request.schemeAndHttpHost }}/</span><input type="text" name="slug" value="{{ page.slug }}" maxlength="180" autocomplete="off" spellcheck="false" placeholder="{{ ui_text('admin.pages.slug_placeholder')|e('html_attr') }}"{% if is_new %} data-slug-auto="1"{% endif %}></span><small>{{ ui_text('admin.pages.slug_hint') }}{% if not is_new %} {{ ui_text('admin.pages.slug_redirect_hint') }}{% endif %}</small></label>
  {% endif %}
  <label><span>{{ ui_text('admin.content.page_form.korotkyi_vstup') }}</span><textarea name="excerpt" rows="3" maxlength="1000">{{ page.excerpt }}</textarea></label>
  <label><span>{{ ui_text('admin.content.page_form.zmist') }}</span><textarea name="body_html" rows="18" data-rich-editor>{{ page.body_html }}</textarea><small>{{ ui_text('admin.content.page_form.html_ochyshchaietsia_na_serveri_pered_zberezhenn') }}</small></label>
  <fieldset class="admin-fieldset"><legend>{{ ui_text('admin.pages.seo') }}</legend>
    {% include '@storefront/admin/_ai_box.html.twig' with {task:'seo_meta', label: ui_text('admin.ai.generate_meta'), inputs:{title:'[name=title]', body:'[name=body_html]'}, outputs:{meta_title:'[name=meta_title]', meta_description:'[name=meta_description]'}} only %}
    <label><span>{{ ui_text('ui.admin.content.page_form.meta_title') }}</span><input type="text" name="meta_title" id="page-meta-title" value="{{ page.meta_title }}" maxlength="255"><small class="admin-counter" data-char-counter="page-meta-title" data-min="30" data-max="60"></small></label>
    <label><span>{{ ui_text('ui.admin.content.page_form.meta_description') }}</span><textarea name="meta_description" id="page-meta-description" rows="3" maxlength="500">{{ page.meta_description }}</textarea><small class="admin-counter" data-char-counter="page-meta-description" data-min="70" data-max="160"></small></label>
    <div class="admin-form-grid">
      <label><span>{{ ui_text('admin.pages.robots') }}</span><select name="robots"><option value="index"{{ not page.noindex ? ' selected' : '' }}>{{ ui_text('admin.pages.robots_index') }}</option><option value="noindex"{{ page.noindex ? ' selected' : '' }}>{{ ui_text('admin.pages.robots_noindex') }}</option></select><small>{{ ui_text('admin.pages.robots_hint') }}</small></label>
      <label><span>{{ ui_text('admin.pages.canonical') }}</span><input type="url" name="canonical_url" value="{{ page.canonical_url }}" maxlength="500" placeholder="https://"><small>{{ ui_text('admin.pages.canonical_hint') }}</small></label>
    </div>
    <div class="admin-form-wide"><span class="admin-field-label">{{ ui_text('admin.pages.og_image') }}</span><div class="admin-media-actions-row"><button type="button" class="admin-button" data-media-pick="single" data-media-target="#page-og-picked">{{ ui_icon('folder-open', 16) }}<span>{{ ui_text('js_media_pick_choose') }}</span></button><small>{{ ui_text('admin.pages.og_image_hint') }}</small></div><div class="admin-media-picked" id="page-og-picked" data-input-name="og_asset_id">{% if page.og_asset_id and page.og_url %}<figure><img src="{{ page.og_url }}" alt="" loading="lazy"><input type="hidden" name="og_asset_id" value="{{ page.og_asset_id }}"><button type="button" data-media-picked-remove aria-label="{{ ui_text('js_media_pick_remove') }}" title="{{ ui_text('js_media_pick_remove') }}">{{ ui_icon('x', 12) }}</button></figure>{% endif %}</div></div>
  </fieldset>
</div>
<aside class="admin-page-editor__side">
  <fieldset class="admin-fieldset"><legend>{{ ui_text('admin.pages.publishing') }}</legend>
    <label><span>{{ ui_text('admin.content.page_form.status') }}</span><select name="status"><option value="draft"{{ page.status == 'draft' ? ' selected' : '' }}>{{ ui_text('admin.content.page_form.chernetka') }}</option><option value="published"{{ page.status == 'published' ? ' selected' : '' }}>{{ ui_text('admin.content.page_form.opublikovano') }}</option></select><small>{{ ui_text('admin.pages.status_hint') }}</small></label>
    <div class="admin-form-actions"><button class="admin-button is-primary" type="submit">{{ ui_icon('save', 16) }}<span>{{ ui_text('admin.pages.save', {language: locale}) }}</span></button></div>
  </fieldset>
  <fieldset class="admin-fieldset"><legend>{{ ui_text('admin.pages.placement') }}</legend>
    <label class="admin-check"><input type="checkbox" name="show_in_footer" value="1"{{ page.show_in_footer ? ' checked' : '' }}> {{ ui_text('admin.pages.in_footer') }}</label>
    <label class="admin-check"><input type="checkbox" name="show_in_menu" value="1"{{ page.show_in_menu ? ' checked' : '' }}> {{ ui_text('admin.pages.in_menu') }}</label>
    <label><span>{{ ui_text('admin.pages.group') }}</span><select name="page_group">{% for g in groups %}<option value="{{ g }}"{{ page.page_group == g ? ' selected' : '' }}>{{ ui_text('admin.pages.group.' ~ g) }}</option>{% endfor %}</select><small>{{ ui_text('admin.pages.group_hint') }}</small></label>
    <label><span>{{ ui_text('admin.pages.sort') }}</span><input type="number" name="sort_order" value="{{ page.sort_order }}" min="0" max="9999"><small>{{ ui_text('admin.pages.sort_hint') }}</small></label>
  </fieldset>
</aside>
</form>
{{ shell.end() }}
