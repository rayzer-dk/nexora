{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.downloads.title'),'downloads') }}
<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.downloads.title') }}</span></nav><h1>{{ ui_text('admin.downloads.title') }}</h1><p>{{ ui_text('admin.downloads.intro') }}</p></div><a class="admin-button" href="{{ path('storefront_downloads') }}" target="_blank" rel="noopener">{{ ui_icon('external-link', 16) }}{{ ui_text('admin.downloads.open_public') }}</a></header>
{% for message in app.flashes('success') %}<div class="admin-notice is-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="admin-notice is-error">{{ message }}</div>{% endfor %}
<section class="admin-panel"><div class="admin-panel__header"><div><small>{{ ui_text('admin.downloads.formats') }}</small><h2>{{ ui_text('admin.downloads.upload') }}</h2></div>{{ ui_icon('upload', 20) }}</div>
<form method="post" action="{{ path('admin_content_downloads_upload') }}" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('admin_downloads') }}">
<label>{{ ui_text('admin.downloads.file') }}<input type="file" name="file" required accept=".pdf,.txt,.csv,.zip,.docx,.xlsx"></label>
<label>{{ ui_text('admin.downloads.name') }}<input type="text" name="title" maxlength="190" required></label>
<label>{{ ui_text('admin.downloads.group') }}<input type="text" name="group" maxlength="120" placeholder="{{ ui_text('admin.downloads.group_placeholder')|e('html_attr') }}"></label>
<label>{{ ui_text('admin.downloads.sort') }}<input type="number" name="sort" value="100" min="0" max="65535"></label>
<label class="admin-form-wide">{{ ui_text('admin.downloads.description') }}<input type="text" name="description" maxlength="500"></label>
<div class="admin-form-actions admin-form-wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.downloads.upload_button') }}</button></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><h2>{{ ui_text('admin.downloads.files') }}</h2></div></div>
{% if files %}<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.downloads.name') }}</th><th>{{ ui_text('admin.downloads.group') }}</th><th>{{ ui_text('admin.downloads.hits') }}</th><th>{{ ui_text('admin.downloads.status') }}</th><th class="is-actions">{{ ui_text('admin.automation.actions_col') }}</th></tr></thead><tbody>
{% for f in files %}<tr><td><a href="{{ f.file_url }}" target="_blank" rel="noopener">{{ f.title }}</a><small>{{ f.file_ext|upper }} · {{ f.file_size >= 1048576 ? (f.file_size / 1048576)|number_format(1) ~ ' MB' : (f.file_size / 1024)|round ~ ' KB' }}</small></td><td>{{ f.group_label ?: '—' }}</td><td>{{ f.download_count }}</td><td><span class="admin-badge {{ f.status == 'active' ? 'is-ok' : '' }}">{{ f.status }}</span></td>
<td class="is-actions"><form method="post" action="{{ path('admin_content_downloads_toggle',{id:f.id}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_downloads') }}"><button class="admin-button" type="submit">{{ f.status == 'active' ? ui_text('admin.automation.disable') : ui_text('admin.automation.enable') }}</button></form> <form method="post" action="{{ path('admin_content_downloads_delete',{id:f.id}) }}" class="admin-inline-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_downloads') }}"><button class="admin-icon-button" type="submit" data-confirm="{{ ui_text('admin.automation.delete_confirm') }}" title="{{ ui_text('admin.automation.delete') }}" aria-label="{{ ui_text('admin.automation.delete') }}">{{ ui_icon('trash-2', 16) }}</button></form></td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="admin-empty">{{ ui_text('admin.downloads.empty') }}</p>{% endif %}</section>
{{ shell.end() }}
