{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.customer_experience.return_view.povernennia_rma'),'customer_experience') }}
<header class="admin-runtime__header"><div><small>{{ ui_text('admin.customer_experience.return_view.kliientskyi_servis') }}</small><h1>{{ ui_text('admin.customer_experience.return_view.povernennia') }} {{ return.public_id|slice(0,8) }}</h1><p>{{ ui_text('admin.customer_experience.return_view.zamovlennia') }} {{ return.order_number }} · {{ return.customer_name|default(ui_text('admin.customer_experience.return_view.kliient')) }}</p></div><div><a class="admin-button" href="{{ path('admin_customer_experience') }}">{{ ui_text('admin.customer_experience.return_view.do_cherhy') }}</a></div></header>
<section class="admin-grid admin-grid--2">
<div class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.return_view.stan_povernennia') }}</h2><span class="status-chip">{{ return.status }}</span></div>
<form method="post" action="{{ path('admin_return_status',{publicId:return.public_id}) }}" class="admin-form-grid">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('return_status_' ~ return.public_id) }}"><input type="hidden" name="_back" value="detail">
<label>{{ ui_text('admin.customer_experience.return_view.status') }}<select name="status">{% for s in return.allowed_statuses %}<option value="{{ s }}"{{ s==return.status?' selected':'' }}>{{ s }}</option>{% endfor %}</select></label>
<label>{{ ui_text('admin.customer_experience.return_view.rishennia') }}<select name="resolution"><option value="">{{ ui_text('admin.customer_experience.return_view.ne_vyznacheno') }}</option>{% for resolution in resolutions %}<option value="{{ resolution }}"{{ resolution==return.resolution?' selected':'' }}>{{ resolution }}</option>{% endfor %}</select></label>
<label>{{ ui_text('admin.customer_experience.return_view.nomer_zvorotnoho_vidpravlennia') }}<input type="text" name="tracking_number" maxlength="190" value="{{ return.return_tracking_number|default('') }}"></label>
<label class="admin-form-grid__wide">{{ ui_text('admin.customer_experience.return_view.komentar') }}<textarea name="note" rows="4" maxlength="4000">{{ return.admin_note|default('') }}</textarea></label>
<div class="admin-form-grid__wide"><button class="admin-button is-primary" type="submit">{{ ui_text('admin.customer_experience.return_view.zberehty') }}</button></div>
</form></div>
<div class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.return_view.dani_zapytu') }}</h2></div><dl class="admin-definition-list"><dt>{{ ui_text('admin.customer_experience.return_view.kliient') }}</dt><dd>{{ return.customer_name|default('—') }}</dd><dt>Email</dt><dd>{{ return.customer_email|default('—') }}</dd><dt>{{ ui_text('admin.customer_experience.return_view.prychyna') }}</dt><dd>{{ return.reason_code }}</dd><dt>{{ ui_text('admin.customer_experience.return_view.komentar_kliienta') }}</dt><dd>{{ return.customer_note|default('—') }}</dd><dt>{{ ui_text('admin.customer_experience.return_view.stvoreno') }}</dt><dd>{{ return.created_at }}</dd></dl></div>
</section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.return_view.tovary') }}</h2><span>{{ return.items|length }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>SKU</th><th>{{ ui_text('admin.customer_experience.return_view.tovar') }}</th><th>{{ ui_text('admin.customer_experience.return_view.kilkist') }}</th><th>{{ ui_text('admin.customer_experience.return_view.prychyna') }}</th><th>{{ ui_text('admin.customer_experience.return_view.suma_riadka') }}</th></tr></thead><tbody>{% for item in return.items %}<tr><td>{{ item.sku }}</td><td>{{ item.name }}</td><td>{{ item.quantity }}</td><td>{{ item.reason_code|default('—') }}</td><td>{{ (item.line_total_minor / 100)|number_format(2, ',', ' ') }} {{ return.currency }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.return_view.istoriia') }}</h2><span>{{ return.events|length }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.customer_experience.return_view.data') }}</th><th>{{ ui_text('admin.customer_experience.return_view.podiia') }}</th><th>{{ ui_text('admin.customer_experience.return_view.khto') }}</th><th>{{ ui_text('admin.customer_experience.return_view.detali') }}</th></tr></thead><tbody>{% for event in return.events %}<tr><td>{{ event.created_at }}</td><td>{{ event.event_type }}</td><td>{{ event.actor_type }}{% if event.actor_id %} #{{ event.actor_id }}{% endif %}</td><td>{% if event.payload.from is defined %}{{ event.payload.from }} → {{ event.payload.to }}{% endif %}{% if event.payload.note|default('') %}<small>{{ event.payload.note }}</small>{% endif %}</td></tr>{% else %}<tr><td colspan="4">{{ ui_text('admin.customer_experience.return_view.istoriia_vidsutnia') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}