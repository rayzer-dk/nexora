{% import '@storefront/admin/catalog/_shell.html.twig' as shell %}{{ shell.start(ui_text('admin.customer_experience.index.kliientskyi_servis'),'customer_experience') }}

<header class="admin-page-header"><div><nav class="admin-breadcrumb" aria-label="{{ ui_text('admin.nav.breadcrumb') }}"><a href="/admin">{{ ui_text('admin_overview') }}</a>{{ ui_icon('chevron-right', 14) }}<span aria-current="page">{{ ui_text('admin.customer_experience.index.kliientskyi_servis') }}</span></nav><h1>{{ ui_text('admin.customer_experience.index.povernennia_vidhuky_ta_pytannia') }}</h1><p>{{ ui_text('admin.customer_experience.index.odna_robocha_cherha_dlia_dii_shcho_potrebuiut_mo') }}</p></div></header>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.index.povernennia_rma') }}</h2><span>{{ returns|length }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.customer_experience.index.zamovlennia') }}</th><th>{{ ui_text('admin.customer_experience.index.kliient') }}</th><th>{{ ui_text('admin.customer_experience.index.prychyna') }}</th><th>{{ ui_text('admin.customer_experience.index.status') }}</th><th>{{ ui_text('admin.customer_experience.index.data') }}</th><th>{{ ui_text('admin.customer_experience.index.diia') }}</th></tr></thead><tbody>{% for r in returns %}<tr><td><a href="{{ path('admin_return_view',{publicId:r.public_id}) }}"><strong>{{ r.order_number }}</strong></a><small>{{ r.item_count }} {{ ui_text('admin.customer_experience.index.poz') }}</small></td><td>{{ r.customer_name|default('—') }}</td><td>{{ r.reason_code }}</td><td><span class="admin-badge is-{{ r.status }}">{{ r.status }}</span></td><td>{{ r.created_at }}</td><td><form method="post" action="{{ path('admin_return_status',{publicId:r.public_id}) }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('return_status_' ~ r.public_id) }}"><select name="status">{% for s in return_statuses %}<option value="{{ s }}"{{ s==r.status?' selected':'' }}>{{ s }}</option>{% endfor %}</select><select name="resolution"><option value="">{{ ui_text('admin.customer_experience.index.rishennia') }}</option><option value="refund">{{ ui_text('ui.admin.customer_experience.index.refund') }}</option><option value="exchange">{{ ui_text('ui.admin.customer_experience.index.exchange') }}</option><option value="repair">{{ ui_text('ui.admin.customer_experience.index.repair') }}</option><option value="store_credit">{{ ui_text('ui.admin.customer_experience.index.store_credit') }}</option><option value="none">{{ ui_text('ui.admin.customer_experience.index.none') }}</option></select><input type="text" name="note" maxlength="4000" placeholder="{{ ui_text('admin.customer_experience.index.komentar') }}"><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.customer_experience.index.zberehty_status') }}" aria-label="{{ ui_text('admin.customer_experience.index.zberehty_status') }}">{{ ui_icon('check', 18) }}</button></form></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.customer_experience.index.novykh_povernen_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.index.vidhuky') }}</h2><span>{{ reviews|length }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.customer_experience.index.tovar') }}</th><th>{{ ui_text('admin.customer_experience.index.avtor') }}</th><th>{{ ui_text('admin.customer_experience.index.otsinka') }}</th><th>{{ ui_text('admin.customer_experience.index.vidhuk') }}</th><th>{{ ui_text('admin.customer_experience.index.korysnist') }}</th><th>{{ ui_text('admin.customer_experience.index.moderatsiia_vidpovid') }}</th></tr></thead><tbody>{% for r in reviews %}<tr><td>{{ r.product_name }}</td><td>{{ r.author_name }}{% if r.verified_purchase %}<small>{{ ui_text('admin.customer_experience.index.pidtverdzhena_pokupka') }}</small>{% endif %}</td><td>{{ r.rating }}/5</td><td title="{{ r.body }}">{% if r.title %}<strong>{{ r.title }}</strong><br>{% endif %}{{ r.body|slice(0,160) }}{% if r.body|length>160 %}…{% endif %}{% if r.images is not empty %}<div class="admin-review-media">{% for image in r.images %}<a href="{{ image }}" target="_blank" rel="noopener"><img src="{{ image }}" alt="{{ ui_text('admin.customer_experience.index.foto_vidhuku') }}" loading="lazy" style="width:48px;height:48px;object-fit:cover"></a>{% endfor %}</div>{% endif %}</td><td>{{ r.helpful_count }}</td><td><form method="post" action="{{ path('admin_review_moderate',{id:r.id}) }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('review_moderate_' ~ r.id) }}"><textarea name="merchant_reply" rows="2" maxlength="8000" placeholder="{{ ui_text('admin.customer_experience.index.vidpovid_mahazynu') }}">{{ r.merchant_reply }}</textarea><select name="status"><option value="published"{{ r.status=='published'?' selected':'' }}>{{ ui_text('admin.customer_experience.index.opublikuvaty') }}</option><option value="pending"{{ r.status=='pending'?' selected':'' }}>{{ ui_text('admin.customer_experience.index.ochikuie') }}</option><option value="rejected"{{ r.status=='rejected'?' selected':'' }}>{{ ui_text('admin.customer_experience.index.vidkhylyty') }}</option><option value="spam"{{ r.status=='spam'?' selected':'' }}>{{ ui_text('admin.customer_experience.index.spam') }}</option></select><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.customer_experience.index.zberehty_moderatsiiu_ta_vidpovid') }}" aria-label="{{ ui_text('admin.customer_experience.index.zberehty_moderatsiiu_ta_vidpovid') }}">{{ ui_icon('check', 18) }}</button></form></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.customer_experience.index.vidhukiv_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel"><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.index.pytannia_do_tovariv') }}</h2><span>{{ questions|length }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.customer_experience.index.tovar') }}</th><th>{{ ui_text('admin.customer_experience.index.avtor') }}</th><th>{{ ui_text('admin.customer_experience.index.pytannia') }}</th><th>{{ ui_text('admin.customer_experience.index.vidpovid') }}</th><th>{{ ui_text('admin.customer_experience.index.status') }}</th><th>{{ ui_text('admin.customer_experience.index.diia') }}</th></tr></thead><tbody>{% for q in questions %}<tr><td>{{ q.product_name }}</td><td>{{ q.author_name }}</td><td>{{ q.question }}</td><td colspan="3"><form method="post" action="{{ path('admin_question_moderate',{id:q.id}) }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('question_moderate_' ~ q.id) }}"><textarea name="answer" rows="2" maxlength="8000" placeholder="{{ ui_text('admin.customer_experience.index.vidpovid') }}">{{ q.answer }}</textarea><select name="status"><option value="published">{{ ui_text('admin.customer_experience.index.opublikuvaty') }}</option><option value="pending">{{ ui_text('admin.customer_experience.index.ochikuie') }}</option><option value="rejected">{{ ui_text('admin.customer_experience.index.vidkhylyty') }}</option></select><button class="admin-icon-button is-success" type="submit" title="{{ ui_text('admin.customer_experience.index.zberehty_vidpovid') }}" aria-label="{{ ui_text('admin.customer_experience.index.zberehty_vidpovid') }}">{{ ui_icon('check', 18) }}</button></form></td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.customer_experience.index.pytan_nemaie') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="admin-panel" data-withdrawal-notices><div class="admin-panel__header"><h2>{{ ui_text('admin.customer_experience.index.withdrawals') }}</h2><span>{{ withdrawals|length }}</span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ ui_text('admin.customer_experience.index.zamovlennia') }}</th><th>{{ ui_text('admin.customer_experience.index.kliient') }}</th><th>{{ ui_text('admin.customer_experience.index.withdrawal_scope') }}</th><th>{{ ui_text('admin.customer_experience.index.data') }}</th><th>{{ ui_text('admin.customer_experience.index.withdrawal_matched') }}</th><th>{{ ui_text('admin.customer_experience.index.status') }}</th></tr></thead><tbody>{% for w in withdrawals %}<tr><td><strong>{{ w.order_reference }}</strong></td><td>{{ w.customer_name }}<small>{{ w.email }}</small></td><td>{{ w.scope_note|default('—') }}</td><td>{{ w.received_at }}</td><td>{{ w.order_id ? '✓' : '—' }}</td><td>{% if w.status == 'received' %}<form method="post" action="{{ path('admin_return_withdrawal_process',{id:w.id}) }}" class="admin-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('withdrawal_process_' ~ w.id) }}"><button class="admin-button" type="submit">{{ ui_icon('check', 18) }} {{ ui_text('admin.customer_experience.index.withdrawal_done') }}</button></form>{% else %}<span class="admin-badge is-ok">{{ ui_text('admin.customer_experience.index.withdrawal_done_state') }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="6">{{ ui_text('admin.customer_experience.index.withdrawals_empty') }}</td></tr>{% endfor %}</tbody></table></div></section>
{{ shell.end() }}
