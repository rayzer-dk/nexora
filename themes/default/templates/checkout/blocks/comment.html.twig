<details class="ck-fold" data-checkout-block="comment"{% if old.customer_comment|default('') or block.props.required|default(false) %} open{% endif %}><summary>{{ ui_icon('message-square', 18) }}<span>{{ block.props.title|default(ui_text('comment')) }}</span>{{ ui_icon('chevron-down', 16) }}</summary>
  <label class="ck-field"><span class="sr-only">{{ block.props.title|default(ui_text('comment')) }}</span><textarea name="customer_comment" maxlength="2000" rows="2" placeholder="{{ block.props.placeholder|default(ui_text('comment_placeholder')) }}" {% if block.props.required|default(false) %}required{% endif %}>{{ old.customer_comment|default('') }}</textarea></label>
</details>
