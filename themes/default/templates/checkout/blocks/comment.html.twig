<section class="checkout-card checkout-builder-block" data-checkout-block="comment"><div class="checkout-card__head"><b>{{ number }}</b><div><strong>{{ block.props.title|default(ui_text('comment')) }}</strong><span>{{ block.props.subtitle|default(ui_text('comment_subtitle')) }}</span></div></div><label class="checkout-wide-field"><textarea name="customer_comment" maxlength="2000" rows="4" placeholder="{{ block.props.placeholder|default(ui_text('comment_placeholder')) }}" {% if block.props.required|default(false) %}required{% endif %}></textarea></label></section>
