<details class="ck-fold" data-checkout-block="company"{% if old.company_name|default('') or old.company_tax_id|default('') or block.props.require_tax_id|default(false) %} open{% endif %}><summary>{{ ui_icon('building', 18) }}<span>{{ block.props.title|default(ui_text('company_sole')) }}</span>{{ ui_icon('chevron-down', 16) }}</summary>
  <div class="ck-grid"><label class="ck-field"><span>{{ ui_text('company_name') }}</span><input name="company_name" value="{{ old.company_name|default('') }}" maxlength="190" autocomplete="organization"></label>{% if block.props.show_tax_id|default(true) %}<label class="ck-field"><span>{{ ui_text('tax_id') }}{% if block.props.require_tax_id|default(false) %} *{% endif %}</span><input name="company_tax_id" value="{{ old.company_tax_id|default('') }}" maxlength="64" {% if block.props.require_tax_id|default(false) %}required{% endif %}></label>{% endif %}</div>
</details>
