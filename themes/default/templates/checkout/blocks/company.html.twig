<section class="checkout-card checkout-builder-block" data-checkout-block="company"><div class="checkout-card__head"><b>{{ number }}</b><div><strong>{{ block.props.title|default(ui_text('company_sole')) }}</strong><span>{{ block.props.subtitle|default(ui_text('company_subtitle')) }}</span></div></div><div class="delivery-fields"><label><span>{{ ui_text('company_name') }}</span><input name="company_name" maxlength="190" autocomplete="organization"></label>{% if block.props.show_tax_id|default(true) %}<label><span>{{ ui_text('tax_id') }}{% if block.props.require_tax_id|default(false) %} *{% endif %}</span><input name="company_tax_id" maxlength="64" {% if block.props.require_tax_id|default(false) %}required{% endif %}></label>{% endif %}</div></section>
