<section class="checkout-block extension-block" data-extension-component="{{ block.component|e('html_attr') }}">
  {% set title = block.props.title|default('')|builder_text %}{% set text = block.props.text|default('')|builder_text %}
  {% if title %}<h2>{{ title }}</h2>{% endif %}
  {% if text %}<p>{{ text }}</p>{% endif %}
</section>
