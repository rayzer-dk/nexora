<details class="ck-fold" data-checkout-block="coupon"{% if old.coupon_code|default('') %} open{% endif %}><summary>{{ ui_icon('tag', 18) }}<span>{{ block.props.title|default(ui_text('promo_code')) }}</span>{{ ui_icon('chevron-down', 16) }}</summary>
  <div class="ck-field"><div class="coupon-row"><input type="text" name="coupon_code" value="{{ old.coupon_code|default('') }}" maxlength="64" autocomplete="off" placeholder="{{ ui_text('promo_placeholder') }}" aria-label="{{ ui_text('promo_code') }}" data-coupon-code><button class="button button--secondary" type="button" data-coupon-apply>{{ ui_text('apply') }}</button></div><small class="ck-hint" data-coupon-message aria-live="polite">{{ ui_text('promo_validation') }}</small></div>
</details>
