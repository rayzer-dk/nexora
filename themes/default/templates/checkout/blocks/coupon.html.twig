<section class="checkout-card checkout-builder-block" data-checkout-block="coupon"><div class="checkout-card__head"><b>{{ number }}</b><div><strong>{{ block.props.title|default(ui_text('promo_code')) }}</strong><span>{{ block.props.subtitle|default(ui_text('promo_subtitle')) }}</span></div></div><div class="coupon-box"><label><span>{{ ui_text('promo_code') }}</span><div class="coupon-row"><input type="text" name="coupon_code" maxlength="64" autocomplete="off" placeholder="{{ ui_text('promo_placeholder') }}" data-coupon-code><button type="button" data-coupon-apply>{{ ui_text('apply') }}</button></div></label><small data-coupon-message>{{ ui_text('promo_validation') }}</small></div></section>
