{% if cart.requires_shipping %}
<section class="checkout-card is-active checkout-builder-block" data-checkout-block="shipping">
  <div class="checkout-card__head"><b>{{ number }}</b><div><strong>{{ block.props.title|default(ui_text('receive')) }}</strong><span>{{ block.props.subtitle|default(ui_text('receive_subtitle')) }}</span></div></div>
  <div class="carrier-grid" role="radiogroup" aria-label="{{ ui_text('delivery_service') }}"><button class="carrier is-selected" type="button" data-carrier="nova_post"><strong>Nova Post</strong><span>{{ ui_text('delivery_branch_locker_courier') }}</span></button><button class="carrier" type="button" data-carrier="ukrposhta"><strong>{{ ui_text('ukrposhta') }}</strong><span>{{ ui_text('delivery_branch_courier') }}</span></button><button class="carrier" type="button" data-carrier="meest"><strong>Meest</strong><span>{{ ui_text('delivery_branch_locker') }}</span></button><button class="carrier" type="button" data-carrier="delivery_auto"><strong>{{ ui_text('ui.checkout.blocks.shipping.delivery') }}</strong><span>{{ ui_text('delivery_warehouse_courier') }}</span></button></div>
  <div class="delivery-fields delivery-search"><label><span>{{ ui_text('city') }}</span><input data-delivery-city type="search" placeholder="{{ ui_text('city_placeholder') }}" autocomplete="address-level2" required><div class="delivery-results" data-city-results hidden></div></label><label><span>{{ ui_text('branch_locker') }}</span><input data-delivery-point type="search" placeholder="{{ ui_text('branch_first_city') }}" autocomplete="off" disabled><div class="delivery-results" data-point-results hidden></div></label></div>
  <div class="delivery-fallback" hidden data-delivery-fallback><strong>{{ ui_text('carrier_unavailable') }}</strong><span>{{ ui_text('checkout_still_possible') }}</span><input name="delivery_manual" data-delivery-manual type="text" placeholder="{{ ui_text('manual_delivery_placeholder') }}"></div>
</section>
{% else %}
<section class="checkout-card is-active checkout-builder-block" data-checkout-block="shipping"><div class="checkout-card__head"><b>{{ number }}</b><div><strong>{{ block.props.title|default(ui_text('receive')) }}</strong><span>{{ ui_text('digital_delivery') }}</span></div></div></section>
{% endif %}
