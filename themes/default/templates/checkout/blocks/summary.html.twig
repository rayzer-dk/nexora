<aside class="order-summary checkout-builder-block" data-checkout-block="summary"><div class="order-summary__head"><span>{{ block.props.title|default(ui_text('order_summary')) }}</span><strong>{{ ui_text('items_count', {count: cart.count}) }}</strong></div>{% for item in cart.items %}<div class="summary-item"><img class="summary-image" src="{{ item.image }}" alt="" width="64" height="64"><div><strong>{{ item.name }}</strong><span>{{ item.quantity }} {{ item.unit_code }}</span></div><b>{{ item.line_total }}</b></div>{% endfor %}<div class="summary-total"><span>{{ ui_text('products_sum') }}</span><strong data-summary-subtotal>{{ cart.subtotal }}</strong></div>{% if cart.discount_minor > 0 %}<div class="summary-total" data-discount-row><span>{{ ui_text('discount') }}</span><strong data-summary-discount>−{{ cart.discount }}</strong></div>{% else %}<div class="summary-total" data-discount-row hidden><span>{{ ui_text('discount') }}</span><strong data-summary-discount></strong></div>{% endif %}<div class="summary-total summary-total--grand"><span>{{ ui_text('amount_due') }}</span><strong data-summary-total>{{ cart.total }}</strong></div><button class="place-order" type="submit">{{ block.props.button_label|default(ui_text('place_order')) }}</button></aside>
