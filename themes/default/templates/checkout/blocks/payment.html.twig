<section class="checkout-card is-active checkout-builder-block" data-checkout-block="payment"><div class="checkout-card__head"><b>{{ number }}</b><div><strong>{{ block.props.title|default(ui_text('payment_methods')) }}</strong><span>{{ block.props.subtitle|default(ui_text('payment_subtitle')) }}</span></div></div><div class="payment-methods">{% set first_payment = true %}{% for method in payment_methods %}{% if cart.requires_shipping or not method.requiresShipping %}<label class="payment-method"><input type="radio" name="payment_method" value="{{ method.code }}" {% if first_payment %}checked{% endif %}><span><strong>{{ method.name }}</strong>{% if method.code == 'monobank' %}<small>{{ ui_text('payment_monobank') }}</small>{% elseif method.code == 'cash_on_delivery' %}<small>{{ ui_text('payment_cod') }}</small>{% elseif method.code == 'bank_transfer' %}<small>{{ ui_text('payment_bank') }}</small>{% elseif method.code == 'b2b_invoice' %}<small>{{ ui_text('for_company', {company: b2b_company.name|default(ui_text('your_company'))}) }}{% if b2b_company.payment_terms_days|default(0) > 0 %} · {{ ui_text('payment_terms_days', {days: b2b_company.payment_terms_days}) }}{% endif %}</small>{% endif %}</span></label>{% set first_payment = false %}{% endif %}{% endfor %}</div>{% if b2b_company %}<div class="delivery-fields"><label><span>{{ ui_text('buyer_po') }}</span><input type="text" name="purchase_order_number" maxlength="128" placeholder="{{ ui_text('optional') }}"></label></div>{% endif %}</section>
