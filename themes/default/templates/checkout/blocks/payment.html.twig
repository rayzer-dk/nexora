{% set pay_icons = {cash_on_delivery: 'wallet', bank_transfer: 'credit-card', b2b_invoice: 'building'} %}
{% set available = [] %}{% for method in payment_methods %}{% if cart.requires_shipping or not method.requiresShipping %}{% set available = available|merge([method]) %}{% endif %}{% endfor %}
{% set current_pay = '' %}{% for method in available %}{% if method.code == old.payment_method|default('') %}{% set current_pay = method.code %}{% endif %}{% endfor %}
{% if current_pay == '' and available %}{% set current_pay = available[0].code %}{% endif %}
<section class="checkout-card is-active checkout-builder-block" data-checkout-block="payment"><div class="checkout-card__head"><b>{{ number }}</b><div><strong>{{ block.props.title|default(ui_text('payment_methods')) }}</strong></div></div>
  {% if available is empty %}<div class="store-notice is-warning" role="alert">{{ ui_icon('circle-alert', 18) }}<span>{{ ui_text('ck_no_payment') }}</span></div>{% endif %}
  <div class="ck-choices ck-choices--payments" role="radiogroup" aria-label="{{ ui_text('payment_methods') }}">
  {% for method in available %}
    <label class="ck-choice{% if method.code == current_pay %} is-selected{% endif %}"><input type="radio" name="payment_method" value="{{ method.code }}"{% if method.code == current_pay %} checked{% endif %}>
      <span class="ck-choice__icon" aria-hidden="true">{{ ui_icon(pay_icons[method.code]|default('credit-card'), 18) }}</span>
      {% set mc = method_config[method.code]|default({}) %}<span class="ck-choice__text"><strong>{{ mc.title|default('') ?: method.name }}</strong>{% if mc.text|default('') %}<small>{{ mc.text }}</small>{% elseif method.code == 'monobank' %}<small>{{ ui_text('payment_monobank') }}</small>{% elseif method.code == 'cash_on_delivery' %}<small>{{ ui_text('payment_cod') }}</small>{% elseif method.code == 'bank_transfer' %}<small>{{ ui_text('payment_bank') }}</small>{% elseif method.code == 'b2b_invoice' %}<small>{{ ui_text('for_company', {company: b2b_company.name|default(ui_text('your_company'))}) }}{% if b2b_company.payment_terms_days|default(0) > 0 %} · {{ ui_text('payment_terms_days', {days: b2b_company.payment_terms_days}) }}{% endif %}</small>{% endif %}</span>
    </label>
  {% endfor %}
  </div>
  {% if b2b_company %}<div class="ck-grid"><label class="ck-field"><span>{{ ui_text('buyer_po') }}</span><input type="text" name="purchase_order_number" value="{{ old.purchase_order_number|default('') }}" maxlength="128" placeholder="{{ ui_text('optional') }}"></label></div>{% endif %}
</section>
