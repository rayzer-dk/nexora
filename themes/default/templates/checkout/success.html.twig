{% extends '@storefront/base.html.twig' %}{% block body %}<section class="content-page"><div class="content-shell"><div class="content-card"><span class="eyebrow">{{ ui_text('order_created') }}</span><h1>{{ ui_text('thank_order') }}</h1><p>{{ ui_text('order_confirmation') }}</p>{% for message in app.flashes('payment_issue') %}<div class="checkout-error" role="alert">{{ message }}</div>{% endfor %}<a class="button" href="/catalog">{{ ui_text('continue_shopping') }}</a></div></div></section>{% endblock %}