{% extends '@storefront/base.html.twig' %}{% block body %}<section class="shell content-shell"><div class="content-card"><span class="eyebrow">{{ ui_text('order_created') }}</span><h1>{{ ui_text('thank_order') }}</h1><p>{{ ui_text('order_confirmation') }}</p>{% for message in app.flashes('payment_issue') %}<div class="store-notice is-error" role="alert">{{ message }}</div>{% endfor %}<a class="button button--primary" href="/catalog">{{ ui_text('continue_shopping') }}{{ ui_icon('arrow-right', 16) }}</a></div></section>{% endblock %}