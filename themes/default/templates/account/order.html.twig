{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-page">
<div class="account-page__header"><div><a class="section-link" href="{{ path('customer_account') }}">{{ ui_icon('arrow-left', 16) }}{{ ui_text('back_account') }}</a><h1>{{ ui_text('order_number', {number: order.order_number}) }}</h1><p>{{ order.created_at }}</p></div><span class="badge">{{ order.status }}</span></div>
<div class="account-grid"><section class="account-panel account-panel--orders"><h2>{{ ui_text('products_sum') }}</h2><div class="account-order-items">{% for item in order.items %}<div><span><strong>{{ item.name }}</strong><small>{{ item.sku }} · {{ item.quantity }} {{ item.unit_code }}</small></span><strong>{{ (item.line_total_minor / 100)|number_format(2, ',', ' ') }} {{ order.currency }}</strong></div>{% endfor %}</div></section><section class="account-panel"><h2>{{ ui_text('summary') }}</h2><dl class="account-data"><div><dt>{{ ui_text('payment') }}</dt><dd>{{ order.payment_status }}</dd></div><div><dt>{{ ui_text('fulfillment') }}</dt><dd>{{ order.fulfillment_status }}</dd></div><div><dt>{{ ui_text('total') }}</dt><dd><strong>{{ (order.total_minor / 100)|number_format(2, ',', ' ') }} {{ order.currency }}</strong></dd></div></dl></section></div>
{% if documents|default([]) %}<section class="account-panel"><div class="section-heading"><h2>{{ ui_text('documents') }}</h2><span>{{ documents|length }}</span></div><div class="account-order-items">{% for doc in documents %}<div><span><strong>{{ doc.document_number }}</strong><small>{{ doc.document_type == 'invoice' ? ui_text('invoice') : ui_text('credit_note') }} · {{ doc.issued_at }}</small></span><span><a class="button button--secondary button--sm" href="{{ path('customer_order_document_view',{document:doc.public_id}) }}" target="_blank">{{ ui_text('view') }}</a> <a class="button button--secondary button--sm" href="{{ path('customer_order_document_pdf',{document:doc.public_id}) }}">PDF</a></span></div>{% endfor %}</div></section>{% endif %}
{% if downloads|default([]) %}<section class="account-panel"><div class="section-heading"><h2>{{ ui_text('digital_files') }}</h2><span>{{ downloads|length }}</span></div><div class="account-order-items">{% for file in downloads %}<div><span><strong>{{ file.title }}</strong><small>{{ file.product_name }} · {{ file.download_count }}/{{ file.max_downloads }} {{ ui_text('downloads') }}{% if file.expires_at %} · {{ ui_text('until') }} {{ file.expires_at }}{% endif %}</small></span>{% if file.available %}<a class="button button--secondary button--sm" href="{{ path('customer_digital_download',{entitlement:file.public_id}) }}">{{ ui_text('download') }}</a>{% else %}<span class="badge">{{ file.status == 'pending' ? ui_text('after_payment') : (file.status == 'revoked' ? ui_text('access_revoked') : ui_text('unavailable')) }}</span>{% endif %}</div>{% endfor %}</div></section>{% endif %}
<section class="account-panel"><div class="section-heading"><h2>{{ ui_text('returns') }}</h2><span>{{ return_requests|length }}</span></div>{% for ret in return_requests %}<div class="account-return"><strong>{{ ret.status }}</strong><span>{{ ret.reason_code }} · {{ ret.item_count }} {{ ui_text('items_short') }}</span><small>{{ ret.created_at }}</small></div>{% else %}<p>{{ ui_text('no_returns') }}</p>{% endfor %}
{% if order.status not in ['cancelled'] %}<details><summary>{{ ui_text('create_return') }}</summary><form method="post" action="{{ path('customer_return_create',{order:order.public_id}) }}" class="feedback-form"><input type="hidden" name="_token" value="{{ csrf_token('return_create_' ~ order.public_id) }}"><fieldset><legend>{{ ui_text('products_quantity') }}</legend>{% for item in order.items %}<label>{{ item.name }} <small>{{ ui_text('max_short') }} {{ item.quantity }}</small><input type="number" name="quantity[{{ item.id }}]" min="0" max="{{ item.quantity }}" value="0" step="0.000001"></label>{% endfor %}</fieldset><label>{{ ui_text('reason') }}<select name="reason" required>{% for reason in return_reasons %}<option value="{{ reason }}">{{ reason }}</option>{% endfor %}</select></label><label>{{ ui_text('comment') }}<textarea name="note" rows="3" maxlength="4000"></textarea></label><button class="button button--secondary" type="submit">{{ ui_text('create_request') }}</button></form></details>{% endif %}</section>
</section>
{% endblock %}
