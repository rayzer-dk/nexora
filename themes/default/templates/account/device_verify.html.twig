{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-auth">
  <div class="account-card">
    <div class="account-card__head">
      <span class="eyebrow">{{ ui_text('account_security') }}</span>
      <h1>{{ ui_text('device_verify_title') }}</h1>
      <p>{{ ui_text('device_verify_text') }}</p>
    </div>
    <form method="post" action="{{ path('customer_device_verify') }}" class="account-form">
      <input type="hidden" name="_token" value="{{ csrf_token('customer_device_verify') }}">
      <label>{{ ui_text('device_verify_code') }}<input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></label>
      <button class="button button--primary" type="submit">{{ ui_text('device_verify_submit') }}</button>
    </form>
    <form method="post" action="{{ path('customer_device_verify') }}" class="account-form">
      <input type="hidden" name="_token" value="{{ csrf_token('customer_device_verify') }}"><input type="hidden" name="action" value="resend">
      <button class="button" type="submit">{{ ui_text('device_verify_resend') }}</button>
    </form>
    <form method="post" action="{{ path('customer_logout') }}" class="account-card__foot"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_logout') }}"><button class="button button--ghost" type="submit">{{ ui_text('device_verify_logout') }}</button></form>
  </div>
</section>
{% endblock %}
