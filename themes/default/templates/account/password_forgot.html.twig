{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-auth">
  <div class="account-card">
    <div class="account-card__head">
      <span class="eyebrow">{{ ui_text('account_security') }}</span>
      <h1>{{ ui_text('password_recovery') }}</h1>
      <p>{{ ui_text('password_recovery_text') }}</p>
    </div>
    <form method="post" action="{{ path('customer_password_forgot') }}" class="account-form">
      <input type="hidden" name="_token" value="{{ csrf_token('customer_password_forgot') }}">
      <label>Email<input type="email" name="email" value="{{ app.request.request.get('email') }}" autocomplete="email" required maxlength="320"></label>
      {% include '@storefront/components/captcha.html.twig' with {form:'password_recovery'} only %}
      <button class="button button--primary" type="submit">{{ ui_text('send_instruction') }}</button>
    </form>
    <p class="account-card__foot"><a href="{{ path('customer_login') }}">{{ ui_text('back_login') }}</a></p>
  </div>
</section>
{% endblock %}
