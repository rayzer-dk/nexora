{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-auth"><div class="account-card"><div class="account-card__head"><span class="eyebrow">{{ ui_text('personal_account') }}</span><h1>{{ ui_text('create_account_full') }}</h1><p>{{ ui_text('registration_optional') }}</p></div><form method="post" action="{{ path('customer_register') }}" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('customer_register') }}"><label>{{ ui_text('name') }}<input type="text" name="display_name" value="{{ app.request.request.get('display_name') }}" autocomplete="name" required maxlength="190"></label><label>Email<input type="email" name="email" value="{{ app.request.request.get('email') }}" autocomplete="email" required maxlength="320"></label><label>{{ ui_text('password') }}<input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="4096"><small>{{ ui_text('password_min_12') }}</small></label>{% if turnstile_enabled and turnstile_site_key %}<div class="cf-turnstile" data-sitekey="{{ turnstile_site_key|e('html_attr') }}"></div><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}<button class="button button--primary" type="submit">{{ ui_text('create_account_full') }}</button></form><p class="account-card__foot">{{ ui_text('already_registered') }} <a href="{{ path('customer_login') }}">{{ ui_text('login_button') }}</a></p></div></section>
{% endblock %}
