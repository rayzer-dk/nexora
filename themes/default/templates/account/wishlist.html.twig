{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-page"><div class="account-page__header"><div><a class="section-link" href="{{ path('customer_account') }}">{{ ui_icon('arrow-left', 16) }}{{ ui_text('back_account') }}</a><h1>{{ ui_text('wishlist') }}</h1><p>{{ ui_text('wishlist_text') }}</p></div></div>{% if products is empty %}<div class="account-panel empty-state"><strong>{{ ui_text('wishlist_empty') }}</strong><p>{{ ui_text('wishlist_empty_text') }}</p><a class="button button--primary" href="/catalog">{{ ui_text('go_catalog') }}</a></div>{% else %}<div class="wishlist-grid">{% for product in products %}<article class="wishlist-card"><a href="{{ product.url }}"><img src="{{ product.image }}" alt="{{ product.name }}" loading="lazy" width="320" height="320"></a><div><small>{{ product.brand }}</small><h2><a href="{{ product.url }}">{{ product.name }}</a></h2><span>SKU {{ product.sku }}</span><strong>{{ product.price }}</strong><form method="post" action="{{ path('customer_wishlist_remove',{product:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('wishlist_remove_' ~ product.id) }}"><button class="button button--ghost" type="submit">{{ ui_text('remove') }}</button></form></div></article>{% endfor %}</div>{% endif %}</section>
{% endblock %}
