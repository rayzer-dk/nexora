{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-auth"><div class="account-card"><div class="account-card__head"><span class="eyebrow">{{ ui_text('personal_account') }}</span><h1>{{ ui_text('sign_in') }}</h1><p>{{ ui_text('login_intro') }}</p></div>{% if login_error %}<div class="form-alert is-error">{{ ui_text('invalid_credentials') }}</div>{% endif %}<form method="post" action="{{ path('customer_login') }}" class="account-form"><label>Email<input type="email" name="_username" value="{{ last_username }}" autocomplete="email" required maxlength="320"></label><label>{{ ui_text('password') }}<input type="password" name="_password" autocomplete="current-password" required maxlength="4096"></label><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_authenticate') }}"><button class="button button--primary" type="submit">{{ ui_text('login_button') }}</button></form><p class="account-card__foot"><a href="{{ path('customer_password_forgot') }}">{{ ui_text('forgot_password') }}</a></p><p class="account-card__foot">{{ ui_text('no_account') }} <a href="{{ path('customer_register') }}">{{ ui_text('create_account') }}</a></p></div></section>
{% endblock %}
