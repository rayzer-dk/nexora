{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-page">
  <div class="account-page__header"><div><span class="eyebrow">{{ ui_text('personal_account') }}</span><h1>{{ customer.display_name|default(app.user.displayName) }}</h1><p>{{ customer.email|default(app.user.email) }}</p></div><form method="post" action="{{ path('customer_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_logout') }}"><button class="button button--ghost" type="submit">{{ ui_text('logout') }}</button></form></div>
  {% include '@storefront/extension/slot.html.twig' with {slot:'account.dashboard'} only %}
  <div class="account-grid">
    <div class="account-stack">
      <section class="account-panel"><div class="account-panel__title"><h2>{{ ui_text('profile') }}</h2><a class="section-link" href="{{ path('customer_wishlist') }}">{{ ui_icon('heart', 16) }}{{ ui_text('wishlist') }}</a></div>{% if customer.email_verified_at %}<div class="store-notice is-success account-verify-state">{{ ui_icon('check-circle', 20) }}<div><strong>{{ ui_text('email_verified') }}</strong><span>{{ customer.email }}</span></div></div>{% else %}<div class="store-notice is-warning account-verify-state">{{ ui_icon('circle-alert', 20) }}<div><strong>{{ ui_text('email_unverified') }}</strong><span>{{ customer.email }}</span></div><form method="post" action="{{ path('customer_email_resend_verification') }}"><input type="hidden" name="_token" value="{{ csrf_token('customer_resend_verification') }}"><button class="button button--ghost" type="submit">{{ ui_text('resend_link') }}</button></form></div>{% endif %}<form method="post" action="{{ path('customer_account_profile') }}" class="account-form account-form--compact"><input type="hidden" name="_token" value="{{ csrf_token('customer_profile') }}"><label>{{ ui_text('name') }}<input name="display_name" value="{{ customer.display_name|default('') }}" required maxlength="190" autocomplete="name"></label><label>{{ ui_text('phone') }}<input name="phone" value="{{ customer.phone_e164|default('') }}" maxlength="16" autocomplete="tel" placeholder="+380501234567"></label><label>{{ ui_text('language') }}<input name="locale" value="{{ customer.locale|default(store_identity.locale) }}" required maxlength="16"></label><button class="button button--primary" type="submit">{{ ui_text('save_profile') }}</button></form></section>
      <section class="account-panel"><h2>{{ ui_text('privacy') }}</h2><p class="muted">{{ ui_text('privacy_account_text') }}</p><div class="account-privacy-actions"><form method="post" action="{{ path('customer_privacy_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('customer_privacy_export') }}"><button class="button button--ghost" type="submit">{{ ui_text('export_data') }}</button></form><form method="post" action="{{ path('customer_privacy_erasure') }}" data-confirm="{{ ui_text('erasure_confirm') }}"><input type="hidden" name="_token" value="{{ csrf_token('customer_privacy_erasure') }}"><button class="button button--danger" type="submit">{{ ui_text('request_erasure') }}</button></form></div></section>
    </div>
    <section class="account-panel account-panel--orders"><h2>{{ ui_text('orders') }}</h2>{% if orders is empty %}<div class="empty-state"><strong>{{ ui_text('no_orders') }}</strong><p>{{ ui_text('no_orders_text') }}</p><a class="button button--primary" href="/catalog">{{ ui_text('go_catalog') }}</a></div>{% else %}<div class="account-orders">{% for item in orders %}<a class="account-order-row" href="{{ path('customer_account_order',{order:item.public_id}) }}"><span><strong>{{ item.order_number }}</strong><small>{{ item.created_at }}</small></span><span>{{ (item.total_minor / 100)|number_format(2, ',', ' ') }} {{ item.currency }}</span><span class="badge">{{ item.status }}</span></a>{% endfor %}</div>{% endif %}</section>
  </div>
</section>
<nav class="shell account-links"><a class="section-link" href="{{ path('customer_saved_carts') }}">{{ ui_text('saved_carts') }}{{ ui_icon('arrow-right', 16) }}</a><a class="section-link" href="{{ path('customer_rewards') }}">{{ ui_text('rewards_loyalty') }}{{ ui_icon('arrow-right', 16) }}</a></nav>
{% endblock %}
