{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-auth">
  <div class="account-card">
    <div class="account-card__head">
      <span class="eyebrow">{{ ui_text('account_security') }}</span>
      <h1>{{ ui_text('new_password') }}</h1>
      <p>{{ usable ? ui_text('reset_password_valid') : ui_text('reset_password_invalid') }}</p>
    </div>
    {% if usable %}
    <form method="post" action="{{ path('customer_password_reset',{token:token}) }}" class="account-form">
      <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
      <label>{{ ui_text('new_password') }}<input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="4096"><small>{{ ui_text('password_min_12') }}</small></label>
      <label>{{ ui_text('repeat_password') }}<input type="password" name="password_confirm" autocomplete="new-password" required minlength="12" maxlength="4096"></label>
      <button class="button button--primary" type="submit">{{ ui_text('save_new_password') }}</button>
    </form>
    {% else %}
      <a class="button button--primary" href="{{ path('customer_password_forgot') }}">{{ ui_text('request_new_link') }}</a>
    {% endif %}
  </div>
</section>
{% endblock %}
