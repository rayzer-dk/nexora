{% extends '@storefront/base.html.twig' %}
{% block body %}
<section class="shell account-auth">
    <div class="account-card">
        <div class="account-card__head">
            <span class="eyebrow">{{ ui_text('account_security') }}</span>
            <h1>{{ ui_text('account_verification.title') }}</h1>
            <p>{{ ui_text('account_verification.intro') }}</p>
        </div>

        {% for message in app.flashes('success') %}<div class="store-notice is-success">{{ message }}</div>{% endfor %}
        {% for message in app.flashes('error') %}<div class="store-notice is-error">{{ message }}</div>{% endfor %}

        <div class="account-verification-grid">
            <section>
                <h2>Email</h2>
                <p>{{ customer.email }}</p>
                <p>{{ customer.email_verified_at ? ui_text('account_verification.verified') : ui_text('account_verification.not_verified') }}</p>
                {% if not customer.email_verified_at %}
                    <form method="post" action="{{ path('customer_verification_request') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('customer_verification_request') }}">
                        <input type="hidden" name="channel" value="email">
                        <button class="button button--secondary" type="submit">{{ ui_text('account_verification.send_email') }}</button>
                    </form>
                {% endif %}
            </section>

            <section>
                <h2>SMS</h2>
                <p>{{ customer.phone_e164|default(ui_text('account_verification.no_phone')) }}</p>
                <p>{{ customer.phone_verified_at|default(null) ? ui_text('account_verification.verified') : ui_text('account_verification.not_verified') }}</p>
                {% if customer.phone_e164 and not customer.phone_verified_at|default(null) %}
                    <form method="post" action="{{ path('customer_verification_request') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('customer_verification_request') }}">
                        <input type="hidden" name="channel" value="sms">
                        <button class="button button--secondary" type="submit">{{ ui_text('account_verification.send_sms') }}</button>
                    </form>
                {% endif %}
            </section>
        </div>

        <form method="post" action="{{ path('customer_verification_confirm') }}" class="account-form">
            <input type="hidden" name="_token" value="{{ csrf_token('customer_verification_confirm') }}">
            <label>{{ ui_text('account_verification.channel') }}
                <select name="channel">
                    <option value="email">Email</option>
                    {% if customer.phone_e164 %}<option value="sms">SMS</option>{% endif %}
                </select>
            </label>
            <label>{{ ui_text('account_verification.code') }}
                <input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required autocomplete="one-time-code">
            </label>
            <button class="button button--primary" type="submit">{{ ui_text('account_verification.submit') }}</button>
        </form>
    </div>
</section>
{% endblock %}
