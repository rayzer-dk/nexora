{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/schemas/commerce-extension-settings-v2.json",
  "title": "Nexora Commerce declarative extension settings v2",
  "type": "object",
  "required": [
    "schema_version",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "fields": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "key",
          "type",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "type": {
            "enum": [
              "text",
              "textarea",
              "number",
              "integer",
              "boolean",
              "select",
              "url",
              "email",
              "secret",
              "color",
              "range",
              "multilingual_text",
              "multilingual_textarea"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190
          },
          "help": {
            "type": "string",
            "maxLength": 1000
          },
          "help_url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 500
          },
          "example": {
            "type": "string",
            "maxLength": 190
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "placeholder": {
            "type": "string",
            "maxLength": 190
          },
          "advanced": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 190
                }
              }
            }
          }
        }
      }
    }
  }
}
