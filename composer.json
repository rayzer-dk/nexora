{
    "name": "nexora-commerce/platform",
    "description": "Nexora Commerce modular e-commerce platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.9.7",
        "dompdf/dompdf": "^3.1.6",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-tokenizer": "*",
        "ext-zip": "*",
        "google/auth": "^1.54",
        "php": ">=8.4.0 <8.6",
        "symfony/cache": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/password-hasher": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/stopwatch": "8.1.*"
    },
    "suggest": {
        "ext-grpc": "Preferred transport for Google Merchant API client libraries when available.",
        "ext-protobuf": "Improves protobuf throughput for Google Merchant API client libraries.",
        "ext-redis": "Recommended for distributed cache, locks and high-volume queues.",
        "ext-imagick": "Optional image-processing fallback.",
        "jcupitt/vips": "Preferred high-performance media processing adapter when libvips is available.",
        "google/shopping-merchant-products": "Official Google Merchant Products client.",
        "google/shopping-merchant-accounts": "Official Google Merchant Accounts client.",
        "google/shopping-merchant-datasources": "Official Google Merchant Data Sources client.",
        "google/shopping-merchant-inventories": "Official Google Merchant Inventories client.",
        "google/shopping-merchant-promotions": "Official Google Merchant Promotions client.",
        "google/shopping-merchant-reports": "Official Google Merchant Reports client.",
        "google/shopping-merchant-notifications": "Official Google Merchant Notifications client.",
        "google/shopping-merchant-issueresolution": "Official Google Merchant Issue Resolution client.",
        "google/shopping-merchant-ordertracking": "Official Google Merchant Order Tracking client."
    },
    "autoload": {
        "psr-4": {
            "Commerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerce\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.4.23"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint:php": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "audit:security": "composer audit --locked",
        "validate:platform": "composer check-platform-reqs",
        "audit:licenses": "php bin/license-audit.php",
        "audit:static-security": "php bin/security-audit.php",
        "test:rollback": "php bin/failure-injection-check.php",
        "audit:seo": "php bin/seo-baseline-check.php",
        "audit:security-regression": "php bin/security-regression-check.php",
        "audit:runtime-failures": "php bin/runtime-failure-injection-check.php",
        "audit:performance": "php bin/performance-audit.php 10k",
        "audit:scale": "php bin/catalog-scale-audit.php",
        "audit:production-critical": "php bin/production-critical-check.php",
        "audit:full-release": "php bin/full-release-static-check.php",
        "audit:commerce-operations": "php bin/commerce-operations-check.php",
        "audit:backup-feed-seo": "php bin/backup-feed-seo-check.php",
        "audit:xss": "php bin/xss-hardening-check.php",
        "audit:ux-modernization": "php bin/ux-modernization-check.php",
        "audit:i18n-critical": "php bin/i18n-critical-journey-check.php",
        "audit:module-certification": "php bin/module-certification-check.php",
        "audit:i18n-runtime": "php bin/i18n-runtime-hardcode-audit.php",
        "audit:public-api": "php bin/public-api-contract-check.php",
        "audit:http-errors": "php bin/http-error-boundary-check.php"
    }
}
