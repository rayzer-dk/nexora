APP_ENV=dev
APP_SECRET=change-me
APP_PUBLIC_URL=https://shop.example.com
STORE_DEFAULT_COUNTRY=UA
STORE_DEFAULT_LOCALE=uk-UA
STORE_DEFAULT_CURRENCY=UAH
STORE_DEFAULT_TIMEZONE=Europe/Kyiv
MESSENGER_TRANSPORT_DSN=sync://
REDIS_DSN=redis://127.0.0.1:6379
VALKEY_DSN=valkey://127.0.0.1:6379
VALKEY_SESSION_DSN=redis://127.0.0.1:6379
LOCK_DSN=flock

NOVA_POST_API_BASE=https://api.novaposhta.ua/v2.0/json/
NOVA_POST_API_KEY=
NOVA_POST_SENDER_REF=
NOVA_POST_CONTACT_SENDER_REF=
NOVA_POST_CITY_SENDER_REF=
NOVA_POST_SENDER_ADDRESS_REF=
NOVA_POST_SENDER_PHONE=
NOVA_POST_PAYER_TYPE=Sender
NOVA_POST_PAYMENT_METHOD=NonCash
# Optional HTTPS URL template. Keep secret server-side; supported placeholders: {ref}, {apiKey}.
NOVA_POST_LABEL_URL_TEMPLATE=

UKRPOSHTA_API_BASE=https://www.ukrposhta.ua/address-classifier-ws/
UKRPOSHTA_BEARER=

DELIVERY_AUTO_API_BASE=https://www.delivery-auto.com/api/v4/Public/

# Meest API is contract-based. Values come from the merchant's Meest integration agreement.
MEEST_API_BASE=
MEEST_API_TOKEN=
MEEST_CITIES_PATH=
MEEST_POINTS_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_MERCHANT_ENABLED=0
GOOGLE_UCP_ENABLED=0
GOOGLE_UCP_VERSION=2026-04-08

# Database: MySQL 8.4 LTS or MariaDB 11.4 LTS for new installations. Always InnoDB + utf8mb4.
DATABASE_URL="mysql://commerce:change_me@127.0.0.1:3306/commerce?charset=utf8mb4"
DATABASE_SERVER_VERSION="8.4"

# Mail transport. Keep secrets outside the repository.
# native://default sends from the server itself (PHP mail / sendmail); an SMTP server can also be saved in the admin.
MAILER_DSN="native://default"
MAIL_FROM_ADDRESS="shop@example.com"
MAIL_FROM_NAME="Nexora Commerce"

# Optional error monitoring: incidents are POSTed as JSON (no stack traces, no personal data) to this https URL.
ERROR_WEBHOOK_URL=""

# Set to 1 to require two-factor authentication for every administrator (cannot be disabled from the panel).
ADMIN_REQUIRE_MFA=0

# Telegram is optional. Leave disabled/empty when not used.
TELEGRAM_NOTIFICATIONS_ENABLED=0
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""
TELEGRAM_API_BASE="https://api.telegram.org"
SMS_NOTIFICATIONS_ENABLED=0
SMS_GATEWAY_ENDPOINT=""
SMS_GATEWAY_BEARER_TOKEN=""
SMS_SENDER=""

# Cloudflare Turnstile is optional and used only as a step-up bot challenge.
TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# mono acquiring (hosted payment page; card data never enters the store).
MONOBANK_ACQUIRING_ENABLED=0
MONOBANK_ACQUIRING_API_BASE=https://api.monobank.ua
MONOBANK_ACQUIRING_TOKEN=
GOOGLE_LOGIN_ENABLED=0
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
LIQPAY_ENABLED=0
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=0
WAYFORPAY_ENABLED=0
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_DOMAIN=

# Ed25519 public key (base64) used to verify official Core update bundles. Blank disables Core update application.
CORE_UPDATE_PUBLIC_KEY=

# Google Merchant API (catalog sync; disabled operationally until credentials are supplied)
GOOGLE_MERCHANT_API_BASE=https://merchantapi.googleapis.com
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_MERCHANT_DATA_SOURCE=
GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON=
GOOGLE_MERCHANT_ACCESS_TOKEN=

# Consent-aware Marketing Hub. All providers are OFF by default.
MARKETING_GA4_ENABLED=0
MARKETING_GA4_MEASUREMENT_ID=
MARKETING_GA4_API_SECRET=
MARKETING_GA4_ENDPOINT=https://region1.google-analytics.com/mp/collect
MARKETING_META_ENABLED=0
MARKETING_META_PIXEL_ID=
MARKETING_META_ACCESS_TOKEN=
MARKETING_META_API_BASE=https://graph.facebook.com
MARKETING_META_API_VERSION=v24.0
MARKETING_TIKTOK_ENABLED=0
MARKETING_TIKTOK_PIXEL_CODE=
MARKETING_TIKTOK_ACCESS_TOKEN=
MARKETING_TIKTOK_ENDPOINT=https://business-api.tiktok.com/open_api/v1.3/event/track/

# Optional external search accelerator. SQL remains the automatic fallback.
MEILISEARCH_ENABLED=0
MEILISEARCH_ENDPOINT=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=commerce_products

# Optional AI authoring helpers (OFF by default)
AI_OPENAI_ENABLED=0
AI_OPENAI_API_KEY=""
AI_OPENAI_MODEL="gpt-5"
AI_GEMINI_ENABLED=0
AI_GEMINI_API_KEY=""
AI_GEMINI_MODEL="gemini-3.6-flash"
AI_ANTHROPIC_ENABLED=0
AI_ANTHROPIC_API_KEY=""
AI_ANTHROPIC_MODEL="claude-sonnet-5-5"

# Comma-separated reverse-proxy IPs/CIDRs. Leave empty when PHP is directly internet-facing.
SYMFONY_TRUSTED_PROXIES=
