{
  "name": "nexora-commerce-ui",
  "private": true,
  "version": "3.36.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "audit": "npm audit --omit=dev",
    "assets:audit": "node tools/check-asset-budgets.mjs",
    "build:production": "vite build && node tools/check-asset-budgets.mjs && node tools/precompress-assets.mjs public/build",
    "assets:compress": "node tools/precompress-assets.mjs public/assets",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint assets vite.config.ts playwright.config.ts tests/e2e",
    "lint:css": "stylelint \"assets/**/*.css\"",
    "format:check": "prettier --check \"playwright.config.ts\" \"tests/e2e/**/*.ts\" \"eslint.config.js\" \"stylelint.config.mjs\" \"prettier.config.mjs\"",
    "format": "prettier --write \"playwright.config.ts\" \"tests/e2e/**/*.ts\" \"eslint.config.js\" \"stylelint.config.mjs\" \"prettier.config.mjs\"",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "e2e:visual": "E2E_VISUAL=1 playwright test tests/e2e/visual.spec.ts",
    "e2e:update": "E2E_VISUAL=1 playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "qa": "npm run typecheck && npm run lint && npm run ui:icons:audit && npm run configurability:audit && npm run build:production && npm run e2e:chromium",
    "ui:icons:audit": "node tools/check-ui-icons.mjs",
    "configurability:audit": "node tools/check-configurability.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@lucide/vue": "1.46.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "codemirror": "6.0.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  },
  "license": "MIT",
  "description": "Nexora Commerce storefront and admin UI"
}
