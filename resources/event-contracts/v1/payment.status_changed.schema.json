{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:nexora-commerce:event:commerce.payment.status_changed:1",
    "type": "object",
    "required": [
        "store_id",
        "status",
        "provider"
    ],
    "additionalProperties": true,
    "properties": {
        "store_id": {
            "type": "integer",
            "minimum": 1
        },
        "status": {
            "type": "string",
            "maxLength": 64
        },
        "provider": {
            "type": "string",
            "maxLength": 96
        },
        "provider_status": {
            "type": "string",
            "maxLength": 96
        }
    }
}
